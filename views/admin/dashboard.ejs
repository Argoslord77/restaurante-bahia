<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración - Restaurante Bahía</title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <script src="/js/libs/qrcode.min.js" type="text/javascript"></script>
</head>
<body>

    <div class="toast-container-custom">
        <% if (error_msg && error_msg.length > 0) { %>
            <div class="toast show text-white bg-danger border-0 shadow" role="alert" id="liveToast">
                <div class="d-flex">
                    <div class="toast-body fw-semibold fs-7">
                        <i class="fa-solid fa-circle-xmark me-2"></i><%= error_msg %>
                    </div>
                    <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        <% } %>
        
        <% if (success_msg && success_msg.length > 0) { %>
            <div class="toast show text-white bg-success border-0 shadow" role="alert" id="liveToast">
                <div class="d-flex">
                    <div class="toast-body fw-semibold fs-7">
                        <i class="fa-solid fa-circle-check me-2"></i><%= success_msg %>
                    </div>
                    <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        <% } %>
    </div>

    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
           <%- include('../includes/sideBarMenu') %> 
            
            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4 d-flex flex-column min-vh-100">
                
                <div class="mb-auto">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                        <%- include('../includes/header', {encabezado_pagina: 'Panel de Control', desc_pagina: 'Resumen operativo en tiempo real.', add_btn: false}) %>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-muted border d-inline-flex align-items-center gap-1.5 px-2.5 py-1.5 rounded-pill fs-8">
                                <span class="spinner-grow text-success" id="indicadorPolling" style="width: 8px; height: 8px;" role="status"></span>
                                <span id="textoPolling">En vivo (10s)</span>
                            </span>
                        </div>
                    </div>
                    
                    <div id="contenedorAlertaTurno">
                        <% if (mostrarAlertaTurno) { %>
                            <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-left: 5px solid #dc3545;">
                                <h4 class="alert-heading"><i class="fas fa-exclamation-triangle"></i> ¡Sistema Bloqueado!</h4>
                                <p>No se ha detectado ningún <strong>Turno de Servicio Activo</strong> en el restaurante. Todas las operaciones críticas de salón, órdenes y transferencias de almacén están suspendidas temporalmente.</p>
                                <hr>
                                <p class="mb-0">Por favor, diríjase al módulo de cajas y realice la <strong>Apertura de Turno</strong> para restablecer las operaciones del staff.</p>
                            </div>
                        <% } %>
                    </div>
                    
                    <!-- TARJETAS DE MÉTRICAS PRINCIPALES -->
                    <div class="row g-3 mb-4">
                        <!-- Mesas Activas -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="card card-custom shadow-sm p-3">
                                <div class="text-muted text-uppercase fs-7 fw-semibold">Mesas Activas</div>
                                <div class="d-flex align-items-baseline justify-content-between mt-2">
                                    <span class="fs-2 fw-bold text-dark" id="metricMesasActivas"><%= metrics.mesasOcupadas %> / <%= metrics.mesasTotales %></span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" id="metricPorcentajeOcupacion">
                                        <%= metrics.mesasTotales > 0 ? Math.round((metrics.mesasOcupadas / metrics.mesasTotales) * 100) : 0 %>% Ocupación
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Pedidos en Cocina / Bar -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="card card-custom shadow-sm p-3">
                                <div class="text-muted text-uppercase fs-7 fw-semibold">Pedidos en Cocina</div>
                                <div class="d-flex align-items-baseline justify-content-between mt-2">
                                    <span class="fs-2 fw-bold text-dark" id="metricPedidosCocina"><%= metrics.pedidosCocina %></span>
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">Pendientes</span>
                                </div>
                            </div>
                        </div>

                        <!-- Ventas del Día -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="card card-custom shadow-sm p-3">
                                <div class="text-muted text-uppercase fs-7 fw-semibold">Ventas del Día</div>
                                <div class="d-flex align-items-baseline justify-content-between mt-2">
                                    <span class="fs-2 fw-bold text-dark" id="metricVentasDia">$<%= parseFloat(metrics.ventasDia || 0).toFixed(2) %></span>
                                    <span class="text-muted small fw-medium">Hoy</span>
                                </div>
                            </div>
                        </div>

                        <!-- Personal de Turno -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="card card-custom shadow-sm p-3">
                                <div class="text-muted text-uppercase fs-7 fw-semibold">Personal de Turno</div>
                                <div class="d-flex align-items-baseline justify-content-between mt-2">
                                    <span class="fs-2 fw-bold text-dark" id="metricPersonalTurno"><%= metrics.totalPersonal %></span>
                                    <span class="text-muted small fw-medium">Registrados</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Estados reales de las mesas -->
                        <div class="col-12 col-lg-8">
                            <div class="card card-custom shadow-sm p-4">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-shop me-2 text-secondary"></i>Estado de mesas</h5>
                                        <small class="text-muted">Estado operativo actual de cada mesa</small>
                                    </div>
                                    <small class="text-muted text-nowrap" id="ultimaActualizacionMesas">Actualizado recientemente</small>
                                </div>
                                <div class="row row-cols-2 row-cols-md-4 g-3" id="contenedorDistribucionMesas">
                                    <% if (metrics.distribucionMesas && metrics.distribucionMesas.length > 0) { %>
                                        <% metrics.distribucionMesas.forEach(m => {
                                            const estado = String(m.estado || m.estado_mesa_db || 'libre').toLowerCase();
                                            let badgeClase = 'bg-success-subtle text-success';
                                            let labelEstado = 'Libre';
                                            if (estado === 'ocupada') { badgeClase = 'bg-danger-subtle text-danger'; labelEstado = 'Ocupada'; }
                                            else if (estado === 'reservada') { badgeClase = 'bg-primary-subtle text-primary'; labelEstado = 'Reservada'; }
                                            else if (estado === 'desocupandose') { badgeClase = 'bg-warning-subtle text-warning-emphasis'; labelEstado = 'Por cobrar'; }
                                            else if (estado === 'mantenimiento') { badgeClase = 'bg-secondary-subtle text-secondary'; labelEstado = 'Mantenimiento'; }
                                        %>
                                            <div class="col">
                                                <div class="p-3 border rounded-3 text-center bg-light shadow-sm h-100 d-flex flex-column justify-content-center" title="<%= m.ubicacion || '' %>">
                                                    <div class="fw-bold text-secondary text-truncate"><%= m.numero || `Mesa ${m.id}` %></div>
                                                    <span class="badge <%= badgeClase %> mt-1 rounded-pill"><%= labelEstado %></span>
                                                    <% if (m.pedido_activo_id) { %>
                                                        <small class="text-muted mt-2 text-truncate">Pedido #<%= m.pedido_activo_id %><%= m.mesero ? ` · ${m.mesero}` : '' %></small>
                                                    <% } else if (m.ubicacion) { %>
                                                        <small class="text-muted mt-2 text-truncate"><%= m.ubicacion %></small>
                                                    <% } %>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="col-12">
                                            <div class="text-center text-muted border rounded-3 py-4">
                                                <i class="fa-solid fa-shop-slash fs-4 d-block mb-2"></i>
                                                No hay mesas configuradas.
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Últimas acciones del registro de auditoría -->
                        <div class="col-12 col-lg-4">
                            <div class="card card-custom shadow-sm p-4 h-100">
                                <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-clock-rotate-left me-2 text-secondary"></i>Últimas acciones</h5>
                                        <small class="text-muted">Registro de auditoría del sistema</small>
                                    </div>
                                    <a href="/admin/auditoria" class="small text-decoration-none text-nowrap" title="Abrir auditoría">Ver todo</a>
                                </div>
                                <ul class="list-unstyled mb-0 d-flex flex-column gap-3 fs-7" id="contenedorUltimasAcciones">
                                    <% if (metrics.ultimasAcciones && metrics.ultimasAcciones.length > 0) { %>
                                        <% metrics.ultimasAcciones.forEach(acc => { %>
                                            <li class="d-flex gap-2 align-items-start">
                                                <i class="fa-solid fa-circle-dot <%= acc.color || 'text-primary' %> mt-1 small" style="font-size: 0.6rem;"></i>
                                                <div class="min-w-0">
                                                    <div class="fw-semibold text-dark"><%= acc.texto %></div>
                                                    <small class="text-muted d-block text-truncate"><%= acc.detalle || '' %></small>
                                                    <small class="text-muted"><%= acc.creado_en ? new Date(acc.creado_en).toLocaleString('es-ES') : 'Fecha no disponible' %></small>
                                                </div>
                                            </li>
                                        <% }) %>
                                    <% } else { %>
                                        <li class="text-center text-muted py-3">
                                            <i class="fa-solid fa-clipboard-check fs-4 d-block mb-2"></i>
                                            No hay acciones registradas todavía.
                                        </li>
                                    <% } %>
                                </ul>
                                <small class="text-muted mt-3" id="ultimaActualizacionAcciones">Actualizado recientemente</small>
                            </div>
                        </div>
                    </div>
                </div>

                <%- include('../includes/footer') %>
            </main>
        </div>
    </div>
    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>

    <!-- POLLING EN TIEMPO REAL (10 SEGUNDOS) -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const INTERVALO_POLLING_MS = 10000;
            let pollingTimer = null;
            let solicitudEnCurso = false;

            const ESTADOS_MESA = {
                libre: { clase: 'bg-success-subtle text-success', etiqueta: 'Libre' },
                ocupada: { clase: 'bg-danger-subtle text-danger', etiqueta: 'Ocupada' },
                reservada: { clase: 'bg-primary-subtle text-primary', etiqueta: 'Reservada' },
                desocupandose: { clase: 'bg-warning-subtle text-warning-emphasis', etiqueta: 'Por cobrar' },
                mantenimiento: { clase: 'bg-secondary-subtle text-secondary', etiqueta: 'Mantenimiento' }
            };

            function escaparHtml(valor) {
                return String(valor ?? '').replace(/[&<>"']/g, caracter => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                })[caracter]);
            }

            function formatearFecha(valor) {
                if (!valor) return 'Fecha no disponible';
                const fecha = new Date(valor);
                return Number.isNaN(fecha.getTime()) ? 'Fecha no disponible' : fecha.toLocaleString('es-ES');
            }

            function actualizarIndicadorPolling(enLinea) {
                const indicador = document.getElementById('indicadorPolling');
                const texto = document.getElementById('textoPolling');
                if (indicador) {
                    indicador.classList.toggle('text-success', enLinea);
                    indicador.classList.toggle('text-danger', !enLinea);
                }
                if (texto) texto.textContent = enLinea ? 'En vivo (10s)' : 'Sin conexión';
            }

            function renderizarMesas(mesas) {
                const contenedor = document.getElementById('contenedorDistribucionMesas');
                if (!contenedor) return;

                if (!Array.isArray(mesas) || mesas.length === 0) {
                    contenedor.innerHTML = `
                        <div class="col-12">
                            <div class="text-center text-muted border rounded-3 py-4">
                                <i class="fa-solid fa-shop-slash fs-4 d-block mb-2"></i>
                                No hay mesas configuradas.
                            </div>
                        </div>
                    `;
                    return;
                }

                contenedor.innerHTML = mesas.map(mesa => {
                    const estado = String(mesa.estado || mesa.estado_mesa_db || 'libre').toLowerCase();
                    const configuracion = ESTADOS_MESA[estado] || ESTADOS_MESA.libre;
                    const numero = mesa.numero || `Mesa ${mesa.id ?? ''}`;
                    const tienePedido = mesa.pedido_activo_id !== null && mesa.pedido_activo_id !== undefined;
                    const detalle = tienePedido
                        ? `Pedido #${mesa.pedido_activo_id}${mesa.mesero ? ` · ${mesa.mesero}` : ''}`
                        : (mesa.ubicacion || '');

                    return `
                        <div class="col">
                            <div class="p-3 border rounded-3 text-center bg-light shadow-sm h-100 d-flex flex-column justify-content-center" title="${escaparHtml(mesa.ubicacion || '')}">
                                <div class="fw-bold text-secondary text-truncate">${escaparHtml(numero)}</div>
                                <span class="badge ${configuracion.clase} mt-1 rounded-pill">${configuracion.etiqueta}</span>
                                ${detalle ? `<small class="text-muted mt-2 text-truncate">${escaparHtml(detalle)}</small>` : ''}
                            </div>
                        </div>
                    `;
                }).join('');
            }

            function renderizarAcciones(acciones) {
                const contenedor = document.getElementById('contenedorUltimasAcciones');
                if (!contenedor) return;

                if (!Array.isArray(acciones) || acciones.length === 0) {
                    contenedor.innerHTML = `
                        <li class="text-center text-muted py-3">
                            <i class="fa-solid fa-clipboard-check fs-4 d-block mb-2"></i>
                            No hay acciones registradas todavía.
                        </li>
                    `;
                    return;
                }

                const coloresPermitidos = new Set(['text-success', 'text-danger', 'text-warning', 'text-primary']);
                contenedor.innerHTML = acciones.map(accion => {
                    const color = coloresPermitidos.has(accion.color) ? accion.color : 'text-primary';
                    const texto = accion.texto || `${accion.usuario_nombre || 'Usuario'}: ${accion.accion || 'Operación'}`;
                    const detalle = accion.detalle || `${accion.metodo_http || 'GET'} ${accion.ruta || '/'}`;
                    return `
                        <li class="d-flex gap-2 align-items-start">
                            <i class="fa-solid fa-circle-dot ${color} mt-1 small" style="font-size: 0.6rem;"></i>
                            <div class="min-w-0">
                                <div class="fw-semibold text-dark">${escaparHtml(texto)}</div>
                                <small class="text-muted d-block text-truncate">${escaparHtml(detalle)}</small>
                                <small class="text-muted">${escaparHtml(formatearFecha(accion.creado_en))}</small>
                            </div>
                        </li>
                    `;
                }).join('');
            }

            function actualizarAlertaTurno(mostrarAlertaTurno) {
                const contenedor = document.getElementById('contenedorAlertaTurno');
                if (!contenedor) return;
                if (!mostrarAlertaTurno) {
                    contenedor.innerHTML = '';
                    return;
                }
                if (contenedor.querySelector('.alert')) return;
                contenedor.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-left: 5px solid #dc3545;">
                        <h4 class="alert-heading"><i class="fas fa-exclamation-triangle"></i> ¡Sistema Bloqueado!</h4>
                        <p>No se ha detectado ningún <strong>Turno de Servicio Activo</strong> en el restaurante. Todas las operaciones críticas de salón, órdenes y transferencias de almacén están suspendidas temporalmente.</p>
                        <hr>
                        <p class="mb-0">Por favor, diríjase al módulo de cajas y realice la <strong>Apertura de Turno</strong> para restablecer las operaciones del staff.</p>
                    </div>
                `;
            }

            async function actualizarMetricasDashboard() {
                if (solicitudEnCurso) return;
                solicitudEnCurso = true;
                try {
                    const response = await fetch('/admin/api/dashboard/metrics', {
                        method: 'GET',
                        cache: 'no-store',
                        credentials: 'same-origin',
                        headers: {
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    const data = await response.json();
                    if (!data || !data.success) throw new Error(data?.message || 'Respuesta inválida');

                    const metrics = data.metrics || {};
                    const mesasTotales = Number(metrics.mesasTotales) || 0;
                    const mesasOcupadas = Number(metrics.mesasOcupadas) || 0;

                    const elMesas = document.getElementById('metricMesasActivas');
                    const elPorc = document.getElementById('metricPorcentajeOcupacion');
                    if (elMesas) elMesas.textContent = `${mesasOcupadas} / ${mesasTotales}`;
                    if (elPorc) elPorc.textContent = `${mesasTotales > 0 ? Math.round((mesasOcupadas / mesasTotales) * 100) : 0}% Ocupación`;

                    const elCocina = document.getElementById('metricPedidosCocina');
                    if (elCocina) elCocina.textContent = Number(metrics.pedidosCocina) || 0;

                    const elVentas = document.getElementById('metricVentasDia');
                    if (elVentas) elVentas.textContent = `$${(Number(metrics.ventasDia) || 0).toFixed(2)}`;

                    const elPersonal = document.getElementById('metricPersonalTurno');
                    if (elPersonal) elPersonal.textContent = Number(metrics.totalPersonal) || 0;

                    actualizarAlertaTurno(Boolean(data.mostrarAlertaTurno));

                    // Se renderizan también los arrays vacíos para quitar datos
                    // antiguos cuando una mesa queda libre o no hay logs.
                    renderizarMesas(metrics.distribucionMesas || []);
                    renderizarAcciones(metrics.ultimasAcciones || []);

                    const fechaActualizacion = formatearFecha(data.timestamp || new Date());
                    const elUltimaHora = document.getElementById('ultimaActualizacionMesas');
                    const elUltimaHoraAcciones = document.getElementById('ultimaActualizacionAcciones');
                    if (elUltimaHora) elUltimaHora.textContent = `Actualizado ${fechaActualizacion}`;
                    if (elUltimaHoraAcciones) elUltimaHoraAcciones.textContent = `Actualizado ${fechaActualizacion}`;
                    actualizarIndicadorPolling(true);
                } catch (error) {
                    actualizarIndicadorPolling(false);
                    console.warn('Fallo transitorio en polling del dashboard:', error);
                } finally {
                    solicitudEnCurso = false;
                }
            }

            function iniciarPolling() {
                if (pollingTimer) clearInterval(pollingTimer);
                actualizarMetricasDashboard();
                pollingTimer = setInterval(actualizarMetricasDashboard, INTERVALO_POLLING_MS);
            }

            iniciarPolling();

            // Pausar el polling si la pestaña está oculta y refrescar al volver.
            document.addEventListener('visibilitychange', () => {
                if (document.hidden) {
                    if (pollingTimer) clearInterval(pollingTimer);
                    pollingTimer = null;
                } else {
                    iniciarPolling();
                }
            });
        });
    </script>
</body>
</html>
