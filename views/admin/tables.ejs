<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoreo de Mesas - Restaurante</title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <script src="/js/libs/qrcode.min.js" type="text/javascript"></script>
    <style>
        .modo-pintura-activa .restaurant-card {
            cursor: pointer;
            transition: transform 0.2s;
        }
        .modo-pintura-activa .restaurant-card:hover {
            transform: scale(1.03);
            border-color: #0d6efd !important;
        }
    </style>
</head>
<body>

    <input type="hidden" id="serverBaseUrl" value="https://<%= serverIp %>:3000/">

    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>
            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4 d-flex flex-column min-vh-100">
                <%- include('../includes/header', {encabezado_pagina: 'Control / Mesas', desc_pagina: 'Gestión de áreas y ocupación del salón', add_btn: true, btn_label: "Nueva Mesa", modal: "modalCrearMesa"}) %>

                <% 
                    let mesasSinAsignar = tables.filter(m => !distributionToday[m.id]).length;
                    if (mesasSinAsignar > 0 && (user.rol === 'superadministrador' || user.rol === 'administrador' || user.rol === 'capitan')) { 
                %>
                    <div class="alert alert-warning d-flex align-items-center justify-content-between shadow-sm border-0 mb-4" id="bannerDistribucion">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-triangle-exclamation fs-5 text-warning"></i>
                            <span class="small fw-medium text-dark">Atención: Hay <strong><%= mesasSinAsignar %></strong> mesas sin dependiente asignado para el turno activo.</span>
                        </div>
                        <button class="btn btn-sm btn-dark small px-3 rounded-pill" id="btnAlertaAsignar">Asignar Ahora</button>
                    </div>
                <% } %>

                <% if (user.rol === 'superadministrador' || user.rol === 'administrador' || user.rol === 'capitan') { %>
                    <div class="card p-3 mb-4 shadow-sm bg-light border-0">
                        <div class="row g-3 align-items-center justify-content-between">
                            <div class="col-md-7 d-flex align-items-center gap-2">
                                <label class="form-label m-0 small fw-bold text-secondary text-nowrap">
                                    <i class="fa-solid fa-user-tie text-primary"></i> Seleccionar Dependiente:
                                </label>
                                <select id="selectPintarDependiente" class="form-select form-select-sm border-2" style="font-family: sans-serif; font-size: 11px;">
                                    <option value="">-- Todos / Elegir de la Lista --</option>
                                    <% waiters.forEach(waiter => { %>
                                        <option value="<%= waiter.id %>">
                                            <%= waiter.nombre %> <%= (waiter.rol && waiter.rol.toLowerCase() === 'capitan') ? '(Capitán)' : '' %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-5 text-md-end d-flex gap-2 justify-content-md-end">
                                <button id="btnModoEditarDistribucion" class="btn btn-sm btn-outline-primary px-3 shadow-sm" style="font-family: sans-serif; font-size: 11px;">
                                    <i class="fa-solid fa-paint-roller me-1"></i> Asignar / Editar Distribución
                                </button>
                                <button id="btnGuardarDistribucion" class="btn btn-sm btn-success px-4 shadow-sm" style="display:none; font-family: sans-serif; font-size: 11px;">
                                    <i class="fa-solid fa-floppy-disk"></i> Guardar Distribución
                                </button>
                                <button id="btnCancelarDistribucion" class="btn btn-sm btn-outline-secondary px-3" style="display:none; font-family: sans-serif; font-size: 11px;">
                                    Cancelar
                                </button>
                            </div>
                        </div>
                    </div>
                <% } %>

                <div class="row row-cols-1 row-cols-xs-2 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3" id="contenedorMesas">
                    <% if (tables.length === 0) { %>
                        <div class="col-12 text-center py-5 card-custom w-100 shadow-sm">
                            <i class="fa-solid fa-border-none text-muted fs-3 mb-2"></i>
                            <p class="text-muted mb-0 fs-7">No hay registros de mobiliario configurados en el sistema.</p>
                        </div>
                    <% } %>

                    <% tables.forEach(mesa => { 
                        let asignado = distributionToday[mesa.id];
                        let dependienteIdAsignado = asignado ? (asignado.dependiente_id || asignado.id || '') : '';
                    %>
                        <div class="col card-mesa-elemento" 
                             data-mesa-id="<%= mesa.id %>" 
                             data-area="<%= mesa.ubicacion %>" 
                             data-dependiente-id="<%= dependienteIdAsignado %>">
                            <div class="restaurant-card p-3 border rounded-3 bg-white shadow-sm h-100 d-flex flex-column justify-content-between card-custom">
                                
                                <div>
                                    <div class="card-header-section d-flex justify-content-between align-items-center mb-2">
                                        <h2 class="table-name fs-5 fw-bold text-dark m-0"><%= mesa.numero %></h2>
                                        
                                        <% if (mesa.estado === 'libre') { %>
                                            <div class="status-badge badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 d-flex align-items-center gap-1">
                                                <i class="fa-solid fa-circle" style="font-size: 7px;"></i> Libre
                                            </div>
                                        <% } else if (mesa.estado === 'ocupada') { %>
                                            <div class="status-badge badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 d-flex align-items-center gap-1">
                                                <i class="fa-solid fa-circle" style="font-size: 7px;"></i> Ocupada
                                            </div>
                                        <% } else if (mesa.estado === 'desocupandose') { %>
                                            <div class="status-badge badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1 d-flex align-items-center gap-1">
                                                <i class="fa-solid fa-circle" style="font-size: 7px;"></i> Limpieza
                                            </div>
                                        <% } else if (mesa.estado === 'reservada') { %>
                                            <div class="status-badge badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 d-flex align-items-center gap-1">
                                                <i class="fa-solid fa-circle" style="font-size: 7px;"></i> Reservada
                                            </div>
                                        <% } else if (mesa.estado === 'mantenimiento') { %>
                                            <div class="status-badge badge bg-dark-subtle text-dark border border-dark-subtle rounded-pill px-3 py-1 d-flex align-items-center gap-1">
                                                <i class="fa-solid fa-circle" style="font-size: 7px;"></i> Mantenimiento
                                            </div>
                                        <% } %>
                                    </div>

                                    <div class="badge-waiter-assigned alert alert-info p-1 px-2 mb-2 rounded-2 border-0 d-flex align-items-center justify-content-between gap-1 text-truncate fs-8" style="font-size: 11px;">
                                        <div class="d-flex align-items-center gap-1 text-truncate">
                                            <i class="fa-solid fa-user-tag text-info"></i> 
                                            <span class="label-waiter-name text-dark">
                                                <%= distributionToday[mesa.id] ? distributionToday[mesa.id].nombre : 'Sin Asignar' %>
                                            </span>
                                        </div>
                                        <span class="badge bg-light text-dark border fw-bold px-2 py-1"><%= mesa.carta || 'CUP' %></span>
                                    </div>

                                    <p class="waiter-name text-muted text-uppercase fw-semibold mb-2" style="font-size: 0.75rem;">
                                        <i class="fa-solid fa-location-dot me-1 text-secondary"></i> Ubicación: <%= mesa.ubicacion %>
                                    </p>
                                </div>  

                                <div class="card-middle-section d-flex justify-content-between align-items-center mb-3">
    
                                    <% if (mesa.estado === 'ocupada' && mesa.pedido_id) { %>
                                        <button class="btn-ver-orden btn btn-light btn-sm border shadow-sm" 
                                                style="font-size: 12px;" 
                                                data-pedido-id="<%= mesa.pedido_id %>"
                                                data-numero-mesa="<%= mesa.numero %>">
                                            <i class="fa-solid fa-hamburger"></i> <strong><%= mesa.total_productos || 0 %></strong> Orden
                                        </button>
                                        
                                        <% if (mesa.pedido_estado) { %>
                                            <div class="btn-status-atendido btn btn-success btn-sm text-white shadow-sm" style="font-size: 11px; font-weight: 500;">
                                                <i class="fa-solid fa-check text-white"></i> <%= mesa.pedido_estado %>
                                            </div>
                                        <% } %>
                                    <% } else { %>
                                        <span class="text-muted" style="font-size: 12px; font-style: italic;">Sin pedidos activos</span>
                                        <div></div>
                                    <% } %>

                                </div>

                                <div class="card-footer-section d-flex justify-content-between align-items-center text-muted fw-medium pt-2 border-top" style="font-size: 11px;">
                                    <div class="service-time"><i class="fa-regular fa-clock me-1"></i><span>--</span> min</div>
                                    <div class="people-count"><i class="fa-solid fa-users me-1"></i><span><strong><%= mesa.capacidad %></strong></span> p.</div>
                                </div>

                                <% if (user.rol === 'superadministrador' || user.rol === 'administrador') { %>
                                    <div class="d-flex justify-content-end gap-2 mt-2 pt-2 border-top card-footer-section action-crud-buttons">
                                        <button class="btn btn-sm d-flex align-items-center justify-content-center btn-editar bg-secondary text-white border-secondary shadow-sm" 
                                                style="width: 32px; height: 32px;" title="Editar Mesa"
                                                data-id="<%= mesa.id %>" 
                                                data-numero="<%= mesa.numero %>" 
                                                data-capacidad="<%= mesa.capacidad %>" 
                                                data-estado="<%= mesa.estado %>" 
                                                data-ubicacion="<%= mesa.ubicacion %>"
                                                data-carta="<%= mesa.carta || 'CUP' %>">
                                            <i class="fa-solid fa-gear text-white" style="font-size: 14px;"></i>
                                        </button>
                                        <button class="btn btn-sm d-flex align-items-center justify-content-center bg-danger text-white border-danger shadow-sm btn-eliminar-mesa" 
                                                style="width: 32px; height: 32px;" title="Quitar Mesa" data-id="<%= mesa.id %>" data-numero="<%= mesa.numero %>">
                                            <i class="fa-solid fa-trash text-white" style="font-size: 14px;"></i>
                                        </button>
                                    </div>
                                <% } %>
                                
                            </div>
                        </div>
                    <% }) %>
                </div>
                
                <div class="mt-auto">
                    <%- include('../includes/footer') %>
                </div>
            </main>
        </div>
    </div>

    <!-- MODAL CREAR MESA -->
    <div class="modal fade" id="modalCrearMesa" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered px-3">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">Registrar Nueva Mesa</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formCrearMesa">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold text-secondary small">Código / Número</label>
                                <input type="text" name="numero" class="form-control" required>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold text-secondary small">Capacidad Máxima</label>
                                <input type="number" name="capacidad" class="form-control" value="2" min="1" required>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold text-secondary small">Carta / Tarifa Asignada</label>
                                <select name="carta" class="form-select fw-bold" required>
                                    <option value="CUP" selected>Carta CUP (Moneda Nacional)</option>
                                    <option value="COMISION">Carta Comisión</option>
                                    <option value="ZELLE">Carta Zelle</option>
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold text-secondary small">Estado Inicial</label>
                                <select name="estado" class="form-select text-capitalize" required>
                                    <option value="libre" selected>Libre</option>
                                    <option value="ocupada">Ocupada</option>
                                    <option value="desocupandose">Desocupándose</option>
                                    <option value="reservada">Reservada</option>
                                    <option value="mantenimiento">Mantenimiento</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Ubicación / Área</label>
                                <input type="text" name="ubicacion" class="form-control" value="Salon Principal" required>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4">Guardar Mesa</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL EDITAR MESA -->
    <div class="modal fade" id="modalEditarMesa" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered px-3">
            <div class="modal-content border-0 shadow">
                <form id="formEditar">
                    <input type="hidden" id="editId">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title fw-bold">Propiedades de Mesa</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold text-secondary small">Código / Número</label>
                                <input type="text" name="numero" id="editNumero" class="form-control" required>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold text-secondary small">Capacidad</label>
                                <input type="number" name="capacidad" id="editCapacidad" class="form-control" min="1" required>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold text-secondary small">Carta / Moneda de Cobro</label>
                                <select name="carta" id="editCarta" class="form-select fw-bold" required>
                                    <option value="CUP">Carta CUP (Moneda Nacional)</option>
                                    <option value="COMISION">Carta Comisión</option>
                                    <option value="ZELLE">Carta Zelle</option>
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold text-secondary small">Estado</label>
                                <select name="estado" id="editEstado" class="form-select" required>
                                    <option value="libre">Libre</option>
                                    <option value="ocupada">Ocupada</option>
                                    <option value="desocupandose">Desocupándose</option>
                                    <option value="reservada">Reservada</option>
                                    <option value="mantenimiento">Mantenimiento</option>
                                </select>
                            </div>>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Ubicación / Área</label>
                                <input type="text" name="ubicacion" id="editUbicacion" class="form-control" required>
                            </div>

                            <div class="col-12 text-center mt-3 pt-3 border-top" id="qrContainerWrapper">
                                <label class="form-label fw-bold text-dark d-block mb-2 small">
                                    <i class="fa-solid fa-qrcode text-primary me-1"></i> Código QR de la Mesa (ID BD)
                                </label>
                                <div class="d-flex justify-content-center align-items-center bg-light p-3 border rounded-3 mx-auto" style="width: 160px; height: 160px;">
                                    <div id="qrcode"></div>
                                </div>
                                <span class="d-block text-muted mt-2 text-break" id="qrTextLink" style="font-size: 11px; font-family: monospace;"></span>
                            </div>

                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                        <button type="submit" class="btn btn-primary px-4">Actualizar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const hayTurnoActivo = <%- JSON.stringify(hayTurnoActivo) %>;
            const distributionToday = <%- JSON.stringify(distributionToday || {}) %>;

            if (!hayTurnoActivo) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Sin Turno Activo',
                    text: 'No hay un turno de servicio abierto. Debes abrir un turno en la caja para poder gestionar o asignar la distribución de mesas.',
                    confirmButtonText: 'Ir a Control de Turnos',
                    showCancelButton: true,
                    cancelButtonText: 'Permanecer aquí',
                    confirmButtonColor: '#0d6efd',
                    cancelButtonColor: '#6c757d'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/admin/turnos-servicio';
                    }
                });
            } else {
                const tieneAsignaciones = Object.keys(distributionToday).length > 0;
                if (!tieneAsignaciones) {
                    Swal.fire({
                        icon: 'info',
                        title: 'Distribución Pendiente',
                        text: 'El turno activo no cuenta con una distribución de mesas configurada. Por favor, haz clic en "Asignar / Editar Distribución" para asignar los dependientes.',
                        confirmButtonText: 'Entendido',
                        confirmButtonColor: '#0d6efd'
                    });
                }
            }

            let modoPintura = false;
            let mapaDistribucionTemporal = [];

            const contenedorMesas = document.getElementById('contenedorMesas');
            const selectPintarDependiente = document.getElementById('selectPintarDependiente');
            const btnModoEditarDistribucion = document.getElementById('btnModoEditarDistribucion');
            const btnGuardarDistribucion = document.getElementById('btnGuardarDistribucion');
            const btnCancelarDistribucion = document.getElementById('btnCancelarDistribucion');
            const btnAlertaAsignar = document.getElementById('btnAlertaAsignar');

            function filtrarMesasPorDependiente(dependienteIdSelected) {
                const cartasMesas = document.querySelectorAll('.card-mesa-elemento');
                
                cartasMesas.forEach(colMesa => {
                    const depId = colMesa.getAttribute('data-dependiente-id');
                    if (!dependienteIdSelected || dependienteIdSelected === "" || depId === dependienteIdSelected) {
                        colMesa.style.display = 'block';
                    } else {
                        colMesa.style.display = 'none';
                    }
                });
            }

            if (selectPintarDependiente) {
                selectPintarDependiente.addEventListener('change', function() {
                    if (!modoPintura) {
                        filtrarMesasPorDependiente(this.value);
                    }
                });
            }

            if (btnModoEditarDistribucion) {
                btnModoEditarDistribucion.addEventListener('click', function() {
                    if (!hayTurnoActivo) {
                        Swal.fire('Acción Denegada', 'No puedes asignar mesas sin un turno de servicio activo.', 'warning');
                        return;
                    }
                    if (!selectPintarDependiente.value) {
                        Swal.fire('Selecciona un Dependiente', 'Elige un dependiente en el selector para comenzar a asignarle mesas.', 'info');
                    }
                    activarModoDistribucion();
                });
            }

            if (btnAlertaAsignar) {
                btnAlertaAsignar.addEventListener('click', function() {
                    if (!hayTurnoActivo) {
                        Swal.fire('Atención', 'Debe haber un turno activo para realizar asignaciones.', 'warning');
                        return;
                    }
                    activarModoDistribucion();
                    selectPintarDependiente.focus();
                });
            }

            if (btnCancelarDistribucion) {
                btnCancelarDistribucion.addEventListener('click', desactivarModoDistribucion);
            }

            if (btnGuardarDistribucion) {
                btnGuardarDistribucion.addEventListener('click', guardarMapaDistribucion);
            }

            function activarModoDistribucion() {
                modoPintura = true;
                filtrarMesasPorDependiente('');
                
                contenedorMesas.classList.add('modo-pintura-activa');
                if (btnModoEditarDistribucion) btnModoEditarDistribucion.style.display = 'none';
                btnGuardarDistribucion.style.display = 'inline-block';
                btnCancelarDistribucion.style.display = 'inline-block';
                document.querySelectorAll('.action-crud-buttons').forEach(el => el.style.setProperty('display', 'none', 'important'));
            }

            function desactivarModoDistribucion() {
                modoPintura = false;
                contenedorMesas.classList.remove('modo-pintura-activa');
                if (btnModoEditarDistribucion) btnModoEditarDistribucion.style.display = 'inline-block';
                btnGuardarDistribucion.style.display = 'none';
                btnCancelarDistribucion.style.display = 'none';
                document.querySelectorAll('.action-crud-buttons').forEach(el => el.style.removeProperty('display'));
                window.location.reload();
            }

            if (contenedorMesas) {
                contenedorMesas.addEventListener('click', function(e) {
                    const cardElement = e.target.closest('.restaurant-card');
                    if (cardElement && modoPintura) {
                        if (e.target.closest('.action-crud-buttons')) return;

                        const dependienteId = selectPintarDependiente.value;
                        if (!dependienteId) {
                            Swal.fire('Atención', 'Por favor selecciona un dependiente primero en la lista para asignarle esta mesa.', 'warning');
                            return;
                        }

                        const nombreDependiente = selectPintarDependiente.options[selectPintarDependiente.selectedIndex].text;
                        const colContenedor = cardElement.closest('.card-mesa-elemento');
                        const mesaId = colContenedor.getAttribute('data-mesa-id');

                        cardElement.querySelector('.label-waiter-name').innerText = nombreDependiente;
                        cardElement.style.borderColor = '#198754';
                        colContenedor.setAttribute('data-dependiente-id', dependienteId);

                        mapaDistribucionTemporal = mapaDistribucionTemporal.filter(item => item.mesaId !== mesaId);
                        mapaDistribucionTemporal.push({ mesaId, dependienteId });
                        return;
                    }

                    const botonEditar = e.target.closest('.btn-editar');
                    if (botonEditar) {
                        e.preventDefault();
                        const tableId = botonEditar.getAttribute('data-id');
                        const numero = botonEditar.getAttribute('data-numero');
                        const ubicacion = botonEditar.getAttribute('data-ubicacion');
                        const capacidad = botonEditar.getAttribute('data-capacidad');
                        const estado = botonEditar.getAttribute('data-estado');
                        const carta = botonEditar.getAttribute('data-carta') || 'CUP';

                        document.getElementById('editId').value = tableId;
                        document.getElementById('editNumero').value = numero;
                        document.getElementById('editUbicacion').value = ubicacion;
                        document.getElementById('editCapacidad').value = capacidad;
                        document.getElementById('editEstado').value = estado;
                        document.getElementById('editCarta').value = carta;

                        const qrcodeDiv = document.getElementById('qrcode');
                        qrcodeDiv.innerHTML = "";
                        document.getElementById('qrTextLink').innerText = `Mesa ID: ${tableId}`;
                        
                        new QRCode(qrcodeDiv, {
                            text: tableId,
                            width: 130,
                            height: 130,
                            colorDark : "#000000",
                            colorLight : "#ffffff",
                            correctLevel : QRCode.CorrectLevel.Q
                        });

                        const modalEditar = new bootstrap.Modal(document.getElementById('modalEditarMesa'));
                        modalEditar.show();
                        return;
                    }

                    const botonEliminar = e.target.closest('.btn-eliminar-mesa');
                    if (botonEliminar) {
                        const id = botonEliminar.getAttribute('data-id');
                        const numero = botonEliminar.getAttribute('data-numero');
                        eliminarMesa(id, numero);
                        return;
                    }
                });
            }

            function guardarMapaDistribucion() {
                if(mapaDistribucionTemporal.length === 0) {
                    Swal.fire('Info', 'No has realizado ningún cambio nuevo en el salón.', 'info');
                    return;
                }

                const primeraMesa = document.querySelector('.card-mesa-elemento');
                const ubicacionArea = primeraMesa ? primeraMesa.getAttribute('data-area') : 'Salon Principal';

                fetch('/admin/mesas/distribucion', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ubicacion: ubicacionArea, asignaciones: mapaDistribucionTemporal })
                })
                .then(res => res.json())
                .then(data => {
                    if(data.success) {
                        Swal.fire('¡Éxito!', data.message, 'success').then(() => window.location.reload());
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                })
                .catch(() => Swal.fire('Error', 'No se pudo comunicar el mapa al servidor.', 'error'));
            }

            document.getElementById('formCrearMesa').addEventListener('submit', function(e) {
                e.preventDefault();
                const bootstrapModal = bootstrap.Modal.getInstance(document.getElementById('modalCrearMesa'));
                const formData = {
                    numero: this.numero.value,
                    capacidad: this.capacidad.value,
                    ubicacion: this.ubicacion.value,
                    estado: this.estado.value,
                    carta: this.carta.value
                };

                fetch('/admin/mesas/crear', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                })
                .then(res => res.json())
                .then(data => {
                    bootstrapModal.hide();
                    if(data.success) {
                        Swal.fire('¡Éxito!', data.message, 'success').then(() => window.location.reload());
                    } else {
                        Swal.fire('Error', data.message, 'error').then(() => bootstrapModal.show());
                    }
                })
                .catch(() => Swal.fire('Error', 'No se pudo procesar la solicitud.', 'error'));
            });

            document.getElementById('formEditar').addEventListener('submit', function(e) {
                e.preventDefault();
                const bootstrapModal = bootstrap.Modal.getInstance(document.getElementById('modalEditarMesa'));
                const id = document.getElementById('editId').value;
                const formData = {
                    numero: this.numero.value,
                    capacidad: this.capacidad.value,
                    ubicacion: this.ubicacion.value,
                    estado: this.estado.value,
                    carta: this.carta.value
                };

                fetch(`/admin/mesas/editar/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                })
                .then(res => res.json())
                .then(data => {
                    bootstrapModal.hide();
                    if(data.success) {
                        Swal.fire('¡Actualizado!', data.message, 'success').then(() => window.location.reload());
                    } else {
                        Swal.fire('Error', data.message, 'error').then(() => bootstrapModal.show());
                    }
                })
                .catch(() => Swal.fire('Error', 'Error de comunicación con el servidor.', 'error'));
            });
        });

        function eliminarMesa(id, numero) {
            Swal.fire({
                title: '¿Remover mesa?',
                text: `Se desvinculará permanentemente la Mesa ${numero}.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/mesas/eliminar/${id}`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    })
                    .then(res => res.json())
                    .then(data => {
                        if(data.success) {
                            Swal.fire('¡Eliminado!', data.message, 'success').then(() => window.location.reload());
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    })
                    .catch(() => Swal.fire('Error', 'No se pudo ejecutar el borrado.', 'error'));
                }
            });
        }
    </script>
</body>
</html>