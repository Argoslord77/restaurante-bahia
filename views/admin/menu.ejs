<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle || 'Gestión de Menú - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>
            
            <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">
                <%- include('../includes/header', {
                    encabezado_pagina: 'Menú / Platillos', 
                    desc_pagina: 'Gestión de la oferta gastronómica y platos especiales del turno', 
                    add_btn: true, 
                    btn_label: "Nuevo Platillo Regular", 
                    modal: "modalCrearPlatillo"
                }) %>

                <!-- SECCIÓN: PLATILLOS Y TRAGOS DEL DÍA (TURNO ACTIVO) -->
                <% 
                    const listaActivos = (typeof platillosDiaActivos !== 'undefined' && Array.isArray(platillosDiaActivos)) ? platillosDiaActivos : 
                                         ((typeof platillosDiaTurno !== 'undefined' && Array.isArray(platillosDiaTurno)) ? platillosDiaTurno : []);
                %>
                <div class="card card-custom shadow-sm border-0 mb-4 mt-3 overflow-hidden">
                    <div class="card-header bg-white py-3 px-4 border-0 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark mb-0 fs-6 d-flex align-items-center gap-2">
                                <i class="fa-solid fa-star text-warning"></i> Platillos y Tragos del Día 
                                <% if (locals.turnoActivo) { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fs-8">Turno Activo #<%= turnoActivo.id %></span>
                                <% } else { %>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fs-8">Sin Turno Abierto</span>
                                <% } %>
                            </h5>
                            <small class="text-secondary fs-8">Ofertas operativas temporales exclusivas de este turno.</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold shadow-xs" data-bs-toggle="modal" data-bs-target="#modalHistoricoPlatillosDia">
                                <i class="fa-solid fa-clock-rotate-left me-1 text-primary"></i> Historial / Reutilizar
                            </button>
                            <% if (locals.turnoActivo) { %>
                                <button class="btn btn-sm btn-dark rounded-pill px-3.5 fw-bold shadow-xs" data-bs-toggle="modal" data-bs-target="#modalCrearPlatilloDia">
                                    <i class="fa-solid fa-plus text-warning me-1"></i> Agregar Platillo del Día
                                </button>
                            <% } %>
                        </div>
                    </div>

                    <div class="card-body p-3 bg-light">
                        <% if (!locals.turnoActivo) { %>
                            <div class="alert alert-warning border-0 p-3 mb-0 rounded-3 small">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> Debe iniciar un <strong>Turno de Servicio</strong> para activar y vender platillos del día.
                            </div>
                        <% } else if (listaActivos.length === 0) { %>
                            <div class="text-center py-4 text-muted small bg-white rounded-3 border">
                                <i class="fa-solid fa-utensils fs-3 d-block mb-1 text-secondary opacity-50"></i>
                                El turno activo no tiene platillos del día configurados todavía.
                            </div>
                        <% } else { %>
                            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                                <% listaActivos.forEach(pd => { %>
                                    <div class="col">
                                        <div class="p-3 bg-white border rounded-3 shadow-xs h-100 d-flex flex-column justify-content-between position-relative">
                                            <div class="d-flex align-items-start gap-3">
                                                <% if (pd.foto && pd.foto !== 'null') { %>
                                                    <img src="/uploads/<%= pd.foto %>" alt="Foto" class="rounded" style="width: 54px; height: 54px; object-fit: cover;">
                                                <% } else { %>
                                                    <div class="rounded bg-light border d-flex align-items-center justify-content-center text-secondary" style="width: 54px; height: 54px;">
                                                        <i class="fa-solid <%= pd.tipo === 'BEBIDAS' ? 'fa-wine-glass text-info' : 'fa-bowl-food text-warning' %> fs-5"></i>
                                                    </div>
                                                <% } %>
                                                <div class="flex-grow-1 min-w-0">
                                                    <span class="badge <%= pd.tipo === 'BEBIDAS' ? 'bg-info-subtle text-info-emphasis' : 'bg-warning-subtle text-warning-emphasis' %> rounded-pill fs-8 text-uppercase mb-1">
                                                        <%= pd.tipo %>
                                                    </span>
                                                    <h6 class="fw-bold text-dark mb-0 fs-7 text-truncate"><%= pd.nombre %></h6>
                                                    <small class="text-muted fs-8 d-block text-truncate"><%= pd.descripcion || 'Especial del día' %></small>
                                                </div>
                                            </div>

                                            <div class="d-flex align-items-center justify-content-between mt-3 pt-2 border-top">
                                                <span class="fw-bold text-dark font-monospace fs-7">$<%= parseFloat(pd.precio).toFixed(2) %></span>
                                                <div class="btn-group gap-1">
                                                    <button class="btn btn-sm btn-outline-secondary border-0 btn-editar-platillo-dia" 
                                                            title="Editar Platillo del Día"
                                                            data-id="<%= pd.id %>"
                                                            data-nombre="<%= pd.nombre %>"
                                                            data-descripcion="<%= pd.descripcion || '' %>"
                                                            data-precio="<%= pd.precio %>"
                                                            data-precio_alt="<%= pd.precio_alt || '' %>"
                                                            data-precio_usd="<%= pd.precio_usd || '' %>"
                                                            data-tipo="<%= pd.tipo %>"
                                                            data-foto="<%= pd.foto || '' %>">
                                                        <i class="fa-solid fa-pen-to-square"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger border-0 btn-eliminar-platillo-dia" data-id="<%= pd.id %>" data-nombre="<%= pd.nombre %>" title="Remover del turno">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- BUSCADOR DEL MENÚ REGULAR -->
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3 bg-white p-3 rounded shadow-sm border">
                    <div class="col-12 col-sm-5 col-md-4 m-0">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" id="buscarPlatilloCatalogo" class="form-control bg-light border-start-0 ps-0" placeholder="Buscar platillo regular...">
                        </div>
                    </div>
                    <div class="text-secondary small fw-semibold">
                        Platillos regulares en catálogo: <span id="contadorPlatillos" class="badge bg-dark text-white rounded-pill px-2.5 py-1.5"><%= locals.platillos ? platillos.length : 0 %></span>
                    </div>
                </div>

                <!-- TABLA DE PLATILLOS REGULARES -->
                <div class="flex-grow-1 mb-4">
                    <div class="card card-custom shadow-sm border-0 overflow-hidden">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="tablaPlatillos">
                                <thead class="table-custom-thead text-uppercase fs-7">
                                    <tr>
                                        <th class="ps-4 py-3">Nombre del Platillo</th>
                                        <th class="py-3">Categoría</th>
                                        <th class="py-3">Precio Principal (CUP)</th>
                                        <th class="py-3">Precio Alt.</th>
                                        <th class="py-3">Precio (USD/Zelle)</th>
                                        <th class="text-center py-3" style="width: 150px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!locals.platillos || platillos.length === 0) { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted">
                                                <i class="fa-solid fa-utensils d-block fs-2 mb-2 text-secondary"></i> No hay platillos registrados en el menú.
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% platillos.forEach(platillo => { %>
                                            <tr id="row-<%= platillo.id %>" class="fila-platillo-catalogo" data-nombre="<%= platillo.nombre ? platillo.nombre.toLowerCase() : '' %>">
                                                <td class="ps-4 fw-semibold text-dark">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <% if (platillo.foto && platillo.foto !== 'null') { %>
                                                            <img src="/uploads/<%= platillo.foto %>" alt="Foto" class="user-avatar rounded">
                                                        <% } else { %>
                                                            <div class="user-avatar rounded bg-light border d-flex align-items-center justify-content-center text-secondary">
                                                                <i class="fa-solid fa-bowl-food"></i>
                                                            </div>
                                                        <% } %>
                                                        <div class="d-flex flex-column">
                                                            <span><%= platillo.nombre %></span>
                                                            <span class="text-muted small fw-normal"><%= platillo.descripcion || 'Sin descripción' %></span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-secondary border text-capitalize px-3 py-1 rounded-pill fs-7">
                                                        <%= platillo.nombre_categoria || platillo.categoria || 'General' %>
                                                    </span>
                                                </td>
                                                <td class="text-dark fw-bold">$<%= parseFloat(platillo.precio).toFixed(2) %></td>
                                                <td class="text-secondary small">
                                                    <%= (platillo.precio_alt) ? '$' + parseFloat(platillo.precio_alt).toFixed(2) : '-' %>
                                                </td>
                                                <td class="text-success small fw-semibold">
                                                    <%= (platillo.precio_usd) ? '$' + parseFloat(platillo.precio_usd).toFixed(2) : '-' %>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group gap-1">
                                                        <button class="btn btn-sm btn-outline-secondary border-0"
                                                            title="Editar"
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#modalEditarPlatillo"
                                                            data-id="<%= platillo.id %>"
                                                            data-nombre="<%= platillo.nombre %>"
                                                            data-descripcion="<%= platillo.descripcion || '' %>"
                                                            data-precio="<%= platillo.precio %>"
                                                            data-categoria="<%= platillo.categoria %>"
                                                            data-precio_alt="<%= platillo.precio_alt || '' %>"
                                                            data-precio_usd="<%= platillo.precio_usd || '' %>"
                                                            data-foto="<%= platillo.foto || '' %>">
                                                            <i class="fa-solid fa-pen-to-square"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger border-0 btn-eliminar-dish" 
                                                                title="Eliminar"
                                                                data-id="<%= platillo.id %>"
                                                                data-nombre="<%= platillo.nombre %>">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <%- include('../includes/footer') %>
            </main>
        </div>
    </div>

    <!-- MODAL: AGREGAR PLATILLO DEL DÍA (TURNO ACTIVO) -->
    <div class="modal fade" id="modalCrearPlatilloDia" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title fw-bold fs-6"><i class="fa-solid fa-star text-warning me-2"></i>Agregar Platillo / Trago del Día</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formCrearPlatilloDia" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Tipo de Oferta *</label>
                                <select name="tipo" class="form-select form-select-sm fw-bold" required>
                                    <option value="COMESTIBLES">Platillo de Cocina (Comestible)</option>
                                    <option value="BEBIDAS">Trago / Cóctel de Bar (Bebida)</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Nombre *</label>
                                <input type="text" name="nombre" class="form-control form-control-sm" placeholder="Ej: Arroz con Mariscos Especial / Daiquirí de Mango" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Descripción</label>
                                <textarea name="descripcion" class="form-control form-control-sm" rows="2" placeholder="Ingredientes y notas para el comensal..."></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Precio CUP *</label>
                                <input type="number" step="0.01" name="precio" class="form-control form-control-sm" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Precio Alt.</label>
                                <input type="number" step="0.01" name="precio_alt" class="form-control form-control-sm">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Precio USD</label>
                                <input type="number" step="0.01" name="precio_usd" class="form-control form-control-sm">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Foto (Opcional)</label>
                                <input type="file" name="foto" class="form-control form-control-sm" accept="image/*">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0 py-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold">Guardar en Turno</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: EDITAR PLATILLO DEL DÍA -->
    <div class="modal fade" id="modalEditarPlatilloDia" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title fw-bold fs-6"><i class="fa-solid fa-pen-to-square text-warning me-2"></i>Editar Platillo / Trago del Día</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formEditarPlatilloDia" enctype="multipart/form-data">
                    <input type="hidden" id="edit_pd_id">
                    <input type="hidden" id="edit_pd_foto_actual" name="fotoActual">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Tipo de Oferta *</label>
                                <select id="edit_pd_tipo" name="tipo" class="form-select form-select-sm fw-bold" required>
                                    <option value="COMESTIBLES">Platillo de Cocina (Comestible)</option>
                                    <option value="BEBIDAS">Trago / Cóctel de Bar (Bebida)</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Nombre *</label>
                                <input type="text" id="edit_pd_nombre" name="nombre" class="form-control form-control-sm" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Descripción</label>
                                <textarea id="edit_pd_descripcion" name="descripcion" class="form-control form-control-sm" rows="2"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Precio CUP *</label>
                                <input type="number" step="0.01" id="edit_pd_precio" name="precio" class="form-control form-control-sm" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Precio Alt.</label>
                                <input type="number" step="0.01" id="edit_pd_precio_alt" name="precio_alt" class="form-control form-control-sm">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Precio USD</label>
                                <input type="number" step="0.01" id="edit_pd_precio_usd" name="precio_usd" class="form-control form-control-sm">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Cambiar Foto (Opcional)</label>
                                <input type="file" name="foto" class="form-control form-control-sm" accept="image/*">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0 py-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success btn-sm px-4 fw-bold">Actualizar Oferta</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: HISTORIAL DE PLATILLOS DEL DÍA CON BUSCADOR Y ANTI-DUPLICADOS -->
    <div class="modal fade" id="modalHistoricoPlatillosDia" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title fw-bold fs-6"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Historial de Platillos del Día</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
                    <!-- BUSCADOR DEL HISTORIAL -->
                    <div class="mb-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                            <input type="text" id="buscarEnHistoricoPlatillosDia" class="form-control bg-light" placeholder="Buscar por nombre de platillo o trago histórico...">
                        </div>
                    </div>

                    <% 
                        const listaHistorica = (typeof platillosDiaHistoricos !== 'undefined' ? platillosDiaHistoricos : 
                                               (typeof historicoPlatillosDia !== 'undefined' ? historicoPlatillosDia : []));
                        const nombresEnTurno = listaActivos.map(p => (p.nombre || '').toLowerCase().trim());
                    %>

                    <div class="table-responsive" style="max-height: 420px;">
                        <table class="table table-hover align-middle mb-0" id="tablaHistoricoPlatillosDia">
                            <thead class="table-light fs-8 text-uppercase">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Tipo</th>
                                    <th>Precio</th>
                                    <th>Turno Origen</th>
                                    <th class="text-center">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (listaHistorica.length === 0) { %>
                                    <tr><td colspan="5" class="text-center py-4 text-muted small">No hay registro histórico de platillos del día.</td></tr>
                                <% } else { %>
                                    <% listaHistorica.forEach(item => { %>
                                        <% const yaEstaEnTurno = nombresEnTurno.includes((item.nombre || '').toLowerCase().trim()); %>
                                        <tr class="fila-historico-pd" data-nombre="<%= (item.nombre || '').toLowerCase() %>">
                                            <td>
                                                <strong><%= item.nombre %></strong><br>
                                                <small class="text-muted"><%= item.descripcion || 'Sin descripción' %></small>
                                            </td>
                                            <td>
                                                <span class="badge <%= item.tipo === 'BEBIDAS' ? 'bg-info text-dark' : 'bg-warning text-dark' %>">
                                                    <%= item.tipo %>
                                                </span>
                                            </td>
                                            <td>$<%= parseFloat(item.precio).toFixed(2) %></td>
                                            <td>Turno #<%= item.turno_servicio_id %></td>
                                            <td class="text-center">
                                                <% if (yaEstaEnTurno) { %>
                                                    <button class="btn btn-sm btn-light border text-muted" disabled>
                                                        <i class="fa-solid fa-check text-success"></i> Ya en turno
                                                    </button>
                                                <% } else { %>
                                                    <button class="btn btn-sm btn-primary btn-reutilizar-platillo-dia" data-id="<%= item.id %>" data-nombre="<%= item.nombre %>">
                                                        <i class="fa-solid fa-plus"></i> Reutilizar
                                                    </button>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0 py-2">
                    <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL CREAR PLATILLO REGULAR -->
    <div class="modal fade" id="modalCrearPlatillo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">Agregar Nuevo Platillo Regular</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formCrearPlatillo" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Nombre del Platillo *</label>
                                <input type="text" name="nombre" class="form-control" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Descripción</label>
                                <textarea name="descripcion" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Precio Principal ($) *</label>
                                <input type="number" step="0.01" name="precio" class="form-control" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Precio Alt.</label>
                                <input type="number" step="0.01" name="precio_alt" class="form-control">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Precio USD</label>
                                <input type="number" step="0.01" name="precio_usd" class="form-control">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Categoría *</label>
                                <select name="categoria" class="form-select text-capitalize" required>
                                    <option value="" disabled selected>-- Seleccione una Categoría --</option>
                                    <% if (typeof categorias !== 'undefined' && categorias.length > 0) { %>
                                        <% categorias.forEach(cat => { %>
                                            <option value="<%= cat.id %>"><%= cat.nombre %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Foto del Platillo</label>
                                <input type="file" name="foto" class="form-control" accept="image/*">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4">Guardar Platillo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL EDITAR PLATILLO REGULAR -->
    <div class="modal fade" id="modalEditarPlatillo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-utensils me-2"></i>Editar Datos del Platillo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formEditarPlatillo" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <input type="hidden" name="fotoActual" id="edit_foto">
                            <input type="hidden" id="edit_id">
                            
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small d-block">Imagen Actual</label>
                                <div id="thumbnail_container" class="mb-2 w-100 border rounded overflow-hidden" style="height: 220px;"></div>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Nombre del Platillo *</label>
                                <input type="text" name="nombre" id="edit_nombre" class="form-control" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Descripción</label>
                                <textarea name="descripcion" id="edit_descripcion" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Precio Principal ($) *</label>
                                <input type="number" step="0.01" name="precio" id="edit_precio" class="form-control" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Precio Alt.</label>
                                <input type="number" step="0.01" name="precio_alt" id="edit_precio_alt" class="form-control">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Precio USD</label>
                                <input type="number" step="0.01" name="precio_usd" id="edit_precio_usd" class="form-control">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Categoría *</label>
                                <select name="categoria" id="edit_categoria" class="form-select text-capitalize" required>
                                    <option value="" disabled>-- Seleccione una Categoría --</option>
                                    <% if (typeof categorias !== 'undefined' && categorias.length > 0) { %>
                                        <% categorias.forEach(cat => { %>
                                            <option value="<%= cat.id %>"><%= cat.nombre %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Cambiar Foto del Platillo</label>
                                <input type="file" name="foto" class="form-control" accept="image/*">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success btn-sm px-4">Actualizar Platillo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    
    <script>
    document.addEventListener("DOMContentLoaded", function() {

        // Buscador catálogo regular
        const inputBuscar = document.getElementById('buscarPlatilloCatalogo');
        const contadorPlatillos = document.getElementById('contadorPlatillos');

        if (inputBuscar) {
            inputBuscar.addEventListener('input', function(e) {
                const termino = e.target.value.toLowerCase().trim();
                const filas = document.querySelectorAll('.fila-platillo-catalogo');
                let count = 0;
                filas.forEach(fila => {
                    const nombre = fila.getAttribute('data-nombre') || '';
                    if (nombre.includes(termino)) {
                        fila.style.display = '';
                        count++;
                    } else {
                        fila.style.display = 'none';
                    }
                });
                if (contadorPlatillos) contadorPlatillos.textContent = count;
            });
        }

        // Buscador dentro del Historial de Platillos del Día
        const inputBuscarHistorico = document.getElementById('buscarEnHistoricoPlatillosDia');
        if (inputBuscarHistorico) {
            inputBuscarHistorico.addEventListener('input', function(e) {
                const term = e.target.value.toLowerCase().trim();
                document.querySelectorAll('.fila-historico-pd').forEach(row => {
                    const name = row.getAttribute('data-nombre') || '';
                    row.style.display = (term === '' || name.includes(term)) ? '' : 'none';
                });
            });
        }

        // 1. CREAR PLATILLO DEL DÍA
        const formCrearPlatilloDia = document.getElementById('formCrearPlatilloDia');
        if (formCrearPlatilloDia) {
            formCrearPlatilloDia.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(formCrearPlatilloDia);

                Swal.fire({ title: 'Guardando oferta del día...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                try {
                    const res = await fetch('/admin/menu/platillo-dia/crear', { method: 'POST', body: formData });
                    const data = await res.json();
                    if (data.success) {
                        Swal.fire({ icon: 'success', title: '¡Guardado!', text: data.message, timer: 1800, showConfirmButton: false })
                            .then(() => location.reload());
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: data.message });
                    }
                } catch (err) {
                    Swal.fire({ icon: 'error', title: 'Error de Red', text: 'No se pudo registrar la oferta del día.' });
                }
            });
        }

        // 2. ABRIR MODAL Y EDITAR PLATILLO DEL DÍA
        const modalEditarPD = new bootstrap.Modal(document.getElementById('modalEditarPlatilloDia'));
        document.addEventListener('click', (e) => {
            const btnEditPD = e.target.closest('.btn-editar-platillo-dia');
            if (btnEditPD) {
                document.getElementById('edit_pd_id').value = btnEditPD.getAttribute('data-id') || '';
                document.getElementById('edit_pd_nombre').value = btnEditPD.getAttribute('data-nombre') || '';
                document.getElementById('edit_pd_descripcion').value = btnEditPD.getAttribute('data-descripcion') || '';
                document.getElementById('edit_pd_precio').value = btnEditPD.getAttribute('data-precio') || '';
                document.getElementById('edit_pd_precio_alt').value = btnEditPD.getAttribute('data-precio_alt') || '';
                document.getElementById('edit_pd_precio_usd').value = btnEditPD.getAttribute('data-precio_usd') || '';
                document.getElementById('edit_pd_tipo').value = btnEditPD.getAttribute('data-tipo') || 'COMESTIBLES';
                document.getElementById('edit_pd_foto_actual').value = btnEditPD.getAttribute('data-foto') || '';
                modalEditarPD.show();
            }
        });

        const formEditarPlatilloDia = document.getElementById('formEditarPlatilloDia');
        if (formEditarPlatilloDia) {
            formEditarPlatilloDia.addEventListener('submit', async (e) => {
                e.preventDefault();
                const id = document.getElementById('edit_pd_id').value;
                const formData = new FormData(formEditarPlatilloDia);

                Swal.fire({ title: 'Actualizando oferta...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                try {
                    const res = await fetch(`/admin/menu/platillo-dia/editar/${id}`, { method: 'POST', body: formData });
                    const data = await res.json();
                    if (data.success) {
                        modalEditarPD.hide();
                        Swal.fire({ icon: 'success', title: '¡Actualizado!', text: data.message, timer: 1800, showConfirmButton: false })
                            .then(() => location.reload());
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: data.message });
                    }
                } catch (err) {
                    Swal.fire({ icon: 'error', title: 'Error de Red', text: 'No se pudo actualizar el platillo del día.' });
                }
            });
        }

        // 3. REUTILIZAR PLATILLO DEL DÍA HISTÓRICO
        document.addEventListener('click', async (e) => {
            const btnReutilizar = e.target.closest('.btn-reutilizar-platillo-dia');
            if (btnReutilizar) {
                const id = btnReutilizar.getAttribute('data-id');
                const nombre = btnReutilizar.getAttribute('data-nombre');

                Swal.fire({
                    title: '¿Agregar al turno actual?',
                    text: `Se agregará "${nombre}" como oferta del día en el turno activo.`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, incorporar',
                    cancelButtonText: 'Cancelar'
                }).then(async (choice) => {
                    if (choice.isConfirmed) {
                        try {
                            const res = await fetch(`/admin/menu/platillo-dia/reutilizar/${id}`, { method: 'POST' });
                            const data = await res.json();
                            if (data.success) {
                                Swal.fire({ icon: 'success', title: '¡Incorporado!', text: data.message, timer: 1500, showConfirmButton: false })
                                    .then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: data.message });
                            }
                        } catch (err) {
                            Swal.fire({ icon: 'error', title: 'Error de Red', text: 'Fallo al procesar la solicitud.' });
                        }
                    }
                });
            }

            // 4. ELIMINAR PLATILLO DEL DÍA DEL TURNO
            const btnEliminarPD = e.target.closest('.btn-eliminar-platillo-dia');
            if (btnEliminarPD) {
                const id = btnEliminarPD.getAttribute('data-id');
                const nombre = btnEliminarPD.getAttribute('data-nombre');

                Swal.fire({
                    title: '¿Remover del turno?',
                    text: `Se quitará "${nombre}" del turno activo.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    confirmButtonText: 'Sí, remover',
                    cancelButtonText: 'Cancelar'
                }).then(async (choice) => {
                    if (choice.isConfirmed) {
                        try {
                            const res = await fetch(`/admin/menu/platillo-dia/eliminar/${id}`, { method: 'DELETE' });
                            const data = await res.json();
                            if (data.success) {
                                Swal.fire({ icon: 'success', title: 'Removido', text: data.message, timer: 1400, showConfirmButton: false })
                                    .then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: data.message });
                            }
                        } catch (err) {
                            Swal.fire({ icon: 'error', title: 'Error de Red', text: 'No se pudo remover el platillo.' });
                        }
                    }
                });
            }
        });

        // PLATILLOS REGULARES (Crear, Editar, Eliminar)
        const formCrear = document.getElementById('formCrearPlatillo');
        if (formCrear) {
            formCrear.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(formCrear);
                try {
                    const response = await fetch('/admin/menu/crear', { method: 'POST', body: formData });
                    const resData = await response.json();
                    if (resData.success) {
                        Swal.fire({ icon: 'success', title: '¡Éxito!', text: resData.message }).then(() => location.reload());
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: resData.message });
                    }
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'Error de Red', text: 'Fallo al guardar platillo regular.' });
                }
            });
        }

        const modalEditar = document.getElementById('modalEditarPlatillo');
        if (modalEditar) {
            modalEditar.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('edit_id').value = button.getAttribute('data-id') || '';
                document.getElementById('edit_nombre').value = button.getAttribute('data-nombre') || '';
                document.getElementById('edit_descripcion').value = button.getAttribute('data-descripcion') || '';
                document.getElementById('edit_precio').value = button.getAttribute('data-precio') || '';
                document.getElementById('edit_categoria').value = button.getAttribute('data-categoria') || '';
                document.getElementById('edit_precio_alt').value = button.getAttribute('data-precio_alt') || '';
                document.getElementById('edit_precio_usd').value = button.getAttribute('data-precio_usd') || '';
                const foto = button.getAttribute('data-foto');
                document.getElementById('edit_foto').value = (foto && foto !== 'null') ? foto : '';

                const thumbContainer = document.getElementById('thumbnail_container');
                if (foto && foto !== 'null' && foto.trim() !== '') {
                    thumbContainer.innerHTML = `<img src="/uploads/${foto}" class="w-100 h-100" style="object-fit: cover;">`;
                } else {
                    thumbContainer.innerHTML = `<div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light text-muted small">Sin imagen asignada</div>`;
                }
            });
        }

        const formEditar = document.getElementById('formEditarPlatillo');
        if (formEditar) {
            formEditar.addEventListener('submit', async (e) => {
                e.preventDefault();
                const id = document.getElementById('edit_id').value;
                const formData = new FormData(formEditar);
                try {
                    const response = await fetch(`/admin/menu/editar/${id}`, { method: 'POST', body: formData });
                    const resData = await response.json();
                    if (resData.success) {
                        Swal.fire({ icon: 'success', title: '¡Actualizado!', text: resData.message }).then(() => location.reload());
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: resData.message });
                    }
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'Error de Red', text: 'No se pudo actualizar el platillo.' });
                }
            });
        }

        document.addEventListener('click', async function (e) {
            const btnEliminar = e.target.closest('.btn-eliminar-dish');
            if (!btnEliminar) return;
            const id = btnEliminar.getAttribute('data-id');
            const nombre = btnEliminar.getAttribute('data-nombre');

            Swal.fire({
                title: '¿Eliminar Platillo Regular?',
                html: `Se eliminará permanentemente: <br><b class="text-danger">"${nombre}"</b>.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                confirmButtonText: 'Sí, Eliminar',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/menu/eliminar/${id}`, { method: 'POST' });
                        const resData = await response.json();
                        if (resData.success) {
                            Swal.fire({ icon: 'success', title: '¡Eliminado!', text: resData.message }).then(() => {
                                const row = document.getElementById(`row-${id}`);
                                if (row) row.remove();
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: resData.message });
                        }
                    } catch (error) {
                        Swal.fire({ icon: 'error', title: 'Error de Red', text: 'No se pudo eliminar el platillo.' });
                    }
                }
            });
        });
    });
    </script>
</body>
</html>
