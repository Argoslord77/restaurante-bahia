<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle || 'Gestión de Menú - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>
            
            <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">
                <%- include('../includes/header', {encabezado_pagina: 'Menú / Platillos', desc_pagina: 'Gestión de la oferta gastronómica y platos del restaurante', add_btn: true, btn_label: "Nuevo Platillo", modal: "modalCrearPlatillo"}) %>
                
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 bg-white p-3 rounded shadow-sm border mt-3">
                    <div class="col-12 col-sm-5 col-md-4 m-0">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" id="buscarPlatilloCatalogo" class="form-control bg-light border-start-0 ps-0" placeholder="Buscar platillo por nombre...">
                        </div>
                    </div>
                    <!-- CONTADOR DINÁMICO DE PLATILLOS -->
                    <div class="text-secondary small fw-semibold">
                        Platillos mostrados: <span id="contadorPlatillos" class="badge bg-dark text-white rounded-pill px-2.5 py-1.5"><%= platillos.length %></span>
                    </div>
                </div>

                <div class="flex-grow-1 my-3">
                    <div class="card card-custom shadow-sm border-0 overflow-hidden">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="tablaPlatillos">
                                <thead class="table-custom-thead text-uppercase fs-7">
                                    <tr>
                                        <th class="ps-4 py-3">Nombre del Platillo</th>
                                        <th class="py-3">Categoría</th>
                                        <th class="py-3">Precio Principal</th>
                                        <th class="py-3">Precio Alt.</th>
                                        <th class="text-center py-3" style="width: 200px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (platillos.length === 0) { %>
                                        <tr id="filaSinPlatillosOriginal">
                                            <td colspan="5" class="text-center py-5 text-muted">
                                                <i class="fa-solid fa-utensils d-block fs-2 mb-2 text-secondary"></i> No hay platillos registrados en el menú.
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% platillos.forEach(platillo => { %>
                                            <tr id="row-<%= platillo.id %>" class="fila-platillo-catalogo" data-nombre="<%= platillo.nombre ? platillo.nombre.toLowerCase() : '' %>">
                                                <td class="ps-4 fw-semibold text-dark">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <% if (platillo.foto) { %>
                                                            <img src="/uploads/<%= platillo.foto %>" alt="Foto Platillo" class="user-avatar rounded">
                                                        <% } else { %>
                                                            <div class="user-avatar rounded bg-light border d-flex align-items-center justify-content-center text-secondary">
                                                                <i class="fa-solid fa-bowl-food"></i>
                                                            </div>
                                                        <% } %>
                                                        <div class="d-flex flex-column">
                                                            <span><%= platillo.nombre %></span>
                                                            <span class="text-muted small fw-normal"><%= platillo.descripcion || 'Sin descripción' %></span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-secondary border text-capitalize px-3 py-1 rounded-pill fs-7">
                                                        <%= platillo.nombre_categoria || platillo.categoria %>
                                                    </span>
                                                </td>
                                                <td class="text-dark fw-bold">$<%= parseFloat(platillo.precio).toFixed(2) %></td>
                                                <td class="text-secondary small">
                                                    <%= (platillo.precio_alt) ? '$' + parseFloat(platillo.precio_alt).toFixed(2) : '-' %>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group gap-1">
                                                        <button class="btn btn-sm btn-outline-secondary border-0"
                                                            title="Editar"
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#modalEditarPlatillo"
                                                            data-id="<%= platillo.id %>"
                                                            data-nombre="<%= platillo.nombre %>"
                                                            data-descripcion="<%= platillo.descripcion %>"
                                                            data-precio="<%= platillo.precio %>"
                                                            data-categoria="<%= platillo.categoria %>"
                                                            data-precio_alt="<%= platillo.precio_alt %>"
                                                            data-foto="<%= platillo.foto %>">
                                                            <i class="fa-solid fa-pen-to-square"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger border-0 btn-eliminar-dish" 
                                                                title="Eliminar"
                                                                data-id="<%= platillo.id %>"
                                                                data-nombre="<%= platillo.nombre %>">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                    <tr id="filaNoCoincidenciasMenu" style="display: none;">
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <i class="fas fa-filter d-block mb-2 fs-3 text-secondary opacity-50"></i>
                                            No se encontraron platillos que coincidan con la búsqueda.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <%- include('../includes/footer') %>
            </main>
        </div>
    </div>

    <div class="modal fade" id="modalCrearPlatillo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">Agregar Nuevo Platillo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formCrearPlatillo" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Nombre del Platillo</label>
                                <input type="text" name="nombre" class="form-control" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Descripción</label>
                                <textarea name="descripcion" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Precio Principal ($)</label>
                                <input type="number" step="0.01" name="precio" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Precio Alternativo <span class="text-muted">(Opcional)</span></label>
                                <input type="number" step="0.01" name="precio_alt" class="form-control">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Categoría</label>
                                <select name="categoria" class="form-select text-capitalize" required>
                                    <option value="" disabled selected>-- Seleccione una Categoría --</option>
                                    <% if (typeof categorias !== 'undefined' && categorias.length > 0) { %>
                                        <% categorias.forEach(cat => { %>
                                            <option value="<%= cat.id %>"><%= cat.nombre %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Foto del Platillo</label>
                                <input type="file" name="foto" class="form-control" accept="image/*">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4">Guardar Platillo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEditarPlatillo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-utensils me-2"></i>Editar Datos del Platillo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formEditarPlatillo" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <input type="hidden" name="fotoActual" id="edit_foto">
                            <input type="hidden" id="edit_id">
                            
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small d-block">Imagen Actual</label>
                                <div id="thumbnail_container" class="mb-2 w-100 border rounded overflow-hidden" style="height: 220px;"></div>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Nombre del Platillo</label>
                                <input type="text" name="nombre" id="edit_nombre" class="form-control" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Descripción</label>
                                <textarea name="descripcion" id="edit_descripcion" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Precio Principal ($)</label>
                                <input type="number" step="0.01" name="precio" id="edit_precio" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Precio Alternativo</label>
                                <input type="number" step="0.01" name="precio_alt" id="edit_precio_alt" class="form-control">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Categoría</label>
                                <select name="categoria" id="edit_categoria" class="form-select text-capitalize" required>
                                    <option value="" disabled>-- Seleccione una Categoría --</option>
                                    <% if (typeof categorias !== 'undefined' && categorias.length > 0) { %>
                                        <% categorias.forEach(cat => { %>
                                            <option value="<%= cat.id %>"><%= cat.nombre %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Cambiar Foto del Platillo</label>
                                <input type="file" name="foto" class="form-control" accept="image/*">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0 fs-11px">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success btn-sm px-4">Actualizar Platillo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    
    <script>
    document.addEventListener("DOMContentLoaded", function() {

        // LÓGICA FILTRADO EN TIEMPO REAL (Buscador)
        const inputBuscar = document.getElementById('buscarPlatilloCatalogo');
        const contadorPlatillos = document.getElementById('contadorPlatillos');

        function actualizarContadorPlatillos() {
            if (contadorPlatillos) {
                // Cuenta las filas de platillos que no están ocultas por el filtro
                const visibles = Array.from(document.querySelectorAll('.fila-platillo-catalogo'))
                                      .filter(fila => fila.style.display !== 'none').length;
                contadorPlatillos.textContent = visibles;
            }
        }

        if (inputBuscar) {
            inputBuscar.addEventListener('input', function(e) {
                const termino = e.target.value.toLowerCase().trim();
                const filasPlatillos = document.querySelectorAll('.fila-platillo-catalogo');
                const filaNoCoincidencias = document.getElementById('filaNoCoincidenciasMenu');
                let coincidencias = 0;

                filasPlatillos.forEach(fila => {
                    const nombre = fila.getAttribute('data-nombre') || '';

                    if (nombre.includes(termino)) {
                        fila.style.display = '';
                        coincidencias++;
                    } else {
                        fila.style.display = 'none';
                    }
                });

                // Actualizar el contador dinámicamente según el DOM actual
                actualizarContadorPlatillos();

                if (filaNoCoincidencias) {
                    filaNoCoincidencias.style.display = (filasPlatillos.length > 0 && coincidencias === 0) ? '' : 'none';
                }
            });
        }

        // Inyección de Datos Dinámicos al Modal de Edición
        const modalEditar = document.getElementById('modalEditarPlatillo');
        if (modalEditar) {
            modalEditar.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                
                const id = button.getAttribute('data-id');
                const nombre = button.getAttribute('data-nombre');
                const descripcion = button.getAttribute('data-descripcion');
                const precio = button.getAttribute('data-precio');
                const categoria = button.getAttribute('data-categoria');
                const precioAlt = button.getAttribute('data-precio_alt');
                const foto = button.getAttribute('data-foto');

                document.getElementById('edit_id').value = id || '';
                document.getElementById('edit_nombre').value = nombre || '';
                document.getElementById('edit_descripcion').value = descripcion || '';
                document.getElementById('edit_precio').value = precio || '';
                document.getElementById('edit_categoria').value = categoria || '';
                document.getElementById('edit_precio_alt').value = (precioAlt && precioAlt !== 'null') ? precioAlt : '';
                document.getElementById('edit_foto').value = (foto && foto !== 'null') ? foto : '';

                const thumbContainer = document.getElementById('thumbnail_container');
                if (foto && foto !== 'null' && foto.trim() !== '') {
                    thumbContainer.innerHTML = `
                        <img src="/uploads/${foto}" alt="Miniatura de ${nombre}" class="w-100 h-100" style="object-fit: cover;">
                    `;
                } else {
                    thumbContainer.innerHTML = `
                        <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-light text-muted">
                            <i class="fa-solid fa-utensils fa-2xl mb-2"></i>
                            <span class="small">Sin imagen asignada</span>
                        </div>
                    `;
                }
            });
        }

        // 1. CREAR PLATILLO VIA FETCH
        const formCrear = document.getElementById('formCrearPlatillo');
        if (formCrear) {
            formCrear.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(formCrear);

                try {
                    const response = await fetch('/admin/menu/crear', {
                        method: 'POST',
                        body: formData
                    });
                    const resData = await response.json();

                    if (resData.success) {
                        bootstrap.Modal.getInstance(document.getElementById('modalCrearPlatillo')).hide();
                        formCrear.reset();
                        Swal.fire({
                            icon: 'success',
                            title: '¡Operación Exitosa!',
                            text: resData.message,
                            confirmButtonColor: '#212529'
                        }).then(() => location.reload());
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: resData.message });
                    }
                } catch (error) {
                    console.error(error);
                    Swal.fire({ icon: 'error', title: 'Error de Red', text: 'No se pudo registrar el platillo.' });
                }
            });
        }

        // 2. EDITAR PLATILLO VIA FETCH
        const formEditar = document.getElementById('formEditarPlatillo');
        if (formEditar) {
            formEditar.addEventListener('submit', async (e) => {
                e.preventDefault();
                const id = document.getElementById('edit_id').value;
                const formData = new FormData(formEditar);

                try {
                    const response = await fetch(`/admin/menu/editar/${id}`, {
                        method: 'POST',
                        body: formData
                    });
                    const resData = await response.json();

                    if (resData.success) {
                        bootstrap.Modal.getInstance(modalEditar).hide();
                        Swal.fire({
                            icon: 'success',
                            title: '¡Actualizado!',
                            text: resData.message,
                            confirmButtonColor: '#198754'
                        }).then(() => location.reload());
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: resData.message });
                    }
                } catch (error) {
                    console.error(error);
                    Swal.fire({ icon: 'error', title: 'Error de Red', text: 'No se pudo actualizar el platillo.' });
                }
            });
        }

        // 3. ELIMINAR PLATILLO INTERCEPTANDO EL BOTÓN DIRECTO DE LA TABLA
        document.addEventListener('click', async function (e) {
            const btnEliminar = e.target.closest('.btn-eliminar-dish');
            if (!btnEliminar) return;

            const id = btnEliminar.getAttribute('data-id');
            const nombre = btnEliminar.getAttribute('data-nombre');

            Swal.fire({
                title: '¿Confirmar Acción?',
                html: `Se eliminará del menú de forma irreversible el siguiente platillo: <br><b class="text-danger">"${nombre}"</b>.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, Eliminar',
                cancelButtonText: 'No, Cancelar',
                reverseButtons: true
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/menu/eliminar/${id}`, { method: 'POST' });
                        const resData = await response.json();

                        if (resData.success) {
                            Swal.fire({
                                icon: 'success',
                                title: '¡Eliminado!',
                                text: resData.message,
                                confirmButtonColor: '#212529'
                            }).then(() => {
                                const row = document.getElementById(`row-${id}`);
                                if (row) row.remove();
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: resData.message });
                        }
                    } catch (error) {
                        console.error(error);
                        Swal.fire({ icon: 'error', title: 'Error de Red', text: 'No se pudo eliminar el platillo.' });
                    }
                }
            });
        });
    });
    </script>
</body>
</html>