<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuración General - Restaurante Bahía</title>
    <link class="csp-css" rel="stylesheet" href="/css/bootstrap.min.css">
    <link class="csp-css" rel="stylesheet" href="/css/all.min.css">
    <link class="csp-css" rel="stylesheet" href="/css/sweetalert2.min.css">
    <link class="csp-css" rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>
            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4 d-flex flex-column min-vh-100">
                <%- include('../includes/header', {encabezado_pagina: 'Sistema / Configuración', desc_pagina: 'Ajustes globales y variables operacionales de Bahía', add_btn: false}) %>

                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header bg-white border-bottom p-3">
                                <ul class="nav nav-tabs card-header-tabs" id="configTabs" role="tablist">
                                    <li class="nav-item">
                                        <button class="nav-link active fw-semibold" id="identidad-tab" data-bs-toggle="tab" data-bs-target="#identidad" type="button" role="tab"><i class="fa-solid fa-id-card me-1"></i> Identidad</button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link fw-semibold" id="salones-tab" data-bs-toggle="tab" data-bs-target="#salones" type="button" role="tab"><i class="fa-solid fa-chair me-1"></i> Salón y Áreas</button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link fw-semibold" id="finanzas-tab" data-bs-toggle="tab" data-bs-target="#finanzas" type="button" role="tab"><i class="fa-solid fa-coins me-1"></i> Finanzas / Impuestos</button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link fw-semibold" id="inventario-tab" data-bs-toggle="tab" data-bs-target="#inventario" type="button" role="tab"><i class="fa-solid fa-boxes-stacked me-1"></i> Inventario</button>
                                    </li>
                                </ul>
                            </div>
                            
                            <form id="formConfiguracion">
                                <div class="card-body p-4 tab-content" id="configTabsContent">
                                    
                                    <div class="tab-pane fade show active" id="identidad" role="tabpanel" aria-labelledby="identidad-tab">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small text-secondary">
                                                    <%= settings.app_nombre ? settings.app_nombre.nombre : 'Nombre Comercial del Restaurante' %>
                                                </label>
                                                <input type="text" name="app_nombre" class="form-control" value="<%= settings.app_nombre ? settings.app_nombre.valor : 'Restaurante Bahía' %>" required>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small text-secondary">
                                                    <%= settings.app_moneda ? settings.app_moneda.nombre : 'Símbolo Monetario Predeterminado' %>
                                                </label>
                                                <input type="text" name="app_moneda" class="form-control" value="<%= settings.app_moneda ? settings.app_moneda.valor : '$' %>" placeholder="Ej: $, €, CUP" required>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="tab-pane fade" id="salones" role="tabpanel" aria-labelledby="salones-tab">
                                        <div class="row">
                                            <div class="col-12">
                                                <label class="form-label fw-bold small text-secondary">
                                                    <%= settings.salon_areas ? settings.salon_areas.nombre : 'Áreas y Ubicaciones del Establecimiento' %>
                                                </label>
                                                <textarea name="salon_areas" class="form-control" rows="3" placeholder="Ej: Salon Principal, Terraza, VIP, Barra"><%= settings.salon_areas ? settings.salon_areas.valor : 'Salon Principal, Terraza, Barra' %></textarea>
                                                <div class="form-text text-muted fs-7">Separa los nombres de las zonas del salón con comas ( , ). Esto alimentará automáticamente los selectores de ubicación en la gestión de mesas.</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="tab-pane fade" id="finanzas" role="tabpanel" aria-labelledby="finanzas-tab">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small text-secondary">
                                                    <%= settings.factura_impuesto ? settings.factura_impuesto.nombre : 'Impuesto General aplicado a Ventas (%)' %>
                                                </label>
                                                <div class="input-group">
                                                    <input type="number" step="0.01" name="factura_impuesto" class="form-control" value="<%= settings.factura_impuesto ? settings.factura_impuesto.valor : 0 %>" required>
                                                    <span class="input-group-text">%</span>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small text-secondary">
                                                    <%= settings.factura_propina ? settings.factura_propina.nombre : 'Porcentaje de Propina Sugerida (%)' %>
                                                </label>
                                                <div class="input-group">
                                                    <input type="number" step="0.01" name="factura_propina" class="form-control" value="<%= settings.factura_propina ? settings.factura_propina.valor : 0 %>" required>
                                                    <span class="input-group-text">%</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="tab-pane fade" id="inventario" role="tabpanel" aria-labelledby="inventario-tab">
                                        <div class="row">
                                            <div class="col-12">
                                                <label class="form-label fw-bold small text-secondary">
                                                    <%= settings.inventario_unidades ? settings.inventario_unidades.nombre : 'Unidades de Medida Permitidas (Stock)' %>
                                                </label>
                                                <textarea name="inventario_unidades" class="form-control" rows="3" placeholder="Ej: Uds, Kg, Lts, Oz, Porciones"><%= settings.inventario_unidades ? settings.inventario_unidades.valor : 'Uds, Kg, Lts, Oz' %></textarea>
                                                <div class="form-text text-muted fs-7">Separa las siglas o nombres con comas ( , ). Estas opciones estarán disponibles al registrar materias primas y productos en los catálogos.</div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                
                                <div class="card-footer bg-light p-3 d-flex justify-content-end border-top">
                                    <button type="submit" id="btnGuardarConfig" class="btn btn-primary px-5 shadow-sm">
                                        <i class="fa-solid fa-floppy-disk me-1"></i> Guardar Ajustes del Sistema
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <footer class="mt-auto">
                    <%- include('../includes/footer') %>
                </footer>
            </main>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const formConfig = document.getElementById('formConfiguracion');

            if (formConfig) {
                formConfig.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const formData = {
                        app_nombre: this.app_nombre.value,
                        app_moneda: this.app_moneda.value,
                        salon_areas: this.salon_areas.value,
                        factura_impuesto: this.factura_impuesto.value,
                        factura_propina: this.factura_propina.value,
                        inventario_unidades: this.inventario_unidades.value
                    };

                    fetch('/admin/configuracion/guardar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(formData)
                    })
                    .then(res => res.json())
                    .then(data => {
                        if(data.success) {
                            Swal.fire('¡Éxito!', data.message, 'success');
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    })
                    .catch(() => {
                        Swal.fire('Error', 'No se pudo establecer conexión con el servidor.', 'error');
                    });
                });
            }
        });
    </script>
</body>
</html>