<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuración General - Restaurante Bahía</title>
    <link class="csp-css" rel="stylesheet" href="/css/bootstrap.min.css">
    <link class="csp-css" rel="stylesheet" href="/css/all.min.css">
    <link class="csp-css" rel="stylesheet" href="/css/sweetalert2.min.css">
    <link class="csp-css" rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>
            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4 d-flex flex-column min-vh-100">
                <%- include('../includes/header', {encabezado_pagina: 'Sistema / Configuración', desc_pagina: 'Ajustes globales y variables operacionales de Bahía', add_btn: false}) %>

                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header bg-white border-bottom p-3">
                                <ul class="nav nav-tabs card-header-tabs" id="configTabs" role="tablist">
                                    <li class="nav-item">
                                        <button class="nav-link active fw-semibold" id="identidad-tab" data-bs-toggle="tab" data-bs-target="#identidad" type="button" role="tab"><i class="fa-solid fa-id-card me-1"></i> Identidad</button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link fw-semibold" id="categorias-tab" data-bs-toggle="tab" data-bs-target="#categorias" type="button" role="tab"><i class="fa-solid fa-utensils me-1"></i> Categorías de Menú</button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link fw-semibold" id="salones-tab" data-bs-toggle="tab" data-bs-target="#salones" type="button" role="tab"><i class="fa-solid fa-chair me-1"></i> Salón y Áreas</button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link fw-semibold" id="finanzas-tab" data-bs-toggle="tab" data-bs-target="#finanzas" type="button" role="tab"><i class="fa-solid fa-coins me-1"></i> Finanzas / Impuestos</button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link fw-semibold" id="inventario-tab" data-bs-toggle="tab" data-bs-target="#inventario" type="button" role="tab"><i class="fa-solid fa-boxes-stacked me-1"></i> Inventario</button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link fw-semibold" id="opciones-sistema-tab" data-bs-toggle="tab" data-bs-target="#opciones-sistema" type="button" role="tab"><i class="fa-solid fa-cogs me-1"></i> Opciones Generales</button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link fw-semibold" id="respaldo-tab" data-bs-toggle="tab" data-bs-target="#respaldo" type="button" role="tab"><i class="fa-solid fa-database me-1"></i> Respaldos y Auditoría</button>
                                    </li>
                                </ul>
                            </div>
                            
                            <div class="card-body p-4 tab-content" id="configTabsContent">
                                
                                <!-- PESTAÑA 1: IDENTIDAD -->
                                <div class="tab-pane fade show active" id="identidad" role="tabpanel">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-secondary">
                                                <%= settings.app_nombre ? settings.app_nombre.nombre : 'Nombre Comercial del Restaurante' %>
                                            </label>
                                            <input type="text" id="cfg_app_nombre" class="form-control" value="<%= settings.app_nombre ? settings.app_nombre.valor : 'Restaurante Bahía' %>" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-secondary">
                                                <%= settings.app_moneda ? settings.app_moneda.nombre : 'Símbolo Monetario Predeterminado' %>
                                            </label>
                                            <input type="text" id="cfg_app_moneda" class="form-control" value="<%= settings.app_moneda ? settings.app_moneda.valor : '$' %>" placeholder="Ej: $, €, CUP" required>
                                        </div>
                                    </div>
                                </div>

                                <!-- PESTAÑA 2: CATEGORÍAS DE MENÚ (CRUD) -->
                                <div class="tab-pane fade" id="categorias" role="tabpanel">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <h6 class="fw-bold mb-0">Categorías de Menú y Platillos</h6>
                                            <small class="text-muted">Define las categorías de la carta y asigna su almacén predeterminado para el descuento automático de insumos al ordenar.</small>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-primary" id="btnNuevaCategoria">
                                            <i class="fa-solid fa-plus me-1"></i> Nueva Categoría
                                        </button>
                                    </div>

                                    <div class="table-responsive border rounded">
                                        <table class="table table-hover align-middle mb-0" id="tablaCategorias">
                                            <thead class="table-light fs-7 text-uppercase">
                                                <tr>
                                                    <th class="ps-3">Categoría de Menú</th>
                                                    <th class="text-center">Tipo</th>
                                                    <th>Almacén de Despacho</th>
                                                    <th class="text-center">Platillos</th>
                                                    <th class="text-center">Estado</th>
                                                    <th class="text-end pe-3">Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbodyCategorias">
                                                <% if (typeof categorias !== 'undefined' && categorias && categorias.length > 0) { %>
                                                    <% categorias.forEach(cat => { %>
                                                        <tr id="cat-row-<%= cat.id %>">
                                                            <td class="ps-3 fw-bold">
                                                                <%= cat.nombre %>
                                                                <% if(cat.descripcion) { %><br><small class="text-muted fw-normal"><%= cat.descripcion %></small><% } %>
                                                            </td>
                                                            <td class="text-center">
                                                                <% if (cat.tipo === 'BEBIDAS') { %>
                                                                    <span class="badge bg-info-subtle text-info border border-info"><i class="fa-solid fa-glass-water me-1"></i>Bebidas</span>
                                                                <% } else { %>
                                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning"><i class="fa-solid fa-utensils me-1"></i>Comestibles</span>
                                                                <% } %>
                                                            </td>
                                                            <td>
                                                                <span class="badge bg-secondary-subtle text-dark border">
                                                                    <i class="fa-solid fa-warehouse me-1"></i><%= cat.almacen_nombre || 'Sin almacén asignado' %>
                                                                </span>
                                                            </td>
                                                            <td class="text-center"><%= cat.total_platillos || 0 %></td>
                                                            <td class="text-center">
                                                                <% if (cat.activo) { %>
                                                                    <span class="badge bg-success-subtle text-success border border-success">Activa</span>
                                                                <% } else { %>
                                                                    <span class="badge bg-danger-subtle text-danger border border-danger">Inactiva</span>
                                                                <% } %>
                                                            </td>
                                                            <td class="text-end pe-3">
                                                                <button class="btn btn-sm btn-outline-secondary me-1 btn-editar-cat" 
                                                                        data-cat='<%- JSON.stringify(cat) %>' title="Editar">
                                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-<%= cat.activo ? "warning" : "success" %> me-1 btn-estado-cat" 
                                                                        data-id="<%= cat.id %>" 
                                                                        data-estado="<%= cat.activo ? 0 : 1 %>" 
                                                                        title="<%= cat.activo ? "Desactivar" : "Activar" %>">
                                                                    <i class="fa-solid fa-<%= cat.activo ? "ban" : "check" %>"></i>
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-danger btn-eliminar-cat" 
                                                                        data-id="<%= cat.id %>" 
                                                                        data-nombre="<%= cat.nombre %>" title="Eliminar">
                                                                    <i class="fa-solid fa-trash-can"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="6" class="text-center text-muted py-4">No hay categorías de menú registradas.</td>
                                                    </tr>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- PESTAÑA 3: SALONES Y ÁREAS (CRUD) -->
                                <div class="tab-pane fade" id="salones" role="tabpanel">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <h6 class="fw-bold mb-0">Áreas de Servicio del Establecimiento</h6>
                                            <small class="text-muted">Define los salones o zonas donde se distribuyen las mesas. Al asignar una mesa a un área, su nombre se toma de este catálogo.</small>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-primary" id="btnNuevaUbicacion">
                                            <i class="fa-solid fa-plus me-1"></i> Nueva Área
                                        </button>
                                    </div>

                                    <div class="table-responsive border rounded">
                                        <table class="table table-hover align-middle mb-0" id="tablaUbicaciones">
                                            <thead class="table-light fs-7 text-uppercase">
                                                <tr>
                                                    <th class="ps-3">Área / Salón</th>
                                                    <th class="text-center">Orden</th>
                                                    <th class="text-center">Mesas</th>
                                                    <th class="text-center">Estado</th>
                                                    <th class="text-end pe-3">Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbodyUbicaciones">
                                                <% if (typeof ubicaciones !== 'undefined' && ubicaciones && ubicaciones.length > 0) { %>
                                                    <% ubicaciones.forEach(ubi => { %>
                                                        <tr id="ubi-row-<%= ubi.id %>">
                                                            <td class="ps-3 fw-bold">
                                                                <i class="fa-solid fa-location-dot me-1 text-secondary"></i><%= ubi.nombre %>
                                                                <% if(ubi.descripcion) { %><br><small class="text-muted fw-normal"><%= ubi.descripcion %></small><% } %>
                                                            </td>
                                                            <td class="text-center"><%= ubi.orden || 0 %></td>
                                                            <td class="text-center"><%= ubi.total_mesas || 0 %></td>
                                                            <td class="text-center">
                                                                <% if (ubi.activo) { %>
                                                                    <span class="badge bg-success-subtle text-success border border-success">Activa</span>
                                                                <% } else { %>
                                                                    <span class="badge bg-danger-subtle text-danger border border-danger">Inactiva</span>
                                                                <% } %>
                                                            </td>
                                                            <td class="text-end pe-3">
                                                                <button class="btn btn-sm btn-outline-secondary me-1 btn-editar-ubi" data-ubi='<%- JSON.stringify({ id: ubi.id, nombre: ubi.nombre, descripcion: ubi.descripcion, orden: ubi.orden, activo: ubi.activo ? 1 : 0, total_mesas: ubi.total_mesas || 0 }) %>' title="Editar">
                                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-<%= ubi.activo ? 'warning' : 'success' %> me-1 btn-estado-ubi" data-id="<%= ubi.id %>" data-estado="<%= ubi.activo ? 0 : 1 %>" title="<%= ubi.activo ? 'Desactivar' : 'Activar' %>">
                                                                    <i class="fa-solid fa-<%= ubi.activo ? 'ban' : 'check' %>"></i>
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-danger btn-eliminar-ubi" data-id="<%= ubi.id %>" data-nombre="<%= ubi.nombre %>" data-mesas="<%= ubi.total_mesas || 0 %>" title="Eliminar">
                                                                    <i class="fa-solid fa-trash-can"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="5" class="text-center text-muted py-4">No hay áreas de servicio registradas. Ejecuta la migración <code>scripts/migracion_ubicacion_mesa.sql</code> o crea la primera área manualmente.</td>
                                                    </tr>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="form-text text-muted fs-7 mt-2">
                                        <i class="fa-solid fa-circle-info me-1"></i>
                                        Un área con mesas asociadas no puede eliminarse (primero reasigna sus mesas). Las áreas inactivas dejan de aparecer al dar de alta nuevas mesas.
                                    </div>
                                </div>

                                <!-- PESTAÑA 4: FINANZAS -->
                                <div class="tab-pane fade" id="finanzas" role="tabpanel">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-secondary">
                                                <%= settings.factura_impuesto ? settings.factura_impuesto.nombre : 'Impuesto General aplicado a Ventas (%)' %>
                                            </label>
                                            <div class="input-group">
                                                <input type="number" step="0.01" id="cfg_factura_impuesto" class="form-control" value="<%= settings.factura_impuesto ? settings.factura_impuesto.valor : 0 %>" required>
                                                <span class="input-group-text">%</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-secondary">
                                                <%= settings.factura_propina ? settings.factura_propina.nombre : 'Porcentaje de Propina Sugerida (%)' %>
                                            </label>
                                            <div class="input-group">
                                                <input type="number" step="0.01" id="cfg_factura_propina" class="form-control" value="<%= settings.factura_propina ? settings.factura_propina.valor : 0 %>" required>
                                                <span class="input-group-text">%</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- PESTAÑA 5: INVENTARIO -->
                                <div class="tab-pane fade" id="inventario" role="tabpanel">
                                    <div class="row">
                                        <div class="col-12">
                                            <label class="form-label fw-bold small text-secondary">Unidades de Medida y Factores de Conversión</label>
                                            <div class="border rounded p-3 bg-light d-flex align-items-center justify-content-between gap-2">
                                                <div>
                                                    <div class="fw-semibold small text-dark">Gestión completa de unidades (código, tipo, decimales, estado)</div>
                                                    <div class="form-text text-muted fs-7 mb-0">y factores de conversión automáticos para POS, recetas y transferencias.</div>
                                                </div>
                                                <a href="/admin/unidades-medida" class="btn btn-sm btn-dark fw-semibold text-nowrap">
                                                    <i class="fa-solid fa-scale-balanced me-1"></i> Gestionar
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- PESTAÑA 6: OPCIONES GENERALES -->
                                <div class="tab-pane fade" id="opciones-sistema" role="tabpanel">
                                    <div class="row g-3">
                                        
                                        <!-- Opción 1: Habilitar Monitores de Elaboración en el Servicio -->
                                        <% 
                                            const monElabActivo = settings.habilitar_monitores_elaboracion && (settings.habilitar_monitores_elaboracion.valor === '1' || settings.habilitar_monitores_elaboracion.valor === true || settings.habilitar_monitores_elaboracion === true || settings.habilitar_monitores_elaboracion === '1');
                                        %>
                                        <div class="col-12 col-md-10">
                                            <div class="p-3 border rounded shadow-sm bg-light d-flex align-items-center justify-content-between mb-2">
                                                <div>
                                                    <h6 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                                                        <i class="fa-solid fa-tv text-primary"></i>
                                                        <%= settings.habilitar_monitores_elaboracion ? settings.habilitar_monitores_elaboracion.nombre : 'Habilitar monitores de elaboración en el Servicio' %>
                                                    </h6>
                                                    <small class="text-muted d-block">
                                                        Al habilitar esta opción, los pedidos ingresan a las pantallas de Cocina y Bar para su control de tiempos y preparación digital. Al deshabilitarla (Modo Servicio Directo), el dependiente puede marcar los ítems como entregados directamente desde el TPV sin pasar por monitores de cocina.
                                                    </small>
                                                </div>
                                                <div class="d-flex align-items-center gap-3 ms-3">
                                                    <span id="lbl_status_monitores" class="badge <%= monElabActivo ? 'bg-success-subtle text-success border border-success' : 'bg-warning-subtle text-warning-emphasis border border-warning' %> px-2.5 py-1.5 font-bold">
                                                        <%= monElabActivo ? 'Habilitado (Digital)' : 'Deshabilitado (Servicio Directo)' %>
                                                    </span>
                                                    <div class="form-check form-switch m-0 fs-4">
                                                        <input class="form-check-input role-switch" type="checkbox" id="cfg_habilitar_monitores_elaboracion" role="switch"
                                                               <%= monElabActivo ? 'checked' : '' %>>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Opción 2: Permitir Pre-pedidos a Clientes -->
                                        <% 
                                            const prepedidoActivo = settings.cliente_permite_prepedido && (settings.cliente_permite_prepedido.valor === '1' || settings.cliente_permite_prepedido.valor === true || settings.cliente_permite_prepedido === true || settings.cliente_permite_prepedido === '1');
                                        %>
                                        <div class="col-12 col-md-10">
                                            <div class="p-3 border rounded shadow-sm bg-light d-flex align-items-center justify-content-between">
                                                <div>
                                                    <h6 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                                                        <i class="fa-solid fa-mobile-screen-button text-info"></i>
                                                        <%= settings.cliente_permite_prepedido ? settings.cliente_permite_prepedido.nombre : 'Permitir Pre-pedidos a Clientes' %>
                                                    </h6>
                                                    <small class="text-muted d-block">
                                                        El cliente puede agregar pre-pedidos a su orden desde el menú público de platillos mediante código QR.
                                                    </small>
                                                </div>
                                                <div class="d-flex align-items-center gap-3 ms-3">
                                                    <span id="lbl_status_prepedido" class="badge <%= prepedidoActivo ? 'bg-success-subtle text-success border border-success' : 'bg-danger-subtle text-danger border border-danger' %> px-2.5 py-1.5 font-bold">
                                                        <%= prepedidoActivo ? 'Habilitado' : 'Deshabilitado' %>
                                                    </span>
                                                    <div class="form-check form-switch m-0 fs-4">
                                                        <input class="form-check-input role-switch" type="checkbox" id="cfg_cliente_permite_prepedido" role="switch"
                                                               <%= prepedidoActivo ? 'checked' : '' %>>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <!-- PESTAÑA 7: RESPALDO, RESTAURACIÓN Y AUDITORÍA -->
                                <div class="tab-pane fade" id="respaldo" role="tabpanel">
                                    <div class="row g-4">
                                        <div class="col-12 col-xl-6">
                                            <div class="card h-100 border-0 bg-light shadow-sm">
                                                <div class="card-body p-4">
                                                    <div class="d-flex align-items-start gap-3">
                                                        <div class="rounded-circle bg-primary-subtle text-primary p-3 flex-shrink-0">
                                                            <i class="fa-solid fa-download fs-4"></i>
                                                        </div>
                                                        <div>
                                                            <h5 class="fw-bold text-dark mb-1">Salvar la base de datos</h5>
                                                            <p class="text-secondary small mb-3">Genera y descarga un archivo SQL con la información de <strong>restaurante_db</strong>. La operación queda registrada en auditoría.</p>
                                                            <a href="/admin/configuracion/backup" class="btn btn-primary fw-semibold" id="btnDescargarBackup">
                                                                <i class="fa-solid fa-database me-2"></i>Descargar salva SQL
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-xl-6">
                                            <div class="card h-100 border-0 bg-warning-subtle shadow-sm">
                                                <div class="card-body p-4">
                                                    <div class="d-flex align-items-start gap-3">
                                                        <div class="rounded-circle bg-warning text-dark p-3 flex-shrink-0">
                                                            <i class="fa-solid fa-upload fs-4"></i>
                                                        </div>
                                                        <div class="w-100">
                                                            <h5 class="fw-bold text-dark mb-1">Restaurar datos</h5>
                                                            <p class="text-secondary small">La restauración reemplaza la información actual por la del archivo seleccionado. Realice una salva antes de continuar.</p>
                                                            <form id="formRestaurarBD" enctype="multipart/form-data">
                                                                <label for="archivoBackup" class="form-label small fw-bold text-secondary">Archivo de salva (.sql o .txt)</label>
                                                                <input type="file" id="archivoBackup" name="backup" class="form-control form-control-sm mb-3" accept=".sql,.txt,text/plain,application/sql" required>
                                                                <button type="submit" class="btn btn-warning text-dark fw-bold" id="btnRestaurarBD">
                                                                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Restaurar base de datos
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 p-3 border rounded bg-white">
                                                <div>
                                                    <h6 class="fw-bold mb-1"><i class="fa-solid fa-shield-halved text-success me-2"></i>Registro de auditoría</h6>
                                                    <small class="text-muted">Consulta quién realizó cada operación, cuándo, desde qué IP y el resultado obtenido.</small>
                                                </div>
                                                <a href="/admin/auditoria" class="btn btn-outline-dark btn-sm fw-semibold" id="btnVerAuditoria">
                                                    <i class="fa-solid fa-list-check me-1"></i>Ver operaciones registradas
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            
                            <div class="card-footer bg-light p-3 d-flex justify-content-end border-top">
                                <button type="button" id="btnGuardarConfig" class="btn btn-primary px-5 shadow-sm font-bold">
                                    <i class="fa-solid fa-floppy-disk me-1"></i> Guardar Ajustes del Sistema
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <footer class="mt-auto">
                    <%- include('../includes/footer') %>
                </footer>
            </main>
        </div>
    </div>

    <!-- MODAL CATEGORÍA DE MENÚ -->
    <div class="modal fade" id="modalCategoria" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="modalCatTitle">Nueva Categoría de Menú</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formCategoriaModal">
                    <div class="modal-body p-4">
                        <input type="hidden" id="cat_id" name="id">
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre de la Categoría <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="cat_nombre" name="nombre" placeholder="Ej: Cócteles, Entradas, Comidas Especiales" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tipo de Despacho (POS) <span class="text-danger">*</span></label>
                            <select class="form-select" id="cat_tipo" name="tipo" required>
                                <option value="COMESTIBLES">Comestibles (Despacho Cocina)</option>
                                <option value="BEBIDAS">Bebidas (Despacho Bar)</option>
                            </select>
                            <div class="form-text fs-7">Define la estación a la que pertenece esta categoría para los filtros de cocina/bar.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Almacén de Despacho (Insumos/Receta)</label>
                            <select class="form-select" id="cat_almacen_id" name="almacen_id">
                                <option value="">-- Sin almacén asignado --</option>
                                <% if (typeof almacenes !== 'undefined' && almacenes && almacenes.length > 0) { %>
                                    <% almacenes.forEach(alm => { %>
                                        <option value="<%= alm.id %>"><%= alm.nombre %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                            <div class="form-text fs-7">Define de qué almacén/área se descontarán las materias primas al comandar platillos de esta categoría.</div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label fw-semibold">Descripción (Opcional)</label>
                            <textarea class="form-control" id="cat_descripcion" name="descripcion" rows="2" placeholder="Notas sobre los platillos de esta categoría..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-save me-1"></i> Guardar Categoría</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL ÁREA DE SERVICIO -->
    <div class="modal fade" id="modalUbicacion" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="modalUbiTitle">Nueva Área de Servicio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formUbicacionModal">
                    <div class="modal-body p-4">
                        <input type="hidden" id="ubi_id" name="id">

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre del Área / Salón <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ubi_nombre" name="nombre" placeholder="Ej: Salon Principal, Terraza, VIP, Barra" required>
                            <div class="form-text fs-7">Los nombres deben ser únicos. Si renombras un área, todas sus mesas mostrarán el nuevo nombre.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Descripción (Opcional)</label>
                            <textarea class="form-control" id="ubi_descripcion" name="descripcion" rows="2" placeholder="Notas sobre esta zona del local..."></textarea>
                        </div>

                        <div class="mb-0">
                            <label class="form-label fw-semibold">Orden de despliegue</label>
                            <input type="number" class="form-control" id="ubi_orden" name="orden" min="0" value="0">
                            <div class="form-text fs-7">Las áreas se listan de menor a mayor orden (0 primero). Áreas con el mismo orden se ordenan alfabéticamente.</div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-save me-1"></i> Guardar Área</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script>

        // Manejo asíncrono e inmediato de la opción de prepedido por el cliente
        document.getElementById('cfg_cliente_permite_prepedido').addEventListener('change', function() {
            const isChecked = this.checked;
            const nuevoValor = isChecked ? '1' : '0';
            const badgeLabel = document.getElementById('lbl_status_prepedido');

            fetch('/admin/configuracion/opcion-rapida', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    clave: 'cliente_permite_prepedido',
                    valor: nuevoValor
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (isChecked) {
                        badgeLabel.textContent = 'Habilitado';
                        badgeLabel.className = 'badge bg-success-subtle text-success border border-success px-2.5 py-1.5 font-bold';
                    } else {
                        badgeLabel.textContent = 'Deshabilitado';
                        badgeLabel.className = 'badge bg-danger-subtle text-danger border border-danger px-2.5 py-1.5 font-bold';
                    }
                    Swal.fire({
                        icon: 'success',
                        title: '¡Configuración actualizada!',
                        text: data.message,
                        timer: 1500,
                        showConfirmButton: false
                    });
                } else {
                    this.checked = !isChecked; // Revertir en caso de error
                    Swal.fire('Error', data.message, 'error');
                }
            })
            .catch(() => {
                this.checked = !isChecked; // Revertir si la solicitud falla
                Swal.fire('Error', 'No se pudo conectar con el servidor para actualizar la opción.', 'error');
            });
        });

        // Manejo asíncrono e inmediato de la opción de monitores de elaboración
        document.getElementById('cfg_habilitar_monitores_elaboracion').addEventListener('change', function() {
            const isChecked = this.checked;
            const nuevoValor = isChecked ? '1' : '0';
            const badgeLabel = document.getElementById('lbl_status_monitores');

            fetch('/admin/configuracion/opcion-rapida', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    clave: 'habilitar_monitores_elaboracion',
                    valor: nuevoValor
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (isChecked) {
                        badgeLabel.textContent = 'Habilitado (Digital)';
                        badgeLabel.className = 'badge bg-success-subtle text-success border border-success px-2.5 py-1.5 font-bold';
                    } else {
                        badgeLabel.textContent = 'Deshabilitado (Servicio Directo)';
                        badgeLabel.className = 'badge bg-warning-subtle text-warning-emphasis border border-warning px-2.5 py-1.5 font-bold';
                    }
                    Swal.fire({
                        icon: 'success',
                        title: isChecked ? '¡Monitores Digitales Activados!' : '¡Modo Servicio Directo Activado!',
                        text: isChecked 
                            ? 'Los pedidos se enviarán a las pantallas de Cocina y Bar para su elaboración.' 
                            : 'El flujo operará directamente en POS sin pasar por monitores de cocina.',
                        timer: 2000,
                        showConfirmButton: false
                    });
                } else {
                    this.checked = !isChecked; // Revertir en caso de error
                    Swal.fire('Error', data.message, 'error');
                }
            })
            .catch(() => {
                this.checked = !isChecked;
                Swal.fire('Error', 'No se pudo conectar con el servidor para actualizar la opción.', 'error');
            });
        });

        const modalCategoriaBs = new bootstrap.Modal(document.getElementById('modalCategoria'));
        const modalUbicacionBs = new bootstrap.Modal(document.getElementById('modalUbicacion'));

        // Guardar ajustes generales del sistema
        document.getElementById('btnGuardarConfig').addEventListener('click', function() {
            const formData = {
                app_nombre: document.getElementById('cfg_app_nombre').value,
                app_moneda: document.getElementById('cfg_app_moneda').value,
                factura_impuesto: document.getElementById('cfg_factura_impuesto').value,
                factura_propina: document.getElementById('cfg_factura_propina').value
            };

            Swal.fire({
                title: 'Guardando configuración...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => Swal.showLoading()
            });

            fetch('/admin/configuracion/guardar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    Swal.fire('¡Éxito!', data.message, 'success');
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            })
            .catch(() => Swal.fire('Error', 'No se pudo conectar con el servidor.', 'error'));
        });

        // Salvar es una descarga directa; restaurar requiere confirmación
        // explícita porque reemplaza el contenido actual de la base de datos.
        const formRestaurarBD = document.getElementById('formRestaurarBD');
        const btnRestaurarBD = document.getElementById('btnRestaurarBD');
        if (formRestaurarBD) {
            formRestaurarBD.addEventListener('submit', async (event) => {
                event.preventDefault();
                const archivo = document.getElementById('archivoBackup')?.files?.[0];
                if (!archivo) return;

                const confirmacion = await Swal.fire({
                    icon: 'warning',
                    title: '¿Restaurar la base de datos?',
                    html: '<p class="mb-2">Esta acción reemplazará los datos actuales por los del archivo seleccionado.</p><strong>Se recomienda descargar una salva antes de continuar.</strong>',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, restaurar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#64748b'
                });
                if (!confirmacion.isConfirmed) return;

                const originalText = btnRestaurarBD.innerHTML;
                btnRestaurarBD.disabled = true;
                btnRestaurarBD.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Restaurando...';
                Swal.fire({ title: 'Restaurando datos...', text: 'No cierre esta ventana.', allowOutsideClick: false, showConfirmButton: false, didOpen: () => Swal.showLoading() });

                try {
                    const response = await fetch('/admin/configuracion/restore', {
                        method: 'POST',
                        body: new FormData(formRestaurarBD)
                    });
                    const data = await response.json().catch(() => ({ success: false, message: 'Respuesta inválida del servidor.' }));
                    if (!response.ok || !data.success) {
                        throw new Error(data.message || 'No se pudo restaurar el archivo.');
                    }
                    await Swal.fire({ icon: 'success', title: 'Restauración completada', text: data.message, confirmButtonText: 'Aceptar' });
                    window.location.reload();
                } catch (error) {
                    Swal.fire('Error de restauración', error.message, 'error');
                    btnRestaurarBD.disabled = false;
                    btnRestaurarBD.innerHTML = originalText;
                }
            });
        }

        // --- MANEJO DE EVENTOS RESPETANDO CSP ---

        document.getElementById('btnNuevaCategoria').addEventListener('click', abrirModalCategoria);

        // Delegación de eventos para botones dinámicos en la tabla
        document.getElementById('tbodyCategorias').addEventListener('click', function(e) {
            const btnEditar = e.target.closest('.btn-editar-cat');
            if (btnEditar) {
                const catData = JSON.parse(btnEditar.getAttribute('data-cat'));
                editarCategoria(catData);
                return;
            }

            const btnEstado = e.target.closest('.btn-estado-cat');
            if (btnEstado) {
                const id = btnEstado.getAttribute('data-id');
                const nuevoEstado = btnEstado.getAttribute('data-estado');
                toggleEstadoCategoria(id, nuevoEstado);
                return;
            }

            const btnEliminar = e.target.closest('.btn-eliminar-cat');
            if (btnEliminar) {
                const id = btnEliminar.getAttribute('data-id');
                const nombre = btnEliminar.getAttribute('data-nombre');
                eliminarCategoria(id, nombre);
                return;
            }
        });

        function recargarTablaCategorias() {
            fetch('/admin/api/categorias-platillos')
                .then(r => r.json())
                .then(res => {
                    if(!res.success && !Array.isArray(res.data) && !Array.isArray(res)) return;
                    const items = res.data || (Array.isArray(res) ? res : []);
                    const tbody = document.getElementById('tbodyCategorias');
                    tbody.innerHTML = '';

                    if(items.length === 0) {
                        tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted py-4">No hay categorías de menú registradas.</td></tr>`;
                        return;
                    }

                    items.forEach(cat => {
                        const tr = document.createElement('tr');
                        tr.id = `cat-row-${cat.id}`;
                        tr.innerHTML = `
                            <td class="ps-3 fw-bold">
                                ${cat.nombre}
                                ${cat.descripcion ? `<br><small class="text-muted fw-normal">${cat.descripcion}</small>` : ''}
                            </td>
                            <td class="text-center">
                                ${cat.tipo === 'BEBIDAS' 
                                    ? '<span class="badge bg-info-subtle text-info border border-info"><i class="fa-solid fa-glass-water me-1"></i>Bebidas</span>' 
                                    : '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning"><i class="fa-solid fa-utensils me-1"></i>Comestibles</span>'}
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-dark border">
                                    <i class="fa-solid fa-warehouse me-1"></i>${cat.almacen_nombre || 'Sin almacén'}
                                </span>
                            </td>
                            <td class="text-center">${cat.total_platillos || 0}</td>
                            <td class="text-center">
                                ${cat.activo 
                                    ? '<span class="badge bg-success-subtle text-success border border-success">Activa</span>' 
                                    : '<span class="badge bg-danger-subtle text-danger border border-danger">Inactiva</span>'}
                            </td>
                            <td class="text-end pe-3">
                                <button class="btn btn-sm btn-outline-secondary me-1 btn-editar-cat" data-cat='${JSON.stringify(cat)}' title="Editar">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-${cat.activo ? 'warning' : 'success'} me-1 btn-estado-cat" data-id="${cat.id}" data-estado="${cat.activo ? 0 : 1}" title="${cat.activo ? 'Desactivar' : 'Activar'}">
                                    <i class="fa-solid fa-${cat.activo ? 'ban' : 'check'}"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger btn-eliminar-cat" data-id="${cat.id}" data-nombre="${cat.nombre}" title="Eliminar">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                });
        }

        function abrirModalCategoria() {
            document.getElementById('formCategoriaModal').reset();
            document.getElementById('cat_id').value = '';
            document.getElementById('cat_tipo').value = 'COMESTIBLES';
            document.getElementById('modalCatTitle').textContent = 'Nueva Categoría de Menú';
            modalCategoriaBs.show();
        }

        function editarCategoria(cat) {
            document.getElementById('cat_id').value = cat.id;
            document.getElementById('cat_nombre').value = cat.nombre;
            document.getElementById('cat_tipo').value = cat.tipo || 'COMESTIBLES';
            document.getElementById('cat_descripcion').value = cat.descripcion || '';
            document.getElementById('cat_almacen_id').value = cat.almacen_id || '';
            document.getElementById('modalCatTitle').textContent = 'Editar Categoría de Menú';
            modalCategoriaBs.show();
        }

        document.getElementById('formCategoriaModal').addEventListener('submit', function(e) {
            e.preventDefault();
            const payload = {
                id: document.getElementById('cat_id').value,
                nombre: document.getElementById('cat_nombre').value,
                tipo: document.getElementById('cat_tipo').value,
                descripcion: document.getElementById('cat_descripcion').value,
                almacen_id: document.getElementById('cat_almacen_id').value
            };

            Swal.fire({
                title: 'Guardando categoría...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => Swal.showLoading()
            });

            fetch('/admin/api/categorias-platillos/guardar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(data => {
                if(data.success) {
                    modalCategoriaBs.hide();
                    Swal.fire({ icon: 'success', title: '¡Guardado!', text: data.message, timer: 1500, showConfirmButton: false });
                    recargarTablaCategorias();
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            })
            .catch(() => Swal.fire('Error', 'No se pudo guardar la categoría', 'error'));
        });

        function toggleEstadoCategoria(id, nuevoEstado) {
            fetch(`/admin/api/categorias-platillos/${id}/estado`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ activo: nuevoEstado })
            })
            .then(r => r.json())
            .then(data => {
                if(data.success) {
                    recargarTablaCategorias();
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            });
        }

        function eliminarCategoria(id, nombre) {
            Swal.fire({
                title: '¿Eliminar Categoría?',
                text: `¿Deseas eliminar la categoría de menú "${nombre}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(res => {
                if(res.isConfirmed) {
                    fetch(`/admin/api/categorias-platillos/${id}`, { method: 'DELETE' })
                        .then(r => r.json())
                        .then(data => {
                            if(data.success) {
                                Swal.fire('¡Eliminada!', data.message, 'success');
                                recargarTablaCategorias();
                            } else {
                                Swal.fire('Atención', data.message, 'warning');
                            }
                        });
                }
            });
        }

        // ================================================================
        // CRUD DE ÁREAS DE SERVICIO (ubicacion_mesa) — Pestaña Salón y Áreas
        // ================================================================
        document.getElementById('btnNuevaUbicacion').addEventListener('click', abrirModalUbicacion);

        document.getElementById('tbodyUbicaciones').addEventListener('click', function(e) {
            const btnEditar = e.target.closest('.btn-editar-ubi');
            if (btnEditar) {
                const ubiData = JSON.parse(btnEditar.getAttribute('data-ubi'));
                editarUbicacion(ubiData);
                return;
            }

            const btnEstado = e.target.closest('.btn-estado-ubi');
            if (btnEstado) {
                toggleEstadoUbicacion(btnEstado.getAttribute('data-id'), btnEstado.getAttribute('data-estado'));
                return;
            }

            const btnEliminar = e.target.closest('.btn-eliminar-ubi');
            if (btnEliminar) {
                eliminarUbicacion(btnEliminar.getAttribute('data-id'), btnEliminar.getAttribute('data-nombre'), btnEliminar.getAttribute('data-mesas'));
                return;
            }
        });

        function recargarTablaUbicaciones() {
            fetch('/admin/api/ubicaciones-mesa')
                .then(r => r.json())
                .then(res => {
                    if(!res.success && !Array.isArray(res.data) && !Array.isArray(res)) return;
                    const items = res.data || (Array.isArray(res) ? res : []);
                    const tbody = document.getElementById('tbodyUbicaciones');
                    tbody.innerHTML = '';

                    if(items.length === 0) {
                        tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4">No hay áreas de servicio registradas.</td></tr>`;
                        return;
                    }

                    items.forEach(ubi => {
                        const tr = document.createElement('tr');
                        tr.id = `ubi-row-${ubi.id}`;
                        const ubiJson = JSON.stringify({ id: ubi.id, nombre: ubi.nombre, descripcion: ubi.descripcion, orden: ubi.orden, activo: ubi.activo ? 1 : 0, total_mesas: ubi.total_mesas || 0 }).replace(/'/g, "&#39;");
                        tr.innerHTML = `
                            <td class="ps-3 fw-bold">
                                <i class="fa-solid fa-location-dot me-1 text-secondary"></i>${ubi.nombre}
                                ${ubi.descripcion ? `<br><small class="text-muted fw-normal">${ubi.descripcion}</small>` : ''}
                            </td>
                            <td class="text-center">${ubi.orden || 0}</td>
                            <td class="text-center">${ubi.total_mesas || 0}</td>
                            <td class="text-center">
                                ${ubi.activo
                                    ? '<span class="badge bg-success-subtle text-success border border-success">Activa</span>'
                                    : '<span class="badge bg-danger-subtle text-danger border border-danger">Inactiva</span>'}
                            </td>
                            <td class="text-end pe-3">
                                <button class="btn btn-sm btn-outline-secondary me-1 btn-editar-ubi" data-ubi='${ubiJson}' title="Editar">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-${ubi.activo ? 'warning' : 'success'} me-1 btn-estado-ubi" data-id="${ubi.id}" data-estado="${ubi.activo ? 0 : 1}" title="${ubi.activo ? 'Desactivar' : 'Activar'}">
                                    <i class="fa-solid fa-${ubi.activo ? 'ban' : 'check'}"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger btn-eliminar-ubi" data-id="${ubi.id}" data-nombre="${ubi.nombre}" data-mesas="${ubi.total_mesas || 0}" title="Eliminar">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                });
        }

        function abrirModalUbicacion() {
            document.getElementById('formUbicacionModal').reset();
            document.getElementById('ubi_id').value = '';
            document.getElementById('ubi_orden').value = 0;
            document.getElementById('modalUbiTitle').textContent = 'Nueva Área de Servicio';
            modalUbicacionBs.show();
        }

        function editarUbicacion(ubi) {
            document.getElementById('ubi_id').value = ubi.id;
            document.getElementById('ubi_nombre').value = ubi.nombre;
            document.getElementById('ubi_descripcion').value = ubi.descripcion || '';
            document.getElementById('ubi_orden').value = ubi.orden || 0;
            document.getElementById('modalUbiTitle').textContent = 'Editar Área de Servicio';
            modalUbicacionBs.show();
        }

        document.getElementById('formUbicacionModal').addEventListener('submit', function(e) {
            e.preventDefault();
            const payload = {
                id: document.getElementById('ubi_id').value,
                nombre: document.getElementById('ubi_nombre').value,
                descripcion: document.getElementById('ubi_descripcion').value,
                orden: document.getElementById('ubi_orden').value
            };

            Swal.fire({
                title: 'Guardando área...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => Swal.showLoading()
            });

            fetch('/admin/api/ubicaciones-mesa/guardar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(data => {
                if(data.success) {
                    modalUbicacionBs.hide();
                    Swal.fire({ icon: 'success', title: '¡Guardado!', text: data.message, timer: 1500, showConfirmButton: false });
                    recargarTablaUbicaciones();
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            })
            .catch(() => Swal.fire('Error', 'No se pudo guardar el área de servicio', 'error'));
        });

        function toggleEstadoUbicacion(id, nuevoEstado) {
            fetch(`/admin/api/ubicaciones-mesa/${id}/estado`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ activo: nuevoEstado })
            })
            .then(r => r.json())
            .then(data => {
                if(data.success) {
                    recargarTablaUbicaciones();
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            });
        }

        function eliminarUbicacion(id, nombre, mesas) {
            if (parseInt(mesas, 10) > 0) {
                Swal.fire(
                    'Área en uso',
                    `El área "${nombre}" tiene ${mesas} mesa(s) asociada(s). Reasigna o elimina esas mesas antes de borrar el área.`,
                    'warning'
                );
                return;
            }
            Swal.fire({
                title: '¿Eliminar Área?',
                text: `¿Deseas eliminar el área de servicio "${nombre}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(res => {
                if(res.isConfirmed) {
                    fetch(`/admin/api/ubicaciones-mesa/${id}`, { method: 'DELETE' })
                        .then(r => r.json())
                        .then(data => {
                            if(data.success) {
                                Swal.fire('¡Eliminada!', data.message, 'success');
                                recargarTablaUbicaciones();
                            } else {
                                Swal.fire('Atención', data.message, 'warning');
                            }
                        });
                }
            });
        }
    </script>
</body>
</html>
