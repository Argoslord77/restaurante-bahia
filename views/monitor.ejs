<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Monitor de Producción • Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/tailwind.css">
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        /* C5+: insignias y cabecera de comanda con estilos propios. No
           dependen del bundle tailwind compilado (que no trae las clases
           red-* ni whitespace-nowrap): así la alerta de SLA siempre se lee
           (fondo rojo, texto blanco) y la mesa no se corta en dos líneas. */
        .mon-mesa-badge {
            white-space: nowrap;
            display: inline-block;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .comanda-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }
        .sla-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .05em;
            text-transform: uppercase;
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid transparent;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .sla-badge-alert {
            background-color: #dc2626;
            border-color: #b91c1c;
            color: #ffffff;
            animation: sla-parpadeo 1.2s ease-in-out infinite;
        }
        .sla-badge-cola {
            background-color: #fef3c7;
            border-color: #fde68a;
            color: #b45309;
        }
        .sla-dot {
            width: 6px;
            height: 6px;
            border-radius: 9999px;
            background-color: #f59e0b;
            display: inline-block;
            flex-shrink: 0;
        }
        .comanda-excedida {
            border-color: #ef4444 !important;
            box-shadow: 0 0 0 2px rgba(239, 68, 68, .55), 0 25px 50px -12px rgba(0, 0, 0, .25);
        }
        #sla-pill {
            background-color: rgba(220, 38, 38, .18);
            border: 2px solid #ef4444;
            color: #fecaca;
        }
        @keyframes sla-parpadeo {
            0%, 100% { opacity: 1; }
            50% { opacity: .55; }
        }
        @media (max-width: 420px) {
            .sla-badge {
                font-size: 10px;
                padding: 5px 8px;
                white-space: normal;
                text-align: center;
            }
        }
    </style>
</head>
<body class="bg-[#090d16] text-slate-100 min-h-screen flex flex-col font-sans antialiased select-none">

    <% 
        let currentArea = typeof area !== 'undefined' ? area : 'COCINA';
        let currentAreaKey = typeof areaKey !== 'undefined' ? areaKey : 'cocina';
        let listaComandasInicial = (typeof comandas !== 'undefined' && Array.isArray(comandas)) ? comandas : [];
        let monitoresHabilitados = (typeof habilitarMonitores !== 'undefined') ? Boolean(habilitarMonitores) : true;
    %>

    <!-- Header Principal -->
    <header class="bg-[#111625] border-b border-slate-800/60 px-6 py-4 flex flex-col md:flex-row gap-4 justify-between items-center shadow-md sticky top-0 z-50">
        
        <div class="flex items-center space-x-4 w-full md:w-auto justify-center md:justify-start">
            <div class="p-3 rounded-xl <%= currentAreaKey === 'cocina' ? 'bg-orange-600 shadow-orange-950/40' : 'bg-cyan-600 shadow-cyan-950/40' %> text-white flex-shrink-0 shadow-lg">
                <i class="fa-solid <%= currentAreaKey === 'cocina' ? 'fa-fire-burner' : 'fa-martini-glass-citrus' %> text-xl"></i>
            </div>
            <div class="text-center md:text-left">
                <h1 class="text-xl md:text-2xl font-black text-white tracking-wider uppercase leading-none">
                    MONITOR DE <%= currentArea %>
                </h1>
                <p class="text-[11px] text-slate-400 font-extrabold uppercase mt-1.5 tracking-widest">
                    Restaurante Bahía • <%= monitoresHabilitados ? 'Producción Digital' : 'Modo Servicio Directo' %>
                </p>
            </div>
        </div>
        
        <!-- Botonera -->
        <div class="flex flex-wrap items-center justify-center md:justify-end gap-3 w-full md:w-auto">
            
            <% if (monitoresHabilitados) { %>
                <!-- Indicador / Botón Auto-refresh -->
                <button id="btn-sync" 
                        type="button"
                        style="border-radius: 9999px !important;"
                        class="group h-11 min-w-[190px] bg-slate-800/40 border-2 border-[#936932] text-slate-300 hover:text-white hover:bg-[#936932]/20 hover:shadow-[0_0_15px_rgba(147,105,50,0.3)] !rounded-full px-5 py-2 text-sm font-bold transition-all duration-200 flex items-center justify-center gap-2 active:scale-95">
                    <span id="sync-dot" class="h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span id="sync-text">Sincronizado</span>
                    <span id="sync-counter" class="text-xs text-amber-400 font-mono font-bold ml-1"></span>
                </button>

                <!-- C5: contador de comandas que exceden el SLA -->
                <span id="sla-pill" class="hidden h-11 min-w-[170px] bg-red-600/20 border-2 border-red-500 text-red-200 px-5 py-2 text-sm font-bold items-center justify-center gap-2" style="border-radius: 9999px !important; display: none;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span id="sla-pill-texto">0 retrasadas</span>
                </span>

                <!-- Botón Refrescar -->
                <button id="btn-reload" 
                        type="button"
                        style="border-radius: 9999px !important;"
                        class="group h-11 min-w-[170px] bg-slate-800/40 border-2 border-[#936932] text-slate-300 hover:text-white hover:bg-[#936932]/20 hover:shadow-[0_0_15px_rgba(147,105,50,0.3)] px-5 py-2 rounded-full text-sm font-bold transition-all duration-200 flex items-center justify-center gap-2.5 active:scale-95">
                    <i class="fa-solid fa-arrows-rotate text-[#936932] group-hover:text-white transition-colors duration-200"></i> Refrescar
                </button>
            <% } %>
            
            <!-- Botón Salir / Panel Central -->
            <a id="btn-exit" 
               href="<%= typeof exitUrl !== 'undefined' ? exitUrl : '/logout' %>" 
               style="border-radius: 9999px !important; color: #cbd5e1 !important;"
               class="group h-11 min-w-[170px] bg-slate-800/40 border-2 border-[#936932] !text-slate-300 hover:!text-white hover:bg-[#936932]/20 hover:shadow-[0_0_15px_rgba(147,105,50,0.3)] !rounded-full px-4 py-2 text-sm font-bold transition-all duration-200 flex items-center justify-center gap-2.5 active:scale-95 text-decoration-none">
                <i class="fa-solid <%= (typeof isAdministrative !== 'undefined' && isAdministrative) ? 'fa-table-columns' : 'fa-right-from-bracket' %> text-[#936932] group-hover:!text-white transition-colors duration-200"></i> 
                <%= (typeof isAdministrative !== 'undefined' && isAdministrative) ? 'Panel Central' : 'Salir' %>
            </a>
        </div>
    </header>

    <% if (monitoresHabilitados) { %>
        <!-- Barra Superior de Consolidado -->
        <section class="bg-[#0b101d] border-b border-slate-900 px-6 py-4 shadow-inner">
            <div class="flex flex-col lg:flex-row lg:items-center gap-4">
                <div class="flex items-center gap-2 flex-shrink-0">
                    <span class="flex h-2 w-2 relative">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
                    </span>
                    <span class="text-[11px] font-black tracking-widest text-cyan-400 uppercase">PRODUCCIÓN ACTIVA:</span>
                </div>
                
                <div id="consolidado-container" class="flex flex-wrap gap-3 items-center overflow-x-auto py-1 custom-scrollbar">
                    <!-- Se renderiza dinámicamente -->
                </div>
            </div>
        </section>
    <% } %>

    <!-- Contenido Principal -->
    <main id="main-comandas-container" class="flex-1 p-4 md:p-6 bg-[#080c16] overflow-x-hidden md:overflow-x-auto">
        <% if (!monitoresHabilitados) { %>
            <div class="h-full min-h-[55vh] flex flex-col items-center justify-center text-center p-6">
                <div class="w-20 h-20 rounded-full bg-[#111625] flex items-center justify-center mb-4 border border-amber-500/40 shadow-lg">
                    <i class="fa-solid fa-power-off text-3xl text-amber-400"></i>
                </div>
                <h2 class="text-xl font-extrabold text-white">Monitores en Modo Inactivo</h2>
                <p class="text-slate-400 text-sm mt-2 max-w-md">
                    El sistema está operando actualmente en <strong>Modo Servicio Directo</strong>. Las comandas y despachos se gestionan directamente desde el TPV.
                </p>
                <% if (typeof isAdministrative !== 'undefined' && isAdministrative) { %>
                    <a href="/admin/settings" class="mt-4 px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold rounded-xl text-sm transition-all shadow-md inline-flex items-center gap-2 text-decoration-none">
                        <i class="fa-solid fa-gear"></i> Ir a Configuración del Sistema
                    </a>
                <% } %>
            </div>
        <% } %>
    </main>

    <!-- Elemento de Audio según el Área Activa -->
    <% if (currentAreaKey === 'cocina') { %>
        <audio id="audio-notification" src="/sounds/notificacion-cocina.mp3" preload="auto"></audio>
    <% } else { %>
        <audio id="audio-notification" src="/sounds/notificacion-bar.mp3" preload="auto"></audio>
    <% } %>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script src="/js/tiempo-transcurrido.js"></script>
    <script>
        const MONITORES_HABILITADOS = <%= monitoresHabilitados ? 'true' : 'false' %>;
        const CURRENT_AREA_KEY = '<%= currentAreaKey %>';
        const CURRENT_AREA_NAME = '<%= currentArea %>';
        const INTERVALO_SEGUNDOS = 15;
        // C5: SLA en minutos (servidor; por defecto 20 cocina / 10 bar).
        const SLA_MIN = <%= (typeof slaMin !== 'undefined' && slaMin) ? slaMin : (currentAreaKey === 'bar' ? 10 : 20) %>;
        let ultimoSlaMin = SLA_MIN;
        
        let countdownInterval = null;
        let timeLeft = INTERVALO_SEGUNDOS;
        let sincronizado = localStorage.getItem('sync_activa') !== 'false';

        // Registro de IDs conocidos para comparar ingresos nuevos sin recargar la página
        let idsItemsConocidos = new Set();
        let idsExcedidosConocidos = new Set();
        let esPrimerCarga = true;

        // Carga inicial inyectada desde Express (SSR)
        let comandasActuales = <%- JSON.stringify(listaComandasInicial) %>;

        // Reproductor de sonido para notificaciones
        function playAreaNotificationSound() {
            const audio = document.getElementById('audio-notification');
            if (audio) {
                audio.currentTime = 0;
                audio.play().catch(err => {
                    console.warn("Autoplay bloqueado por el navegador. Requiere una interacción previa del usuario:", err);
                });
            }
        }

        /**
         * Realiza la petición Fetch asíncrona para traer las comandas activas
         */
        async function fetchComandasAsincronas() {
            if (!MONITORES_HABILITADOS) return;
            try {
                const response = await fetch(`/api/monitor/comandas?area=${CURRENT_AREA_KEY}`);
                const data = await response.json();

                if (data.success && Array.isArray(data.comandas)) {
                    if (Number(data.sla_min) > 0) ultimoSlaMin = Number(data.sla_min);
                    procesarYRenderizar(data.comandas);
                }
            } catch (error) {
                console.error("Error al actualizar comandas asíncronamente:", error);
            }
        }

        /**
         * Procesa los datos recibidos, detecta ítems nuevos para disparar el sonido y actualiza el DOM
         */
        function procesarYRenderizar(comandas) {
            if (!MONITORES_HABILITADOS) return;
            comandasActuales = comandas;

            // Extraer lista completa de detalle_id activos
            const idsEntrantes = [];
            comandas.forEach(comanda => {
                if (comanda.items && Array.isArray(comanda.items)) {
                    comanda.items.forEach(item => idsEntrantes.push(String(item.detalle_id)));
                }
            });

            // Verificar si hay nuevos platillos/bebidas
            if (!esPrimerCarga) {
                const hayNuevos = idsEntrantes.some(id => !idsItemsConocidos.has(id));
                if (hayNuevos) {
                    playAreaNotificationSound();

                    const Toast = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 4000,
                        timerProgressBar: true
                    });

                    Toast.fire({
                        icon: 'info',
                        title: CURRENT_AREA_KEY === 'cocina' ? '¡Nuevos platillos en comanda!' : '¡Nuevas bebidas en comanda!'
                    });
                }
            }

            // C5: SLA — avisar solo cuando una comanda RECIÉN excede el
            // límite (no en cada sondeo) para no fatigar con sonido.
            const slaLimite = (typeof ultimoSlaMin === 'number' && ultimoSlaMin > 0) ? ultimoSlaMin : SLA_MIN;
            const excedidasAhora = [];
            comandas.forEach(comanda => {
                if (Number(comanda.minutos_en_cola || 0) >= slaLimite) excedidasAhora.push(String(comanda.id_pedido));
            });
            const nuevasExcedidas = excedidasAhora.filter(id => !idsExcedidosConocidos.has(id));
            idsExcedidosConocidos = new Set(excedidasAhora);
            if (!esPrimerCarga && nuevasExcedidas.length > 0) {
                playAreaNotificationSound();
                const ToastSla = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 5000,
                    timerProgressBar: true
                });
                ToastSla.fire({
                    icon: 'warning',
                    title: nuevasExcedidas.length + ' comanda(s) exceden el SLA (' + slaLimite + ' min)'
                });
            }

            // Actualizar Set de control
            idsItemsConocidos = new Set(idsEntrantes);
            esPrimerCarga = false;

            // Renderizar secciones
            renderizarConsolidado(comandas);
            renderizarComandas(comandas);
        }

        /**
         * Renderiza la barra horizontal de consolidado de platillos
         */
        function renderizarConsolidado(comandas) {
            const container = document.getElementById('consolidado-container');
            if (!container) return;

            let consolidado = {};
            comandas.forEach(comanda => {
                if (comanda.items && Array.isArray(comanda.items)) {
                    comanda.items.forEach(item => {
                        let nombre = item.nombre_platillo;
                        consolidado[nombre] = (consolidado[nombre] || 0) + item.cantidad;
                    });
                }
            });

            const llaves = Object.keys(consolidado);
            if (llaves.length === 0) {
                container.innerHTML = `<span class="text-xs text-slate-500 italic">Sin tareas activas en ${CURRENT_AREA_NAME}</span>`;
                return;
            }

            let html = '';
            llaves.forEach(platillo => {
                html += `
                    <div class="bg-[#f8fafc] border border-slate-200/80 rounded-2xl px-4 py-2 flex items-center gap-3 shadow-md">
                        <span class="bg-[#3b82f6] text-white font-black px-2.5 py-1 rounded-lg text-xs leading-none shadow-sm">
                            ${consolidado[platillo]}x
                        </span>
                        <span class="text-xs font-extrabold text-[#0f172a] tracking-wide uppercase">${platillo}</span>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        /**
         * Renderiza el contenedor de tarjetas de comandas
         */
        function renderizarComandas(comandas) {
            const main = document.getElementById('main-comandas-container');
            if (!main || !MONITORES_HABILITADOS) return;

            if (comandas.length === 0) {
                main.innerHTML = `
                    <div class="h-full min-h-[55vh] flex flex-col items-center justify-center text-center p-6">
                        <div class="w-20 h-20 rounded-full bg-[#111625] flex items-center justify-center mb-4 border border-slate-800 shadow-md">
                            <i class="fa-solid fa-circle-check text-3xl text-emerald-400"></i>
                        </div>
                        <h2 class="text-xl font-extrabold text-slate-200">¡Todo al día!</h2>
                        <p class="text-slate-400 text-sm mt-1.5">No hay ordenes pendientes en ${CURRENT_AREA_NAME}.</p>
                    </div>
                `;
                const pillVacia = document.getElementById('sla-pill');
                if (pillVacia) pillVacia.style.display = 'none';
                return;
            }

            let html = `<div class="flex flex-col space-y-6 md:space-y-0 md:flex-row md:inline-flex md:space-x-6 h-full items-start align-top w-full md:w-auto">`;

            const slaLimiteCards = (typeof ultimoSlaMin === 'number' && ultimoSlaMin > 0) ? ultimoSlaMin : SLA_MIN;
            comandas.forEach(comanda => {
                // C5: insignia RETRASADO si excede el SLA.
                const minCola = Number(comanda.minutos_en_cola || 0);
                const excedida = minCola >= slaLimiteCards;
                const insigniaSla = excedida
                    ? '<span class="sla-badge sla-badge-alert"><i class="fa-solid fa-triangle-exclamation"></i> Retrasado +' + minCola + ' min (SLA ' + slaLimiteCards + ')</span>'
                    : '<span class="sla-badge sla-badge-cola"><span class="sla-dot"></span> En cola</span>';
                html += `
                    <div class="w-full md:w-85 bg-[#f8fafc] rounded-3xl shadow-2xl flex flex-col max-h-[68vh] whitespace-normal flex-shrink-0 transition-all border ${excedida ? 'comanda-excedida' : 'border-slate-200/60'} overflow-hidden transform hover:translate-y-[-4px] duration-200">
                        <div class="p-4 bg-[#f1f5f9] border-b border-slate-200/80 comanda-head">
                            <div style="min-width: 0;">
                                <span class="mon-mesa-badge bg-[#1e293b] text-white text-[11px] px-3.5 py-1.5 rounded-xl font-black tracking-widest uppercase shadow-sm">
                                    MESA ${comanda.numero_mesa}
                                </span>
                                <div class="text-[11px] text-slate-500 mt-2.5 font-bold tracking-wider">ORDEN #${comanda.id_pedido}</div>
                                <div class="text-[11px] text-slate-500 mt-1 font-bold tracking-wider">⏱ EN ELABORACIÓN <span class="text-slate-700" data-t0="${comanda.fecha_pedido}">…</span></div>
                            </div>
                            ${insigniaSla}
                        </div>

                        <div class="flex-1 overflow-y-auto p-4 space-y-3.5 custom-scrollbar bg-white">
                `;

                if (comanda.items && comanda.items.length > 0) {
                    comanda.items.forEach(item => {
                        html += `
                            <div class="bg-[#f8fafc] p-4 rounded-2xl border border-slate-200/70 flex flex-col justify-between hover:bg-[#f1f5f9] transition-all" id="item-row-${item.detalle_id}">
                                <div class="flex items-start gap-3">
                                    <span class="bg-[#3b82f6] text-white font-black px-2.5 py-1 rounded-lg text-sm leading-none flex-shrink-0 mt-0.5 shadow-sm">
                                        ${item.cantidad}x
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <h4 class="font-extrabold text-[#0f172a] text-[15px] leading-snug tracking-wide break-words uppercase">
                                            ${item.nombre_platillo}
                                        </h4>
                                        ${item.notas_especiales ? `
                                            <div class="text-sm text-amber-900 bg-amber-50 px-3 py-2.5 rounded-xl mt-3 border border-amber-200 font-bold leading-relaxed shadow-sm">
                                                <i class="fa-solid fa-bell mr-1.5 text-amber-600 animate-bounce"></i> ${item.notas_especiales}
                                            </div>
                                        ` : ''}
                                    </div>
                                </div>
                                
                                <div class="mt-4 pt-3 border-t border-slate-100 flex justify-end">
                                    <button data-id="${item.detalle_id}"
                                            type="button" 
                                            class="btn-complete w-full bg-[#10b981] hover:bg-[#059669] text-white text-[11px] font-black py-3 px-6 rounded-full transition-all flex items-center justify-center gap-2 tracking-widest uppercase active:scale-[0.98] shadow-md shadow-emerald-200/50">
                                        <i class="fa-solid fa-circle-check text-sm"></i> Marcar Listo
                                    </button>
                                </div>
                            </div>
                        `;
                    });
                }

                html += `
                        </div>
                    </div>
                `;
            });

            html += `</div>`;
            main.innerHTML = html;

            // C5: píldora del encabezado con el conteo de retrasadas.
            const pill = document.getElementById('sla-pill');
            const pillTexto = document.getElementById('sla-pill-texto');
            if (pill && pillTexto) {
                const nRetrasadas = comandas.filter(c => Number(c.minutos_en_cola || 0) >= slaLimiteCards).length;
                if (nRetrasadas > 0) {
                    pillTexto.textContent = nRetrasadas + (nRetrasadas === 1 ? ' retrasada' : ' retrasadas') + ' (SLA ' + slaLimiteCards + ' min)';
                    pill.style.display = 'inline-flex';
                } else {
                    pill.style.display = 'none';
                }
            }

            // Vincular los eventos de los botones recién renderizados
            main.querySelectorAll('.btn-complete').forEach(btn => {
                btn.addEventListener('click', function() {
                    const detalleId = this.getAttribute('data-id');
                    marcarListo(detalleId);
                });
            });
        }

        // --- MANEJO DEL REFRESH TEMPORIZADO ---
        function iniciarAutoRefresh() {
            if (!MONITORES_HABILITADOS) return;
            detenerAutoRefresh();
            timeLeft = INTERVALO_SEGUNDOS;
            actualizarContadorUI();

            countdownInterval = setInterval(() => {
                timeLeft--;
                if (timeLeft <= 0) {
                    timeLeft = INTERVALO_SEGUNDOS;
                    actualizarContadorUI();
                    fetchComandasAsincronas();
                } else {
                    actualizarContadorUI();
                }
            }, 1000);
        }

        function detenerAutoRefresh() {
            if (countdownInterval) {
                clearInterval(countdownInterval);
                countdownInterval = null;
            }
        }

        function actualizarContadorUI() {
            const counterSpan = document.getElementById('sync-counter');
            if (counterSpan) {
                counterSpan.textContent = `(${timeLeft}s)`;
            }
        }

        function actualizarUI() {
            if (!MONITORES_HABILITADOS) return;
            const dot = document.getElementById('sync-dot');
            const text = document.getElementById('sync-text');
            const counterSpan = document.getElementById('sync-counter');

            if (sincronizado) {
                if (dot) dot.className = "h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"; 
                if (text) text.textContent = "Sincronizado";
                iniciarAutoRefresh();
            } else {
                detenerAutoRefresh();
                if (dot) dot.className = "h-2.5 w-2.5 rounded-full bg-orange-500"; 
                if (text) text.textContent = "Sin Sincronizar";
                if (counterSpan) {
                    counterSpan.textContent = "";
                }
            }
        }

        function toggleSincronizacion() {
            sincronizado = !sincronizado;
            localStorage.setItem('sync_activa', sincronizado ? 'true' : 'false');
            actualizarUI();
        }

        function marcarListo(detalle_id) {
            Swal.fire({
                title: '¿MARCAR PRODUCTO LISTO?',
                text: 'El ítem pasará al estado listo para su entrega al cliente.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#ef4444',
                confirmButtonText: 'SÍ, LISTO',
                cancelButtonText: 'CANCELAR',
                background: '#ffffff',
                color: '#0f172a'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch('/api/monitor/cambiar-estado', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                detalle_id: detalle_id,
                                nuevo_estado: 'listo'
                            })
                        });
                        
                        const data = await response.json();

                        if (data.success) {
                            const row = document.getElementById(`item-row-${detalle_id}`);
                            if (row) {
                                row.style.opacity = '0';
                                row.style.transform = 'scale(0.9)';
                                row.style.transition = 'all 0.2s cubic-bezier(0.4, 0, 0.2, 1)';
                                setTimeout(() => {
                                    idsItemsConocidos.delete(String(detalle_id));
                                    fetchComandasAsincronas();
                                }, 200);
                            }
                        } else {
                            Swal.fire({
                                title: 'ERROR',
                                text: data.message || 'No se pudo actualizar el estado.',
                                icon: 'error',
                                confirmButtonColor: '#ef4444'
                            });
                        }
                    } catch (err) {
                        Swal.fire({
                            title: 'ERROR DE RED',
                            text: 'Ocurrió un fallo de conexión al intentar actualizar.',
                            icon: 'error',
                            confirmButtonColor: '#ef4444'
                        });
                    }
                }
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            if (MONITORES_HABILITADOS) {
                const btnSync = document.getElementById('btn-sync');
                if (btnSync) {
                    btnSync.addEventListener('click', toggleSincronizacion);
                }

                const btnReload = document.getElementById('btn-reload');
                if (btnReload) {
                    btnReload.addEventListener('click', () => {
                        fetchComandasAsincronas();
                    });
                }

                procesarYRenderizar(comandasActuales);
                actualizarUI();
                if (window.TiempoTranscurrido) {
                    window.TiempoTranscurrido.iniciarTickerTiempos();
                }
            }
        });
    </script>

    <style>
        .custom-scrollbar::-webkit-scrollbar {
            height: 8px;
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</body>
</html>
