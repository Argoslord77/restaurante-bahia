<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle || 'Panel de Servicio - Restaurante Bahía' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        .mesa-card {
            transition: transform 0.2s, box-shadow 0.2s;
            border: none;
        }
        .mesa-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15)!important;
        }
        .status-badge {
            position: absolute;
            top: 15px;
            right: 15px;
        }
        .qr-scanner-placeholder {
            background: #e9ecef;
            border: 2px dashed #6c757d;
            border-radius: 10px;
            min-height: 200px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
    </style>
</head>
<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark px-3 px-md-4 sticky-top shadow-sm">
        <div class="container-fluid">
            <span class="navbar-brand fw-bold mb-0">
                <i class="fa-solid fa-utensils me-2 text-warning"></i>Restaurante Bahía
            </span>
            <div class="d-flex align-items-center gap-3">
                <span class="text-white small d-none d-sm-inline">
                    <i class="fa-solid fa-user-circle me-1 text-info"></i><%= user.nombre %>
                </span>
                <a href="/logout" class="btn btn-outline-danger btn-sm">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </nav>

    <div class="container py-4">
        
        <% if (locals.success_msg && success_msg.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i><%= success_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (locals.error_msg && error_msg.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-xmark me-2"></i><%= error_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="row g-4">
            
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="fa-solid fa-table-cells text-primary me-2"></i>Plano del Salón / Mesas
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <% if (locals.mesas && mesas.length > 0) { %>
                                <% mesas.forEach(mesa => { %>
                                    <div class="col-6 col-sm-4 col-md-4">
                                        <div class="card h-100 mesa-card shadow-sm position-relative text-center p-3 <%= mesa.id_pedido_activo ? 'bg-danger-subtle' : 'bg-success-subtle' %>">
                                            
                                            <span class="badge rounded-pill status-badge <%= mesa.id_pedido_activo ? 'bg-danger' : 'bg-success' %>">
                                                <%= mesa.id_pedido_activo ? 'Ocupada' : 'Libre' %>
                                            </span>

                                            <div class="py-2">
                                                <i class="fa-solid fa-couch fa-2x mb-2 <%= mesa.id_pedido_activo ? 'text-danger' : 'text-success' %>"></i>
                                                <h6 class="fw-bold text-dark mb-1"><%= mesa.nombre %></h6>
                                                <p class="text-secondary small mb-3">Capacidad: <%= mesa.capacidad %> pax</p>
                                            </div>

                                            <% if (mesa.id_pedido_activo) { %>
                                                <a href="/pos/<%= mesa.id_pedido_activo %>" class="btn btn-danger btn-sm w-100 fw-bold shadow-sm">
                                                    <i class="fa-solid fa-pen-to-square me-1"></i>Modificar
                                                </a>
                                            <% } else { %>
                                                <form action="/pos/init-manual" method="POST">
                                                    <input type="hidden" name="id_mesa" value="<%= mesa.id %>">
                                                    <button type="submit" class="btn btn-success btn-sm w-100 fw-bold shadow-sm">
                                                        <i class="fa-solid fa-plus me-1"></i>Crear Orden
                                                    </button>
                                                </form>
                                            <% } %>

                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="col-12 text-center py-5 text-muted">
                                    <i class="fa-solid fa-border-none fa-2x mb-2"></i>
                                    <p>No hay mesas configuradas en el sistema.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div id="reader" style="width: 100%; max-width: 500px; margin: auto;"></div>
                    <div id="resultado" style="margin-top: 20px; font-weight: bold; text-align: center;"></div>
                </div>
            </div>

        </div>
    </div>

    <script src="/js/libs/html5-qrcode.min.js" type="text/javascript"></script>

    <script>
      function onScanSuccess(decodedText, decodedResult) {
          // Aquí manejas el texto o URL que contenía el código QR
          document.getElementById('resultado').innerText = `Código detectado: ${decodedText}`;
          
          // Detener la cámara tras una lectura exitosa (opcional)
          html5QrcodeScanner.clear();
      }

      function onScanFailure(error) {
          // Errores menores de lectura constante (puedes ignorarlos)
      }

      // Configuración del escáner
      let html5QrcodeScanner = new Html5QrcodeScanner(
          "reader", 
          { fps: 10, qrbox: { width: 250, height: 250 } }, 
          /* verbose= */ false
      );
      
      html5QrcodeScanner.render(onScanSuccess, onScanFailure);
    </script>

    <script>
        function ejecutarSimulacionQR() {
            const hash = document.getElementById('simular_qr_select').value;
            if (!hash) {
                alert('Por favor selecciona una mesa que disponga de un hash de auto_creación válido.');
                return;
            }
            // Redirige simulando el comportamiento exacto del QR físico
            window.location.href = `/qr/${hash}`;
        }
    </script>

    <script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>