<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle || 'Panel de Servicio - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        :root {
            --bahia-bg: #0b0f19; 
            --bahia-dark: #0f172a;
            --bahia-card-bg: #ffffff;
            --border-color: #e5e7eb;
            
            --bg-header-card: #111827; 
            --bg-badge-mesa: #1f2937;  
            --color-espera-bg: #fef3c7; 
            --color-espera-txt: #d97706; 
        }

        body {
            background-color: var(--bahia-bg) !important;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        .navbar-bahia {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding: 0.85rem 1.5rem;
        }

        .panel-container {
            border-radius: 16px;
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
        }

        /* --- CONTENEDOR CON ALTO LIMITADO Y DESAPILAMIENTO TRADICIONAL --- */
        .monitor-grid-container {
            max-height: 75vh; 
            overflow-y: auto;
            padding-right: 4px; 
        }

        .monitor-grid-container::-webkit-scrollbar {
            width: 6px;
        }
        .monitor-grid-container::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        .monitor-grid-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        /* --- ESTRUCTURA DE TARJETAS --- */
        .monitor-mesa-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            display: flex;
            flex-direction: column;
            height: 100%;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        
        .monitor-mesa-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
        }

        .monitor-mesa-header {
            background-color: var(--bg-header-card);
            padding: 10px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 4px;
        }

        .monitor-mesa-badge {
            background-color: var(--bg-badge-mesa);
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            padding: 5px 10px;
            border-radius: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .monitor-status-badge {
            font-size: 10px;
            font-weight: 800;
            padding: 4px 8px;
            border-radius: 6px;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }
        .status-monitor-libre { background-color: #d1fae5; color: #065f46; }
        .status-monitor-pendiente { background-color: var(--color-espera-bg); color: var(--color-espera-txt); }
        .status-monitor-ocupada { background-color: #fee2e2; color: #991b1b; }

        .monitor-mesa-body {
            padding: 16px 14px;
            flex-grow: 1;
            background-color: #f9fafb;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .monitor-mesa-icon {
            color: #9ca3af;
            margin-bottom: 4px;
        }

        .monitor-footer-info {
            font-family: sans-serif;
            font-size: 13px;
            color: #4b5563;
            margin-top: 10px;
            padding-top: 8px;
            border-top: 1px dashed #e5e7eb;
        }

        .btn-monitor {
            font-size: 12px;
            font-weight: 700;
            padding: 8px 12px;
            border-radius: 8px;
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            border: none;
            transition: background-color 0.15s ease;
            white-space: nowrap;
        }

        .btn-monitor-libre { background-color: #10b981; color: #ffffff; }
        .btn-monitor-libre:hover { background-color: #059669; }

        .btn-monitor-ocupada { background-color: #ef4444; color: #ffffff; }
        .btn-monitor-ocupada:hover { background-color: #dc2626; }

        .btn-monitor-pendiente {
            background-color: #f59e0b !important;
            color: #ffffff !important;
            border: none !important;
        }
        .btn-monitor-pendiente i { color: #ffffff !important; }
        .btn-monitor-pendiente:hover { background-color: #d97706 !important; }

        .btn-monitor-qr { background-color: #7c3aed; color: #ffffff; }
        .btn-monitor-qr:hover { background-color: #6d28d9; color: #ffffff; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark navbar-bahia sticky-top shadow-sm">
        <div class="container-fluid">
            <span class="navbar-brand fw-extrabold mb-0 d-flex align-items-center gap-2" style="letter-spacing: -0.5px;">
                <i class="fa-solid fa-circle text-warning fs-6"></i>
                <span class="text-white">Bahía</span><span class="text-warning-emphasis fw-light">POS</span>
            </span>
            <div class="d-flex align-items-center gap-3">
                <div class="bg-white bg-opacity-10 px-3 py-1.5 rounded-pill d-none d-sm-flex align-items-center gap-2 border border-white border-opacity-10">
                    <i class="fa-solid fa-user text-warning small"></i>
                    <span class="text-white small fw-semibold"><%= user.nombre %></span>
                </div>
                <a href="/logout" class="btn btn-dark btn-sm rounded-circle d-flex align-items-center justify-content-center border-0" style="width: 36px; height: 36px; background-color: #334155;">
                    <i class="fa-solid fa-right-from-bracket text-danger-subtle small"></i>
                </a>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4 px-3 px-md-5">
        <% if (locals.success_msg && success_msg.length > 0) { %>
            <div class="alert alert-success border-0 shadow-sm rounded-3 p-3 mb-4 d-flex align-items-center" role="alert">
                <i class="fa-solid fa-circle-check fs-5 me-3 text-success"></i>
                <div class="fw-medium text-success-emphasis"><%= success_msg %></div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="row g-4">
            <!-- Sección Salón de Mesas (Ocupa el 100% del ancho) -->
            <div class="col-12">
                <div class="card panel-container border-0 mb-4">
                    <div class="card-header bg-white py-4 px-4 border-0 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-map text-secondary fs-5"></i>Salón de Mesas Asignadas
                        </h5>
                        <div class="d-flex gap-2">
                            <span class="badge text-dark bg-light border px-2.5 py-1.5 rounded-pill small fw-medium">
                                <i class="fa-solid fa-circle text-success me-1 small"></i> Libres
                            </span>
                            <span class="badge text-dark bg-light border px-2.5 py-1.5 rounded-pill small fw-medium">
                                <i class="fa-solid fa-circle text-warning me-1 small"></i> Pendientes
                            </span>
                            <span class="badge text-dark bg-light border px-2.5 py-1.5 rounded-pill small fw-medium">
                                <i class="fa-solid fa-circle text-danger me-1 small"></i> Ocupadas
                            </span>
                        </div>
                    </div>
                    
                    <div class="card-body px-4 pb-4 pt-0">
                        <div class="monitor-grid-container">
                            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-4 g-3">
                                <% if (locals.mesas && mesas.length > 0) { %>
                                    <% mesas.forEach(mesa => { 
                                        let estadoMesa = 'Libre';
                                        if (mesa.id_pedido_activo) {
                                            estadoMesa = (mesa.estado_pedido === 'pendiente') ? 'Pendiente' : 'Ocupada';
                                        } else if (mesa.estado && mesa.estado.toLowerCase() !== 'libre') {
                                            estadoMesa = mesa.estado;
                                        }
                                        let estadoClase = estadoMesa.toLowerCase();
                                    %>
                                        <div class="col">
                                            <div class="monitor-mesa-card">
                                                <div class="monitor-mesa-header">
                                                    <span class="monitor-mesa-badge" title="<%= mesa.nombre %>"><%= mesa.nombre %></span>
                                                    <span class="monitor-status-badge status-monitor-<%= estadoClase %>">
                                                        • <%= estadoMesa === 'Pendiente' ? 'EN ESPERA' : estadoMesa.toUpperCase() %>
                                                    </span>
                                                </div>

                                                <div class="monitor-mesa-body">
                                                    <div class="text-center my-3">
                                                        <i class="fa-solid fa-utensils fa-2xl monitor-mesa-icon"></i>
                                                    </div>
                                                    
                                                    <div class="monitor-footer-info">
                                                        <span class="d-block"><i class="fa-solid fa-users me-1"></i> Capacidad: <strong><%= mesa.capacidad %> personas</strong></span>
                                                        <span class="d-block mt-1 text-truncate"><i class="fa-solid fa-layer-group me-1"></i> <%= mesa.ubicacion || 'Salón Principal' %></span>
                                                        <span class="d-block mt-1"><i class="fa-solid fa-tags me-1"></i> Carta: <strong><%= mesa.carta || 'CUP' %></strong></span>
                                                    </div>
                                                </div>

                                                <div class="p-2.5 bg-white border-top">
                                                    <% if (!mesa.id_pedido_activo) { %>
                                                        <button class="btn-monitor btn-monitor-libre abrir-mesa-btn" data-mesa-id="<%= mesa.id %>">
                                                            <i class="fa-solid fa-plus"></i> Abrir Mesa
                                                        </button>
                                                    <% } else if (estadoMesa === 'Pendiente') { %>
                                                        <a href="/pos/<%= mesa.id_pedido_activo %>" class="btn-monitor btn-monitor-pendiente text-decoration-none">
                                                            <i class="fa-solid fa-bell"></i> Atender Pedido
                                                        </a>
                                                    <% } else { %>
                                                        <a href="/pos/<%= mesa.id_pedido_activo %>" class="btn-monitor btn-monitor-ocupada text-decoration-none">
                                                            <i class="fa-solid fa-file-invoice-dollar"></i> Ver Orden
                                                        </a>
                                                    <% } %>
                                                    <button type="button"
                                                            class="btn-monitor btn-monitor-qr mt-2 mostrar-qr-btn"
                                                            data-mesa-id="<%= mesa.id %>"
                                                            data-mesa-nombre="<%= mesa.nombre %>"
                                                            data-qr-url="<%= ((typeof clientDashboardBaseUrl !== 'undefined' && clientDashboardBaseUrl) ? clientDashboardBaseUrl : '/cliente/dashboard/') + mesa.id %>">
                                                        <i class="fa-solid fa-qrcode"></i> Mostrar QR del cliente
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="col-12 text-center py-5 text-muted">
                                        <i class="fa-solid fa-border-none fa-3x mb-3 text-neutral-300"></i>
                                        <p class="fw-medium">No hay distribución de mesas configurada para el día de hoy.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal del QR público de la mesa -->
    <div class="modal fade" id="modalQrMesa" tabindex="-1" aria-labelledby="modalQrMesaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-dark text-white border-0">
                    <h5 class="modal-title fw-bold" id="modalQrMesaLabel"><i class="fa-solid fa-qrcode text-warning me-2"></i>QR del menú del cliente</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <p class="text-secondary small mb-3" id="qrMesaDescripcion">Escanea este código para abrir el menú.</p>
                    <div id="qrMesaCanvas" class="d-inline-flex align-items-center justify-content-center bg-white p-3 rounded-3 border" style="min-width: 280px; min-height: 280px;"></div>
                    <div class="mt-3 text-start">
                        <label class="form-label text-secondary small fw-semibold mb-1">URL codificada</label>
                        <div class="input-group input-group-sm">
                            <input type="text" id="qrMesaUrl" class="form-control font-monospace bg-light" readonly>
                            <button type="button" id="btnCopiarQrUrl" class="btn btn-outline-secondary" title="Copiar URL"><i class="fa-solid fa-copy"></i></button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 justify-content-center">
                    <button type="button" id="btnDescargarQr" class="btn btn-primary btn-sm rounded-pill px-4"><i class="fa-solid fa-download me-1"></i> Descargar QR</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Libs JS -->
    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script src="/js/libs/qrcode.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const modalQrEl = document.getElementById('modalQrMesa');
            const modalQr = modalQrEl ? new bootstrap.Modal(modalQrEl) : null;
            const qrCanvas = document.getElementById('qrMesaCanvas');
            const qrUrlInput = document.getElementById('qrMesaUrl');
            const qrDescripcion = document.getElementById('qrMesaDescripcion');
            let qrUrlActual = '';
            let qrMesaActual = '';

            document.addEventListener('click', async function(e) {
                const qrButton = e.target.closest('.mostrar-qr-btn');
                if (qrButton) {
                    e.preventDefault();
                    qrUrlActual = qrButton.getAttribute('data-qr-url') || '';
                    qrMesaActual = qrButton.getAttribute('data-mesa-nombre') || qrButton.getAttribute('data-mesa-id') || '';
                    if (!qrUrlActual || !qrCanvas || !modalQr) return;
                    qrCanvas.innerHTML = '';
                    qrUrlInput.value = qrUrlActual;
                    qrDescripcion.textContent = `Mesa ${qrMesaActual}: escanea este código para abrir el menú del cliente.`;
                    try {
                        new QRCode(qrCanvas, {
                            text: qrUrlActual,
                            width: 250,
                            height: 250,
                            colorDark: '#111827',
                            colorLight: '#ffffff',
                            correctLevel: QRCode.CorrectLevel.M
                        });
                        modalQr.show();
                    } catch (error) {
                        console.error('No se pudo generar el QR:', error);
                        alert('No se pudo generar el código QR.');
                    }
                    return;
                }

                const copiar = e.target.closest('#btnCopiarQrUrl');
                if (copiar && qrUrlActual) {
                    try {
                        await navigator.clipboard.writeText(qrUrlActual);
                        copiar.innerHTML = '<i class="fa-solid fa-check text-success"></i>';
                        setTimeout(() => { copiar.innerHTML = '<i class="fa-solid fa-copy"></i>'; }, 1500);
                    } catch (_) {
                        qrUrlInput.select();
                        document.execCommand('copy');
                    }
                    return;
                }

                const descargar = e.target.closest('#btnDescargarQr');
                if (descargar && qrCanvas) {
                    const imagen = qrCanvas.querySelector('img');
                    const lienzo = qrCanvas.querySelector('canvas');
                    const href = imagen ? imagen.src : (lienzo ? lienzo.toDataURL('image/png') : '');
                    if (!href) return;
                    const enlace = document.createElement('a');
                    enlace.href = href;
                    enlace.download = `qr-mesa-${String(qrMesaActual).replace(/[^a-z0-9_-]+/gi, '-').toLowerCase()}.png`;
                    enlace.click();
                    return;
                }

                const abrirButton = e.target.closest('.abrir-mesa-btn');
                if (!abrirButton) return;
                const idMesa = abrirButton.getAttribute('data-mesa-id');
                abrirButton.disabled = true;
                abrirButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Abriendo...';
                try {
                    const response = await fetch('/pos/init-manual', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id_mesa: parseInt(idMesa, 10) })
                    });
                    const data = await response.json();
                    if (data.success && data.pedidoId) {
                        window.location.href = `/pos/${data.pedidoId}`;
                    } else {
                        alert(data.message || 'Error al abrir mesa');
                        abrirButton.disabled = false;
                        abrirButton.innerHTML = '<i class="fa-solid fa-plus"></i> Abrir Mesa';
                    }
                } catch (error) {
                    console.error(error);
                    abrirButton.disabled = false;
                    abrirButton.innerHTML = '<i class="fa-solid fa-plus"></i> Abrir Mesa';
                }
            });
        });
    </script>

    <!-- Audio para alertas -->
    <audio id="audioAlertaCliente" src="/sounds/alert-notification.mp3" preload="auto"></audio>

    <script>
    (() => {
        let alertasProcesadas = new Set();
        const POLLING_INTERVAL = 4000; // Sondeo cada 4 segundos

        async function verificarAlertasCliente() {
            try {
                const response = await fetch('/pos/alertas-pendientes');
                if (!response.ok) return;

                const data = await response.json();
                if (!data.success) return;

                const { notificaciones = [], prePedidos = [] } = data.alertas || {};
                let hayNuevasAlertas = false;

                // 1. Procesar llamadas de clientes y solicitudes de cierre
                for (const notif of notificaciones) {
                    const key = `notif_${notif.id}`;
                    if (!alertasProcesadas.has(key)) {
                        alertasProcesadas.add(key);
                        hayNuevasAlertas = true;

                        const esCierre = notif.tipo === 'SOLICITUD_CIERRE';
                        const titulo = esCierre ? '💳 Solicitud de Cuenta' : '🔔 Llamada de Cliente';
                        const icono = esCierre ? 'warning' : 'info';
                        
                        const nombreMesa = notif.nombre_mesa || notif.numero || notif.mesa || 'N/A';

                        Swal.fire({
                            title: titulo,
                            html: `<p class="fs-5 mb-0">Mesa <strong>${nombreMesa}</strong></p><p class="text-muted mt-2">${notif.mensaje}</p>`,
                            icon: icono,
                            confirmButtonText: 'Marcar Atendida',
                            confirmButtonColor: '#0f172a',
                            allowOutsideClick: false,
                            customClass: {
                                popup: 'rounded-4 border-0 shadow-lg'
                            }
                        }).then(async (result) => {
                            if (result.isConfirmed) {
                                await fetch(`/pos/notificaciones/${notif.id}/leer`, { method: 'POST' });
                            }
                        });
                    }
                }

                // 2. Procesar Pre-pedidos agrupados por mesa
                if (prePedidos.length > 0) {
                    const prepedidosPorMesa = {};
                    prePedidos.forEach(item => {
                        if (!prepedidosPorMesa[item.id_mesa]) {
                            prepedidosPorMesa[item.id_mesa] = {
                                idMesa: item.id_mesa,
                                numeroMesa: item.numero,
                                items: []
                            };
                        }
                        prepedidosPorMesa[item.id_mesa].items.push(item);
                    });

                    Object.values(prepedidosPorMesa).forEach(grupo => {
                        const key = `pre_mesa_${grupo.idMesa}_count_${grupo.items.length}`;
                        if (!alertasProcesadas.has(key)) {
                            alertasProcesadas.add(key);
                            hayNuevasAlertas = true;

                            const resumenText = grupo.items
                                .map(i => `<li class="list-group-item d-flex justify-content-between align-items-center bg-light border-0 py-2 mb-1 rounded-3">
                                    <span><strong>${i.cantidad}x</strong> ${i.platillo}${i.notas_especiales ? `<small class="d-block text-warning-emphasis"><em>Nota: ${i.notas_especiales}</em></small>` : ''}</span>
                                </li>`)
                                .join('');

                            Swal.fire({
                                title: `🍽️ Pre-pedido: Mesa ${grupo.numeroMesa}`,
                                html: `<div class="text-start mt-3">
                                        <p class="text-secondary small fw-bold text-uppercase mb-2">Detalle de la selección:</p>
                                        <ul class="list-group list-group-flush">${resumenText}</ul>
                                       </div>`,
                                icon: 'question',
                                showCancelButton: true,
                                showDenyButton: true,
                                confirmButtonText: '<i class="fa-solid fa-cart-plus me-1"></i> Cargar al POS',
                                denyButtonText: '<i class="fa-solid fa-trash me-1"></i> Descartar',
                                cancelButtonText: '⏳ Luego',
                                confirmButtonColor: '#10b981',
                                denyButtonColor: '#ef4444',
                                cancelButtonColor: '#64748b',
                                allowOutsideClick: false,
                                customClass: { popup: 'rounded-4 border-0 shadow-lg' }
                            }).then(async (result) => {
                                if (result.isConfirmed) {
                                    const itemsPrePedido = grupo.items.map(item => ({
                                        id: item.id_platillo,
                                        nombre: item.platillo,
                                        precio: parseFloat(item.precio),
                                        cantidad: parseInt(item.cantidad),
                                        es_platillo_dia: item.es_platillo_dia === true || item.es_platillo_dia === 1 || item.es_platillo_dia === '1',
                                        notas: item.notas_especiales || ''
                                    }));

                                    const itemsParam = encodeURIComponent(JSON.stringify(itemsPrePedido));
                                    window.location.href = `/pos/mesa/${grupo.idMesa}?cargarPrePedido=${itemsParam}`;
                                } else if (result.isDenied) {
                                    await fetch(`/pos/mesas/${grupo.idMesa}/pre-pedidos`, { method: 'DELETE' });
                                }
                            });
                        }
                    });
                }

                if (hayNuevasAlertas) {
                    reproducirSonidoAlerta();
                }

            } catch (err) {
                console.error('Error en el sondeo de alertas:', err);
            }
        }

        function reproducirSonidoAlerta() {
            const audio = document.getElementById('audioAlertaCliente');
            if (audio) {
                audio.currentTime = 0;
                audio.play().catch(() => {
                    console.warn('Reproducción de audio bloqueada hasta interacción del usuario.');
                });
            }
        }

        // Iniciar polling
        setInterval(verificarAlertasCliente, POLLING_INTERVAL);
        document.addEventListener('DOMContentLoaded', verificarAlertasCliente);
    })();
    </script>
</body>
</html>