<%- include('../partials/header') %>
<div class="container-fluid py-3 bg-light min-vh-100">
  <h2 class="mb-4">Monitor de Cocina - Comandas Activas</h2>
  <div class="row g-3" id="kds-grid">
    <% comandas.forEach(comanda => { %>
      <div class="col-12 col-md-4 col-lg-3">
        <div class="card <%= comanda.estado_item === 'en_cocina' ? 'border-warning bg-warning bg-opacity-10' : 'border-success bg-success bg-opacity-10' %>">
          <div class="card-header d-flex justify-content-between font-monospace">
            <strong>MESA <%= comanda.mesa %></strong>
            <span><%= comanda.hora_pedido %></span>
          </div>
          <div class="card-body">
            <h4 class="card-title"><%= comanda.cantidad %>x <%= comanda.platillo %></h4>
            <% if (comanda.notas_especiales) { %>
              <div class="alert alert-danger p-1 mb-2"><small><i class="bi bi-exclamation-triangle"></i> <%= comanda.notas_especiales %></small></div>
            <% } %>
            <% if (comanda.modificadores && comanda.modificadores.length > 0) { %>
              <ul class="mb-3 ps-3 text-secondary">
                <% comanda.modificadores.forEach(mod => { %><li><b><%= mod.tipo %>:</b> <%= mod.nombre %></li><% }) %>
              </ul>
            <% } %>
            <button class="btn <%= comanda.estado_item === 'en_cocina' ? 'btn-warning' : 'btn-success' %> w-100 btn-marcar-listo"
                    data-detalle-id="<%= comanda.detalle_id %>"
                    <%= comanda.estado_item === 'listo' ? 'disabled' : '' %>>
              <%= comanda.estado_item === 'en_cocina' ? 'Marcar como LISTO' : '¡Preparado!' %>
            </button>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>
<script>
  document.querySelectorAll('.btn-marcar-listo').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const id = e.target.getAttribute('data-detalle-id');
      const res = await fetch(`/pedidos/item/${id}/estado`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nuevoEstado: 'listo' })
      });
      if(res.ok) location.reload();
    });
  });
</script>
<%- include('../partials/footer') %>