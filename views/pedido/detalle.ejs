<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle del Pedido #<%= pedido.id %> - Restaurante</title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>
            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4">                
                <%- include('../includes/header', {encabezado_pagina: 'Detalle de Pedido #' + pedido.id, desc_pagina: 'Mesa: ' + pedido.numero_mesa + ' | Mesero: ' + (pedido.mesero || 'Por asignar'), add_btn: false}) %>
                
                <div class="row g-4 mt-1">
                    <% if (!pedido.fecha_cierre) { %>
                        <div class="col-12 col-lg-4">
                            <div class="card card-custom shadow-sm border-0 p-4 mb-3">
                                <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-plus me-2 text-success"></i>Borrador de Orden</h5>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-secondary small">ID del Platillo</label>
                                    <input type="number" id="inputPlatillo" class="form-control" min="1">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-secondary small">Cantidad</label>
                                    <input type="number" id="inputCantidad" class="form-control" value="1" min="1">
                                </div>
                                <button type="button" class="btn btn-secondary w-100 py-2 mb-2" onclick="agregarAlBorradorLocal()">Pre-agregar a Lista</button>
                            </div>

                            <div class="card card-custom shadow-sm border-0 p-3 d-none" id="cardBorradorLote">
                                <h6 class="fw-bold text-dark mb-2">Nuevos ítems a enviar:</h6>
                                <ul class="list-group list-group-flush mb-3 fs-7" id="listaBorrador"></ul>
                                <button class="btn btn-success w-100 py-2 font-weight-bold" onclick="enviarOrdenLoteServidor('<%= pedido.id %>')">
                                    <i class="fa-solid fa-paper-plane me-1"></i> Enviar Orden a Cocina
                                </button>
                            </div>
                        </div>
                    <% } %>

                    <div class="col-12 <%= !pedido.fecha_cierre ? 'col-lg-8' : 'col-lg-12' %>">
                        <div class="card card-custom shadow-sm border-0 overflow-hidden">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                                <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-utensils me-2"></i> Productos en Preparación / Servidos</h6>
                                
                                <% if (!pedido.fecha_cierre && typeof user !== 'undefined' && user && ['superadministrador', 'administrador', 'cajero'].includes(user.role)) { %>
                                    <div class="d-flex gap-2" id="grupoAccionesCancelacion">
                                        <button class="btn btn-outline-danger btn-sm" id="btnModoCancelacion" onclick="activarModoCancelacion()">
                                            <i class="fa-solid fa-list-check me-1"></i> Cancelación Parcial
                                        </button>
                                        <button class="btn btn-danger btn-sm" onclick="anularPedidoCompletoDirecto()">
                                            <i class="fa-solid fa-ban me-1"></i> Anular Pedido
                                        </button>
                                    </div>
                                <% } %>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" id="tablaComanda">
                                    <thead class="table-custom-thead text-uppercase fs-7">
                                        <tr>
                                            <th class="col-cancelar d-none text-center" style="width: 50px;">Sel.</th>
                                            <th class="ps-4 py-3">Artículos Solicitados</th>
                                            <th class="text-center py-3" style="width: 100px;">Cantidad</th>
                                            <th class="text-center py-3" style="width: 150px;">Estado Ítem</th>
                                            <th class="col-cancelar d-none text-center" style="width: 180px;">Acción Stock</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (!pedido.detalles || pedido.detalles.length === 0) { %>
                                            <tr>
                                                <td colspan="5" class="text-center py-5 text-muted" id="filaVaciaMensaje">
                                                    <i class="fa-solid fa-basket-shopping d-block fs-2 mb-2 text-secondary"></i> Sin órdenes enviadas aún.
                                                </td>
                                            </tr>
                                        <% } else { %>
                                            <% pedido.detalles.forEach(item => { %>
                                                <tr data-id-detalle="<%= item.id_detalle %>">
                                                    <td class="col-cancelar d-none text-center">
                                                        <input type="checkbox" class="form-check-input chk-item-cancelar" onchange="evaluarSeleccion()">
                                                    </td>
                                                    <td class="ps-4 fw-semibold text-dark">
                                                        <%= item.nombre_platillo %>
                                                        
                                                        <!-- Bloque de modificadores -->
                                                        <% if (item.modificadores && item.modificadores.length > 0) { %>
                                                            <div class="mt-1">
                                                                <% item.modificadores.forEach(mod => { %>
                                                                    <span class="badge <%= mod.tipo === 'exclusion' ? 'bg-danger' : 'bg-primary' %> bg-opacity-10 text-<%= mod.tipo === 'exclusion' ? 'danger' : 'primary' %> me-1" style="font-size: 0.75rem;">
                                                                        <%= mod.tipo === 'exclusion' ? 'Sin:' : 'Extra:' %> <%= mod.nombre %>
                                                                    </span>
                                                                <% }) %>
                                                            </div>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-center fw-bold text-secondary font-monospace"><%= item.cantidad %></td>
                                                    <td class="text-center">
                                                        <% if (item.estado_item === 'en_espera') { %>
                                                            <span class="badge bg-secondary text-capitalize px-2 py-1 rounded-pill"><i class="fa-solid fa-clock me-1"></i>En Espera</span>
                                                        <% } else if (item.estado_item === 'en_cocina' || item.estado_item === 'en_bar') { %>
                                                            <span class="badge bg-warning text-dark text-capitalize px-2 py-1 rounded-pill"><i class="fa-solid fa-fire me-1"></i>En Cocina</span>
                                                        <% } else if (item.estado_item === 'listo') { %>
                                                            <span class="badge bg-info text-dark text-capitalize px-2 py-1 rounded-pill"><i class="fa-solid fa-bell me-1"></i>Listo</span>
                                                        <% } else if (item.estado_item === 'entregado') { %>
                                                            <span class="badge bg-success text-capitalize px-2 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i>Servido</span>
                                                        <% } else { %>
                                                            <span class="badge bg-danger text-capitalize px-2 py-1 rounded-pill"><i class="fa-solid fa-circle-xmark me-1"></i>Cancelado</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="col-cancelar d-none text-center">
                                                        <select class="form-select form-select-sm sel-accion-inventario">
                                                            <option value="merma">Merma / Desperdicio</option>
                                                            <option value="reingresar" <%= item.estado_item === 'en_espera' ? 'selected' : '' %>>Reingresar Stock</option>
                                                        </select>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>

                            <div id="panelConfirmarCancelacion" class="d-none bg-light border-top p-3 text-end">
                                <button class="btn btn-sm btn-outline-secondary me-2" onclick="desactivarModoCancelacion()">Regresar</button>
                                <button class="btn btn-sm btn-danger px-3" id="btnEnviarCancelacion" onclick="ejecutarCancelacionFlujo('<%= pedido.id %>')" disabled>
                                    <i class="fa-solid fa-gavel me-1"></i> Cancelar Ítems Seleccionados
                                </button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-light rounded border">
                            <a href="/admin/pedidos" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Volver al Listado</a>
                            <div>
                                <% if (!pedido.fecha_cierre) { %>
                                    <button class="btn btn-danger btn-sm px-4 py-2 shadow-sm" onclick="confirmarCierreCuenta('<%= pedido.id %>')">
                                        <i class="fa-solid fa-cash-register me-1"></i> Procesar Cierre y Descargar Stock
                                    </button>
                                <% } else { %>
                                    <div class="text-end">
                                        <span class="badge bg-success px-3 py-2 rounded fs-7 mb-1"><i class="fa-solid fa-circle-check me-1"></i> Cuenta Cerrada / Pagada</span>
                                        <div class="text-muted small">Cajero ID: <%= pedido.id_usuario_cajero %> | <%= pedido.fecha_cierre %></div>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script>
        let borradorOrden = [];

        function agregarAlBorradorLocal() {
            const idPlatillo = parseInt(document.getElementById('inputPlatillo').value, 10);
            const cantidad = parseInt(document.getElementById('inputCantidad').value, 10);

            if (!idPlatillo || cantidad < 1) {
                return Swal.fire('Atención', 'Verifique el ID del platillo y la cantidad.', 'warning');
            }

            const itemExistente = borradorOrden.find(i => i.id_platillo === idPlatillo);
            if (itemExistente) {
                itemExistente.cantidad += cantidad;
            } else {
                borradorOrden.push({ id_platillo: idPlatillo, cantidad: cantidad });
            }

            renderizarBorradorUI();
            document.getElementById('inputPlatillo').value = '';
            document.getElementById('inputCantidad').value = '1';
        }

        function eliminarDelBorradorLocal(index) {
            borradorOrden.splice(index, 1);
            renderizarBorradorUI();
        }

        function renderizarBorradorUI() {
            const contenedor = document.getElementById('cardBorradorLote');
            const lista = document.getElementById('listaBorrador');
            lista.innerHTML = '';

            if (borradorOrden.length === 0) {
                contenedor.classList.add('d-none');
                return;
            }

            contenedor.classList.remove('d-none');
            borradorOrden.forEach((item, index) => {
                lista.innerHTML += `
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-2 border-bottom">
                        <div>
                            <span class="fw-bold text-dark">ID: ${item.id_platillo}</span> 
                            <span class="text-secondary font-monospace ms-2">x${item.cantidad}</span>
                        </div>
                        <button class="btn btn-link btn-sm text-danger p-0" onclick="eliminarDelBorradorLocal(${index})">
                            <i class="fa-solid fa-circle-minus"></i>
                        </button>
                    </li>
                `;
            });
        }

        async function enviarOrdenLoteServidor(idPedido) {
            Swal.fire({ title: 'Enviando órdenes a producción...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            try {
                const res = await fetch(`/pedido/${idPedido}/enviar-orden`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ items: borradorOrden })
                });
                const data = await res.json();
                if (data.success) {
                    Swal.fire({ title: '¡Orden Enviada!', text: 'Los productos entraron a cocina.', icon: 'success', timer: 1500, showConfirmButton: false })
                    .then(() => { window.location.reload(); });
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            } catch (err) {
                Swal.fire('Error', 'Fallo de red.', 'error');
            }
        }

        function activarModoCancelacion() {
            document.querySelectorAll('.col-cancelar').forEach(el => el.classList.remove('d-none'));
            document.getElementById('panelConfirmarCancelacion').classList.remove('d-none');
            document.getElementById('grupoAccionesCancelacion').classList.add('d-none');
        }

        function desactivarModoCancelacion() {
            document.querySelectorAll('.col-cancelar').forEach(el => el.classList.add('d-none'));
            document.getElementById('panelConfirmarCancelacion').classList.add('d-none');
            document.getElementById('grupoAccionesCancelacion').classList.remove('d-none');
            document.querySelectorAll('.chk-item-cancelar').forEach(chk => chk.checked = false);
            evaluarSeleccion();
        }

        function evaluarSeleccion() {
            const seleccionados = document.querySelectorAll('.chk-item-cancelar:checked').length;
            document.getElementById('btnEnviarCancelacion').disabled = (seleccionados === 0);
        }

        function ejecutarCancelacionFlujo(idPedido) {
            const productosAfectados = [];
            document.querySelectorAll('#tablaComanda tbody tr').forEach(row => {
                const checkbox = row.querySelector('.chk-item-cancelar');
                if (checkbox && checkbox.checked) {
                    productosAfectados.push({
                        id_detalle: parseInt(row.getAttribute('data-id-detalle'), 10),
                        accion: row.querySelector('.sel-accion-inventario').value
                    });
                }
            });

            Swal.fire({
                title: 'Motivo de Cancelación Parcial',
                text: 'Escriba la justificación para la auditoría de almacén:',
                input: 'textarea',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Aplicar Cambios',
                cancelButtonText: 'Volver',
                preConfirm: (text) => {
                    if (!text) Swal.showValidationMessage('El motivo es requerido.');
                    return text;
                }
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch(`/pedido/${idPedido}/cancelar-parcial-o-total`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                            body: JSON.stringify({ productosAfectados, motivo: result.value })
                        });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire('¡Éxito!', 'Los ítems se han dado de baja.', 'success').then(() => {
                                window.location.href = data.redirectUrl;
                            });
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    } catch (err) {
                        Swal.fire('Error de Red', 'No se pudo comunicar el cambio.', 'error');
                    }
                }
            });
        }

        function anularPedidoCompletoDirecto() {
            Swal.fire({
                title: '¿Anular Todo el Pedido #<%= pedido.id %>?',
                text: 'Esta acción cancelará inmediatamente todos los artículos activos. Ingrese el motivo:',
                input: 'textarea',
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Sí, Cancelar Todo',
                cancelButtonText: 'Regresar',
                preConfirm: (text) => {
                    if (!text) Swal.showValidationMessage('La justificación es obligatoria.');
                    return text;
                }
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Procesando baja total...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                    try {
                        const res = await fetch(`/pedido/<%= pedido.id %>/cancelar-parcial-o-total`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                            body: JSON.stringify({ productosAfectados: [], motivo: result.value })
                        });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire('Pedido Anulado', 'Redireccionando al panel...', 'success').then(() => {
                                window.location.href = data.redirectUrl;
                            });
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    } catch (err) {
                        Swal.fire('Error', 'Fallo de comunicación.', 'error');
                    }
                }
            });
        }

        function confirmarCierreCuenta(idPedido) {
            Swal.fire({
                title: '¿Confirmar Cierre de Cuenta?',
                text: `Se liquidará el pedido #${idPedido}, bloqueando la orden y procesando el cambio de estado de la mesa.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, Cerrar Cuenta',
                cancelButtonText: 'Cancelar',
                reverseButtons: true
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Procesando transacciones...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                    try {
                        const res = await fetch(`/pedido/${idPedido}/cerrar`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
                        });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire({ title: '¡Cierre Exitoso!', text: 'Mesa en estado desocupando.', icon: 'success', timer: 2000, showConfirmButton: false })
                            .then(() => { window.location.href = data.redirectUrl; });
                        } else {
                            Swal.fire('Error del Servidor', data.message, 'error');
                        }
                    } catch (error) {
                        Swal.fire('Error de Red', 'Fallo en la comunicación.', 'error');
                    }
                }
            });
        }
    </script>
</body>
</html>