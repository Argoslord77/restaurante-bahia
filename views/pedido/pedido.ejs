<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Pedidos - Restaurante</title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>
            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4">                
                <%- include('../includes/header', {encabezado_pagina: 'Ventas / Pedidos', desc_pagina: 'Monitoreo de órdenes en consumo y apertura de mesas', add_btn: true, btn_label: "Crear Orden", modal: "modalCrearPedido"}) %>
                
                <div class="card card-custom shadow-sm border-0 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-custom-thead text-uppercase fs-7">
                                <tr>
                                    <th class="ps-4 py-3">ID Pedido</th>
                                    <th class="py-3">Ubicación / Mesa</th>
                                    <th class="py-3">Mesero Responsable</th>
                                    <th class="py-3">Estado</th>
                                    <th class="text-center py-3" style="width: 180px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (lista.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <i class="fa-solid fa-utensils d-block fs-2 mb-2 text-secondary"></i> No hay pedidos activos en este momento.
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% lista.forEach(item => { %>
                                        <tr>
                                            <td class="ps-4 fw-bold text-dark">#<%= item.id %></td>
                                            <td>
                                                <span class="fw-semibold text-dark"><%= item.numero_mesa %></span>
                                            </td>
                                            <td class="text-secondary fs-7">
                                                <i class="fa-solid fa-user me-1 text-muted"></i> <%= item.mesero || 'Por asignar' %>
                                            </td>
                                            <td>
                                                <span class="badge bg-warning text-dark text-capitalize px-3 py-1 rounded-pill fs-7">
                                                    <i class="fa-solid fa-clock me-1"></i>En Consumo
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group gap-1">
                                                    <a href="/admin/pedido/<%= item.id %>" class="btn btn-sm btn-outline-secondary border-0" title="Ver Detalle / Gestionar Caja">
                                                        <i class="fa-solid fa-eye text-primary"></i>
                                                    </a>
                                                    <% if (typeof user !== 'undefined' && user && ['superadministrador', 'administrador', 'cajero'].includes(user.role)) { %>
                                                        <button class="btn btn-sm btn-outline-secondary border-0" title="Anular Pedido Completo" onclick="cancelarPedidoInmediato('<%= item.id %>')">
                                                            <i class="fa-solid fa-trash-can text-danger"></i>
                                                        </button>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <div class="modal fade" id="modalCrearPedido" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">Abrir Servicio / Orden</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formCrearPedido" action="/pedido/nuevo" method="POST">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Seleccionar Número de Mesa / ID</label>
                                <input type="number" name="id_mesa" class="form-control" placeholder="Ej. 5" min="1" required>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4">Iniciar Servicio</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script>
        document.getElementById('modalCrearPedido').addEventListener('hidden.bs.modal', () => {
            document.getElementById('formCrearPedido').reset();
        });

        function cancelarPedidoInmediato(idPedido) {
            Swal.fire({
                title: '¿Anular Pedido #' + idPedido + ' por Completo?',
                text: 'Se procederá a dar de baja toda la orden. Escriba la justificación:',
                input: 'textarea',
                inputPlaceholder: 'Motivo de la cancelación total obligatoria...',
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Confirmar Anulación',
                cancelButtonText: 'Volver',
                preConfirm: (text) => {
                    if (!text) Swal.showValidationMessage('Debe indicar un motivo para la auditoría.');
                    return text;
                }
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Anulando orden...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                    try {
                        const res = await fetch(`/pedido/${idPedido}/cancelar-parcial-o-total`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                            body: JSON.stringify({ productosAfectados: [], motivo: result.value }) 
                        });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire('Pedido Anulado', 'La mesa ha sido liberada.', 'success').then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    } catch (err) {
                        Swal.fire('Error', 'Fallo en la comunicación con el servidor.', 'error');
                    }
                }
            });
        }
    </script>
</body>
</html>