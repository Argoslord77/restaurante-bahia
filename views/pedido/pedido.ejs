<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedidos y Ventas - Restaurante Bahía</title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .fila-pedido { cursor: pointer; }
        .fila-detalle > td { background: #f8f9fa; }
        .fila-detalle.oculta { display: none; }
        .chevron-detalle { transition: transform .15s ease; }
        .fila-pedido.abierta .chevron-detalle { transform: rotate(90deg); }
        .tabla-items { font-size: .8rem; }
        .tabla-items thead th { white-space: nowrap; }
        .moneda-chip { white-space: nowrap; }
        @media print {
            #sidebarMenu, .content-header-responsive, .filtros-ventas, .acciones-ventas,
            .paginacion-ventas, .no-print, .topbar-movil { display: none !important; }
            main { width: 100% !important; margin: 0 !important; padding: 0 !important; }
            .fila-detalle { display: table-row !important; }
            .card, .table { border: 0 !important; box-shadow: none !important; }
            body { background: #fff !important; }
        }
    </style>
</head>
<body class="bg-light">
    <%
        // Constructor de query strings: conserva los filtros al paginar o exportar.
        const qs = (overrides) => {
            const base = {
                desde: filtros.desde,
                hasta: filtros.hasta,
                turno_id: filtros.turno_id || '',
                mesero_id: filtros.mesero_id || '',
                mesa_id: filtros.mesa_id || '',
                estado: filtros.estado && filtros.estado !== 'todas' ? filtros.estado : '',
                q: filtros.q || '',
                por_pagina: resultado.porPagina
            };
            Object.assign(base, overrides || {});
            return Object.entries(base)
                .filter(([, v]) => v !== '' && v !== null && v !== undefined)
                .map(([k, v]) => `${k}=${encodeURIComponent(v)}`)
                .join('&');
        };
        const dinero = (v) => Number(v || 0).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const t = resultado.totales || {};
        const rolActual = (typeof user !== 'undefined' && user) ? user.rol : null;
    %>

    <div class="container-fluid">
        <div class="row">
            <div class="topbar-movil">
                <%- include('../includes/topBarMobile') %>
            </div>

            <%- include('../includes/sideBarMenu') %>

            <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">
                <%- include('../includes/header', {
                    encabezado_pagina: 'Pedidos y Ventas',
                    desc_pagina: 'Registro de servicios del ' + filtros.desde + ' al ' + filtros.hasta + ': turno, mesa, dependiente, tiempos de entrega e importe desglosado por moneda.',
                    add_btn: true,
                    btn_label: 'Abrir Servicio',
                    modal: 'modalCrearPedido'
                }) %>

                <% if (!tiemposDisponibles) { %>
                <div class="alert alert-warning d-flex align-items-start gap-2 shadow-sm border-0 rounded py-2 px-3 mb-4 no-print" role="alert">
                    <i class="fa-solid fa-triangle-exclamation mt-1"></i>
                    <div class="fs-7">
                        <strong>Sin tiempos por ítem.</strong>
                        La base de datos todavía no tiene las columnas de tiempos de
                        <code>detalles_pedido</code>, por lo que el listado no puede mostrar el tiempo de entrega
                        de cada plato ni el cocinero responsable. Ejecute
                        <code>scripts/migracion_tiempos_detalles_pedido.sql</code> (o <code>npm run migrate</code>)
                        para habilitarlos; el resto de la vista funciona igual.
                    </div>
                </div>
                <% } %>

                <!-- ═══════════ FILTROS ESPECIALIZADOS ═══════════ -->
                <div class="card border-0 shadow-sm rounded p-3 mb-4 filtros-ventas bg-white no-print">
                    <form method="get" action="/admin/pedidos" class="row g-2 align-items-end" id="formFiltros">
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted fw-semibold mb-1" for="fDesde">Desde</label>
                            <input type="date" id="fDesde" name="desde" class="form-control form-control-sm" value="<%= filtros.desde %>">
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted fw-semibold mb-1" for="fHasta">Hasta</label>
                            <input type="date" id="fHasta" name="hasta" class="form-control form-control-sm" value="<%= filtros.hasta %>">
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted fw-semibold mb-1" for="fTurno">Turno</label>
                            <select id="fTurno" name="turno_id" class="form-select form-select-sm">
                                <option value="">Todos</option>
                                <% (opciones.turnos || []).forEach(turno => { %>
                                    <% const aperturaTurno = turno.fecha_apertura ? new Date(turno.fecha_apertura) : null; %>
                                    <option value="<%= turno.id %>" <%= filtros.turno_id === turno.id ? 'selected' : '' %>>
                                        #<%= turno.id %> · <%= aperturaTurno ? aperturaTurno.toLocaleDateString('es-ES') + ' ' + aperturaTurno.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) : 'sin fecha' %> (<%= turno.estado %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted fw-semibold mb-1" for="fMesero">Dependiente</label>
                            <select id="fMesero" name="mesero_id" class="form-select form-select-sm">
                                <option value="">Todos</option>
                                <% (opciones.meseros || []).forEach(m => { %>
                                    <option value="<%= m.id %>" <%= filtros.mesero_id === m.id ? 'selected' : '' %>>
                                        <%= [m.nombre, m.apellidos].filter(Boolean).join(' ') %> (<%= m.rol %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted fw-semibold mb-1" for="fMesa">Mesa</label>
                            <select id="fMesa" name="mesa_id" class="form-select form-select-sm">
                                <option value="">Todas</option>
                                <% (opciones.mesas || []).forEach(m => { %>
                                    <option value="<%= m.id %>" <%= filtros.mesa_id === m.id ? 'selected' : '' %>>
                                        <%= m.numero %><%= m.ubicacion ? ' · ' + m.ubicacion : '' %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted fw-semibold mb-1" for="fEstado">Estado</label>
                            <select id="fEstado" name="estado" class="form-select form-select-sm">
                                <option value="todas" <%= filtros.estado === 'todas' ? 'selected' : '' %>>Todos los estados</option>
                                <% Object.entries(etiquetasEstado).forEach(([clave, etiqueta]) => { %>
                                    <option value="<%= clave %>" <%= filtros.estado === clave ? 'selected' : '' %>><%= etiqueta %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label small text-muted fw-semibold mb-1" for="fBusqueda">Búsqueda</label>
                            <input type="text" id="fBusqueda" name="q" class="form-control form-control-sm"
                                   placeholder="Nº de pedido, mesa o cliente…"
                                   value="<%= filtros.q || '' %>" data-limpiar data-limpiar-enviar="si">
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted fw-semibold mb-1" for="fPorPagina">Filas por página</label>
                            <select id="fPorPagina" name="por_pagina" class="form-select form-select-sm">
                                <% paginasValidas.forEach(n => { %>
                                    <option value="<%= n %>" <%= resultado.porPagina === n ? 'selected' : '' %>><%= n %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-12 col-md-7 d-flex flex-wrap gap-2 justify-content-md-end">
                            <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" data-rango="hoy">Hoy</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" data-rango="ayer">Ayer</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" data-rango="7">Últimos 7 días</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" data-rango="mes">Mes actual</button>
                            <button type="button" class="btn btn-outline-dark btn-sm fw-semibold" data-rango="limpiar">
                                <i class="fa-solid fa-eraser me-1"></i>Limpiar filtros
                            </button>
                            <button type="submit" class="btn btn-dark btn-sm fw-semibold px-3">
                                <i class="fa-solid fa-magnifying-glass me-1"></i>Filtrar
                            </button>
                        </div>
                    </form>
                </div>

                <!-- ═══════════ RESUMEN DEL PERÍODO ═══════════ -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-primary border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Pedidos del período</h6>
                            <h3 class="fw-bold mb-0 text-dark"><%= t.pedidos || 0 %></h3>
                            <small class="text-muted">
                                <%= t.abiertas || 0 %> en consumo · <%= t.cobradas || 0 %> cobradas
                                <% if (t.anuladas) { %> · <span class="text-danger"><%= t.anuladas %> anuladas</span><% } %>
                            </small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-success border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Importe (equivalente CUP)</h6>
                            <h3 class="fw-bold mb-0 text-success">$<%= dinero(t.importe) %></h3>
                            <small class="text-muted">Descuentos: $<%= dinero(t.descuentos) %></small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-warning border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Propinas (excedentes)</h6>
                            <h3 class="fw-bold mb-0 text-warning">$<%= dinero(t.propinas) %></h3>
                            <small class="text-muted">Van al cuadre de trabajadores, no al arqueo del dueño</small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-info border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Ítems y servicio</h6>
                            <h3 class="fw-bold mb-0 text-info"><%= t.items_entregados || 0 %> <small class="fs-7 fw-normal text-muted">entregados</small></h3>
                            <small class="text-muted">
                                <%= t.items_cancelados || 0 %> cancelados · duración media <%= t.duracion_media || '—' %>
                            </small>
                        </div>
                    </div>
                </div>

                <% if ((t.por_moneda || []).length) { %>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
                    <span class="text-muted fs-7 fw-semibold text-uppercase">Cobros por moneda:</span>
                    <% t.por_moneda.forEach(mo => { %>
                        <span class="badge rounded-pill text-bg-light border shadow-sm moneda-chip py-2 px-3">
                            <strong><%= dinero(mo.monto_origen) %> <%= mo.codigo %></strong>
                            <span class="text-muted ms-1">→ $<%= dinero(mo.monto_local) %> CUP</span>
                            <span class="text-muted ms-1">(<%= mo.pagos %> pago<%= mo.pagos === 1 ? '' : 's' %>)</span>
                        </span>
                    <% }) %>
                </div>
                <% } %>

                <!-- ═══════════ ACCIONES ═══════════ -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 acciones-ventas no-print">
                    <small class="text-muted">
                        Mostrando <%= resultado.filas.length %> de <%= resultado.total %> pedido<%= resultado.total === 1 ? '' : 's' %>
                        · haga clic en una fila para ver el desglose de ítems
                    </small>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark" id="btnExpandirTodo">
                            <i class="fa-solid fa-angles-down text-secondary me-1"></i>Expandir todo
                        </button>
                        <a href="/admin/pedidos/exportar?detalle=1&<%= qs() %>" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                            <i class="fa-solid fa-file-csv text-success me-1"></i>CSV por ítem
                        </a>
                        <a href="/admin/pedidos/exportar?<%= qs() %>" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                            <i class="fa-solid fa-file-csv text-success me-1"></i>Exportar CSV
                        </a>
                        <button type="button" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark" id="btnImprimir">
                            <i class="fa-solid fa-print text-secondary me-1"></i>Imprimir
                        </button>
                    </div>
                </div>

                <!-- ═══════════ TABLA DE PEDIDOS ═══════════ -->
                <div class="card card-custom shadow-sm border-0 overflow-hidden mb-3">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 fs-7">
                            <thead class="table-custom-thead text-uppercase" style="font-size:.7rem;">
                                <tr>
                                    <th class="ps-3 py-3" style="width:38px;"></th>
                                    <th class="py-3">Pedido</th>
                                    <th class="py-3">Turno</th>
                                    <th class="py-3">Mesa / Área</th>
                                    <th class="py-3">Dependiente</th>
                                    <th class="py-3">Apertura</th>
                                    <th class="py-3">Cierre</th>
                                    <th class="py-3 text-center">Duración</th>
                                    <th class="py-3">Estado</th>
                                    <th class="py-3 text-center">Ítems</th>
                                    <th class="py-3 text-end">Importe</th>
                                    <th class="py-3 text-center no-print" style="width:150px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (resultado.filas.length === 0) { %>
                                    <tr>
                                        <td colspan="12" class="text-center py-5 text-muted">
                                            <i class="fa-solid fa-utensils d-block fs-2 mb-2 text-secondary"></i>
                                            No hay pedidos entre el <%= filtros.desde %> y el <%= filtros.hasta %> con los filtros aplicados.
                                        </td>
                                    </tr>
                                <% } %>

                                <% resultado.filas.forEach(pedido => { %>
                                <tr class="fila-pedido" data-detalle="detalle-<%= pedido.id %>" title="Ver desglose de ítems">
                                    <td class="ps-3 text-center">
                                        <i class="fa-solid fa-chevron-right chevron-detalle text-muted"></i>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">#<%= pedido.id %></span>
                                        <% if (pedido.cliente_nombre) { %>
                                            <small class="text-muted d-block text-truncate" style="max-width:150px;"><%= pedido.cliente_nombre %></small>
                                        <% } %>
                                        <small class="text-muted d-block"><%= pedido.comensales %> comensal<%= pedido.comensales === 1 ? '' : 'es' %></small>
                                    </td>
                                    <td>
                                        <% if (pedido.turno_etiqueta) { %>
                                            <span class="fw-semibold">#<%= pedido.turno_id %></span>
                                            <small class="text-muted d-block">
                                                <%= pedido.turno_apertura ? new Date(pedido.turno_apertura).toLocaleDateString('es-ES') : '—' %>
                                                · <%= pedido.turno_estado || '' %>
                                            </small>
                                        <% } else { %><span class="text-muted">—</span><% } %>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark"><%= pedido.mesa_numero %></span>
                                        <% if (pedido.mesa_ubicacion) { %><small class="text-muted d-block"><%= pedido.mesa_ubicacion %></small><% } %>
                                    </td>
                                    <td>
                                        <i class="fa-solid fa-user me-1 text-muted"></i>
                                        <span class="text-dark"><%= pedido.mesero %></span>
                                        <% if (pedido.cajero) { %><small class="text-muted d-block">Cobró: <%= pedido.cajero %></small><% } %>
                                    </td>
                                    <td>
                                        <span class="fw-semibold"><%= pedido.apertura_hora || '—' %></span>
                                        <small class="text-muted d-block"><%= pedido.apertura_fecha || '' %></small>
                                    </td>
                                    <td>
                                        <% if (pedido.cierre_hora) { %>
                                            <span class="fw-semibold"><%= pedido.cierre_hora %></span>
                                            <small class="text-muted d-block"><%= pedido.cierre_fecha %></small>
                                        <% } else { %>
                                            <span class="badge text-bg-warning text-dark">En curso</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-semibold <%= pedido.duracion ? '' : 'text-muted' %>"><%= pedido.duracion || '—' %></span>
                                        <% if (pedido.tiempo_medio) { %>
                                            <small class="text-muted d-block" title="Tiempo medio de entrega por plato">
                                                <i class="fa-solid fa-stopwatch me-1"></i><%= pedido.tiempo_medio %>/plato
                                            </small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="badge <%= pedido.estado_clase %> px-2 py-1 rounded-pill"><%= pedido.estado_etiqueta %></span>
                                        <% if (pedido.impresiones_precuenta > 0) { %>
                                            <small class="text-muted d-block"><%= pedido.impresiones_precuenta %> precuenta<%= pedido.impresiones_precuenta === 1 ? '' : 's' %></small>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge text-bg-success" title="Entregados"><%= pedido.items_entregados %></span>
                                        <% if (pedido.items_pendientes > 0) { %>
                                            <span class="badge text-bg-warning text-dark" title="Pendientes"><%= pedido.items_pendientes %></span>
                                        <% } %>
                                        <% if (pedido.items_cancelados > 0) { %>
                                            <span class="badge text-bg-danger" title="Cancelados"><%= pedido.items_cancelados %></span>
                                        <% } %>
                                        <small class="text-muted d-block"><%= pedido.items_total %> en total</small>
                                    </td>
                                    <td class="text-end">
                                        <span class="fw-bold text-dark">$<%= dinero(pedido.total) %></span>
                                        <% if (pedido.propina > 0) { %>
                                            <small class="text-warning d-block fw-semibold">propina $<%= dinero(pedido.propina) %></small>
                                        <% } %>
                                        <% if (pedido.monedas.length) { %>
                                            <small class="text-muted d-block">
                                                <%= pedido.monedas.map(mo => dinero(mo.monto_origen) + ' ' + mo.codigo).join(' · ') %>
                                            </small>
                                        <% } else if (pedido.descuento > 0) { %>
                                            <small class="text-muted d-block">desc. $<%= dinero(pedido.descuento) %></small>
                                        <% } %>
                                    </td>
                                    <td class="text-center no-print">
                                        <div class="btn-group gap-1">
                                            <a href="/admin/pedido/<%= pedido.id %>" class="btn btn-sm btn-outline-secondary border-0" title="Ver detalle / gestionar caja">
                                                <i class="fa-solid fa-eye text-primary"></i>
                                            </a>
                                            <% if (pedido.abierta) { %>
                                                <% if (rolActual && ['superadministrador', 'administrador', 'dependiente', 'capitan'].includes(rolActual)) { %>
                                                    <a href="/pos/<%= pedido.id %>" class="btn btn-sm btn-outline-secondary border-0" title="Abrir en el POS">
                                                        <i class="fa-solid fa-cash-register text-success"></i>
                                                    </a>
                                                <% } %>
                                                <% if (rolActual && ['superadministrador', 'administrador', 'cajero'].includes(rolActual)) { %>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary border-0 btn-anular" data-id="<%= pedido.id %>" title="Anular pedido completo">
                                                        <i class="fa-solid fa-trash-can text-danger"></i>
                                                    </button>
                                                <% } %>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Desglose de ítems de la orden -->
                                <tr class="fila-detalle oculta" id="detalle-<%= pedido.id %>">
                                    <td colspan="12" class="p-3">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold text-uppercase mb-0" style="font-size:.75rem; letter-spacing:.5px;">
                                                <i class="fa-solid fa-list-check me-1 text-secondary"></i>Ítems de la orden #<%= pedido.id %>
                                            </h6>
                                            <small class="text-muted">
                                                Tiempo de entrega = envío a producción → entrega al cliente
                                            </small>
                                        </div>

                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered bg-white tabla-items align-middle mb-2">
                                                <thead class="table-light text-uppercase" style="font-size:.65rem;">
                                                    <tr>
                                                        <th class="ps-2">Ítem</th>
                                                        <th class="text-center">Cant.</th>
                                                        <th class="text-end">P. unit.</th>
                                                        <th class="text-end">Importe</th>
                                                        <th class="text-center">Estado</th>
                                                        <th class="text-center">Área</th>
                                                        <th class="text-center">Alta</th>
                                                        <th class="text-center">Enviado</th>
                                                        <th class="text-center">Listo</th>
                                                        <th class="text-center">Entregado</th>
                                                        <th class="text-center">Tiempo entrega</th>
                                                        <th>Cocinero</th>
                                                        <th>Entregó</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (pedido.items.length === 0) { %>
                                                        <tr><td colspan="13" class="text-center text-muted py-3">La orden no tiene ítems registrados.</td></tr>
                                                    <% } %>
                                                    <% pedido.items.forEach(item => { %>
                                                    <tr class="<%= item.estado_item === 'cancelado' ? 'table-danger' : '' %>">
                                                        <td class="ps-2">
                                                            <span class="fw-semibold"><%= item.nombre %></span>
                                                            <% if (item.es_platillo_dia) { %><span class="badge text-bg-info ms-1">del día</span><% } %>
                                                            <% if (item.modificadores.length) { %>
                                                                <small class="text-muted d-block">
                                                                    <i class="fa-solid fa-plus me-1"></i><%= item.modificadores.map(mo => mo.nombre).join(', ') %>
                                                                </small>
                                                            <% } %>
                                                            <% if (item.notas_especiales) { %>
                                                                <small class="text-muted d-block fst-italic"><%= item.notas_especiales %></small>
                                                            <% } %>
                                                        </td>
                                                        <td class="text-center"><%= item.cantidad %></td>
                                                        <td class="text-end">$<%= dinero(item.precio_unitario) %></td>
                                                        <td class="text-end fw-semibold">$<%= dinero(item.importe) %></td>
                                                        <td class="text-center">
                                                            <span class="badge <%= item.estado_item === 'entregado' ? 'text-bg-success' : (item.estado_item === 'cancelado' ? 'text-bg-danger' : 'text-bg-warning text-dark') %>">
                                                                <%= item.estado_etiqueta %>
                                                            </span>
                                                        </td>
                                                        <td class="text-center text-capitalize"><%= item.area_preparacion || '—' %></td>
                                                        <td class="text-center"><%= item.alta || '—' %></td>
                                                        <td class="text-center"><%= item.envio || '—' %></td>
                                                        <td class="text-center"><%= item.listo || '—' %></td>
                                                        <td class="text-center"><%= item.entrega || '—' %></td>
                                                        <td class="text-center fw-semibold"><%= item.tiempo_entrega || '—' %></td>
                                                        <td><%= item.cocinero || '—' %></td>
                                                        <td><%= item.entregado_por || '—' %></td>
                                                    </tr>
                                                    <% }) %>
                                                </tbody>
                                                <tfoot class="table-light fw-bold">
                                                    <tr>
                                                        <td class="ps-2">Subtotal ítems</td>
                                                        <td class="text-center"><%= pedido.items.reduce((a, i) => a + i.cantidad, 0) %></td>
                                                        <td></td>
                                                        <td class="text-end">$<%= dinero(pedido.items.reduce((a, i) => a + i.importe, 0)) %></td>
                                                        <td colspan="9"></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>

                                        <div class="row g-3">
                                            <div class="col-12 col-lg-7">
                                                <h6 class="fw-bold text-uppercase mb-2" style="font-size:.72rem; letter-spacing:.5px;">
                                                    <i class="fa-solid fa-money-bill-wave me-1 text-secondary"></i>Pagos registrados
                                                </h6>
                                                <% if (pedido.pagos.length === 0) { %>
                                                    <p class="text-muted fs-7 mb-0">Sin pagos asentados (cuenta abierta o consumo interno).</p>
                                                <% } else { %>
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-bordered bg-white tabla-items align-middle mb-0">
                                                        <thead class="table-light text-uppercase" style="font-size:.65rem;">
                                                            <tr>
                                                                <th>Método</th>
                                                                <th>Moneda</th>
                                                                <th class="text-end">Monto origen</th>
                                                                <th class="text-center">Cambio</th>
                                                                <th class="text-end">Equivalente CUP</th>
                                                                <th>Referencia</th>
                                                                <th>Fecha</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <% pedido.pagos.forEach(pago => { %>
                                                            <tr>
                                                                <td><%= pago.metodo_etiqueta %></td>
                                                                <td><%= pago.moneda_codigo %><% if (pago.moneda_nombre) { %><small class="text-muted d-block"><%= pago.moneda_nombre %></small><% } %></td>
                                                                <td class="text-end fw-semibold"><%= dinero(pago.monto_moneda_origen) %></td>
                                                                <td class="text-center"><%= pago.factor_cambio_aplicado %></td>
                                                                <td class="text-end">$<%= dinero(pago.monto_equivalente_local) %></td>
                                                                <td><small><%= pago.referencia_transaccion || '—' %></small></td>
                                                                <td><small><%= pago.fecha || '—' %></small></td>
                                                            </tr>
                                                            <% }) %>
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <% } %>
                                            </div>
                                            <div class="col-12 col-lg-5">
                                                <h6 class="fw-bold text-uppercase mb-2" style="font-size:.72rem; letter-spacing:.5px;">
                                                    <i class="fa-solid fa-receipt me-1 text-secondary"></i>Composición de la cuenta
                                                </h6>
                                                <table class="table table-sm bg-white tabla-items mb-0">
                                                    <tbody>
                                                        <tr><td>Subtotal</td><td class="text-end">$<%= dinero(pedido.subtotal) %></td></tr>
                                                        <tr><td>Descuento</td><td class="text-end text-danger">-$<%= dinero(pedido.descuento) %></td></tr>
                                                        <tr><td>Impuesto</td><td class="text-end">$<%= dinero(pedido.impuesto) %></td></tr>
                                                        <tr class="fw-bold"><td>Total</td><td class="text-end">$<%= dinero(pedido.total) %></td></tr>
                                                        <tr><td>Propina (excedente)</td><td class="text-end text-warning fw-semibold">$<%= dinero(pedido.propina) %></td></tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- ═══════════ PAGINACIÓN ═══════════ -->
                <% if (resultado.paginas > 1) { %>
                <nav class="paginacion-ventas d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 no-print" aria-label="Paginación de pedidos">
                    <small class="text-muted">Página <%= resultado.pagina %> de <%= resultado.paginas %> · <%= resultado.total %> pedidos</small>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item <%= resultado.pagina <= 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="/admin/pedidos?<%= qs({ pagina: resultado.pagina - 1 }) %>">Anterior</a>
                        </li>
                        <% for (let n = Math.max(1, resultado.pagina - 2); n <= Math.min(resultado.paginas, resultado.pagina + 2); n++) { %>
                            <li class="page-item <%= n === resultado.pagina ? 'active' : '' %>">
                                <a class="page-link" href="/admin/pedidos?<%= qs({ pagina: n }) %>"><%= n %></a>
                            </li>
                        <% } %>
                        <li class="page-item <%= resultado.pagina >= resultado.paginas ? 'disabled' : '' %>">
                            <a class="page-link" href="/admin/pedidos?<%= qs({ pagina: resultado.pagina + 1 }) %>">Siguiente</a>
                        </li>
                    </ul>
                </nav>
                <% } %>

                <%- include('../includes/footer') %>
            </main>
        </div>
    </div>

    <!-- ═══════════ MODAL: ABRIR SERVICIO ═══════════ -->
    <div class="modal fade" id="modalCrearPedido" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">Abrir Servicio / Orden</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formCrearPedido" action="/admin/pedido/nuevo" method="POST">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small" for="nuevaMesa">Mesa libre</label>
                                <% if ((mesasLibres || []).length === 0) { %>
                                    <p class="text-muted fs-7 mb-0">No hay mesas libres en este momento.</p>
                                <% } else { %>
                                <select class="form-select" id="nuevaMesa" name="id_mesa" required>
                                    <option value="">Seleccione la mesa…</option>
                                    <% mesasLibres.forEach(mesa => { %>
                                        <option value="<%= mesa.id %>">
                                            Mesa <%= mesa.numero %><%= mesa.ubicacion ? ' · ' + mesa.ubicacion : '' %> (<%= mesa.capacidad %> pax)
                                        </option>
                                    <% }) %>
                                </select>
                                <small class="text-muted">El pedido queda asociado al dependiente que lo abre y al turno de servicio activo.</small>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4" <%= (mesasLibres || []).length === 0 ? 'disabled' : '' %>>Iniciar Servicio</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>

    <script>
        // Sin manejadores inline: compatible con la política de seguridad (CSP).
        document.addEventListener('DOMContentLoaded', function () {
            const formFiltros = document.getElementById('formFiltros');
            const inputDesde = document.getElementById('fDesde');
            const inputHasta = document.getElementById('fHasta');

            const iso = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

            // Rangos rápidos: hoy, ayer, últimos 7 días, mes actual
            document.querySelectorAll('[data-rango]').forEach((boton) => {
                boton.addEventListener('click', function () {
                    const rango = this.getAttribute('data-rango');
                    const hoy = new Date();

                    if (rango === 'limpiar') {
                        ['turno_id', 'mesero_id', 'mesa_id', 'q'].forEach((nombre) => {
                            const campo = formFiltros.querySelector(`[name="${nombre}"]`);
                            if (campo) campo.value = '';
                        });
                        const estado = formFiltros.querySelector('[name="estado"]');
                        if (estado) estado.value = 'todas';
                    } else if (rango === 'ayer') {
                        const ayer = new Date(hoy.getTime() - 86400000);
                        inputDesde.value = iso(ayer);
                        inputHasta.value = iso(ayer);
                    } else if (rango === '7') {
                        inputDesde.value = iso(new Date(hoy.getTime() - 6 * 86400000));
                        inputHasta.value = iso(hoy);
                    } else if (rango === 'mes') {
                        inputDesde.value = iso(new Date(hoy.getFullYear(), hoy.getMonth(), 1));
                        inputHasta.value = iso(hoy);
                    } else {
                        inputDesde.value = iso(hoy);
                        inputHasta.value = iso(hoy);
                    }
                    formFiltros.submit();
                });
            });

            // Desglose de ítems: clic en la fila o en el chevron
            const alternar = (fila) => {
                const detalle = document.getElementById(fila.getAttribute('data-detalle'));
                if (!detalle) return;
                const abierto = fila.classList.toggle('abierta');
                detalle.classList.toggle('oculta', !abierto);
            };
            document.querySelectorAll('.fila-pedido').forEach((fila) => {
                fila.addEventListener('click', (evento) => {
                    if (evento.target.closest('a, button')) return;
                    alternar(fila);
                });
            });

            const btnExpandir = document.getElementById('btnExpandirTodo');
            if (btnExpandir) {
                btnExpandir.addEventListener('click', function () {
                    const filas = Array.from(document.querySelectorAll('.fila-pedido'));
                    const hayCerradas = filas.some((f) => !f.classList.contains('abierta'));
                    filas.forEach((fila) => {
                        const detalle = document.getElementById(fila.getAttribute('data-detalle'));
                        if (!detalle) return;
                        fila.classList.toggle('abierta', hayCerradas);
                        detalle.classList.toggle('oculta', !hayCerradas);
                    });
                    this.innerHTML = hayCerradas
                        ? '<i class="fa-solid fa-angles-up text-secondary me-1"></i>Contraer todo'
                        : '<i class="fa-solid fa-angles-down text-secondary me-1"></i>Expandir todo';
                });
            }

            const btnImprimir = document.getElementById('btnImprimir');
            if (btnImprimir) btnImprimir.addEventListener('click', () => window.print());

            // Anulación total del pedido (solo órdenes abiertas)
            document.querySelectorAll('.btn-anular').forEach((boton) => {
                boton.addEventListener('click', function (evento) {
                    evento.stopPropagation();
                    anularPedido(this.getAttribute('data-id'));
                });
            });

            const modalCrear = document.getElementById('modalCrearPedido');
            if (modalCrear) {
                modalCrear.addEventListener('hidden.bs.modal', () => {
                    document.getElementById('formCrearPedido').reset();
                });
            }
        });

        function anularPedido(idPedido) {
            Swal.fire({
                title: '¿Anular Pedido #' + idPedido + ' por Completo?',
                text: 'Se procederá a dar de baja toda la orden. Escriba la justificación:',
                input: 'textarea',
                inputPlaceholder: 'Motivo de la cancelación total obligatoria...',
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Confirmar Anulación',
                cancelButtonText: 'Volver',
                preConfirm: (text) => {
                    const motivo = String(text || '').trim();
                    // El servidor exige entre 5 y 500 caracteres (middlewares/validator.js).
                    if (motivo.length < 5) Swal.showValidationMessage('Indique un motivo de al menos 5 caracteres para la auditoría.');
                    return motivo;
                }
            }).then(async (result) => {
                if (!result.isConfirmed) return;
                Swal.fire({ title: 'Anulando orden...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                try {
                    const res = await fetch(`/admin/pedido/${idPedido}/cancelar-parcial-o-total`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({ productosAfectados: [], motivo: result.value })
                    });
                    const data = await res.json();
                    if (data.success) {
                        Swal.fire('Pedido Anulado', 'La mesa ha sido liberada.', 'success')
                            .then(() => { window.location.reload(); });
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                } catch (err) {
                    Swal.fire('Error', 'Fallo en la comunicación con el servidor.', 'error');
                }
            });
        }
    </script>
</body>
</html>
