<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ventas / Pedidos - Restaurante Bahía</title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .row-detalle { display: none; }
        .row-detalle.abierta { display: table-row; }
        .btn-chevron { transition: transform .2s; }
        .btn-chevron.girado { transform: rotate(90deg); }
        .hms { font-variant-numeric: tabular-nums; font-family: ui-monospace, 'Courier New', monospace; font-size: 0.78rem; }
        .estado-pill { font-size: 0.68rem; letter-spacing: .3px; }
    </style>
</head>
<body>
    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>

            <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">
                <%- include('../includes/header', {encabezado_pagina: 'Ventas / Pedidos', desc_pagina: 'Reporte de pedidos por rango de fechas: comandas, tiempos de entrega, elaboradores e importes desglosados por moneda.', add_btn: true, btn_label: "Crear Orden", modal: "modalCrearPedido"}) %>

                <!-- ======================= FILTROS ======================= -->
                <form method="get" action="/admin/pedidos" class="card card-custom shadow-sm border-0 mb-4">
                    <div class="card-body py-3">
                        <div class="row g-2 align-items-end">
                            <div class="col-6 col-md-2">
                                <label class="form-label fw-semibold small text-secondary mb-1">Desde</label>
                                <input type="date" name="desde" class="form-control form-control-sm" value="<%= filtros.desde %>" max="<%= filtros.hasta %>">
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label fw-semibold small text-secondary mb-1">Hasta</label>
                                <input type="date" name="hasta" class="form-control form-control-sm" value="<%= filtros.hasta %>" min="<%= filtros.desde %>">
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label fw-semibold small text-secondary mb-1">Turno</label>
                                <select name="turno" class="form-select form-select-sm">
                                    <option value="">Todos</option>
                                    <% turnos.forEach(t => { %>
                                        <option value="<%= t.id %>" <%= String(filtros.turno) === String(t.id) ? 'selected' : '' %>>T<%= t.id %> · <%= t.estado === 'abierto' ? 'Abierto' : 'Cerrado' %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label fw-semibold small text-secondary mb-1">Estado</label>
                                <select name="estado" class="form-select form-select-sm">
                                    <option value="todos" <%= filtros.estado === 'todos' ? 'selected' : '' %>>Todos</option>
                                    <option value="curso" <%= filtros.estado === 'curso' ? 'selected' : '' %>>En curso</option>
                                    <option value="cobrados" <%= filtros.estado === 'cobrados' ? 'selected' : '' %>>Cobrados</option>
                                    <option value="cancelados" <%= filtros.estado === 'cancelados' ? 'selected' : '' %>>Cancelados</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-4 d-flex gap-2 justify-content-md-end">
                                <button type="submit" class="btn btn-dark btn-sm fw-semibold px-3 flex-grow-1 flex-md-grow-0">
                                    <i class="fa-solid fa-filter me-1"></i> Aplicar
                                </button>
                                <a href="/admin/pedidos" class="btn btn-outline-secondary btn-sm fw-semibold px-3">Hoy</a>
                            </div>
                        </div>
                    </div>
                </form>

                <!-- ======================= KPIs ======================= -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-lg-2">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Pedidos</h6>
                            <h3 class="fw-bold mb-0 text-dark"><%= kpis.total %></h3>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-success border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Ventas Cobradas</h6>
                            <h3 class="fw-bold mb-0 text-success">$<%= kpis.ventas.toFixed(2) %></h3>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-warning border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">En Curso</h6>
                            <h3 class="fw-bold mb-0 text-warning"><%= kpis.en_curso %> <small class="fs-7">($<%= kpis.en_curso_importe.toFixed(2) %>)</small></h3>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-info border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Ticket Promedio</h6>
                            <h3 class="fw-bold mb-0 text-info">$<%= kpis.ticket_promedio.toFixed(2) %></h3>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-secondary border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Propinas</h6>
                            <h3 class="fw-bold mb-0 text-secondary">$<%= kpis.propinas.toFixed(2) %></h3>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-danger border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Cancelados</h6>
                            <h3 class="fw-bold mb-0 text-danger"><%= kpis.cancelados %></h3>
                        </div>
                    </div>
                </div>

                <!-- ======================= TABLA ======================= -->
                <div class="flex-grow-1 my-3">
                    <div class="card card-custom shadow-sm border-0 overflow-hidden">
                        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                            <span class="fw-bold"><i class="fa-solid fa-receipt me-2 text-secondary"></i>Comandas del rango <%= filtros.desde %> → <%= filtros.hasta %></span>
                            <span class="text-muted small"><%= lista.length %> pedido(s)</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-custom-thead text-uppercase fs-7">
                                    <tr>
                                        <th style="width:34px"></th>
                                        <th>Pedido</th>
                                        <th>Mesa</th>
                                        <th>Turno</th>
                                        <th>Dependiente</th>
                                        <th>Apertura / Cierre</th>
                                        <th class="text-center">Duración</th>
                                        <th class="text-center">Ítems</th>
                                        <th>Importe (monedas)</th>
                                        <th>Estado</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                <% if (lista.length === 0) { %>
                                    <tr><td colspan="11" class="text-center text-muted py-5"><i class="fa-solid fa-mug-hot fs-1 d-block mb-2 text-secondary"></i>No hay pedidos en el rango seleccionado.</td></tr>
                                <% } %>
                                <% 
                                   const hms = (seg) => {
                                       if (seg === null || seg === undefined || isNaN(Number(seg))) return '—';
                                       const s = Math.max(0, Math.floor(Number(seg)));
                                       const h = Math.floor(s/3600), m = Math.floor((s%3600)/60), x = s%60;
                                       return (h > 0 ? h + 'h ' : '') + String(m).padStart(2,'0') + 'm ' + String(x).padStart(2,'0') + 's';
                                   };
                                   const fmtHora = (f) => f ? new Date(f).toLocaleTimeString('es-ES', { hour:'2-digit', minute:'2-digit' }) : '—';
                                   const badgePago = (ep, ed) => {
                                       if (ed === 'cancelado') return '<span class="badge text-bg-danger estado-pill">ANULADO</span>';
                                       const map = { pagado:['success','COBRADO'], facturado:['dark','FACTURA'], pendiente_pago:['warning','PTDO. PAGO'], cortesia:['info','CORTESÍA'], pendiente:['warning','EN CURSO'] };
                                       const [cls, txt] = map[ep] || ['secondary', String(ep||'—').toUpperCase()];
                                       return `<span class="badge text-bg-${cls} estado-pill">${txt}</span>`;
                                   };
                                %>
                                <% lista.forEach(p => { %>
                                    <tr class="fila-principal" data-pedido="<%= p.id %>">
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-light border btn-chevron" type="button" onclick="toggleDetalle(<%= p.id %>, this)" title="Ver desglose">
                                                <i class="fa-solid fa-chevron-right fs-7"></i>
                                            </button>
                                        </td>
                                        <td class="fw-bold">#<%= p.id %>
                                            <% if (p.comensales) { %><small class="text-muted d-block"><%= p.comensales %> pax</small><% } %>
                                        </td>
                                        <td><span class="fw-semibold"><%= p.mesa_numero || '—' %></span></td>
                                        <td><small>T<%= p.turno_servicio_id || '—' %></small>
                                            <% if (p.turno_estado) { %><small class="d-block text-muted"><%= p.turno_estado === 'abierto' ? 'abierto' : 'cerrado' %></small><% } %>
                                        </td>
                                        <td><small><%= p.mesero || '—' %></small></td>
                                        <td class="hms">
                                            <i class="fa-regular fa-circle-play text-success me-1"></i><%= fmtHora(p.creado_en) %>
                                            <span class="mx-1 text-muted">→</span>
                                            <i class="fa-solid fa-flag-checkered <%= p.fecha_cierre ? 'text-danger' : 'text-muted' %> me-1"></i><%= fmtHora(p.fecha_cierre) %>
                                        </td>
                                        <td class="text-center hms"><%= hms(p.duracion_seg) %></td>
                                        <td class="text-center">
                                            <span class="badge text-bg-light border"><%= p.items_total %> ítems</span>
                                            <% if (Number(p.items_entregados) > 0) { %><small class="text-success d-block"><%= p.items_entregados %> entregados</small><% } %>
                                            <% if (Number(p.items_cancelados) > 0) { %><small class="text-danger d-block"><%= p.items_cancelados %> cancelados</small><% } %>
                                        </td>
                                        <td>
                                            <span class="fw-bold">$<%= parseFloat(p.total || 0).toFixed(2) %></span>
                                            <% const pgs = pagosPorPedido[p.id] || []; %>
                                            <% if (pgs.length) { %>
                                                <small class="d-block text-muted">
                                                    <% pgs.forEach((g, i) => { %><%= i > 0 ? ' · ' : '' %><%= (g.simbolo || '$') + parseFloat(g.monto).toFixed(2) + ' ' + (g.codigo || '') %><% }) %>
                                                </small>
                                                <small class="text-muted fst-italic"><%= pgs.map(g => g.metodos).join(' / ') %></small>
                                            <% } else if (p.estado_pago !== 'cancelado') { %>
                                                <small class="text-warning d-block">sin pagos registrados</small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <%- badgePago(p.estado_pago, p.estado_pedido) %>
                                            <% if (Number(p.propina) > 0) { %><small class="d-block text-muted">propina $<%= parseFloat(p.propina).toFixed(2) %></small><% } %>
                                            <% if (Number(p.excedente_cobro) > 0) { %><small class="d-block text-warning">excedente $<%= parseFloat(p.excedente_cobro).toFixed(2) %></small><% } %>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <a href="/admin/pedido/<%= p.id %>?desde=<%= filtros.desde %>&hasta=<%= filtros.hasta %><% if (filtros.turno) { %>&turno=<%= filtros.turno %><% } %>&estado=<%= filtros.estado %>" class="btn btn-light border" title="Detalle completo"><i class="fa-solid fa-eye text-secondary"></i></a>
                                                <% if (typeof user !== 'undefined' && user && ['superadministrador', 'administrador', 'cajero'].includes(user.rol) && p.estado_pago === 'pendiente' && p.estado_pedido !== 'cancelado') { %>
                                                    <button class="btn btn-light border" onclick="cancelarPedidoInmediato(<%= p.id %>)" title="Anular pedido"><i class="fa-solid fa-ban text-danger"></i></button>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr class="row-detalle bg-light" id="detalle-<%= p.id %>">
                                        <td colspan="11" class="p-0">
                                            <div class="row g-0">
                                                <div class="col-lg-7 p-3">
                                                    <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-utensils me-1"></i>Desglose de ítems</h6>
                                                    <div class="table-responsive">
                                                        <table class="table table-sm table-bordered bg-white mb-2 fs-7">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>Cant</th><th>Producto</th><th>Estado</th>
                                                                    <th class="text-center">Entrega</th><th>Elaboró</th><th class="text-end">Importe</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                            <% (itemsPorPedido[p.id] || []).forEach(it => { %>
                                                                <tr class="<%= it.estado_item === 'cancelado' ? 'table-danger' : '' %>">
                                                                    <td class="fw-bold"><%= it.cantidad %></td>
                                                                    <td><%= it.nombre %><% if (it.notas_especiales) { %><small class="d-block text-muted fst-italic"><%= it.notas_especiales %></small><% } %></td>
                                                                    <td>
                                                                        <% const estCls = { entregado:'success', cancelado:'danger', listo:'info', en_cocina:'warning', en_bar:'warning', en_espera:'secondary' }[it.estado_item] || 'secondary'; %>
                                                                        <span class="badge text-bg-<%= estCls %> estado-pill"><%= it.estado_item.replace('_',' ') %></span>
                                                                    </td>
                                                                    <td class="text-center hms"><%= it.estado_item === 'entregado' ? hms(it.entrega_seg) : '—' %></td>
                                                                    <td><small><%= it.cocinero || '—' %></small></td>
                                                                    <td class="text-end <%= it.estado_item === 'cancelado' ? 'text-decoration-line-through text-muted' : 'fw-semibold' %>">$<%= (parseFloat(it.precio_unitario) * it.cantidad).toFixed(2) %></td>
                                                                </tr>
                                                            <% }) %>
                                                            <% if (!(itemsPorPedido[p.id] || []).length) { %>
                                                                <tr><td colspan="6" class="text-center text-muted">Sin ítems</td></tr>
                                                            <% } %>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                                <div class="col-lg-5 p-3 border-start">
                                                    <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-coins me-1"></i>Importes y auditoría</h6>
                                                    <table class="table table-sm mb-0 fs-7">
                                                        <tbody>
                                                            <tr><td class="text-muted">Subtotal</td><td class="text-end">$<%= parseFloat(p.subtotal || 0).toFixed(2) %></td></tr>
                                                            <% if (Number(p.descuento) > 0) { %><tr><td class="text-muted">Descuento</td><td class="text-end text-danger">-$<%= parseFloat(p.descuento).toFixed(2) %></td></tr><% } %>
                                                            <% if (Number(p.impuesto) > 0) { %><tr><td class="text-muted">Impuesto</td><td class="text-end">$<%= parseFloat(p.impuesto).toFixed(2) %></td></tr><% } %>
                                                            <% if (Number(p.propina) > 0) { %><tr><td class="text-muted">Propina</td><td class="text-end">$<%= parseFloat(p.propina).toFixed(2) %></td></tr><% } %>
                                                            <tr class="table-light"><td class="fw-bold">TOTAL</td><td class="text-end fw-bold">$<%= parseFloat(p.total || 0).toFixed(2) %></td></tr>
                                                            <% (pagosPorPedido[p.id] || []).forEach(g => { %>
                                                                <tr><td class="text-muted">Pago (<%= (g.metodos || '').toUpperCase() %>)</td><td class="text-end fw-semibold"><%= (g.simbolo || '$') %> <%= parseFloat(g.monto).toFixed(2) %> <%= g.codigo || '' %></td></tr>
                                                            <% }) %>
                                                            <tr><td class="text-muted">Cajero</td><td class="text-end"><small><%= p.cajero || '—' %></small></td></tr>
                                                            <tr><td class="text-muted">Duración del servicio</td><td class="text-end hms"><%= hms(p.duracion_seg) %></td></tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <% if (lista.length > 0) { %>
                        <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
                            <span class="small text-muted">Toca <i class="fa-solid fa-chevron-right fs-7"></i> para desglosar ítems, tiempos de entrega y pagos por moneda.</span>
                            <span class="fw-bold">Total rango: <span class="text-success">$<%= lista.reduce((a, p) => a + (p.estado_pedido === 'cancelado' ? 0 : parseFloat(p.total || 0)), 0).toFixed(2) %></span></span>
                        </div>
                        <% } %>
                    </div>
                </div>

                <%- include('../includes/footer') %>
            </main>
        </div>
    </div>

    <div class="modal fade" id="modalCrearPedido" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">Abrir Servicio / Orden</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formCrearPedido" action="/pedido/nuevo" method="POST">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold text-secondary small">Mesa (Nº / ID)</label>
                                <input type="number" name="id_mesa" class="form-control" placeholder="Ej. 5" min="1" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold text-secondary small">Personas</label>
                                <input type="number" name="comensales" class="form-control" value="1" min="1" max="50" required>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4">Iniciar Servicio</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>

    <script>
        function toggleDetalle(idPedido, btn) {
            const fila = document.getElementById('detalle-' + idPedido);
            const icono = btn.querySelector('i');
            fila.classList.toggle('abierta');
            btn.classList.toggle('girado');
        }

        document.addEventListener("DOMContentLoaded", function() {
            const modalCrear = document.getElementById('modalCrearPedido');
            if (modalCrear) {
                modalCrear.addEventListener('hidden.bs.modal', () => {
                    document.getElementById('formCrearPedido').reset();
                });
            }
        });

        function cancelarPedidoInmediato(idPedido) {
            Swal.fire({
                title: '¿Anular Pedido #' + idPedido + ' por Completo?',
                text: 'Se procederá a dar de baja toda la orden. Escriba la justificación:',
                input: 'textarea',
                inputPlaceholder: 'Motivo de la cancelación total obligatoria...',
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Confirmar Anulación',
                cancelButtonText: 'Volver',
                preConfirm: (text) => {
                    if (!text) Swal.showValidationMessage('Debe indicar un motivo para la auditoría.');
                    return text;
                }
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Anulando orden...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                    try {
                        const res = await fetch(`/pedido/${idPedido}/cancelar-parcial-o-total`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                            body: JSON.stringify({ productosAfectados: [], motivo: result.value })
                        });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire('Pedido Anulado', 'La mesa ha sido liberada.', 'success').then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    } catch (err) {
                        Swal.fire('Error', 'Fallo en la comunicación con el servidor.', 'error');
                    }
                }
            });
        }
    </script>
</body>
</html>
