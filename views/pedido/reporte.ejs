<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reporte de Pedido #<%= datos.pedido.id %> - Restaurante Bahía</title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .hms { font-variant-numeric: tabular-nums; font-family: ui-monospace, 'Courier New', monospace; font-size: 0.8rem; }
        .estado-pill { font-size: 0.68rem; letter-spacing: .3px; }
        .timeline { position: relative; padding-left: 1.4rem; }
        .timeline::before { content: ''; position: absolute; left: 6px; top: 4px; bottom: 4px; width: 2px; background: #d1d5db; border-radius: 2px; }
        .timeline .evento { position: relative; padding: 0 0 .9rem .8rem; }
        .timeline .evento::before { content: ''; position: absolute; left: -1.4rem; top: 4px; width: 12px; height: 12px; border-radius: 50%; background: #696b6d; border: 2px solid #fff; box-shadow: 0 0 0 2px #696b6d; }
        @media print {
            .no-print { display: none !important; }
            body { background: #fff; }
            main { width: 100% !important; max-width: 100% !important; margin: 0 !important; }
        }
    </style>
</head>
<body class="bg-light">
    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>

            <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">

                <%- include('../includes/header', {encabezado_pagina: 'Reporte de Pedido #' + datos.pedido.id, desc_pagina: 'Información completa de la comanda: servicio, ítems, tiempos, elaboradores, pagos y auditoría.', add_btn: false}) %>

                <div class="d-flex justify-content-end gap-2 mb-3 no-print flex-wrap">
                    <a href="/admin/pedidos?<%- filtros.queryString %>" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                        <i class="fa-solid fa-arrow-left text-secondary me-1"></i> Volver al listado
                    </a>
                    <% if (!datos.pedido.fecha_cierre) { %>
                    <a href="/pos/<%= datos.pedido.id %>?vista=1" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark" title="Modo visualización administrativa (igual que POS mesero)">
                        <i class="fa-solid fa-cash-register text-secondary me-1"></i> Abrir en POS
                    </a>
                    <% } %>
                    <a href="/pos/precuenta/<%= datos.pedido.id %>?retorno=pedido" target="_blank" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                        <i class="fa-solid fa-receipt text-secondary me-1"></i> Pre-cuenta
                    </a>
                    <button onclick="window.print()" class="btn btn-dark btn-sm fw-semibold shadow-sm py-2">
                        <i class="fa-solid fa-print me-1"></i> Imprimir reporte
                    </button>
                </div>

                <%
                   const P = datos.pedido;
                   const hms = (seg) => {
                       if (seg === null || seg === undefined || isNaN(Number(seg)) || Number(seg) < 0) return '—';
                       const t = Math.floor(Number(seg));
                       const h = Math.floor(t/3600), m = Math.floor((t%3600)/60), x = t%60;
                       return (h > 0 ? h + 'h ' : '') + String(m).padStart(2,'0') + 'm ' + String(x).padStart(2,'0') + 's';
                   };
                   const fHora = (f) => f ? new Date(f).toLocaleTimeString('es-ES', { hour:'2-digit', minute:'2-digit', second:'2-digit' }) : '—';
                   const fFecha = (f) => f ? new Date(f).toLocaleString('es-ES', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) : '—';
                   const badgePago = (ep, ed) => {
                       if (ed === 'cancelado') return '<span class="badge text-bg-danger estado-pill">ANULADO</span>';
                       const map = { pagado:['success','COBRADO'], facturado:['dark','FACTURA'], pendiente_pago:['warning','PTDO. PAGO'], cortesia:['info','CORTESÍA'], pendiente:['warning','EN CURSO'] };
                       const par = map[ep] || ['secondary', String(ep||'—').toUpperCase()];
                       return `<span class="badge text-bg-${par[0]} estado-pill">${par[1]}</span>`;
                   };
                   const badgeItem = (e) => {
                       const cls = { entregado:'success', cancelado:'danger', listo:'info', en_cocina:'warning', en_bar:'warning', en_espera:'secondary' }[e] || 'secondary';
                       return `<span class="badge text-bg-${cls} estado-pill">${String(e||'—').replace('_',' ')}</span>`;
                   };
                %>

                <!-- ====== Cabecera del pedido ====== -->
                <div class="card border-0 shadow-sm rounded bg-white mb-4">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div>
                                <h3 class="fw-bold mb-1">Pedido #<%= P.id %> <%- badgePago(P.estado_pago, P.estado_pedido) %></h3>
                                <div class="text-muted">
                                    <i class="fa-solid fa-table me-1"></i><%= P.mesa_numero || ('Mesa ' + P.id_mesa) %>
                                    <% if (P.mesa_ubicacion) { %> <span class="mx-1">·</span> <%= P.mesa_ubicacion %> <% } %>
                                    <% if (P.mesa_capacidad) { %> <span class="mx-1">·</span> cap. <%= P.mesa_capacidad %> <% } %>
                                    <span class="mx-1">·</span> <i class="fa-solid fa-user-group me-1"></i><%= P.comensales || 1 %> pax
                                    <% if (P.cliente_nombre) { %> <span class="mx-1">·</span> <i class="fa-solid fa-user me-1"></i><%= P.cliente_nombre %> <% } %>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fs-4 fw-bold text-success">$<%= parseFloat(P.total || 0).toFixed(2) %></div>
                                <small class="text-muted">Turno #<%= P.turno_servicio_id || '—' %> (<%= P.turno_estado === 'abierto' ? 'abierto' : 'cerrado' %>)</small>
                            </div>
                        </div>
                        <hr class="my-3">
                        <div class="row g-3 small">
                            <div class="col-6 col-md-3"><span class="text-muted d-block">Dependiente</span><strong><%= P.mesero || '—' %></strong></div>
                            <div class="col-6 col-md-3"><span class="text-muted d-block">Cajero</span><strong><%= P.cajero || '—' %></strong></div>
                            <div class="col-6 col-md-3"><span class="text-muted d-block">Cocinero de turno</span><strong><%= P.cocinero_turno || '— (turno sin cocinero)' %></strong></div>
                            <div class="col-6 col-md-3"><span class="text-muted d-block">Apertura</span><strong class="hms"><%= fFecha(P.creado_en) %></strong></div>
                            <div class="col-6 col-md-3"><span class="text-muted d-block">Cierre</span><strong class="hms"><%= fFecha(P.fecha_cierre) %></strong></div>
                            <div class="col-6 col-md-3"><span class="text-muted d-block">Duración del servicio</span><strong class="hms"><%= hms(P.duracion_seg) %></strong></div>
                            <div class="col-6 col-md-3"><span class="text-muted d-block">Pre-cuenta</span><strong><%= P.impresiones_precuenta || 0 %> impresión(es)</strong><% if (P.fecha_precuenta) { %><small class="text-muted d-block hms"><%= fFecha(P.fecha_precuenta) %></small><% } %></div>
                            <div class="col-6 col-md-3"><span class="text-muted d-block">Última actualización</span><strong class="hms"><%= fFecha(P.actualizado_en) %></strong></div>
                            <div class="col-6 col-md-3"><span class="text-muted d-block">Estado del pedido</span><strong class="text-uppercase"><%= P.estado_pedido %></strong></div>
                        </div>
                    </div>
                </div>

                <!-- ====== KPIs de ítems ====== -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-lg-2"><div class="card border-0 shadow-sm rounded p-3 bg-white"><h6 class="text-muted fw-semibold mb-1 fs-7">Ítems</h6><h4 class="fw-bold mb-0"><%= datos.kpis.items_total %></h4></div></div>
                    <div class="col-6 col-lg-2"><div class="card border-0 shadow-sm rounded p-3 bg-white border-start border-success border-4"><h6 class="text-muted fw-semibold mb-1 fs-7">Entregados</h6><h4 class="fw-bold mb-0 text-success"><%= datos.kpis.entregados %></h4></div></div>
                    <div class="col-6 col-lg-2"><div class="card border-0 shadow-sm rounded p-3 bg-white border-start border-warning border-4"><h6 class="text-muted fw-semibold mb-1 fs-7">En proceso</h6><h4 class="fw-bold mb-0 text-warning"><%= datos.kpis.en_proceso %></h4></div></div>
                    <div class="col-6 col-lg-2"><div class="card border-0 shadow-sm rounded p-3 bg-white border-start border-danger border-4"><h6 class="text-muted fw-semibold mb-1 fs-7">Cancelados</h6><h4 class="fw-bold mb-0 text-danger"><%= datos.kpis.cancelados %></h4><% if (datos.kpis.importe_cancelado > 0) { %><small class="text-muted">-$<%= datos.kpis.importe_cancelado.toFixed(2) %></small><% } %></div></div>
                    <div class="col-6 col-lg-2"><div class="card border-0 shadow-sm rounded p-3 bg-white border-start border-info border-4"><h6 class="text-muted fw-semibold mb-1 fs-7">Entrega media</h6><h4 class="fw-bold mb-0 text-info hms"><%= hms(datos.kpis.entrega_media_seg) %></h4></div></div>
                    <div class="col-6 col-lg-2"><div class="card border-0 shadow-sm rounded p-3 bg-white border-start border-secondary border-4"><h6 class="text-muted fw-semibold mb-1 fs-7">Entrega más lenta</h6><h4 class="fw-bold mb-0 text-secondary hms"><%= hms(datos.kpis.entrega_max_seg) %></h4></div></div>
                </div>

                <div class="row g-4">
                    <!-- ====== Ítems ====== -->
                    <div class="col-12 col-xl-8">
                        <div class="card border-0 shadow-sm rounded bg-white h-100">
                            <div class="card-header bg-white border-bottom pt-3 fw-bold"><i class="fa-solid fa-utensils me-2 text-secondary"></i>Desglose de ítems</div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light fs-7 text-uppercase text-secondary">
                                        <tr>
                                            <th>Pedido</th><th class="text-center">Cant</th><th>Producto</th>
                                            <th class="text-center">Estado</th><th class="text-center">Hora</th>
                                            <th class="text-center">Entrega</th><th>Elaboró</th><th class="text-end">P. Unit.</th><th class="text-end">Importe</th>
                                        </tr>
                                    </thead>
                                    <tbody class="fs-7">
                                    <% datos.items.forEach(it => { %>
                                        <tr class="<%= it.estado_item === 'cancelado' ? 'table-danger' : '' %>">
                                            <td class="hms"><%= fHora(it.creado_en) %></td>
                                            <td class="text-center fw-bold"><%= it.cantidad %></td>
                                            <td>
                                                <%= it.nombre %>
                                                <% if (it.es_platillo_dia == 1) { %><span class="badge text-bg-dark ms-1 estado-pill">DÍA</span><% } %>
                                                <% if (it.modificadores) { %><small class="d-block text-muted fst-italic"><i class="fa-solid fa-plus-minus me-1"></i><%= it.modificadores %></small><% } %>
                                                <% if (it.notas_especiales) { %><small class="d-block text-muted"><%= it.notas_especiales %></small><% } %>
                                            </td>
                                            <td class="text-center"><%- badgeItem(it.estado_item) %></td>
                                            <td class="text-center hms"><%= fHora(it.creado_en) %></td>
                                            <td class="text-center hms"><%= it.estado_item === 'entregado' ? hms(it.entrega_seg) : '—' %></td>
                                            <td><small><%= it.cocinero || '—' %></small></td>
                                            <td class="text-end">$<%= parseFloat(it.precio_unitario).toFixed(2) %></td>
                                            <td class="text-end fw-semibold <%= it.estado_item === 'cancelado' ? 'text-decoration-line-through text-muted' : '' %>">$<%= (parseFloat(it.precio_unitario) * it.cantidad).toFixed(2) %></td>
                                        </tr>
                                    <% }) %>
                                    <% if (!datos.items.length) { %>
                                        <tr><td colspan="9" class="text-center text-muted py-4">El pedido aún no tiene ítems registrados (orden en captura).</td></tr>
                                    <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- ====== Importes / Pagos / Timeline ====== -->
                    <div class="col-12 col-xl-4 d-flex flex-column gap-4">
                        <div class="card border-0 shadow-sm rounded bg-white">
                            <div class="card-header bg-white border-bottom pt-3 fw-bold"><i class="fa-solid fa-coins me-2 text-secondary"></i>Importes</div>
                            <div class="card-body py-2">
                                <table class="table table-sm mb-0">
                                    <tbody>
                                        <tr><td class="text-muted">Subtotal</td><td class="text-end">$<%= parseFloat(P.subtotal || 0).toFixed(2) %></td></tr>
                                        <% if (Number(P.descuento) > 0) { %><tr><td class="text-muted">Descuento</td><td class="text-end text-danger">-$<%= parseFloat(P.descuento).toFixed(2) %></td></tr><% } %>
                                        <% if (Number(P.impuesto) > 0) { %><tr><td class="text-muted">Impuesto</td><td class="text-end">$<%= parseFloat(P.impuesto).toFixed(2) %></td></tr><% } %>
                                        <% if (Number(P.propina) > 0) { %><tr><td class="text-muted">Propina</td><td class="text-end">$<%= parseFloat(P.propina).toFixed(2) %></td></tr><% } %>
                                        <% if (Number(P.excedente_cobro) > 0) { %><tr><td class="text-warning">Excedente de cobro</td><td class="text-end text-warning">$<%= parseFloat(P.excedente_cobro).toFixed(2) %></td></tr><% } %>
                                        <tr class="table-light"><td class="fw-bold">TOTAL</td><td class="text-end fw-bold text-success">$<%= parseFloat(P.total || 0).toFixed(2) %></td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm rounded bg-white">
                            <div class="card-header bg-white border-bottom pt-3 fw-bold"><i class="fa-solid fa-money-bill-wave me-2 text-secondary"></i>Pagos</div>
                            <div class="card-body py-2">
                            <% if (datos.pagos.length) { %>
                                <table class="table table-sm mb-0 fs-7">
                                    <thead class="table-light"><tr><th>Método</th><th>Moneda</th><th class="text-end">Monto</th><th class="text-end">Equiv. local</th></tr></thead>
                                    <tbody>
                                    <% datos.pagos.forEach(g => { %>
                                        <tr>
                                            <td class="text-uppercase"><%= g.metodo_pago %><% if (g.referencia_transaccion) { %><small class="d-block text-muted"><%= g.referencia_transaccion %></small><% } %></td>
                                            <td><%= g.moneda_codigo || '—' %><small class="d-block text-muted">t.c. <%= parseFloat(g.factor_cambio_aplicado).toFixed(2) %></small></td>
                                            <td class="text-end fw-semibold"><%= g.moneda_simbolo || '$' %> <%= parseFloat(g.monto_moneda_origen).toFixed(2) %></td>
                                            <td class="text-end">$<%= parseFloat(g.monto_equivalente_local).toFixed(2) %></td>
                                        </tr>
                                    <% }) %>
                                    </tbody>
                                </table>
                            <% } else { %>
                                <p class="text-muted mb-0 small"><i class="fa-solid fa-hourglass-half me-1"></i>Sin pagos registrados todavía.</p>
                            <% } %>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm rounded bg-white mb-auto">
                            <div class="card-header bg-white border-bottom pt-3 fw-bold"><i class="fa-solid fa-timeline me-2 text-secondary"></i>Línea de tiempo</div>
                            <div class="card-body">
                                <div class="timeline">
                                <% datos.eventos.forEach(ev => { %>
                                    <div class="evento">
                                        <div class="fw-semibold small"><%= ev.titulo %></div>
                                        <div class="text-muted hms"><%= fFecha(ev.t) %><% if (ev.detalle) { %> — <%= ev.detalle %><% } %></div>
                                    </div>
                                <% }) %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>
