<div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-start align-items-sm-center gap-3 mb-4 pb-3 border-bottom content-header-responsive">
    
    <!-- CAMBIO: se quitó el botón hamburguesa raw-sidebar-toggle, ya que la barra superior sticky ya cubre esa función en móvil -->
    <div class="header-title-block text-truncate w-100 w-sm-auto">
        <h1 class="h3 md-h2 fw-bold text-dark m-0 text-truncate">
            <% if(typeof encabezado_pagina !== 'undefined' && encabezado_pagina !== null){%><%- encabezado_pagina %><%}%>
        </h1>
        <p class="text-muted small mb-0">
            <% if(typeof desc_pagina !== 'undefined' && desc_pagina !== null){%><%- desc_pagina %><%}%>
        </p>
    </div>
    
    <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center justify-content-sm-end gap-2 w-100 w-sm-auto structural-actions-block">
        <% if (user.rol === 'superadministrador' || user.rol === 'administrador') { %>
            <% if (typeof add_btn !== 'undefined' && add_btn) { %>
                <button class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 d-flex align-items-center justify-content-center gap-1 text-dark flex-shrink-0" data-bs-toggle="modal" data-bs-target="<% if(typeof modal !== 'undefined' && modal){%>#<%- modal %><% } else { %>#modalWindow<% } %>">
                    <i class="fa-solid fa-plus text-secondary"></i> <span><% if(btn_label !== 'undefined' && btn_label){%><%- btn_label %><%} else {%>Agregar Elemento<%}%></span>
                </button>
            <% } else if(typeof warehouse_menu !== 'undefined' && warehouse_menu) { %>
                <div class="flex-shrink-0">
                    <%- include('../includes/menuAccionesAlmacen') %>
                </div>
            <% } %>
        <% } %>
        
        <div class="dropdown custom-nav-profile align-self-end align-self-sm-auto">
            <button class="btn btn-white border shadow-sm fw-semibold btn-sm p-0 d-flex align-items-center text-dark overflow-hidden user-dropdown-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="height: 38px;">
                <div class="d-flex align-items-center gap-2 px-2 px-md-3 h-100">
                    <% if (user && user.foto && user.foto !== 'null') { %>
                        <img src="/uploads/<%= user.foto %>" class="user-avatar-nav rounded-circle" alt="Avatar" style="width: 24px; height: 24px; object-fit: cover;">
                    <% } else { %>
                        <i class="fa-solid fa-user-tie text-secondary"></i>
                    <% } %>
                    <span class="fs-7 fw-semibold d-none d-inline-block text-truncate profile-name-text" style="max-width: 110px;"><%= user ? user.nombre : 'Gestor Activo' %></span>
                </div>
                <div class="border-start h-100" style="border-color: #dee2e6 !important;"></div>
                <div class="bg-dark text-light px-2 px-md-3 h-100 d-flex align-items-center rounded-end align-self-stretch text-uppercase gap-1 gap-md-2" style="background-color: #212529 !important; font-size: 0.65rem; letter-spacing: 0.5px;">
                    <i class="fa-solid fa-shield-halved text-white-50 d-none d-inline-block" style="font-size: 0.80rem;"></i>
                    <span class="fw-bold text-white"><%= user ? user.rol : 'Sin Rol' %></span>
                    <i class="fa-solid fa-chevron-down text-white-50" style="font-size: 0.6rem;"></i>
                </div>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                <li>
                    <button class="dropdown-item p-2 fs-7" type="button" data-bs-toggle="modal" data-bs-target="#modalCambiarPassword">
                        <i class="fa-solid fa-key me-2"></i>Cambiar Contraseña
                    </button>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item p-2 text-danger fs-7" href="/logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Salir</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- MODAL: CAMBIAR CONTRASEÑA -->
<div class="modal fade" id="modalCambiarPassword" tabindex="-1" aria-labelledby="modalCambiarPasswordLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold text-dark fs-5" id="modalCambiarPasswordLabel">
                    <i class="fa-solid fa-key text-secondary me-2"></i>Cambiar Contraseña
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form action="/admin/usuario/cambiar-password" method="POST" id="formCambiarPassword" class="needs-validation" novalidate>
                <div class="modal-body p-4">
                    
                    <!-- Campo: Contraseña Actual -->
                    <div class="mb-3">
                        <label for="passwordActual" class="form-label fw-semibold text-secondary small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Contraseña Actual</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fa-solid fa-lock-open text-muted" style="font-size: 0.85rem;"></i>
                            </span>
                            <input type="password" 
                                   class="form-control border-start-0 fs-7" 
                                   id="passwordActual" 
                                   name="passwordActual" 
                                   placeholder="Introduce tu contraseña actual" 
                                   required>
                            <div class="invalid-feedback">
                                Por favor, introduce tu contraseña actual.
                            </div>
                        </div>
                    </div>

                    <!-- Campo: Nueva Contraseña -->
                    <div class="mb-3">
                        <label for="nuevaPassword" class="form-label fw-semibold text-secondary small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Nueva Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fa-solid fa-lock text-muted" style="font-size: 0.85rem;"></i>
                            </span>
                            <input type="password" 
                                   class="form-control border-start-0 fs-7" 
                                   id="nuevaPassword" 
                                   name="nuevaPassword" 
                                   placeholder="Mínimo 6 caracteres" 
                                   minlength="6"
                                   required>
                            <div class="invalid-feedback">
                                La contraseña nueva debe tener al menos 6 caracteres.
                            </div>
                        </div>
                    </div>

                    <!-- Campo: Confirmar Nueva Contraseña -->
                    <div class="mb-0">
                        <label for="confirmarPassword" class="form-label fw-semibold text-secondary small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Confirmar Nueva Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fa-solid fa-circle-check text-muted" style="font-size: 0.85rem;"></i>
                            </span>
                            <input type="password" 
                                   class="form-control border-start-0 fs-7" 
                                   id="confirmarPassword" 
                                   name="confirmarPassword" 
                                   placeholder="Repite tu nueva contraseña" 
                                   required>
                            <div class="invalid-feedback">
                                Confirma tu nueva contraseña.
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-top bg-light p-3">
                    <button type="button" class="btn btn-white border shadow-sm fw-semibold btn-sm px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary shadow-sm fw-semibold btn-sm px-3">Actualizar Contraseña</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- LÓGICA DE ENVÍO INTEGRADA CON SWEETALERT2 -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('formCambiarPassword');
    const modalElement = document.getElementById('modalCambiarPassword');

    // Al cancelar o cerrar el modal se limpian los campos y los mensajes de validación.
    // Bootstrap se encarga del cierre mediante data-bs-dismiss="modal".
    if (modalElement && form) {
        modalElement.addEventListener('hidden.bs.modal', () => {
            form.reset();
            form.classList.remove('was-validated');
        });
    }
    
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // 1. Activar validación nativa visual de Bootstrap
        if (!this.checkValidity()) {
            this.classList.add('was-validated');
            return;
        }

        const passwordActual = document.getElementById('passwordActual').value;
        const nuevaPassword = document.getElementById('nuevaPassword').value;
        const confirmarPassword = document.getElementById('confirmarPassword').value;

        // 2. Validación de coincidencia local
        if (nuevaPassword !== confirmarPassword) {
            Swal.fire({
                icon: 'warning',
                title: 'Las contraseñas no coinciden',
                text: 'La nueva contraseña y su confirmación deben ser idénticas.',
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        // 3. Envío asíncrono seguro
        try {
            // Mostrar estado de carga
            Swal.fire({
                title: 'Procesando...',
                text: 'Actualizando tus credenciales de acceso.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            const actionUrl = this.getAttribute('action') || '/admin/usuario/cambiar-password';
            const response = await fetch(actionUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    passwordActual,
                    nuevaPassword,
                    confirmarPassword
                })
            });

            const data = await response.json();

            if (response.ok && data.success) {
                // ÉXITO: Contraseña cambiada
                Swal.fire({
                    icon: 'success',
                    title: '¡Contraseña cambiada!',
                    text: data.message,
                    timer: 2500,
                    showConfirmButton: false
                }).then(() => {
                    // Cerrar el modal limpiamente y resetear formulario
                    const modalElement = document.getElementById('modalCambiarPassword');
                    const modalInstance = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
                    modalInstance.hide();
                    form.reset();
                    form.classList.remove('was-validated');
                });
            } else {
                // MANEJO DE ERRORES (Incluyendo validación del backend o usurpación/bloqueo)
                Swal.fire({
                    icon: 'error',
                    title: 'No se pudo realizar el cambio',
                    text: data.message || 'Ocurrió un error inesperado al actualizar la contraseña.',
                    confirmButtonColor: '#d33'
                }).then(() => {
                    // Si el backend dictaminó que la cuenta fue bloqueada/usurpada, redirigir al login
                    if (data.usurpado) {
                        window.location.href = '/login';
                    }
                });
            }

        } catch (error) {
            console.error('Error de red:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error de red',
                text: 'No se pudo conectar con el servidor. Inténtalo de nuevo más tarde.',
                confirmButtonColor: '#d33'
            });
        }
    });
});
</script>