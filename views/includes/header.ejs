<div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-start align-items-sm-center gap-3 mb-4 pb-3 border-bottom content-header-responsive">
    
    <div class="d-flex align-items-center gap-3 w-100 w-sm-auto">
        <button class="btn btn-white border shadow-sm d-md-none py-2 px-3 text-dark raw-sidebar-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars fs-5"></i>
        </button>

        <div class="header-title-block text-truncate">
            <h1 class="h3 md-h2 fw-bold text-dark m-0 text-truncate">
                <% if(typeof encabezado_pagina !== 'undefined' && encabezado_pagina !== null){%><%- encabezado_pagina %><%}%>
            </h1>
            <p class="text-muted small mb-0 d-none d-sm-block">
                <% if(typeof desc_pagina !== 'undefined' && desc_pagina !== null){%><%- desc_pagina %><%}%>
            </p>
        </div>
    </div>
    
    <div class="d-flex align-items-center justify-content-between justify-content-sm-end gap-2 w-100 w-sm-auto structural-actions-block">
        <% if (user.rol === 'superadministrador' || user.rol === 'administrador') { %>
            <% if (typeof add_btn !== 'undefined' && add_btn) { %>
                <button class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 d-flex align-items-center gap-1 text-dark flex-shrink-0" data-bs-toggle="modal" data-bs-target="<% if(typeof modal !== 'undefined' && modal){%>#<%- modal %><% } else { %>#modalWindow<% } %>">
                    <i class="fa-solid fa-plus text-secondary"></i> <span><% if(btn_label !== 'undefined' && btn_label){%><%- btn_label %><%} else {%>Agregar Elemento<%}%></span>
                </button>
            <% } else if(typeof warehouse_menu !== 'undefined' && warehouse_menu) { %>
                <div class="flex-shrink-0">
                    <%- include('../includes/menuAccionesAlmacen') %>
                </div>
            <% } %>
        <% } %>
        
        <div class="dropdown custom-nav-profile ms-auto ms-sm-0">
            <button class="btn btn-white border shadow-sm fw-semibold btn-sm p-0 d-flex align-items-center text-dark overflow-hidden user-dropdown-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="height: 38px;">
                
                <div class="d-flex align-items-center gap-2 px-2 px-md-3 h-100">
                    <% if (user && user.foto && user.foto !== 'null') { %>
                        <img src="/uploads/<%= user.foto %>" class="user-avatar-nav rounded-circle" alt="Avatar" style="width: 24px; height: 24px; object-fit: cover;">
                    <% } else { %>
                        <i class="fa-solid fa-user-tie text-secondary"></i>
                    <% } %>
                    <span class="fs-7 fw-semibold d-none d-inline-block text-truncate profile-name-text" style="max-width: 110px;"><%= user ? user.nombre : 'Gestor Activo' %></span>
                </div>

                <div class="border-start h-100" style="border-color: #dee2e6 !important;"></div>

                <div class="bg-dark text-light px-2 px-md-3 h-100 d-flex align-items-center rounded-end align-self-stretch text-uppercase gap-1 gap-md-2" style="background-color: #212529 !important; font-size: 0.65rem; letter-spacing: 0.5px;">
                    <i class="fa-solid fa-shield-halved text-white-50 d-none d-inline-block" style="font-size: 0.80rem;"></i>
                    <span class="fw-bold text-white"><%= user ? user.rol : 'Sin Rol' %></span>
                    <i class="fa-solid fa-chevron-down text-white-50" style="font-size: 0.6rem;"></i>
                </div>

            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                <li><a class="dropdown-item p-2 fs-7" href="/admin/perfil"><i class="fa-solid fa-id-card me-2"></i>Mi Perfil</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item p-2 text-danger fs-7" href="/logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Salir</a></li>
            </ul>
        </div>
    </div>
</div>