<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle || 'Cierre del Día - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>
            
            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4 d-flex flex-column min-vh-100">
                
                <div class="flex-grow-1">
                    <%- include('../includes/header', {
                        encabezado_pagina: 'Caja / Cierre del Día',
                        desc_pagina: 'Auditoría integral de cobros, cuentas por cobrar (facturas) y balance del turno',
                        add_btn: false,
                        btn_label: "",
                        modal: ""
                    }) %>

                    <div class="d-flex justify-content-end mb-3">
                        <a href="/admin/cierre-dia/ticket" target="_blank" class="btn btn-dark btn-sm fw-semibold shadow-sm" title="Vista de impresión del cierre (ticket)">
                            <i class="fa-solid fa-print me-1"></i> Imprimir Cierre
                        </a>
                    </div>

                    <% if (turnoActivo) { %>
                        <!-- TARJETAS DE INDICADORES / MÉTRICAS DEL TURNO -->
                        <div class="row g-3 mb-4">
                            <!-- Cobrado en Caja (Total: Órdenes + Propinas / Excedente) -->
                            <div class="col-sm-6 col-xl-3">
                                <div class="card card-custom shadow-sm border-0 h-100 p-3 bg-white">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="pe-2">
                                            <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Total Cobrado en Caja</span>
                                            
                                            <!-- MONTO TOTAL SUMADO (ÓRDENES + EXCEDENTE / PROPINAS) -->
                                            <h4 class="fw-bold text-success mb-1 font-monospace fs-4">
                                                $<%= (resumen.total_efectivo_total_caja || (resumen.total_cobrado_caja + resumen.total_propinas)).toFixed(2) %>
                                            </h4>

                                            <!-- DESGLOSE DETALLADO -->
                                            <div class="text-muted fs-8 d-flex flex-wrap gap-1 align-items-center">
                                                <span>Órdenes: <b>$<%= resumen.total_cobrado_caja.toFixed(2) %></b></span>
                                                <span class="text-secondary opacity-50">•</span>
                                                <span class="text-success fw-semibold">+ Propina: <b>$<%= resumen.total_propinas.toFixed(2) %></b></span>
                                            </div>
                                        </div>
                                        <div class="rounded-circle bg-success-subtle p-3 text-success flex-shrink-0">
                                            <i class="fa-solid fa-cash-register fs-4"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Cuentas por Cobrar (Facturas / Crédito) -->
                            <div class="col-sm-6 col-xl-3">
                                <div class="card card-custom shadow-sm border-0 h-100 p-3 bg-white">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Cuentas por Cobrar (CxC)</span>
                                            <h4 class="fw-bold text-primary mb-0 font-monospace">$<%= resumen.total_cxc_facturas.toFixed(2) %></h4>
                                            <small class="text-muted fs-8">Facturas pendientes de cobro</small>
                                        </div>
                                        <div class="rounded-circle bg-primary-subtle p-3 text-primary">
                                            <i class="fa-solid fa-file-invoice-dollar fs-4"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Cuentas Pendientes de Pago -->
                            <div class="col-sm-6 col-xl-3">
                                <div class="card card-custom shadow-sm border-0 h-100 p-3 bg-white">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Pendiente de Pago</span>
                                            <h4 class="fw-bold text-warning-emphasis mb-0 font-monospace">$<%= resumen.total_pendiente_pago.toFixed(2) %></h4>
                                            <small class="text-muted fs-8">Mesas cerradas con saldo</small>
                                        </div>
                                        <div class="rounded-circle bg-warning-subtle p-3 text-warning-emphasis">
                                            <i class="fa-solid fa-clock-rotate-left fs-4"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Cortesías / Descuentos -->
                            <div class="col-sm-6 col-xl-3">
                                <div class="card card-custom shadow-sm border-0 h-100 p-3 bg-white">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Cortesías Totales</span>
                                            <h4 class="fw-bold text-secondary mb-0 font-monospace">$<%= resumen.total_cortesias.toFixed(2) %></h4>
                                            <small class="text-muted fs-8">100% Descuentos aplicados</small>
                                        </div>
                                        <div class="rounded-circle bg-secondary-subtle p-3 text-secondary">
                                            <i class="fa-solid fa-gift fs-4"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- DESGLOSE MULTIMONEDA EN CAJA (EFECTIVO Y TRANSFERENCIAS) -->
                        <% if (desgloseMonedas && desgloseMonedas.length > 0) { 
                            const efectivos = desgloseMonedas.filter(dm => (dm.metodo_pago || '').toLowerCase() === 'efectivo' || !dm.metodo_pago);
                            const transferencias = desgloseMonedas.filter(dm => (dm.metodo_pago || '').toLowerCase() === 'transferencia');
                            const otrosMetodos = desgloseMonedas.filter(dm => (dm.metodo_pago || '').toLowerCase() !== 'efectivo' && (dm.metodo_pago || '').toLowerCase() !== 'transferencia' && dm.metodo_pago);
                        %>
                            <div class="card card-custom shadow-sm border-0 p-3 mb-4 bg-light">
                                <div class="d-flex flex-column gap-2.5">
                                    <!-- Encabezado de la barra -->
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pb-2 border-bottom">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-coins text-warning fs-5"></i>
                                            <span class="small fw-bold text-dark text-uppercase">Desglose de Monedas Recaudadas en el Turno:</span>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center flex-wrap gap-3">
                                        <!-- 1. EN EFECTIVO FÍSICO -->
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill small fw-bold d-flex align-items-center gap-1">
                                                <i class="fa-solid fa-money-bill-wave"></i> Efectivo:
                                            </span>
                                            <% if (efectivos.length === 0) { %>
                                                <span class="text-muted small italic">$0.00</span>
                                            <% } else { %>
                                                <% efectivos.forEach(dm => { %>
                                                    <span class="badge bg-white text-dark border px-3 py-2 rounded-pill font-monospace small shadow-xs">
                                                        <strong><%= dm.codigo_moneda %>:</strong> <%= dm.simbolo || '$' %><%= parseFloat(dm.total_origen).toFixed(2) %>
                                                        <span class="text-muted">(Eq. $<%= parseFloat(dm.total_local).toFixed(2) %>)</span>
                                                    </span>
                                                <% }) %>
                                            <% } %>
                                        </div>

                                        <div class="vr d-none d-md-block opacity-25"></div>

                                        <!-- 2. POR TRANSFERENCIA BANCARIA / DIGITAL (Con su moneda) -->
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1.5 rounded-pill small fw-bold d-flex align-items-center gap-1">
                                                <i class="fa-solid fa-mobile-screen-button"></i> Transferencia:
                                            </span>
                                            <% if (transferencias.length === 0) { %>
                                                <span class="text-muted small italic">$0.00</span>
                                            <% } else { %>
                                                <% transferencias.forEach(dm => { %>
                                                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle px-3 py-2 rounded-pill font-monospace small shadow-xs">
                                                        <strong><%= dm.codigo_moneda %> (Transf):</strong> <%= dm.simbolo || '$' %><%= parseFloat(dm.total_origen).toFixed(2) %>
                                                        <span class="text-secondary opacity-75">(Eq. $<%= parseFloat(dm.total_local).toFixed(2) %>)</span>
                                                    </span>
                                                <% }) %>
                                            <% } %>
                                        </div>

                                        <!-- 3. OTROS MÉTODOS (Tarjeta, etc.) -->
                                        <% if (otrosMetodos.length > 0) { %>
                                            <div class="vr d-none d-md-block opacity-25"></div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="badge bg-secondary-subtle text-secondary border px-2.5 py-1.5 rounded-pill small fw-bold">
                                                    Otros:
                                                </span>
                                                <% otrosMetodos.forEach(dm => { %>
                                                    <span class="badge bg-white text-secondary border px-3 py-2 rounded-pill font-monospace small shadow-xs">
                                                        <strong><%= dm.codigo_moneda %> (<%= dm.metodo_pago %>):</strong> <%= dm.simbolo || '$' %><%= parseFloat(dm.total_origen).toFixed(2) %>
                                                        <span class="text-muted">(Eq. $<%= parseFloat(dm.total_local).toFixed(2) %>)</span>
                                                    </span>
                                                <% }) %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% } %>


                        <!-- TABLA DE AUDITORÍA Y LISTA DE CUENTAS -->
                        <div class="card card-custom shadow-sm border-0 overflow-hidden mb-4">
                            <div class="card-header bg-white py-3 px-4 border-0 d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <h5 class="fw-bold text-dark mb-0 fs-6 d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-receipt text-secondary"></i> Comandas del Turno Activo (#<%= turnoActivo.id %>)
                                </h5>
                                <div class="d-flex gap-2">
                                    <input type="text" id="filtroTablaCuentas" class="form-control form-control-sm" placeholder="Buscar por mesa o mesero..." style="width: 220px;">
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" id="tablaCuentasCierre">
                                    <thead class="table-custom-thead text-uppercase fs-7">
                                        <tr>
                                            <th class="ps-4 py-3" style="width: 90px;">Comanda</th>
                                            <th class="py-3">Mesa</th>
                                            <th class="py-3">Atendido Por</th>
                                            <th class="py-3">Monto Total</th>
                                            <th class="py-3">Estado de Pago</th>
                                            <th class="py-3">Hora Cierre</th>
                                            <th class="text-center py-3" style="width: 140px;">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (pedidosCuentas.length === 0) { %>
                                            <tr>
                                                <td colspan="7" class="text-center py-5 text-muted">
                                                    <i class="fa-solid fa-folder-open d-block fs-2 mb-2 text-secondary"></i> No se han registrado comandas en este turno.
                                                </td>
                                            </tr>
                                        <% } else { %>
                                            <% pedidosCuentas.forEach(p => { %>
                                                <tr>
                                                    <td class="ps-4 font-monospace fw-bold text-dark">#<%= p.id %></td>
                                                    <td class="fw-semibold text-dark">
                                                        <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill">
                                                            <i class="fa-solid fa-table me-1 text-secondary"></i><%= p.nombre_mesa || 'Barra' %>
                                                        </span>
                                                    </td>
                                                    <td class="text-secondary small"><%= p.mesero || 'Sin mesero' %></td>
                                                    <td class="font-monospace fw-bold text-dark fs-7">
                                                        $<%= parseFloat(p.total).toFixed(2) %>
                                                        <% if (parseFloat(p.propina) > 0) { %>
                                                            <small class="d-block text-success fs-8">+$<%= parseFloat(p.propina).toFixed(2) %> propina</small>
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <% 
                                                            let badgeColor = 'bg-success text-white';
                                                            let iconStyle = 'fa-solid fa-circle-check';
                                                            let labelEstado = 'Pagado';

                                                            if (p.estado_pago === 'facturado') {
                                                                badgeColor = 'bg-primary text-white';
                                                                iconStyle = 'fa-solid fa-file-invoice';
                                                                labelEstado = 'Factura (CxC)';
                                                            } else if (p.estado_pago === 'pendiente_pago') {
                                                                badgeColor = 'bg-warning text-dark fw-bold';
                                                                iconStyle = 'fa-solid fa-clock';
                                                                labelEstado = 'Pendiente Pago';
                                                            } else if (p.estado_pago === 'cortesia') {
                                                                badgeColor = 'bg-secondary text-white';
                                                                iconStyle = 'fa-solid fa-gift';
                                                                labelEstado = 'Cortesía';
                                                            } else if (p.estado_pago === 'pendiente') {
                                                                badgeColor = 'bg-danger text-white';
                                                                iconStyle = 'fa-solid fa-hourglass-half';
                                                                labelEstado = 'En Consumo';
                                                            }
                                                        %>
                                                        <span class="badge <%= badgeColor %> px-3 py-1 rounded-pill fs-7 text-uppercase">
                                                            <i class="<%= iconStyle %> me-1"></i><%= labelEstado %>
                                                        </span>
                                                    </td>
                                                    <td class="text-secondary fs-8">
                                                        <%= p.fecha_cierre ? new Date(p.fecha_cierre).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : 'En curso' %>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="btn-group gap-1">
                                                            <a href="/admin/cierre-dia/ticket-pedido/<%= p.id %>" target="_blank" class="btn btn-sm btn-outline-secondary border-0" title="Imprimir Ticket de la Orden">
                                                                <i class="fa-solid fa-print"></i>
                                                            </a>
                                                            
                                                            <% if (p.estado_pago === 'facturado' || p.estado_pago === 'pendiente_pago') { %>
                                                                <button class="btn btn-sm btn-success border-0 btn-liquidar-cxc" 
                                                                        data-id="<%= p.id %>"
                                                                        data-total="<%= parseFloat(p.total).toFixed(2) %>"
                                                                        data-tipo="<%= p.estado_pago === 'facturado' ? 'Factura CxC' : 'Cuenta Pendiente' %>"
                                                                        title="Asentar Pago y Liquidar">
                                                                    <i class="fa-solid fa-hand-holding-dollar"></i> Cobrar
                                                                </button>
                                                            <% } %>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    <% } else { %>
                        <div class="alert alert-danger p-4 border-0 shadow-sm rounded-3 text-center">
                            <i class="fa-solid fa-triangle-exclamation fa-3x mb-3 text-danger"></i>
                            <h5 class="fw-bold text-dark">No hay un Turno de Servicio Activo</h5>
                            <p class="text-secondary small mb-3">Para auditar el cierre del día, es necesario que exista un turno operativo abierto.</p>
                            <a href="/admin/turnos-servicio" class="btn btn-dark px-4 btn-sm fw-semibold">
                                <i class="fa-solid fa-door-open me-2 text-warning"></i>Ir al Control de Turnos
                            </a>
                        </div>
                    <% } %>

                </div>

                <div class="mt-auto">
                    <%- include('../includes/footer') %>
                </div>
            </main>
        </div>
    </div>

    <!-- Libs JS -->
    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Buscador en vivo de la tabla de comandas
            const inputFiltro = document.getElementById('filtroTablaCuentas');
            if (inputFiltro) {
                inputFiltro.addEventListener('input', function() {
                    const termino = this.value.toLowerCase().trim();
                    const filas = document.querySelectorAll('#tablaCuentasCierre tbody tr');
                    filas.forEach(fila => {
                        const texto = fila.textContent.toLowerCase();
                        fila.style.display = texto.includes(termino) ? '' : 'none';
                    });
                });
            }

            // Acción para liquidar Cuentas por Cobrar (Facturas) o Cuentas Pendientes
            document.addEventListener('click', async (e) => {
                const btnLiquidar = e.target.closest('.btn-liquidar-cxc');
                if (btnLiquidar) {
                    const idPedido = btnLiquidar.getAttribute('data-id');
                    const total = btnLiquidar.getAttribute('data-total');
                    const tipo = btnLiquidar.getAttribute('data-tipo');

                    const { value: formValues } = await Swal.fire({
                        title: `LIQUIDAR ${tipo.toUpperCase()}`,
                        html: `
                            <div class="text-start p-2">
                                <p class="text-secondary small mb-3">Asentar ingreso a caja para la Comanda <b>#${idPedido}</b> por un total de <b>$${total}</b>.</p>
                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-bold">Método Recibido</label>
                                    <select id="swal-liq-metodo" class="form-select form-select-sm">
                                        <option value="efectivo">Efectivo</option>
                                        <option value="transferencia">Transferencia Bancaria</option>
                                        <option value="tarjeta">Tarjeta</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label text-secondary small fw-bold">Referencia / Comprobante</label>
                                    <input type="text" id="swal-liq-ref" class="form-control form-control-sm" placeholder="Ej: Recibido por dueño / Transf #1234">
                                </div>
                            </div>
                        `,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Confirmar Ingreso a Caja',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#10b981',
                        cancelButtonColor: '#6c757d',
                        preConfirm: () => {
                            return {
                                metodo_pago: document.getElementById('swal-liq-metodo').value,
                                referencia: document.getElementById('swal-liq-ref').value || 'COBRO POSTERIOR'
                            };
                        }
                    });

                    if (formValues) {
                        Swal.fire({ title: 'Asentando pago...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                        try {
                            const res = await fetch(`/admin/cierre-dia/liquidar-cuenta/${idPedido}`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(formValues)
                            });
                            const data = await res.json();

                            if (data.success) {
                                Swal.fire({
                                    title: '¡Cuenta Liquidada!',
                                    text: data.message,
                                    icon: 'success',
                                    timer: 1800,
                                    showConfirmButton: false
                                }).then(() => location.reload());
                            } else {
                                Swal.fire('Error', data.message || 'No se pudo liquidar la cuenta.', 'error');
                            }
                        } catch (err) {
                            console.error(err);
                            Swal.fire('Error de Red', 'Fallo en la comunicación con el servidor.', 'error');
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>