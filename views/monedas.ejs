<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Monedas - Restaurante</title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
            <%- include('./includes/sideBarMenu') %>
            
            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4 d-flex flex-column min-vh-100">
                
                <div class="flex-grow-1">
                    <%- include('./includes/header', {encabezado_pagina: 'Configuración / Monedas', desc_pagina: 'Gestión de tipos de moneda y tasas de cambio', add_btn: true, btn_label: "Nueva Moneda", modal: "modalCrearMoneda"}) %>
                    
                    <div class="card card-custom shadow-sm border-0 overflow-hidden mb-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="tablaMonedas">
                                <thead class="table-custom-thead text-uppercase fs-7">
                                    <tr>
                                        <th class="ps-4 py-3">Nombre</th>
                                        <th class="py-3">Código ISO</th>
                                        <th class="py-3">Símbolo</th>
                                        <th class="py-3">Tasa de Cambio</th>
                                        <th class="py-3 text-center">Tipo</th>
                                        <th class="py-3 text-center">Estado</th>
                                        <th class="text-center py-3" style="width: 160px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!monedas || monedas.length === 0) { %>
                                        <tr>
                                            <td colspan="7" class="text-center py-5 text-muted">
                                                <i class="fa-solid fa-coins d-block fs-2 mb-2 text-secondary"></i> No hay monedas registradas.
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% monedas.forEach(moneda => { %>
                                            <tr>
                                                <td class="ps-4 fw-semibold text-dark">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="fa-solid fa-money-bill-wave text-secondary"></i>
                                                        <span><%= moneda.nombre %></span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="text-secondary bg-light border px-2 py-1 rounded small font-monospace"><%= moneda.codigo %></span>
                                                </td>
                                                <td class="fw-bold text-secondary"><%= moneda.simbolo %></td>
                                                <td class="font-monospace"><%= moneda.factor_cambio %></td>
                                                <td class="text-center">
                                                    <% if (moneda.es_moneda_base) { %>
                                                        <span class="badge bg-success text-white px-3 py-1 rounded-pill fs-7">
                                                            <i class="fa-solid fa-star me-1"></i>Base Sistema
                                                        </span>
                                                    <% } else { %>
                                                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 fs-7 btn-establecer-base"
                                                                data-id="<%= moneda.id %>"
                                                                data-nombre="<%= moneda.nombre %>"
                                                                title="Establecer como moneda base">
                                                            Secundaria
                                                        </button>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <% if (moneda.activo) { %>
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small">Activo</span>
                                                    <% } else { %>
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill small">Inactivo</span>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group gap-1">
                                                        <button class="btn btn-sm btn-outline-secondary border-0"
                                                                title="Editar" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-target="#modalEditarMoneda"
                                                                data-id="<%= moneda.id %>"
                                                                data-nombre="<%= moneda.nombre %>"
                                                                data-codigo="<%= moneda.codigo %>"
                                                                data-simbolo="<%= moneda.simbolo %>"
                                                                data-tasa="<%= moneda.factor_cambio %>"
                                                                data-base="<%= moneda.es_moneda_base %>">
                                                            <i class="fa-solid fa-pen-to-square"></i>
                                                        </button>
                                                        <button class="btn btn-sm <%= moneda.activo ? 'btn-outline-danger' : 'btn-outline-success' %> border-0 btn-cambiar-estado" 
                                                                data-id="<%= moneda.id %>"
                                                                data-nombre="<%= moneda.nombre %>"
                                                                data-activo="<%= moneda.activo %>"
                                                                title="<%= moneda.activo ? 'Desactivar Moneda' : 'Activar Moneda' %>">
                                                            <i class="fa-solid <%= moneda.activo ? 'fa-user-slash' : 'fa-user-check' %>"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="mt-auto">
                    <%- include('./includes/footer') %>
                </div>
            </main>
        </div>
    </div>

    <!-- MODAL CREAR MONEDA -->
    <div class="modal fade" id="modalCrearMoneda" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-coins me-2"></i>Registrar Nueva Moneda</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formCrearMoneda">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Nombre de la Moneda</label>
                                <input type="text" id="crearNombre" name="nombre" class="form-control" placeholder="Ej. Peso Cubano" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Código ISO</label>
                                <input type="text" id="crearCodigo" name="codigo" class="form-control" placeholder="Ej. CUP" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Símbolo</label>
                                <input type="text" id="crearSimbolo" name="simbolo" class="form-control" placeholder="Ej. $" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Tasa de Cambio</label>
                                <input type="number" step="0.0001" id="crearTasa" name="tasa_cambio" class="form-control" placeholder="1.0000" required>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" id="crearEsMonedaBase" name="es_moneda_base" value="1">
                                    <label class="form-check-label fw-semibold text-secondary small" for="crearEsMonedaBase">
                                        Establecer como moneda base del sistema
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4">Guardar Moneda</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL EDITAR MONEDA -->
    <div class="modal fade" id="modalEditarMoneda" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i>Editar Datos de Moneda</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formEditarMoneda">
                    <div class="modal-body p-4">
                        <input type="hidden" id="editMonedaId" name="id">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Nombre de la Moneda</label>
                                <input type="text" id="editNombre" name="nombre" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Código ISO</label>
                                <input type="text" id="editCodigo" name="codigo" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Símbolo</label>
                                <input type="text" id="editSimbolo" name="simbolo" class="form-control" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Tasa de Cambio</label>
                                <input type="number" step="0.0001" id="editTasa" name="tasa_cambio" class="form-control" required>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" id="editEsMonedaBase" name="es_moneda_base" value="1">
                                    <label class="form-check-label fw-semibold text-secondary small" for="editEsMonedaBase">
                                        Establecer como moneda base del sistema
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success btn-sm px-4">Actualizar Moneda</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script>
        const bsModalCrear = new bootstrap.Modal(document.getElementById('modalCrearMoneda'));
        const bsModalEditar = new bootstrap.Modal(document.getElementById('modalEditarMoneda'));

        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById('formCrearMoneda').addEventListener('submit', (e) => saveMoneda(e, false));
            document.getElementById('formEditarMoneda').addEventListener('submit', (e) => saveMoneda(e, true));

            document.getElementById('tablaMonedas').addEventListener('click', function(e) {
                const btnEstado = e.target.closest('.btn-cambiar-estado');
                if (btnEstado) {
                    const id = btnEstado.getAttribute('data-id');
                    const nombre = btnEstado.getAttribute('data-nombre');
                    const estadoActual = btnEstado.getAttribute('data-activo') === 'true' || btnEstado.getAttribute('data-activo') === '1';
                    toggleEstado(id, nombre, estadoActual);
                }

                const btnBase = e.target.closest('.btn-establecer-base');
                if (btnBase) {
                    const id = btnBase.getAttribute('data-id');
                    const nombre = btnBase.getAttribute('data-nombre');
                    setMonedaBase(id, nombre);
                }
            });
        });

        document.getElementById('modalCrearMoneda').addEventListener('hidden.bs.modal', () => {
            document.getElementById('formCrearMoneda').reset();
        });

        const modalEditarElement = document.getElementById('modalEditarMoneda');
        if (modalEditarElement) {
            modalEditarElement.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-id');
                const nombre = button.getAttribute('data-nombre');
                const codigo = button.getAttribute('data-codigo');
                const simbolo = button.getAttribute('data-simbolo');
                const tasa = button.getAttribute('data-tasa');
                const base = button.getAttribute('data-base');

                document.getElementById('editMonedaId').value = id;
                document.getElementById('editNombre').value = nombre;
                document.getElementById('editCodigo').value = codigo;
                document.getElementById('editSimbolo').value = simbolo;
                document.getElementById('editTasa').value = tasa;
                document.getElementById('editEsMonedaBase').checked = (base === 'true' || base === '1');
            });
        }

        async function saveMoneda(e, esEdicion) {
            e.preventDefault();
            const formElement = esEdicion ? document.getElementById('formEditarMoneda') : document.getElementById('formCrearMoneda');
            
            // Extraer valores directamente por ID para garantizar el tipo y nombre exacto
            const prefix = esEdicion ? 'edit' : 'crear';
            const nombre = document.getElementById(`${prefix}Nombre`).value.trim();
            const codigo = document.getElementById(`${prefix}Codigo`).value.trim();
            const simbolo = document.getElementById(`${prefix}Simbolo`).value.trim();
            const tasaVal = parseFloat(document.getElementById(`${prefix}Tasa`).value);
            const esBase = document.getElementById(`${prefix}EsMonedaBase`).checked;

            // Payload adaptado a los nombres más comunes de controladores Node/Express
            const payload = {
                nombre: nombre,
                codigo: codigo,
                simbolo: simbolo,
                tasa_cambio: tasaVal,
                factor_cambio: tasaVal, // Enviamos ambas variaciones por compatibilidad
                es_moneda_base: esBase ? 1 : 0
            };

            let url = '/admin/api/crear-moneda';
            let method = 'POST';

            if (esEdicion) {
                const id = document.getElementById('editMonedaId').value;
                url = `/admin/api/act-moneda/${id}`;
                method = 'PUT';
            }

            Swal.fire({
                title: esEdicion ? 'Actualizando moneda...' : 'Guardando moneda...',
                text: 'Por favor, espere.',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const res = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json().catch(() => ({ success: false, message: 'Respuesta inválida del servidor.' }));

                if (res.ok && (result.success || result.status === 'success')) {
                    if (esEdicion) bsModalEditar.hide(); else bsModalCrear.hide();
                    Swal.fire({
                        title: esEdicion ? '¡Actualizado!' : '¡Registrado!',
                        text: result.message || 'Operación realizada correctamente.',
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false,
                        willClose: () => { location.reload(); }
                    });
                } else {
                    Swal.fire('Error de Validación', result.message || 'Verifica los campos ingresados.', 'error');
                }
            } catch (err) {
                console.error(err);
                Swal.fire('Error de Red', err.message || 'Fallo de conexión con el servidor.', 'error');
            }
        }

        function toggleEstado(id, nombreMoneda, estadoActual) {
            const accion = estadoActual ? 'desactivar' : 'activar';
            
            Swal.fire({
                title: '¿Confirmar Acción?',
                text: `¿Desea ${accion} la moneda: ${nombreMoneda}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: estadoActual ? '#d33' : '#198754',
                cancelButtonColor: '#6c757d',
                confirmButtonText: `Sí, ${accion}`,
                cancelButtonText: 'Cancelar',
                reverseButtons: true
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Procesando...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                    try {
                        const res = await fetch(`/admin/api/moneda/${id}/estado`, { 
                            method: 'PATCH', 
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ activo: !estadoActual })
                        });
                        const data = await res.json().catch(() => ({ success: false, message: 'Error al interpretar respuesta.' }));

                        if (res.ok && (data.success || data.status === 'success')) {
                            Swal.fire({
                                title: '¡Actualizado!',
                                text: data.message || `Moneda ${accion}da exitosamente.`,
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => { location.reload(); });
                        } else {
                            Swal.fire('Error', data.message || 'No se pudo cambiar el estado.', 'error');
                        }
                    } catch (error) {
                        console.error(error);
                        Swal.fire('Error de Red', 'No se pudo conectar con el servidor.', 'error');
                    }
                }
            });
        }

        function setMonedaBase(id, nombreMoneda) {
            Swal.fire({
                title: '¿Establecer como Base?',
                text: `¿Desea establecer ${nombreMoneda} como la moneda principal del sistema?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, Establecer',
                cancelButtonText: 'Cancelar',
                reverseButtons: true
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Actualizando base...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                    try {
                        const res = await fetch(`/admin/api/moneda/${id}/establecer-base`, { 
                            method: 'PATCH', 
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await res.json().catch(() => ({ success: false, message: 'Error al interpretar respuesta.' }));

                        if (res.ok && (data.success || data.status === 'success')) {
                            Swal.fire({
                                title: '¡Configurado!',
                                text: data.message || 'Moneda base actualizada.',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => { location.reload(); });
                        } else {
                            Swal.fire('Error', data.message || 'No se pudo actualizar la moneda base.', 'error');
                        }
                    } catch (error) {
                        console.error(error);
                        Swal.fire('Error de Red', 'No se pudo conectar con el servidor.', 'error');
                    }
                }
            });
        }
    </script>
</body>
</html>