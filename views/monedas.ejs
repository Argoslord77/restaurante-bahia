<%- include('../partials/header') %>

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-coins me-2"></i>Gestión de Monedas y Tasas</h1>
            <p class="text-muted small mb-0">Administra las divisas aceptadas en el negocio y configura la moneda local base.</p>
        </div>
        <button type="button" class="btn btn-primary" onclick="abrirModalCrear()">
            <i class="fas fa-plus me-1"></i> Nueva Moneda
        </button>
    </div>

    <!-- Tabla de Monedas -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th class="text-center">Símbolo</th>
                            <th class="text-end">Factor de Cambio</th>
                            <th class="text-center">Tipo</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end me-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (monedas && monedas.length > 0) { %>
                            <% monedas.forEach(moneda => { %>
                                <tr class="<%= moneda.activo ? '' : 'table-secondary opacity-75' %>">
                                    <td class="fw-bold"><%= moneda.codigo %></td>
                                    <td><%= moneda.nombre %></td>
                                    <td class="text-center"><span class="badge bg-light text-dark border"><%= moneda.simbolo %></span></td>
                                    <td class="text-end font-monospace">
                                        <%= parseFloat(moneda.factor_cambio).toFixed(4) %>
                                    </td>
                                    <td class="text-center">
                                        <% if (moneda.es_moneda_base) { %>
                                            <span class="badge bg-success"><i class="fas fa-star me-1"></i>Moneda Base</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">Secundaria</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <% if (moneda.activo) { %>
                                            <span class="badge bg-primary">Activa</span>
                                        <% } else { %>
                                            <span class="badge bg-danger">Inactiva</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <% if (!moneda.es_moneda_base && moneda.activo) { %>
                                                <button type="button" class="btn btn-outline-warning" title="Establecer como Moneda Base" onclick="establecerBase(<%= moneda.id %>, '<%= moneda.codigo %>')">
                                                    <i class="fas fa-star"></i>
                                                </button>
                                            <% } %>
                                            <button type="button" class="btn btn-outline-secondary" title="Editar" onclick='abrirModalEditar(<%- JSON.stringify(moneda) %>)'>
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <% if (!moneda.es_moneda_base) { %>
                                                <button type="button" class="btn <%= moneda.activo ? 'btn-outline-danger' : 'btn-outline-success' %>" title="<%= moneda.activo ? 'Desactivar' : 'Activar' %>" onclick="toggleEstado(<%= moneda.id %>, <%= moneda.activo %>)">
                                                    <i class="fas <%= moneda.activo ? 'fa-ban' : 'fa-check' %>"></i>
                                                </button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">No hay monedas registradas.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Formulario Moneda (Crear / Editar) -->
<div class="modal fade" id="modalMoneda" tabindex="-1" aria-labelledby="modalMonedaTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalMonedaTitle">Nueva Moneda</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formMoneda" onsubmit="guardarMoneda(event)">
                <div class="modal-body">
                    <input type="hidden" id="monedaId" value="">
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="codigo" class="form-label">Código ISO <span class="text-danger">*</span></label>
                            <input type="text" class="form-control text-uppercase" id="codigo" maxlength="5" placeholder="EJ: USD, CUP" required>
                        </div>
                        <div class="col-md-6">
                            <label for="simbolo" class="form-label">Símbolo <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="simbolo" maxlength="5" placeholder="$" defaultValue="$" required>
                        </div>
                        <div class="col-12">
                            <label for="nombre" class="form-label">Nombre de la Moneda <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="nombre" placeholder="Ej: Dólar Estadounidense" required>
                        </div>
                        <div class="col-12">
                            <label for="factor_cambio" class="form-label">Factor de Cambio (Tasa respecto a Moneda Base)</label>
                            <input type="number" step="0.0001" min="0.0001" class="form-control" id="factor_cambio" value="1.0000" required>
                            <div class="form-text">Si se marca como moneda base, el factor se fijará automáticamente en 1.0000.</div>
                        </div>
                        <div class="col-12" id="wrapperEsBase">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="es_moneda_base" onchange="gestionarToggleBase()">
                                <label class="form-check-label fw-bold" for="es_moneda_base">Es Moneda Base del Sistema</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btnGuardar">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    let bsModalMoneda = null;

    document.addEventListener('DOMContentLoaded', () => {
        bsModalMoneda = new bootstrap.Modal(document.getElementById('modalMoneda'));
    });

    function gestionarToggleBase() {
        const chkBase = document.getElementById('es_moneda_base');
        const inputFactor = document.getElementById('factor_cambio');
        if (chkBase.checked) {
            inputFactor.value = "1.0000";
            inputFactor.disabled = true;
        } else {
            inputFactor.disabled = false;
        }
    }

    function abrirModalCrear() {
        document.getElementById('formMoneda').reset();
        document.getElementById('monedaId').value = '';
        document.getElementById('modalMonedaTitle').innerText = 'Nueva Moneda';
        document.getElementById('factor_cambio').disabled = false;
        document.getElementById('es_moneda_base').disabled = false;
        bsModalMoneda.show();
    }

    function abrirModalEditar(moneda) {
        document.getElementById('formMoneda').reset();
        document.getElementById('monedaId').value = moneda.id;
        document.getElementById('modalMonedaTitle').innerText = `Editar Moneda: ${moneda.codigo}`;
        document.getElementById('codigo').value = moneda.codigo;
        document.getElementById('nombre').value = moneda.nombre;
        document.getElementById('simbolo').value = moneda.simbolo;
        document.getElementById('factor_cambio').value = parseFloat(moneda.factor_cambio).toFixed(4);
        
        const chkBase = document.getElementById('es_moneda_base');
        chkBase.checked = !!moneda.es_moneda_base;

        // Si es la moneda base actual, no permitimos desmarcarla desde edición rápida
        if (moneda.es_moneda_base) {
            chkBase.disabled = true;
            document.getElementById('factor_cambio').disabled = true;
        } else {
            chkBase.disabled = false;
            document.getElementById('factor_cambio').disabled = false;
        }

        bsModalMoneda.show();
    }

    async function guardarMoneda(event) {
        event.preventDefault();

        const id = document.getElementById('monedaId').value;
        const payload = {
            codigo: document.getElementById('codigo').value,
            nombre: document.getElementById('nombre').value,
            simbolo: document.getElementById('simbolo').value,
            factor_cambio: parseFloat(document.getElementById('factor_cambio').value),
            es_moneda_base: document.getElementById('es_moneda_base').checked
        };

        const url = id ? `/admin/monedas/api/${id}` : '/admin/monedas/api';
        const method = id ? 'PUT' : 'POST';

        try {
            const res = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await res.json();

            if (res.ok && data.success) {
                bsModalMoneda.hide();
                Swal.fire({
                    icon: 'success',
                    title: '¡Logrado!',
                    text: data.message,
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => location.reload());
            } else {
                Swal.fire('Error', data.message || 'Ocurrió un inconveniente', 'error');
            }
        } catch (err) {
            console.error(err);
            Swal.fire('Error', 'No se pudo procesar la solicitud.', 'error');
        }
    }

    async function establecerBase(id, codigo) {
        const confirm = await Swal.fire({
            title: `¿Convertir ${codigo} en Moneda Base?`,
            text: "Todas las transacciones tomarán esta moneda como equivalencia 1.0000.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, cambiar',
            cancelButtonText: 'Cancelar'
        });

        if (!confirm.isConfirmed) return;

        try {
            const res = await fetch(`/admin/monedas/api/${id}/establecer-base`, { method: 'PATCH' });
            const data = await res.json();

            if (res.ok && data.success) {
                Swal.fire('Actualizado', data.message, 'success').then(() => location.reload());
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        } catch (err) {
            Swal.fire('Error', 'Error de red al establecer la moneda base.', 'error');
        }
    }

    async function toggleEstado(id, estaActiva) {
        const accion = estaActiva ? 'desactivar' : 'activar';

        try {
            const res = await fetch(`/admin/monedas/api/${id}/estado`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ activo: !estaActiva })
            });

            const data = await res.json();

            if (res.ok && data.success) {
                location.reload();
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        } catch (err) {
            Swal.fire('Error', `No se pudo ${accion} la moneda.`, 'error');
        }
    }
</script>

<%- include('../partials/footer') %>