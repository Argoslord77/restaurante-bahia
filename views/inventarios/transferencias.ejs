<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Transferencias Internas - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <%- include('../includes/sideBarMenu') %>
    
    <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4">
        
        <%- include('../includes/header', {
            encabezado_pagina: 'Transferencias de Almacén', 
            desc_pagina: 'Módulo de movimientos, reabastecimiento y flujo transaccional de stock por lotes.', 
            add_btn: true, 
            btn_label: "Nueva Solicitud", 
            modal: "modalTransferencia"
        }) %>

        <div class="card card-custom shadow-sm border-0 overflow-hidden mt-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tablaTransferencias">
                    <thead class="table-custom-thead text-uppercase fs-7 bg-light">
                        <tr>
                            <th class="ps-4 py-3">Código / Fecha</th>
                            <th class="py-3">Producto / Insumo</th>
                            <th class="py-3">Origen</th>
                            <th class="py-3">Destino</th>
                            <th class="text-end py-3">Cantidad</th>
                            <th class="text-center py-3">Estado</th>
                            <th class="text-center py-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof transferencias !== 'undefined' && transferencias.length > 0) { %>
                            <% transferencias.forEach(t => { %>
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark font-monospace"><%= t.codigo %></div>
                                        <small class="text-secondary fs-7">
                                            <%= new Date(t.created_at).toLocaleDateString('es-ES', {day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute:'2-digit'}) %>
                                        </small>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= t.producto_nombre || 'N/A' %></div>
                                        <small class="font-monospace text-primary">#<%= t.producto_codigo || 'S/C' %></small>
                                    </td>
                                    <td><span class="badge bg-light text-dark border"><i class="fa-solid fa-warehouse me-1 text-secondary"></i><%= t.almacen_origen_nombre %></span></td>
                                    <td><span class="badge bg-light text-dark border"><i class="fa-solid fa-square-parking me-1 text-secondary"></i><%= t.almacen_destino_nombre %></span></td>
                                    <td class="text-end fw-bold text-dark"><%= t.cantidad ? parseFloat(t.cantidad).toFixed(2) : '0.00' %></td>
                                    <td class="text-center">
                                        <% if (t.estado === 'PENDIENTE') { %>
                                            <span class="badge bg-warning-subtle text-warning px-3 rounded-pill fw-semibold">PENDIENTE</span>
                                        <% } else if (t.estado === 'APROBADA') { %>
                                            <span class="badge bg-info-subtle text-info px-3 rounded-pill fw-semibold">APROBADA</span>
                                        <% } else if (t.estado === 'COMPLETADA') { %>
                                            <span class="badge bg-success-subtle text-success px-3 rounded-pill fw-semibold">COMPLETADA</span>
                                        <% } else { %>
                                            <span class="badge bg-danger-subtle text-danger px-3 rounded-pill fw-semibold">RECHAZADA</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group gap-1">
                                            <% if (t.estado === 'PENDIENTE') { %>
                                                <button class="btn btn-sm btn-outline-success border-0 btn-action-trigger" data-id="<%= t.id %>" data-action="aprobar" title="Aprobar Solicitud">
                                                    <i class="fa-solid fa-circle-check fs-5"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger border-0 btn-action-trigger" data-id="<%= t.id %>" data-action="rechazar" title="Rechazar Solicitud">
                                                    <i class="fa-solid fa-circle-xmark fs-5"></i>
                                                </button>
                                            <% } else if (t.estado === 'APROBADA') { %>
                                                <button class="btn btn-sm btn-success px-2 py-1 fs-7 shadow-sm btn-action-trigger" data-id="<%= t.id %>" data-action="completar">
                                                    <i class="fa-solid fa-boxes-packing me-1"></i> Procesar Lotes
                                                </button>
                                            <% } else { %>
                                                <span class="text-muted small font-italic"><i class="fa-solid fa-lock me-1"></i>Archivado</span>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-inbox d-block fs-3 mb-2 text-secondary"></i>
                                    No hay solicitudes de transferencia registradas.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <div class="modal fade" id="modalTransferencia" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <form id="formTransferencia" class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="modalTitle"><i class="fa-solid fa-right-left me-2"></i>Nueva Solicitud de Transferencia</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="almacen_origen_id" class="form-label fw-semibold text-secondary small">Almacén de Origen</label>
                            <select class="form-select shadow-sm" id="almacen_origen_id" required>
                                <option value="">Seleccione origen...</option>
                                <% almacenes.forEach(a => { %>
                                    <option value="<%= a.id %>"><%= a.nombre %> (<%= a.codigo %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="almacen_destino_id" class="form-label fw-semibold text-secondary small">Almacén de Destino</label>
                            <select class="form-select shadow-sm" id="almacen_destino_id" required>
                                <option value="">Seleccione destino...</option>
                                <% almacenes.forEach(a => { %>
                                    <option value="<%= a.id %>"><%= a.nombre %> (<%= a.codigo %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label for="producto_id" class="form-label fw-semibold text-secondary small">Producto / Insumo</label>
                            <select class="form-select shadow-sm" id="producto_id" required>
                                <option value="">Seleccione un insumo de la lista...</option>
                                <% productos.forEach(p => { %>
                                    <option value="<%= p.id %>">[<%= p.codigo %>] <%= p.nombre %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="cantidad" class="form-label fw-semibold text-secondary small">Cantidad a Transferir</label>
                            <input type="number" step="0.001" id="cantidad" class="form-control shadow-sm" required min="0.001" placeholder="0.000">
                        </div>
                        <div class="col-md-12">
                            <label for="observaciones" class="form-label fw-semibold text-secondary small">Observaciones / Justificación</label>
                            <textarea id="observaciones" class="form-control shadow-sm" rows="2" placeholder="Describa el motivo del movimiento interno de stock..." required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">Enviar a Revisión</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const modalElement = document.getElementById('modalTransferencia');
        const bsModal = new bootstrap.Modal(modalElement);

        // Captura e inicialización limpia desde el botón del Header común
        document.addEventListener('click', (e) => {
            const tgt = e.target.closest('[data-bs-target="modalTransferencia"]') || e.target.closest('[data-bs-target="#modalTransferencia"]');
            if (tgt) {
                e.preventDefault();
                bsModal.show();
            }
        });

        // Resetear formulario al cerrar modal
        modalElement.addEventListener('hidden.bs.modal', () => {
            document.getElementById('formTransferencia').reset();
        });

        // Manejo del Submit mediante API REST (POST)
        document.getElementById('formTransferencia').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const payload = {
                almacen_origen_id: document.getElementById('almacen_origen_id').value,
                almacen_destino_id: document.getElementById('almacen_destino_id').value,
                producto_id: document.getElementById('producto_id').value,
                cantidad: document.getElementById('cantidad').value,
                observaciones: document.getElementById('observaciones').value
            };

            try {
                const response = await fetch('/admin/api/transferencias', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();
                
                if (data.success) {
                    bsModal.hide();
                    Swal.fire({
                        title: '¡Solicitud Creada!',
                        text: data.message,
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => { location.reload(); });
                } else {
                    Swal.fire('Atención', data.message || 'Error al validar el stock en origen.', 'warning');
                }
            } catch (error) {
                Swal.fire('Error Operativo', 'Fallo de red o caída del servicio de Base de Datos.', 'error');
            }
        });

        // Delegación de eventos pura en la tabla para manejar estados (CSP Compliant)
        document.getElementById('tablaTransferencias').addEventListener('click', function(e) {
            const trigger = e.target.closest('.btn-action-trigger');
            if (!trigger) return;

            const id = trigger.getAttribute('data-id');
            const action = trigger.getAttribute('data-action');

            let title, text, icon, confirmText;

            if (action === 'aprobar') {
                title = '¿Aprobar transferencia?';
                text = 'La solicitud pasará a estar disponible para el despacho de lotes.';
                icon = 'question';
                confirmText = 'Sí, aprobar';
            } else if (action === 'rechazar') {
                title = '¿Rechazar solicitud?';
                text = 'Esta acción denegará el traslado y archivará la cabecera.';
                icon = 'warning';
                confirmText = 'Sí, rechazar';
            } else if (action === 'completar') {
                title = '¿Procesar despacho e inventario?';
                text = 'Se ejecutará la rebaja FIFO del origen y el ingreso automatizado en el almacén de destino.';
                icon = 'info';
                confirmText = 'Sí, procesar movimiento';
            }

            Swal.fire({
                title: title,
                text: text,
                icon: icon,
                showCancelButton: true,
                confirmButtonColor: action === 'rechazar' ? '#dc3545' : '#198754',
                cancelButtonColor: '#6c757d',
                confirmButtonText: confirmText,
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/api/transferencias/${id}/${action}`, { method: 'PUT' });
                        const resData = await response.json();

                        if (resData.success) {
                            Swal.fire({
                                title: '¡Operación Exitosa!',
                                text: resData.message,
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => { location.reload(); });
                        } else {
                            Swal.fire('Fallo en Transacción', resData.message || 'El lote origen se quedó sin stock intermedio.', 'error');
                        }
                    } catch (err) {
                        Swal.fire('Error del Servidor', 'No se pudo completar la petición HTTP.', 'error');
                    }
                }
            });
        });
    });
    </script>
</body>
</html>