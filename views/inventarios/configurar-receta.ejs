<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurar Receta - <%= platillo.nombre %></title>
    <link class="js-bootstrap-css" rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css"> 
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <div class="toast-container-custom">
        <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
            <div class="toast show text-white bg-danger border-0 shadow" role="alert" id="liveToast">
                <div class="d-flex">
                    <div class="toast-body fw-semibold fs-7">
                        <i class="fa-solid fa-circle-xmark me-2"></i><%= error_msg %>
                    </div>
                    <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        <% } %>
        
        <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
            <div class="toast show text-white bg-success border-0 shadow" role="alert" id="liveToast">
                <div class="d-flex">
                    <div class="toast-body fw-semibold fs-7">
                        <i class="fa-solid fa-circle-check me-2"></i><%= success_msg %>
                    </div>
                    <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        <% } %>
    </div>

    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>
            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4">
                <%- include('../includes/header', {
                    encabezado_pagina: '🍽️ Configurar Receta', 
                    desc_pagina: `Ingredientes para: <strong>${platillo.nombre}</strong>`, 
                    add_btn: true, 
                    btn_label: "Agregar Ingrediente", 
                    modal: "ingredienteModal",
                    back_btn: true,
                    back_url: '/admin/recetas'
                }) %>

                <div class="card card-custom shadow-sm border-0 overflow-hidden mb-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-custom-thead text-uppercase fs-7">
                                    <tr>
                                        <th class="ps-4 py-3">Ingrediente</th>
                                        <th class="py-3">Cantidad</th>
                                        <th class="py-3">Unidad</th>
                                        <th class="py-3 text-center">Stock Disponible</th>
                                        <th class="text-center py-3" style="width: 150px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (ingredientes.length === 0) { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-5 text-muted">
                                                <i class="fa-solid fa-carrot d-block fs-2 mb-2 text-secondary"></i> 
                                                No hay ingredientes configurados para este platillo.
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% ingredientes.forEach(ingrediente => { %>
                                            <tr class="<%= !ingrediente.activo ? 'opacity-50 table-light' : '' %>">
                                                <td class="ps-4 fw-semibold text-dark">
                                                    <i class="fa-solid fa-box me-2 text-primary"></i>
                                                    <%= ingrediente.producto_nombre %>
                                                    <div class="text-muted small"><%= ingrediente.producto_codigo || '' %></div>
                                                </td>
                                                <td class="fw-bold text-dark"><%= ingrediente.cantidad_requerida %></td>
                                                <td><%= ingrediente.unidad_medida || '—' %></td>
                                                <td class="text-center">
                                                    <span class="badge <%= ingrediente.stock_disponible < ingrediente.cantidad_requerida ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-success-subtle text-success border border-success-subtle' %> px-3 py-1 rounded-pill fs-7">
                                                        <%= ingrediente.stock_disponible.toFixed(2) %>
                                                    </span>
                                                </td>
                                                <td class="text-center pe-3">
                                                    <div class="btn-group gap-1">
                                                        <button class="btn btn-sm btn-outline-secondary border-0" onclick="openEditModal('<%= ingrediente.id %>')" title="Editar">
                                                            <i class="fa-solid fa-pen-to-square"></i>
                                                        </button>
                                                        <% if (user && ['superadministrador', 'administrador'].includes(user.rol)) { %>
                                                            <button class="btn btn-sm btn-outline-danger border-0" onclick="deleteIngrediente('<%= ingrediente.id %>')" title="Eliminar">
                                                                <i class="fa-solid fa-trash"></i>
                                                            </button>
                                                        <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Resumen de Costos -->
                <div class="card card-custom shadow-sm border-0">
                    <div class="card-header bg-white border-0 py-3">
                        <h6 class="fw-bold mb-0"><i class="fa-solid fa-chart-pie me-2 text-primary"></i>Resumen de Receta</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Total Ingredientes</div>
                                    <div class="fs-4 fw-bold text-dark"><%= ingredientes.length %></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Ingredientes con Stock</div>
                                    <div class="fs-4 fw-bold text-success">
                                        <%= ingredientes.filter(i => i.stock_disponible >= i.cantidad_requerida).length %>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Ingredientes sin Stock</div>
                                    <div class="fs-4 fw-bold text-danger">
                                        <%= ingredientes.filter(i => i.stock_disponible < i.cantidad_requerida).length %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Modal Agregar/Editar Ingrediente -->
    <div class="modal fade" id="ingredienteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
           <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="fa-solid fa-plus-circle me-2 text-primary"></i>
                        <span id="modalTitle">Agregar Ingrediente</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="ingredienteForm">
                    <div class="modal-body">
                        <input type="hidden" id="recetaId" name="id">
                        <input type="hidden" id="platilloId" value="<%= platillo.id %>">
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ingrediente <span class="text-danger">*</span></label>
                            <select class="form-select" id="productoId" name="producto_id" required>
                                <option value="">Seleccione un ingrediente</option>
                                <% productos.forEach(producto => { %>
                                    <option value="<%= producto.id %>"><%= producto.nombre %> (<%= producto.codigo || 'N/A' %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Cantidad <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="cantidadRequerida" name="cantidad_requerida" step="0.001" min="0.001" required>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Unidad de Medida</label>
                            <select class="form-select" id="unidadMedida" name="unidad_medida">
                                <option value="">Seleccione unidad</option>
                                <option value="kg">Kilogramos (kg)</option>
                                <option value="g">Gramos (g)</option>
                                <option value="l">Litros (l)</option>
                                <option value="ml">Mililitros (ml)</option>
                                <option value="unidad">Unidad</option>
                                <option value="pieza">Pieza</option>
                                <option value="caja">Caja</option>
                                <option value="botella">Botella</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tipo de Platillo</label>
                            <select class="form-select" id="tipoPlatillo" name="tipo_platillo">
                                <option value="comida">Comida</option>
                                <option value="trago">Trago</option>
                                <option value="coctel">Coctel</option>
                            </select>
                        </div>
                        
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="activo" name="activo" checked>
                            <label class="form-check-label" for="activo">Ingrediente Activo</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-save me-2"></i>Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>
        const ingredienteModal = new bootstrap.Modal(document.getElementById('ingredienteModal'));
        const ingredienteForm = document.getElementById('ingredienteForm');
        const platilloId = <%- JSON.stringify(platillo.id) %>;

        function openEditModal(id) {
            fetch(`/admin/api/recetas/${id}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('recetaId').value = id;
                        document.getElementById('productoId').value = data.data.producto_id;
                        document.getElementById('cantidadRequerida').value = data.data.cantidad_requerida;
                        document.getElementById('unidadMedida').value = data.data.unidad_medida || '';
                        document.getElementById('tipoPlatillo').value = data.data.tipo_platillo || 'comida';
                        document.getElementById('activo').checked = data.data.activo;
                        document.getElementById('modalTitle').textContent = 'Editar Ingrediente';
                        ingredienteModal.show();
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                })
                .catch(error => Swal.fire('Error', 'No se pudo cargar el ingrediente', 'error'));
        }

        function deleteIngrediente(id) {
            Swal.fire({
                title: '¿Eliminar ingrediente?',
                text: 'Esta acción no se puede deshacer',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/api/recetas/${id}`, {
                        method: 'DELETE'
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire('Eliminado', data.message, 'success').then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    })
                    .catch(error => Swal.fire('Error', 'No se pudo eliminar el ingrediente', 'error'));
                }
            });
        }

        ingredienteForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const recetaId = document.getElementById('recetaId').value;
            const url = recetaId ? `/admin/api/recetas/${recetaId}` : '/admin/api/recetas';
            const method = recetaId ? 'PUT' : 'POST';

            const data = {
                platillo_id: platilloId,
                producto_id: formData.get('producto_id'),
                cantidad_requerida: formData.get('cantidad_requerida'),
                unidad_medida: formData.get('unidad_medida'),
                tipo_platillo: formData.get('tipo_platillo'),
                activo: document.getElementById('activo').checked
            };

            fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire('Éxito', data.message, 'success').then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            })
            .catch(error => Swal.fire('Error', 'No se pudo guardar el ingrediente', 'error'));
        });

        document.getElementById('ingredienteModal').addEventListener('hidden.bs.modal', function() {
            ingredienteForm.reset();
            document.getElementById('recetaId').value = '';
            document.getElementById('modalTitle').textContent = 'Agregar Ingrediente';
        });
    </script>
</body>
</html>
