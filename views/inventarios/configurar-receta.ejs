<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurar Receta - <%= (platillo && platillo.nombre) ? platillo.nombre : 'Ficha Técnica' %></title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css"> 
</head>
<body>

    <div class="toast-container-custom">
        <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
            <div class="toast show text-white bg-danger border-0 shadow" role="alert" id="liveToast">
                <div class="d-flex">
                    <div class="toast-body fw-semibold fs-7">
                        <i class="fa-solid fa-circle-xmark me-2"></i><%= error_msg %>
                    </div>
                    <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        <% } %>
        
        <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
            <div class="toast show text-white bg-success border-0 shadow" role="alert" id="liveToastSuccess">
                <div class="d-flex">
                    <div class="toast-body fw-semibold fs-7">
                        <i class="fa-solid fa-circle-check me-2"></i><%= success_msg %>
                    </div>
                    <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        <% } %>
    </div>

    <%- include('../includes/topBarMobile') %>

    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>
            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4">
                <%- include('../includes/header', {
                    encabezado_pagina: '🍽️ Configurar Receta', 
                    desc_pagina: `Ingredientes para: <strong>${(platillo && platillo.nombre) ? platillo.nombre : (platillo && platillo.receta_nombre ? platillo.receta_nombre : 'Ficha')}</strong>`, 
                    add_btn: true, 
                    btn_label: "Agregar Ingrediente", 
                    modal: "ingredienteModal",
                    back_btn: true,
                    back_url: '/admin/recetas'
                }) %>

                <%
                    const almProduccion = (typeof almacenesProduccion !== 'undefined' && almacenesProduccion) ? almacenesProduccion : [];
                    const almLogisticos = (typeof almacenesLogisticos !== 'undefined' && almacenesLogisticos) ? almacenesLogisticos : [];
                    const fmtStock = (n) => {
                        const v = parseFloat(n || 0);
                        return (Math.round(v * 10000) / 10000).toLocaleString('es-ES', { maximumFractionDigits: 4 });
                    };
                    // Cantidad realmente necesaria por porción, incluyendo merma
                    const requeridoConMerma = (ing) => {
                        const cant = parseFloat(ing.cantidad_requerida || 0);
                        const merma = parseFloat(ing.porcentaje_merma || 0);
                        return merma > 0 ? cant * (1 + merma / 100) : cant;
                    };
                %>

                <% if (almProduccion.length === 0) { %>
                    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-3 mb-4">
                        <i class="fa-solid fa-triangle-exclamation fs-4 mt-1"></i>
                        <div>
                            <div class="fw-bold">No hay almacenes de producción configurados</div>
                            <div class="small">
                                El descuento de insumos por venta en el POS solo ocurre en almacenes de categoría
                                <strong>Producción</strong>. Asigna esa categoría a los almacenes de cocina, bar o
                                pastelería en <a href="/admin/almacenes" class="alert-link">Gestión de Almacenes</a>
                                para que esta ficha muestre existencias reales.
                            </div>
                        </div>
                    </div>
                <% } %>

                <div class="alert alert-light border shadow-sm d-flex align-items-start gap-3 mb-4 py-2">
                    <i class="fa-solid fa-circle-info text-primary mt-1"></i>
                    <div class="small text-secondary">
                        El <strong class="text-dark">stock de producción</strong> es el único que respalda una venta:
                        al cobrar en el POS los insumos se descuentan de los almacenes de producción.
                        El <strong class="text-dark">stock logístico</strong> es de referencia — abastece a producción
                        mediante transferencias y nunca se descuenta por venta.
                    </div>
                </div>

                <div class="card card-custom shadow-sm border-0 overflow-hidden mb-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-custom-thead text-uppercase fs-7 bg-light">
                                    <tr>
                                        <th class="ps-4 py-3">Ingrediente / Insumo</th>
                                        <th class="py-3 text-end">Cantidad Req.</th>
                                        <th class="py-3">Unidad</th>
                                        <th class="py-3 text-center">% Merma</th>
                                        <th class="py-3 text-center">Tipo</th>
                                        <th class="py-3 text-center border-start" style="min-width: 180px;">
                                            <i class="fa-solid fa-warehouse me-1 text-secondary"></i>Stock Logístico
                                            <div class="text-muted fw-normal text-lowercase fs-8">solo referencia</div>
                                        </th>
                                        <th class="py-3 text-center border-start bg-body-tertiary" style="min-width: 200px;">
                                            <i class="fa-solid fa-utensils me-1 text-primary"></i>Stock Producción
                                            <div class="text-muted fw-normal text-lowercase fs-8">descuenta el POS</div>
                                        </th>
                                        <th class="text-center py-3 border-start" style="width: 120px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!ingredientes || ingredientes.length === 0) { %>
                                        <tr>
                                            <td colspan="8" class="text-center py-5 text-muted">
                                                <i class="fa-solid fa-carrot d-block fs-2 mb-2 text-secondary"></i> 
                                                No hay ingredientes configurados para esta ficha técnica.
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% ingredientes.forEach(ingrediente => { %>
                                            <% 
                                                const cant = parseFloat(ingrediente.cantidad_requerida || 0);
                                                const cantTotal = requeridoConMerma(ingrediente);
                                                const stockLogistico = parseFloat(ingrediente.stock_logistico || 0);
                                                const stockProduccion = parseFloat(ingrediente.stock_produccion || 0);
                                                const detalleLogistico = ingrediente.almacenes_logisticos || [];
                                                const detalleProduccion = ingrediente.almacenes_produccion || [];
                                                const tieneStock = stockProduccion >= cantTotal && cantTotal > 0;
                                                const porcionesPosibles = cantTotal > 0 ? Math.floor(stockProduccion / cantTotal) : null;
                                                const unidad = ingrediente.unidad_medida || '';
                                            %>
                                            <tr>
                                                <td class="ps-4 fw-semibold text-dark">
                                                    <i class="fa-solid fa-box me-2 text-primary"></i>
                                                    <%= ingrediente.producto_nombre %>
                                                    <div class="text-muted small font-monospace"><%= ingrediente.producto_codigo || 'S/C' %></div>
                                                </td>
                                                <td class="fw-bold text-dark text-end font-monospace">
                                                    <%= cant.toFixed(4).replace(/\.?0+$/, '') || '0' %>
                                                    <% if (cantTotal > cant) { %>
                                                        <div class="text-muted fw-normal fs-8">c/merma: <%= fmtStock(cantTotal) %></div>
                                                    <% } %>
                                                </td>
                                                <td><span class="badge bg-light text-dark border"><%= unidad || '—' %></span></td>
                                                <td class="text-center font-monospace text-muted fs-7">
                                                    <%= parseFloat(ingrediente.porcentaje_merma || 0).toFixed(1) %>%
                                                </td>
                                                <td class="text-center">
                                                    <% if (ingrediente.es_opcional) { %>
                                                        <span class="badge bg-info-subtle text-info-emphasis rounded-pill fs-8">Opcional</span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill fs-8">Indispensable</span>
                                                    <% } %>
                                                </td>

                                                <!-- Existencias en almacenes logísticos (referencia / abastecimiento) -->
                                                <td class="text-center border-start">
                                                    <span class="badge bg-light text-dark border px-3 py-1 rounded-pill fs-7 font-monospace">
                                                        <i class="fa-solid fa-warehouse me-1 text-secondary"></i>
                                                        <%= fmtStock(stockLogistico) %> <%= unidad %>
                                                    </span>
                                                    <% if (detalleLogistico.length > 0) { %>
                                                        <div class="mt-1 text-start d-inline-block">
                                                            <% detalleLogistico.forEach(a => { %>
                                                                <div class="fs-8 text-muted d-flex justify-content-between gap-2">
                                                                    <span><%= a.nombre %></span>
                                                                    <span class="font-monospace <%= parseFloat(a.stock) > 0 ? 'text-dark' : 'text-danger' %>"><%= fmtStock(a.stock) %></span>
                                                                </div>
                                                            <% }) %>
                                                        </div>
                                                    <% } else { %>
                                                        <div class="fs-8 text-muted mt-1">Sin almacén logístico</div>
                                                    <% } %>
                                                </td>

                                                <!-- Existencias en almacenes de producción (las que sostienen la venta) -->
                                                <td class="text-center border-start bg-body-tertiary">
                                                    <span class="badge <%= tieneStock ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle' %> px-3 py-1 rounded-pill fs-7 font-monospace">
                                                        <i class="fa-solid <%= tieneStock ? 'fa-check' : 'fa-triangle-exclamation' %> me-1"></i>
                                                        <%= fmtStock(stockProduccion) %> <%= unidad %>
                                                    </span>
                                                    <% if (detalleProduccion.length > 0) { %>
                                                        <div class="mt-1 text-start d-inline-block">
                                                            <% detalleProduccion.forEach(a => { %>
                                                                <% const ok = parseFloat(a.stock) >= cantTotal && cantTotal > 0; %>
                                                                <div class="fs-8 d-flex justify-content-between gap-2">
                                                                    <span class="text-muted"><%= a.nombre %></span>
                                                                    <span class="font-monospace fw-semibold <%= ok ? 'text-success' : (parseFloat(a.stock) > 0 ? 'text-warning-emphasis' : 'text-danger') %>">
                                                                        <%= fmtStock(a.stock) %>
                                                                    </span>
                                                                </div>
                                                            <% }) %>
                                                        </div>
                                                    <% } else { %>
                                                        <div class="fs-8 text-danger mt-1">Sin almacén de producción</div>
                                                    <% } %>
                                                    <% if (porcionesPosibles !== null && detalleProduccion.length > 0) { %>
                                                        <div class="fs-8 text-muted mt-1 border-top pt-1">
                                                            Alcanza para <strong class="<%= porcionesPosibles > 0 ? 'text-dark' : 'text-danger' %>"><%= porcionesPosibles %></strong> porción(es)
                                                        </div>
                                                    <% } %>
                                                </td>

                                                <td class="text-center pe-3 border-start">
                                                    <div class="btn-group gap-1">
                                                        <% if (user && ['superadministrador', 'administrador', 'jefe-cocina'].includes(user.rol)) { %>
                                                            <button type="button" class="btn btn-sm btn-outline-danger border-0 btn-eliminar-ingrediente" 
                                                                    data-id="<%= ingrediente.id %>" 
                                                                    data-nombre="<%= ingrediente.producto_nombre || 'Ingrediente' %>" 
                                                                    title="Eliminar Ingrediente">
                                                                <i class="fa-solid fa-trash pointer-events-none"></i>
                                                            </button>
                                                        <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Resumen de Costos -->
                <div class="card card-custom shadow-sm border-0">
                    <div class="card-header bg-white border-0 py-3">
                        <h6 class="fw-bold mb-0"><i class="fa-solid fa-chart-pie me-2 text-primary"></i>Resumen de Receta</h6>
                        <div class="text-muted fs-8">La disponibilidad se evalúa contra el stock de los almacenes de producción</div>
                    </div>
                    <div class="card-body">
                        <%
                            const listaIng = ingredientes || [];
                            const cubiertos = listaIng.filter(i => parseFloat(i.stock_produccion || 0) >= requeridoConMerma(i));
                            const faltantes = listaIng.filter(i => parseFloat(i.stock_produccion || 0) < requeridoConMerma(i));
                            // Solo en logística: hay existencia en el central pero cero en producción -> requiere transferencia
                            const porTransferir = listaIng.filter(i =>
                                parseFloat(i.stock_produccion || 0) < requeridoConMerma(i) &&
                                parseFloat(i.stock_logistico || 0) > 0
                            );
                            const porcionesReceta = listaIng
                                .filter(i => !i.es_opcional)
                                .map(i => {
                                    const req = requeridoConMerma(i);
                                    return req > 0 ? Math.floor(parseFloat(i.stock_produccion || 0) / req) : null;
                                })
                                .filter(v => v !== null);
                            const porcionesMax = porcionesReceta.length ? Math.min(...porcionesReceta) : 0;
                        %>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Total Ingredientes</div>
                                    <div class="fs-4 fw-bold text-dark"><%= listaIng.length %></div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Con stock en Producción</div>
                                    <div class="fs-4 fw-bold text-success"><%= cubiertos.length %></div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Sin stock en Producción</div>
                                    <div class="fs-4 fw-bold text-danger"><%= faltantes.length %></div>
                                    <% if (porTransferir.length > 0) { %>
                                        <div class="fs-8 text-warning-emphasis mt-1">
                                            <i class="fa-solid fa-truck-fast me-1"></i>
                                            <%= porTransferir.length %> disponible(s) en logístico — requiere transferencia
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Porciones elaborables</div>
                                    <div class="fs-4 fw-bold <%= porcionesMax > 0 ? 'text-primary' : 'text-danger' %>"><%= porcionesMax %></div>
                                    <div class="fs-8 text-muted mt-1">Según el insumo indispensable más escaso</div>
                                </div>
                            </div>
                        </div>

                        <% if (porTransferir.length > 0) { %>
                            <div class="alert alert-warning border-0 mt-3 mb-0 py-2 d-flex align-items-start gap-2">
                                <i class="fa-solid fa-truck-fast mt-1"></i>
                                <div class="small">
                                    Hay insumos con existencia en el <strong>almacén logístico</strong> pero sin stock suficiente
                                    en producción:
                                    <strong><%= porTransferir.map(i => i.producto_nombre).join(', ') %></strong>.
                                    Realiza una <a href="/admin/transferencias" class="alert-link">transferencia a producción</a>
                                    para poder venderlos, ya que el POS nunca descuenta del logístico.
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Modal Agregar Ingrediente -->
    <div class="modal fade" id="ingredienteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
           <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="fa-solid fa-plus-circle me-2 text-warning"></i>
                        <span id="modalTitle">Agregar Ingrediente</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="ingredienteForm">
                    <div class="modal-body">
                        <input type="hidden" id="recetaId" name="receta_id" value="<%= platillo ? platillo.id : '' %>">
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ingrediente <span class="text-danger">*</span></label>
                            <select class="form-select" id="productoId" name="producto_id" required>
                                <option value="">Seleccione un ingrediente</option>
                                <% if (typeof productos !== 'undefined') { %>
                                    <% productos.forEach(producto => { %>
                                        <option value="<%= producto.id %>"><%= producto.nombre %> (<%= producto.codigo || 'S/C' %>)</option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Cantidad <span class="text-danger">*</span></label>
                            <input type="number" class="form-control font-monospace" id="cantidadRequerida" name="cantidad_requerida" step="0.0001" min="0.0001" required placeholder="0.0000">
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Unidad de Medida</label>
                            <select class="form-select" id="unidadMedida" name="unidad_medida">
                                <option value="">Seleccione unidad</option>
                                <% if (typeof unidades !== 'undefined') { %>
                                    <% unidades.forEach(u => { %>
                                        <option value="<%= u.nombre %>"><%= u.nombre %> (<%= u.abreviatura %>)</option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">% Merma Estimada</label>
                            <input type="number" class="form-control font-monospace" id="porcentajeMerma" name="porcentaje_merma" step="0.01" min="0" max="99" value="0.00">
                        </div>
                        
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="esOpcional" name="es_opcional">
                            <label class="form-check-label" for="esOpcional">Ingrediente Opcional (No bloquea comanda si no hay stock)</label>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-save me-2"></i>Guardar Ingrediente
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ingredienteModalEl = document.getElementById('ingredienteModal');
            const ingredienteModal = ingredienteModalEl ? new bootstrap.Modal(ingredienteModalEl) : null;
            const ingredienteForm = document.getElementById('ingredienteForm');

            // Event delegation para eliminar ingrediente cumpliendo con Content-Security-Policy
            document.addEventListener('click', function(e) {
                const btn = e.target.closest('.btn-eliminar-ingrediente');
                if (!btn) return;

                const detalleId = btn.dataset.id;
                const nombre = btn.dataset.nombre || 'el ingrediente';

                Swal.fire({
                    title: '¿Eliminar ingrediente?',
                    text: `¿Desea remover "${nombre}" de esta ficha técnica?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fa-solid fa-trash me-1"></i> Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Notificación interactiva del proceso de eliminación
                        Swal.fire({
                            title: 'Eliminando ingrediente...',
                            html: `Removiendo <b>${nombre}</b> de la ficha técnica.<br><small class="text-muted">Actualizando disponibilidad y stock...</small>`,
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            showConfirmButton: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        fetch(`/admin/api/recetas/detalles/${detalleId}`, {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' }
                        })
                        .then(r => r.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    title: '¡Eliminado!',
                                    text: data.message,
                                    icon: 'success',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => window.location.reload());
                            } else {
                                Swal.fire('Error', data.message || 'No se pudo eliminar el ingrediente', 'error');
                            }
                        })
                        .catch(() => {
                            Swal.fire('Error', 'Error de conexión con el servidor al eliminar', 'error');
                        });
                    }
                });
            });

            // Guardar nuevo ingrediente mediante AJAX
            if (ingredienteForm) {
                ingredienteForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const formData = new FormData(ingredienteForm);
                    const payload = {
                        receta_id: formData.get('receta_id'),
                        producto_id: formData.get('producto_id'),
                        cantidad_requerida: parseFloat(formData.get('cantidad_requerida')),
                        unidad_medida: formData.get('unidad_medida'),
                        porcentaje_merma: parseFloat(formData.get('porcentaje_merma') || 0),
                        es_opcional: formData.get('es_opcional') === 'on'
                    };

                    fetch('/admin/api/recetas/detalles', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            if (ingredienteModal) ingredienteModal.hide();
                            Swal.fire('¡Guardado!', data.message, 'success').then(() => window.location.reload());
                        } else {
                            Swal.fire('Error', data.message || 'No se pudo registrar el ingrediente', 'error');
                        }
                    })
                    .catch(() => {
                        Swal.fire('Error', 'Error de comunicación con el servidor', 'error');
                    });
                });
            }
        });
    </script>
</body>
</html>
