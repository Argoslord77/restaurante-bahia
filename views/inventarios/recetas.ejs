<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Fichas Técnicas - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/select2.min.css"/>
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        /* Integración estética de Select2 con Bootstrap 5 */
        .select2-container--default .select2-selection--single {
            height: calc(3.5rem + 2px);
            padding: 0.375rem 0.75rem;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            box-shadow: 0 .125rem .25rem rgba(0,0,0,.075)!important;
            display: flex;
            align-items: center;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 100%;
            top: 0;
            right: 10px;
        }
        .select2-container {
            width: 100% !important;
        }
        /* Ajuste de altura específico para los buscadores pequeños dentro de las filas de la tabla */
        .table .select2-container--default .select2-selection--single {
            height: calc(2.25rem + 2px);
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }
    </style>
</head>
<body>

    <div id="data-productos-json" style="display: none;" data-json="<%= JSON.stringify(productos || []) %>"></div>
    <div id="data-unidades-json" style="display: none;" data-json="<%= JSON.stringify(unidades || []) %>"></div>

    <div class="toast-container-custom">
        <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
            <div class="toast show text-white bg-danger border-0 shadow" role="alert" id="liveToast">
                <div class="d-flex">
                    <div class="toast-body fw-semibold fs-7">
                        <i class="fa-solid fa-circle-xmark me-2"></i><%= error_msg %>
                    </div>
                    <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        <% } %>
    </div>

    <%- include('../includes/topBarMobile') %>
    
    <%- include('../includes/sideBarMenu') %>

    <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">
        
        <%- include('../includes/header', {
            encabezado_pagina: 'Estructuración de Fichas Técnicas (Recetas)', 
            desc_pagina: 'Mapea la composición maestro-detalle de tus platos y bebidas de venta para automatizar el descuento FIFO de inventario.', 
            add_btn: true, 
            btn_label: "Nueva Receta Base", 
            modal: "recetaModal"
        }) %>

        <div class="card card-custom shadow-sm border-0 overflow-hidden mt-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-custom-thead text-uppercase fs-7 bg-light">
                        <tr>
                            <th class="ps-4 py-3">Código / Receta</th>
                            <th class="py-3">Producto Terminado (Menú)</th>
                            <th class="py-3">Tipo Receta</th>
                            <th class="text-end py-3">Rendimiento Base</th>
                            <th class="text-end py-3">Costo Estimado</th>
                            <th class="text-end py-3">Precio Menú</th>
                            <th class="text-center py-3">Estado</th>
                            <th class="text-center py-3" style="width: 120px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof recetas !== 'undefined' && recetas.length > 0) { %>
                            <% recetas.forEach(r => { %>
                                <tr>
                                    <td class="ps-4">
                                        <div class="font-monospace fw-bold text-primary">#<%= r.codigo %></div>
                                        <small class="text-muted fs-7">v1.0 (Activa)</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= r.receta_nombre %></div>
                                        <span class="badge bg-light text-secondary border fs-8"><%= r.unidad_rendimiento %></span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary fw-semibold"><%= r.tipo %></span>
                                    </td>
                                    <td class="text-end font-monospace fw-semibold"><%= parseFloat(r.rendimiento).toFixed(2) %></td>
                                    <td class="text-end font-monospace text-danger fw-bold">$<%= parseFloat(r.costo_estimado).toFixed(2) %></td>
                                    <td class="text-end font-monospace text-success fw-bold">$<%= r.precio_sugerido ? parseFloat(r.precio_sugerido).toFixed(2) : '0.00' %></td>
                                    <td class="text-center">
                                        <% if(r.activa) { %>
                                            <span class="badge bg-success-subtle text-success px-3 rounded-pill">VIGENTE</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary-subtle text-secondary px-3 rounded-pill">INACTIVA</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-outline-secondary edit-btn" 
                                                    data-id="<%= r.id %>" 
                                                    data-codigo="<%= r.codigo %>"
                                                    data-nombre="<%= r.receta_nombre %>"
                                                    data-descripcion="<%= r.descripcion %>"
                                                    data-tipo="<%= r.tipo %>"
                                                    data-producto="<%= r.platillo_id %>"
                                                    data-rendimiento="<%= r.rendimiento %>"
                                                    data-unidad="<%= r.unidad_rendimiento %>"
                                                    data-tiempo="<%= r.tiempo_preparacion_minutos %>"
                                                    data-costo="<%= r.costo_estimado %>"
                                                    data-precio="<%= r.precio_sugerido %>"
                                                    data-observaciones="<%= r.observaciones %>">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary opciones-btn" 
                                                    data-id="<%= r.id %>" 
                                                    data-nombre="<%= r.receta_nombre %>" 
                                                    data-activa="<%= r.activa %>"
                                                    title="Opciones de Ficha Técnica">
                                                <i class="fa-solid fa-gears"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-kitchen-set d-block fs-2 mb-2 text-secondary"></i>
                                    No se registran fichas técnicas maestras en el sistema.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <footer class="mt-auto">
            <%- include('../includes/footer') %>
        </footer>
    </main>

    <div class="modal fade" id="recetaModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <form id="recetaForm" class="modal-content border-0 shadow">
                <input type="hidden" id="recetaId" name="id">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="modalTitle"><i class="fa-solid fa-utensils me-2"></i>Nueva Receta Base</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="bg-light p-3 rounded border mb-4 shadow-sm">
                        <h6 class="text-primary fw-bold mb-3"><i class="fa-solid fa-paste me-2"></i>Datos Generales (Maestro)</h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label for="codigo" class="form-label fw-semibold text-secondary small">Código Ficha</label>
                                <input type="text" class="form-control shadow-sm font-monospace text-uppercase" id="codigo" name="codigo" required placeholder="REC-XYZ">
                            </div>
                            <div class="col-md-5">
                                <label for="nombre" class="form-label fw-semibold text-secondary small">Nombre Comercial de la Receta</label>
                                <input type="text" class="form-control shadow-sm" id="nombre" name="nombre" required placeholder="Ej. Lomo Saltado Criollo">
                            </div>
                            <div class="col-md-4">
                                <label for="tipo" class="form-label fw-semibold text-secondary small">Tipo Operación</label>
                                <select class="form-select shadow-sm" id="tipo" name="tipo" required>
                                    <option value="VENTA">VENTA (Descuento POS Directo)</option>
                                    <option value="PREPARACION_INTERNA">PREPARACIÓN INTERNA (Sub-receta)</option>
                                    <option value="PRODUCCION">PRODUCCIÓN EN LOTE</option>
                                </select>
                            </div>
                            
                            <div class="col-md-6">
                                <label for="platillo_id" class="form-label fw-semibold text-secondary small">Producto Terminado / Menú (Buscador)</label>
                                <select class="form-select shadow-sm select2-producto-maestro" id="platillo_id" name="platillo_id" required>
                                    <option value="">Escriba el nombre o código del platillo...</option>
                                    <% if (typeof platillos !== 'undefined') { %>
                                        <% platillos.forEach(p => { %>
                                            <option value="<%= p.id %>">[<%= p.codigo %>] <%= p.nombre %></option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label for="rendimiento" class="form-label fw-semibold text-secondary small">Rendimiento Cantidad</label>
                                <input type="number" step="0.001" class="form-control shadow-sm font-monospace" id="rendimiento" name="rendimiento" value="1.000" required>
                            </div>
                            
                            <div class="col-md-3">
                                <label for="unidad_rendimiento" class="form-label fw-semibold text-secondary small">Unidad Rendimiento</label>
                                <select class="form-select shadow-sm select2-unidad-maestro" id="unidad_rendimiento" name="unidad_rendimiento" required>
                                    <option value="">Seleccione magnitud...</option>
                                    <% if (typeof unidades !== 'undefined') { %>
                                        <% unidades.forEach(u => { %>
                                            <option value="<%= u.nombre %>"><%= u.nombre %> (<%= u.abreviatura %>)</option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label for="tiempo_preparacion_minutos" class="form-label fw-semibold text-secondary small">Tiempo Preparación (Minutos)</label>
                                <input type="number" class="form-control shadow-sm font-monospace" id="tiempo_preparacion_minutos" name="tiempo_preparacion_minutos" placeholder="0">
                            </div>
                            <div class="col-md-3">
                                <label for="precio_sugerido" class="form-label fw-semibold text-secondary small">Precio en Carta ($)</label>
                                <input type="number" step="0.01" class="form-control shadow-sm font-monospace text-success fw-bold" id="precio_sugerido" name="precio_sugerido" placeholder="0.00">
                            </div>
                            <div class="col-md-6">
                                <label for="descripcion" class="form-label fw-semibold text-secondary small">Descripción Breve</label>
                                <input type="text" class="form-control shadow-sm" id="descripcion" name="descripcion" placeholder="Ej. Receta estándar para el turno almuerzo y cena.">
                            </div>
                        </div>
                    </div>

                    <div class="border rounded overflow-hidden shadow-sm">
                        <div class="bg-dark text-white px-3 py-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold small text-uppercase"><i class="fa-solid fa-basket-shopping me-2 text-warning"></i>Insumos y Componentes de la Ficha</span>
                            <button type="button" id="btnAgregarFila" class="btn btn-warning btn-sm fw-bold px-3"><i class="fa-solid fa-plus me-1"></i>Añadir Insumo</button>
                        </div>
                        <div class="table-responsive" style="max-height: 280px;">
                            <table class="table table-sm table-hover align-middle mb-0" id="tablaIngredientes">
                                <!-- En la tabla #tablaIngredientes del modal -->
                                <thead class="bg-light fs-7 text-uppercase border-bottom">
                                    <tr>
                                        <th class="ps-3 py-2" style="width: 34%;">Materia Prima / Insumo</th>
                                        <th class="py-2" style="width: 14%;">Cant. Neta</th>
                                        <th class="py-2" style="width: 20%;">Unidad de Medida</th>
                                        <th class="py-2" style="width: 12%;">% Merma</th>
                                        <th class="text-center py-2" style="width: 10%;">Opcional</th>
                                        <th class="text-center py-2" style="width: 10%;">Remover</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyIngredientes"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar Operación</button>
                    <button type="submit" class="btn btn-success px-4 shadow-sm fw-bold">Guardar Ficha Técnica</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script src="/js/libs/select2.min.js"></script>

    <script>
        // PARSEO INTEGRAL Y SEGURO DESDE ELEMENTOS DOM
        const productosDisponibles = JSON.parse(document.getElementById('data-productos-json').getAttribute('data-json'));
        const unidadesDisponibles = JSON.parse(document.getElementById('data-unidades-json').getAttribute('data-json'));
        
        const tbodyIngredientes = document.getElementById('tbodyIngredientes');
        const btnAgregarFila = document.getElementById('btnAgregarFila');
        const recetaForm = document.getElementById('recetaForm');
        const modalElement = document.getElementById('recetaModal');
        const bsModal = new bootstrap.Modal(modalElement);

        // Inicializar Select2 acoplado al modal de Bootstrap para los campos Maestro
        $(modalElement).on('shown.bs.modal', function () {
            $('.select2-producto-maestro').select2({
                dropdownParent: $(modalElement),
                placeholder: "Escriba el nombre o código del platillo...",
                allowClear: true
            });

            $('.select2-unidad-maestro').select2({
                dropdownParent: $(modalElement),
                placeholder: "Seleccione unidad...",
                allowClear: true
            });
            
            inicializarSelect2Detalles();
        });

        // Inicializar Select2 en selectores de la tabla de ingredientes
        function inicializarSelect2Detalles() {
            $(modalElement).find('.select2-insumo-detalle, .select2-unidad-detalle').each(function() {
                if (!$(this).hasClass("select2-hidden-accessible")) {
                    const esUnidad = $(this).hasClass('select2-unidad-detalle');
                    $(this).select2({
                        dropdownParent: $(modalElement),
                        placeholder: esUnidad ? "Medida..." : "Buscar insumo...",
                        allowClear: true
                    });
                }
            });
        }

        function crearFilaBaseHTML(datos = {}) {
            const tr = document.createElement('tr');
            
            let opcionesProductos = `<option value="">Buscar insumo...</option>`;
            productosDisponibles.forEach(p => {
                const selected = datos.producto_id == p.id ? 'selected' : '';
                opcionesProductos += `<option value="${p.id}" ${selected}>[${p.codigo}] ${p.nombre}</option>`;
            });

            let opcionesUnidades = `<option value="">Medida...</option>`;
            unidadesDisponibles.forEach(u => {
                const selected = datos.unidad_medida == u.nombre ? 'selected' : '';
                opcionesUnidades += `<option value="${u.nombre}" ${selected}>${u.nombre} (${u.abreviatura})</option>`;
            });

            const checkOpcional = datos.es_opcional ? 'checked' : '';

            tr.innerHTML = `
                <td class="ps-3">
                    <select class="form-select form-select-sm combo-producto select2-insumo-detalle" required>
                        ${opcionesProductos}
                    </select>
                </td>
                <td>
                    <input type="number" step="0.0001" class="form-control form-select-sm font-monospace input-cantidad" value="${datos.cantidad_requerida || '0.0000'}" required>
                </td>
                <td>
                    <select class="form-select form-select-sm combo-unidad select2-unidad-detalle" required>
                        ${opcionesUnidades}
                    </select>
                </td>
                <td>
                    <input type="number" step="0.01" class="form-control form-select-sm font-monospace input-merma" value="${datos.porcentaje_merma || '0.00'}" min="0" max="99">
                </td>
                <td class="text-center align-middle">
                    <div class="form-check d-flex justify-content-center mb-0">
                        <input class="form-check-input check-opcional" type="checkbox" ${checkOpcional} title="Si está marcado, la falta de stock de este ingrediente NO bloqueará la venta">
                    </div>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-fila"><i class="fa-solid fa-trash-can"></i></button>
                </td>
            `;
            // ... resto de event listeners igual
            return tr;
        }

        btnAgregarFila.addEventListener('click', () => {
            const nuevaFila = crearFilaBaseHTML();
            tbodyIngredientes.appendChild(nuevaFila);
            
            $(nuevaFila).find('.select2-insumo-detalle, .select2-unidad-detalle').each(function() {
                const esUnidad = $(this).hasClass('select2-unidad-detalle');
                $(this).select2({
                    dropdownParent: $(modalElement),
                    placeholder: esUnidad ? "Medida..." : "Buscar insumo...",
                    allowClear: true
                });
            });
        });

        // Configurar modal al presionar "Nuevo"
        document.addEventListener('click', (e) => {
            const tgt = e.target.closest('[data-bs-target="recetaModal"]') || e.target.closest('[data-bs-target="#recetaModal"]');
            if (tgt) {
                e.preventDefault();
                document.getElementById('recetaId').value = '';
                document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-plus me-2"></i>Nueva Receta Base';
                recetaForm.reset();
                $('.select2-producto-maestro').val('').trigger('change'); 
                $('.select2-unidad-maestro').val('').trigger('change'); 
                
                tbodyIngredientes.innerHTML = '';
                
                const filaInicial = crearFilaBaseHTML();
                tbodyIngredientes.appendChild(filaInicial);
                
                setTimeout(() => {
                    $(filaInicial).find('.select2-insumo-detalle, .select2-unidad-detalle').each(function() {
                        const esUnidad = $(this).hasClass('select2-unidad-detalle');
                        $(this).select2({ dropdownParent: $(modalElement), placeholder: esUnidad ? "Medida..." : "Buscar insumo...", allowClear: true });
                    });
                }, 150);
                
                bsModal.show();
            }
        });

        // Escuchador para la Edición de Fichas Existentes
        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('recetaId').value = this.dataset.id;
                document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square me-2"></i>Editar Ficha Técnica';
                
                document.getElementById('codigo').value = this.dataset.codigo;
                document.getElementById('nombre').value = this.dataset.nombre;
                document.getElementById('descripcion').value = this.dataset.descripcion || '';
                document.getElementById('tipo').value = this.dataset.tipo;
                document.getElementById('rendimiento').value = this.dataset.rendimiento;
                document.getElementById('tiempo_preparacion_minutos').value = this.dataset.tiempo || '';
                document.getElementById('precio_sugerido').value = this.dataset.precio || '';

                $('.select2-producto-maestro').val(this.dataset.producto).trigger('change');
                $('.select2-unidad-maestro').val(this.dataset.unidad).trigger('change');

                tbodyIngredientes.innerHTML = '';

                // Sincronización estricta con endpoint de la API sin fragmentos '/admin'
                fetch(`/admin/api/recetas/platillo/${this.dataset.id}`)
                    .then(r => {
                        if (!r.ok) throw new Error('Error al obtener ingredientes');
                        return r.json();
                    })
                    .then(ingredientes => {
                        if(ingredientes && ingredientes.length > 0) {
                            ingredientes.forEach(ing => {
                                const fila = crearFilaBaseHTML({
                                    producto_id: ing.producto_id,
                                    cantidad_requerida: ing.cantidad_requerida,
                                    unidad_medida: ing.unidad_medida,
                                    porcentaje_merma: ing.porcentaje_merma
                                });
                                tbodyIngredientes.appendChild(fila);
                            });
                        } else {
                            tbodyIngredientes.appendChild(crearFilaBaseHTML());
                        }
                        
                        inicializarSelect2Detalles();
                        bsModal.show();
                    })
                    .catch(err => {
                        console.error(err);
                        tbodyIngredientes.appendChild(crearFilaBaseHTML());
                        inicializarSelect2Detalles();
                        bsModal.show();
                    });
            });
        });

        // Limpieza al cerrar el modal
        modalElement.addEventListener('hidden.bs.modal', function() {
            $('.select2-insumo-detalle, .select2-unidad-detalle').each(function() {
                if ($(this).data('select2')) {
                    $(this).select2('destroy');
                }
            });
            recetaForm.reset();
            $('.select2-producto-maestro').val('').trigger('change');
            $('.select2-unidad-maestro').val('').trigger('change');
            document.getElementById('recetaId').value = '';
        });

        // Envío Estructurado Maestro-Detalle Embebido via AJAX
        recetaForm.addEventListener('submit', function(e) {
            e.preventDefault();

            const recetaId = document.getElementById('recetaId').value;
            const esEdicion = recetaId && recetaId !== "";
            const url = esEdicion ? `/admin/api/recetas/${recetaId}` : '/admin/api/recetas';
            const method = esEdicion ? 'PUT' : 'POST';

            const filas = tbodyIngredientes.querySelectorAll('tr');
            const detalles = [];
            // Dentro del event listener submit de recetaForm:
            filas.forEach((fila, index) => {
                detalles.push({
                    producto_id: fila.querySelector('.combo-producto').value,
                    cantidad_requerida: fila.querySelector('.input-cantidad').value,
                    unidad_medida: fila.querySelector('.combo-unidad').value,
                    porcentaje_merma: fila.querySelector('.input-merma').value || 0,
                    es_opcional: fila.querySelector('.check-opcional').checked ? 1 : 0, // <-- NUEVO
                    orden_preparacion: index + 1
                });
            });

            const payload = {
                codigo: document.getElementById('codigo').value,
                nombre: document.getElementById('nombre').value,
                descripcion: document.getElementById('descripcion').value,
                tipo: document.getElementById('tipo').value,
                platillo_id: document.getElementById('platillo_id').value,
                rendimiento: document.getElementById('rendimiento').value,
                unidad_rendimiento: document.getElementById('unidad_rendimiento').value,
                tiempo_preparacion_minutos: document.getElementById('tiempo_preparacion_minutos').value || null,
                precio_sugerido: document.getElementById('precio_sugerido').value || null,
                detalles: detalles
            };

            fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire('¡Éxito!', data.message, 'success').then(() => {
                        window.location.reload();
                    });
                } else {
                    if (data.errors && Array.isArray(data.errors)) {
                        let msg = data.errors.map(err => `${err.param || err.field || 'Campo'}: ${err.msg || err.message}`).join('<br>');
                        Swal.fire({ title: 'Error de Validación', html: msg, icon: 'error' });
                    } else {
                        Swal.fire('Error', data.message || 'Error interno en la operación.', 'error');
                    }
                }
            })
            .catch(error => Swal.fire('Error', 'No se pudo guardar la receta maestro-detalle', 'error'));
        });

        // Manejador del botón "Opciones de Ficha Técnica"
        document.querySelectorAll('.opciones-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.dataset.id;
                const nombre = this.dataset.nombre;
                const estaActiva = parseInt(this.dataset.activa) === 1;

                Swal.fire({
                    title: `⚙️ Opciones: ${nombre}`,
                    text: 'Selecciona la acción que deseas realizar sobre esta ficha técnica:',
                    icon: 'question',
                    showCancelButton: true,
                    showDenyButton: true,
                    confirmButtonText: estaActiva ? '<i class="fa-solid fa-ban me-1"></i> Desactivar Receta' : '<i class="fa-solid fa-check me-1"></i> Activar Receta',
                    denyButtonText: '<i class="fa-solid fa-trash-can me-1"></i> Eliminar Definitivamente',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: estaActiva ? '#ffc107' : '#198754',
                    denyButtonColor: '#dc3545',
                    customClass: {
                        confirmButton: 'text-dark fw-bold'
                    }
                }).then((result) => {
                    // OPCIÓN 1: CAMBIAR ESTADO (Desactivar / Activar lógicamente)
                    if (result.isConfirmed) {
                        const nuevoEstado = estaActiva ? 0 : 1;
                        fetch(`/admin/api/recetas/${id}/estado`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ activa: nuevoEstado })
                        })
                        .then(r => r.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('¡Actualizado!', data.message, 'success').then(() => window.location.reload());
                            } else {
                                Swal.fire('Error', data.message || 'No se pudo cambiar el estado', 'error');
                            }
                        })
                        .catch(() => Swal.fire('Error', 'Error de conexión con el servidor', 'error'));
                    } 
                    // OPCIÓN 2: ELIMINAR REGISTRO FISICAMENTE O BAJA LÓGICA
                    else if (result.isDenied) {
                        Swal.fire({
                            title: '¿Estás seguro?',
                            text: `Esta acción eliminará la ficha técnica "${nombre}". ¿Deseas continuar?`,
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#dc3545',
                            confirmButtonText: 'Sí, eliminar',
                            cancelButtonText: 'Cancelar'
                        }).then((delResult) => {
                            if (delResult.isConfirmed) {
                                fetch(`/admin/api/recetas/${id}`, {
                                    method: 'DELETE'
                                })
                                .then(r => r.json())
                                .then(data => {
                                    if (data.success) {
                                        Swal.fire('¡Eliminada!', data.message, 'success').then(() => window.location.reload());
                                    } else {
                                        Swal.fire('Error', data.message || 'No se pudo eliminar la receta', 'error');
                                    }
                                })
                                .catch(() => Swal.fire('Error', 'Error al procesar la solicitud', 'error'));
                            }
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>