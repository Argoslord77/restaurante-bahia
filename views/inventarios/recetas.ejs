<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Fichas Técnicas - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <div class="toast-container-custom">
        <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
            <div class="toast show text-white bg-danger border-0 shadow" role="alert" id="liveToast">
                <div class="d-flex">
                    <div class="toast-body fw-semibold fs-7">
                        <i class="fa-solid fa-circle-xmark me-2"></i><%= error_msg %>
                    </div>
                    <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        <% } %>
        
        <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
            <div class="toast show text-white bg-success border-0 shadow" role="alert" id="liveToast">
                <div class="d-flex">
                    <div class="toast-body fw-semibold fs-7">
                        <i class="fa-solid fa-circle-check me-2"></i><%= success_msg %>
                    </div>
                    <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        <% } %>
    </div>

    <div class="bg-white d-md-none p-3 border-bottom d-flex align-items-center justify-content-between sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <img src="/img/favicon.png" alt="Logo" class="sidebar-logo">
            <span class="fw-bold text-dark">Restaurante Bahía</span>
        </div>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="container-fluid">
        <div class="row">
            <%- include('../includes/sideBarMenu') %>
            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4">
                <%- include('../includes/header', {
                    encabezado_pagina: '🍽️ Fichas Técnicas y Recetas', 
                    desc_pagina: 'Gestión de cabeceras de recetas de platillos, bebidas y elaboraciones internas.', 
                    add_btn: true, 
                    btn_label: "Nueva Ficha", 
                    modal: "recetaModal" 
                }) %>

                <div class="card card-custom shadow-sm border-0 overflow-hidden">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-custom-thead text-uppercase fs-7">
                                    <tr>
                                        <th class="ps-4 py-3">Código</th>
                                        <th class="py-3">Nombre de la Receta</th>
                                        <th class="py-3">Rendimiento Base</th>
                                        <th class="py-3 text-center">Tipo</th>
                                        <th class="py-3 text-center">Estado</th>
                                        <th class="text-center py-3" style="width: 180px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (recetas.length === 0) { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted">
                                                <i class="fa-solid fa-utensils d-block fs-2 mb-2 text-secondary"></i> 
                                                No hay recetas maestras registradas.
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% recetas.forEach(receta => { %>
                                            <tr class="<%= !receta.activa ? 'opacity-50 table-light' : '' %>">
                                                <td class="ps-4 fw-mono text-secondary"><%= receta.codigo %></td>
                                                <td>
                                                    <div class="fw-semibold text-dark">
                                                        <i class="fa-solid fa-kitchen-set me-2 text-primary"></i>
                                                        <%= receta.nombre %>
                                                    </div>
                                                    <% if (receta.descripcion) { %>
                                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;"><%= receta.descripcion %></small>
                                                    <% } %>
                                                </td>
                                                <td class="fw-medium text-dark">
                                                    <%= receta.rendimiento %> <span class="text-lowercase text-muted fs-7"><%= receta.unidad_rendimiento %></span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge <%= receta.tipo === 'VENTA' ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-info-subtle text-info border border-info-subtle' %> px-3 py-1 rounded-pill fs-7">
                                                        <%= receta.tipo %>
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge <%= receta.activa ? 'bg-light text-dark border' : 'bg-danger-subtle text-danger' %> px-2 py-1 fs-7">
                                                        <%= receta.activa ? 'Activa' : 'Inactiva' %>
                                                    </span>
                                                </td>
                                                <td class="text-center pe-3">
                                                    <div class="btn-group gap-1">
                                                        <a href="/recetas/configurar/<%= receta.id %>" class="btn btn-sm btn-outline-primary border-0" title="Configurar Ingredientes Detallados">
                                                            <i class="fa-solid fa-mortar-pestle"></i>
                                                        </a>
                                                        <button class="btn btn-sm btn-outline-secondary border-0" onclick="openEditModal('<%= receta.id %>')" title="Editar Ficha">
                                                            <i class="fa-solid fa-pen-to-square"></i>
                                                        </button>
                                                        <% if (typeof user !== 'undefined' && user && ['superadministrador', 'administrador'].includes(user.rol)) { %>
                                                            <button class="btn btn-sm btn-outline-danger border-0" onclick="deleteReceta('<%= receta.id %>')" title="Dar de Baja">
                                                                <i class="fa-solid fa-trash"></i>
                                                            </button>
                                                        <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <div class="modal fade" id="recetaModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="fa-solid fa-file-invoice me-2 text-primary"></i>
                        <span id="modalTitle">Nueva Receta</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="recetaForm">
                    <div class="modal-body">
                        <input type="hidden" id="recetaId" name="id">
                        
                        <h6 class="text-primary border-bottom pb-2 mb-3 fw-bold"><i class="fa-solid fa-circle-info me-2"></i>Cabecera de la Receta</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Código Ficha <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="recetaCodigo" name="codigo" placeholder="REC-001" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Nombre de la Receta / Platillo <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="recetaNombre" name="nombre" placeholder="Ej: Ceviche Clásico" required>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Tipo Receta</label>
                                <select class="form-select" id="recetaTipo" name="tipo">
                                    <option value="VENTA">Venta</option>
                                    <option value="PRODUCCION">Producción</option>
                                </select>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Producto Resultante Relacionado <span class="text-danger">*</span></label>
                                <select class="form-select" id="productoResultanteId" name="producto_resultante_id" required>
                                    <option value="">Seleccione el ítem del menú o inventario correspondiente</option>
                                    <% productos.forEach(prod => { %>
                                        <option value="<%= prod.id %>"><%= prod.nombre %> (<%= prod.codigo || 'N/A' %>)</option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Cantidad Rendimiento <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="recetaRendimiento" name="rendimiento" step="0.001" value="1.000" required>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Unidad Rendimiento <span class="text-danger">*</span></label>
                                <select class="form-select" id="recetaUnidadRendimiento" name="unidad_rendimiento" required>
                                    <option value="" disabled selected>Seleccione...</option>
                                    <% if (typeof unidades !== 'undefined' && unidades.length > 0) { %>
                                        <% unidades.forEach(uni => { %>
                                            <option value="<%= uni.codigo %>"><%= uni.nombre %> (<%= uni.abreviatura %>)</option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Costo Estimado de Producción</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" step="0.01" class="form-control" id="recetaCostoEstimado" name="costo_estimado" placeholder="0.00">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Precio Sugerido de Venta</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" step="0.01" class="form-control" id="recetaPrecioSugerido" name="precio_sugerido" placeholder="0.00">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Tiempo Prep. (Minutos)</label>
                                <input type="number" class="form-control" id="recetaTiempo" name="tiempo_preparacion_minutos" min="0">
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Descripción / Observaciones</label>
                                <textarea class="form-control" id="recetaDescripcion" name="descripcion" rows="2"></textarea>
                            </div>
                            
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="recetaActiva" name="activa" value="1" checked>
                                    <label class="form-check-label" for="recetaActiva">Ficha Técnica Activa</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                            <h6 class="text-primary mb-0 fw-bold"><i class="fa-solid fa-basket-shopping me-2"></i>Ingredientes / Insumos de la Receta</h6>
                            <button type="button" class="btn btn-sm btn-success" id="btnAgregarIngrediente">
                                <i class="fa-solid fa-plus me-1"></i> Añadir Insumo
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered align-middle fs-7" id="tablaIngredientes">
                                <thead class="table-light text-uppercase">
                                    <tr>
                                        <th style="width: 45%;">Insumo / Producto <span class="text-danger">*</span></th>
                                        <th style="width: 25%;">Cantidad Requerida <span class="text-danger">*</span></th>
                                        <th style="width: 20%;">Unidad de Medida <span class="text-danger">*</span></th>
                                        <th style="width: 10%; text-align: center;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyIngredientes">
                                    <tr class="fila-ingrediente">
                                        <td>
                                            <select class="form-select select-producto" required>
                                                <option value="" disabled selected>Seleccione un insumo...</option>
                                                <% productos.forEach(prod => { %>
                                                    <option value="<%= prod.id %>"><%= prod.nombre %></option>
                                                <% }) %>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" step="0.0001" class="form-control input-cantidad" placeholder="0.0000" required>
                                        </td>
                                        <td>
                                            <select class="form-select select-unidad" required>
                                                <option value="" disabled selected>Unidad...</option>
                                                <% if (typeof unidades !== 'undefined' && unidades.length > 0) { %>
                                                    <% unidades.forEach(uni => { %>
                                                        <option value="<%= uni.codigo %>"><%= uni.nombre %> (<%= uni.abreviatura %>)</option>
                                                    <% }) %>
                                                <% } %>
                                            </select>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar-fila">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-save me-2"></i>Guardar Ficha
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script>
        const recetaModal = new bootstrap.Modal(document.getElementById('recetaModal'));
        const recetaForm = document.getElementById('recetaForm');
        const tbodyIngredientes = document.getElementById('tbodyIngredientes');
        const btnAgregarIngrediente = document.getElementById('btnAgregarIngrediente');

        btnAgregarIngrediente.addEventListener('click', () => {
            const primeraFila = document.querySelector('.fila-ingrediente');
            const nuevaFila = primeraFila.cloneNode(true);
            
            nuevaFila.querySelector('.select-producto').value = "";
            nuevaFila.querySelector('.input-cantidad').value = "";
            nuevaFila.querySelector('.select-unidad').value = "";
            
            tbodyIngredientes.appendChild(nuevaFila);
        });

        tbodyIngredientes.addEventListener('click', (e) => {
            if (e.target.closest('.btn-eliminar-fila')) {
                const filas = document.querySelectorAll('.fila-ingrediente');
                if (filas.length > 1) {
                    e.target.closest('.fila-ingrediente').remove();
                } else {
                    Swal.fire('Atención', 'La receta debe poseer al menos un ingrediente válido.', 'warning');
                }
            }
        });

        function openEditModal(id) {
            fetch(`/admin/api/recetas/platillo/${id}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.data) {
                        const item = Array.isArray(data.data) ? data.data[0] : data.data; 
                        
                        document.getElementById('recetaId').value = id;
                        document.getElementById('recetaCodigo').value = item.codigo || '';
                        document.getElementById('recetaNombre').value = item.nombre || '';
                        document.getElementById('productoResultanteId').value = item.producto_resultante_id || '';
                        document.getElementById('recetaTipo').value = item.tipo || 'VENTA';
                        document.getElementById('recetaRendimiento').value = item.rendimiento || '1.000';
                        
                        // Mapea perfectamente la unidad guardada en la base de datos hacia el nuevo select
                        document.getElementById('recetaUnidadRendimiento').value = item.unidad_rendimiento || '';
                        
                        document.getElementById('recetaCostoEstimado').value = item.costo_estimado || '';
                        document.getElementById('recetaPrecioSugerido').value = item.precio_sugerido || '';
                        document.getElementById('recetaTiempo').value = item.tiempo_preparacion_minutos || '';
                        document.getElementById('recetaDescripcion').value = item.descripcion || '';
                        document.getElementById('recetaActiva').checked = item.activa == 1;

                        if (item.detalles && item.detalles.length > 0) {
                            tbodyIngredientes.innerHTML = '';
                            item.detalles.forEach(det => {
                                const primeraFila = document.querySelector('.fila-ingrediente') || crearFilaBaseHTML();
                                const nuevaFila = primeraFila.cloneNode(true);
                                nuevaFila.querySelector('.select-producto').value = det.producto_id;
                                nuevaFila.querySelector('.input-cantidad').value = det.cantidad_requerida;
                                nuevaFila.querySelector('.select-unidad').value = det.unidad_medida;
                                tbodyIngredientes.appendChild(nuevaFila);
                            });
                        }

                        document.getElementById('modalTitle').textContent = 'Editar Ficha Técnica Completa';
                        recetaModal.show();
                    } else {
                        Swal.fire('Error', 'No se pudieron recuperar los datos de la ficha.', 'error');
                    }
                })
                .catch(error => Swal.fire('Error', 'No se pudo cargar la receta', 'error'));
        }

        function crearFilaBaseHTML() {
            const tr = document.createElement('tr');
            tr.className = 'fila-ingrediente';
            tr.innerHTML = `
                <td>
                    <select class="form-select select-producto" required>
                        <option value="" disabled selected>Seleccione un insumo...</option>
                        <% productos.forEach(prod => { %>
                            <option value="<%= prod.id %>"><%= prod.nombre %></option>
                        <% }) %>
                    </select>
                </td>
                <td>
                    <input type="number" step="0.0001" class="form-control input-cantidad" placeholder="0.0000" required>
                </td>
                <td>
                    <select class="form-select select-unidad" required>
                        <option value="" disabled selected>Unidad...</option>
                        <% if (typeof unidades !== 'undefined' && unidades.length > 0) { %>
                            <% unidades.forEach(uni => { %>
                                <option value="<%= uni.codigo %>"><%= uni.nombre %> (<%= uni.abreviatura %>)</option>
                            <% }) %>
                        <% } %>
                    </select>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar-fila">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </td>`;
            return tr;
        }

        function deleteReceta(id) {
            Swal.fire({
                title: '¿Dar de baja esta receta?',
                text: 'El estado pasará a inactivo. Los platos dependientes podrían afectarse.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, dar de baja',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/api/recetas/${id}`, {
                        method: 'DELETE'
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire('Desactivada', data.message, 'success').then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    })
                    .catch(error => Swal.fire('Error', 'No se pudo procesar la baja', 'error'));
                }
            });
        }

        recetaForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const recetaId = document.getElementById('recetaId').value;
            
            const filasIngredientes = document.querySelectorAll('.fila-ingrediente');
            const detalles = [];

            filasIngredientes.forEach(fila => {
                const prodId = fila.querySelector('.select-producto').value;
                const cant = fila.querySelector('.input-cantidad').value;
                const uni = fila.querySelector('.select-unidad').value;

                if (prodId && cant && uni) {
                    detalles.push({
                        producto_id: parseInt(prodId),
                        cantidad_requerida: parseFloat(cant),
                        unidad_medida: uni
                    });
                }
            });

            const payload = {
                codigo: document.getElementById('recetaCodigo').value.trim(),
                nombre: document.getElementById('recetaNombre').value.trim(),
                producto_resultante_id: parseInt(document.getElementById('productoResultanteId').value),
                tipo: document.getElementById('recetaTipo').value,
                rendimiento: parseFloat(document.getElementById('recetaRendimiento').value),
                
                // Captura el valor seleccionado del dropdown de manera natural
                unidad_rendimiento: document.getElementById('recetaUnidadRendimiento').value,
                
                costo_estimado: document.getElementById('recetaCostoEstimado').value ? parseFloat(document.getElementById('recetaCostoEstimado').value) : 0.00,
                precio_sugerido: document.getElementById('recetaPrecioSugerido').value ? parseFloat(document.getElementById('recetaPrecioSugerido').value) : 0.00,
                tiempo_preparacion_minutos: document.getElementById('recetaTiempo').value ? parseInt(document.getElementById('recetaTiempo').value) : 0,
                descripcion: document.getElementById('recetaDescripcion').value.trim(),
                activa: document.getElementById('recetaActiva').checked ? 1 : 0,
                detalles: detalles
            };

            const url = recetaId ? `/admin/api/recetas/${recetaId}` : '/admin/api/recetas';
            const method = recetaId ? 'PUT' : 'POST';

            fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire('Éxito', data.message, 'success').then(() => {
                        window.location.reload();
                    });
                } else {
                    if (data.errors && Array.isArray(data.errors)) {
                        let msg = data.errors.map(err => `${err.param || err.field || 'Campo'}: ${err.msg || err.message}`).join('<br>');
                        Swal.fire({ title: 'Error de Validación', html: msg, icon: 'error' });
                    } else {
                        Swal.fire('Error', data.message || 'Error interno en la operación.', 'error');
                    }
                }
            })
            .catch(error => Swal.fire('Error', 'No se pudo guardar la receta maestro-detalle', 'error'));
        });

        document.getElementById('recetaModal').addEventListener('hidden.bs.modal', function() {
            recetaForm.reset();
            document.getElementById('recetaId').value = '';
            document.getElementById('modalTitle').textContent = 'Nueva Receta';
            
            const filaPlantilla = crearFilaBaseHTML();
            tbodyIngredientes.innerHTML = '';
            tbodyIngredientes.appendChild(filaPlantilla);
        });
    </script>
</body>
</html>