<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Valorización de Inventario - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">

    <div class="container-fluid">
        <div class="row">

            <%- include('../includes/topBarMobile') %>

            <%- include('../includes/sideBarMenu') %>

            <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">

                <%- include('../includes/header', {encabezado_pagina: 'Valorización de Inventario', desc_pagina: 'Valor del stock por almacén y lote a costo unitario (Σ cantidad × costo).', add_btn: false}) %>

                <div class="d-flex justify-content-end mb-3">
                    <a href="/admin/inventario/stock" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                        <i class="fa-solid fa-boxes-stacked text-secondary me-1"></i> Ir a Control de Stock
                    </a>
                </div>

                <!-- Tarjetas de resumen -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-success border-4">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="text-muted fw-semibold mb-1 fs-7">Valor Total del Inventario</h6>
                                    <h3 class="fw-bold mb-0 text-success">$<%= parseFloat(totalGeneral || 0).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></h3>
                                </div>
                                <div class="bg-success-subtle text-success p-3 rounded-circle"><i class="fa-solid fa-sack-dollar fs-4"></i></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-primary border-4">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="text-muted fw-semibold mb-1 fs-7">Almacenes con Stock</h6>
                                    <h3 class="fw-bold mb-0 text-primary"><%= porAlmacen.filter(a => parseFloat(a.valor) > 0).length %></h3>
                                </div>
                                <div class="bg-primary-subtle text-primary p-3 rounded-circle"><i class="fa-solid fa-warehouse fs-4"></i></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-danger border-4">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="text-muted fw-semibold mb-1 fs-7">Valor en Lotes Vencidos (riesgo)</h6>
                                    <h3 class="fw-bold mb-0 text-danger">$<%= parseFloat(vencidos.valor || 0).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></h3>
                                    <small class="text-muted"><%= vencidos.lotes %> lote(s)</small>
                                </div>
                                <div class="bg-danger-subtle text-danger p-3 rounded-circle"><i class="fa-solid fa-triangle-exclamation fs-4"></i></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Resumen por almacén -->
                <div class="card border-0 shadow-sm rounded bg-white mb-4">
                    <div class="card-header bg-white border-bottom pt-3 fw-bold">
                        <i class="fa-solid fa-warehouse me-2 text-secondary"></i>Resumen por Almacén
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light fs-7 text-uppercase text-secondary">
                                <tr>
                                    <th>Almacén</th>
                                    <th class="text-center">Lotes con Stock</th>
                                    <th class="text-end">Unidades</th>
                                    <th class="text-end">Valor</th>
                                    <th class="text-end">% del Total</th>
                                </tr>
                            </thead>
                            <tbody class="fs-7">
                                <% if (porAlmacen.length === 0) { %>
                                <tr><td colspan="5" class="text-center text-muted py-4">Sin almacenes registrados.</td></tr>
                                <% } else { porAlmacen.forEach(a => { %>
                                <tr>
                                    <td class="fw-semibold text-dark"><%= a.nombre %></td>
                                    <td class="text-center"><%= a.lotes_con_stock %></td>
                                    <td class="text-end"><%= parseFloat(a.unidades || 0).toLocaleString('es-ES') %></td>
                                    <td class="text-end fw-bold">$<%= parseFloat(a.valor || 0).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="text-end text-muted"><%= totalGeneral > 0 ? ((parseFloat(a.valor) / totalGeneral) * 100).toFixed(1) : '0.0' %>%</td>
                                </tr>
                                <% }) } %>
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="3">TOTAL GENERAL</td>
                                    <td class="text-end text-success">$<%= parseFloat(totalGeneral || 0).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="text-end">100%</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Detalle por lote -->
                <div class="card border-0 shadow-sm rounded bg-white mb-auto">
                    <div class="card-header bg-white border-bottom pt-3 fw-bold d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-layer-group me-2 text-secondary"></i>Detalle por Lote (top 200 por valor)</span>
                        <button class="btn btn-sm btn-white border fw-semibold text-dark" onclick="window.print()">
                            <i class="fa-solid fa-print me-1"></i>Imprimir
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light fs-7 text-uppercase text-secondary">
                                <tr>
                                    <th>Producto</th>
                                    <th>Almacén</th>
                                    <th>Lote</th>
                                    <th class="text-center">Vence</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Costo Unit.</th>
                                    <th class="text-end">Valor</th>
                                </tr>
                            </thead>
                            <tbody class="fs-7">
                                <% if (lotes.length === 0) { %>
                                <tr><td colspan="7" class="text-center text-muted py-4">No hay lotes con stock disponible.</td></tr>
                                <% } else { lotes.forEach(l => { %>
                                <tr class="<%= l.estado === 'VENCIDO' ? 'table-danger' : '' %>">
                                    <td>
                                        <span class="fw-semibold text-dark d-block"><%= l.producto_nombre %></span>
                                        <small class="text-muted">#<%= l.producto_codigo || l.id %></small>
                                    </td>
                                    <td><%= l.almacen_nombre %></td>
                                    <td class="font-monospace"><%= l.numero_lote %></td>
                                    <td class="text-center <%= l.estado === 'VENCIDO' ? 'text-danger fw-bold' : '' %>">
                                        <%= l.fecha_vencimiento ? new Date(l.fecha_vencimiento).toLocaleDateString('es-ES') : '—' %>
                                        <% if (l.estado === 'VENCIDO') { %><small class="d-block">VENCIDO</small><% } %>
                                    </td>
                                    <td class="text-end"><%= parseFloat(l.cantidad_actual || 0).toLocaleString('es-ES') %></td>
                                    <td class="text-end">$<%= parseFloat(l.costo_unitario || 0).toFixed(2) %></td>
                                    <td class="text-end fw-bold">$<%= parseFloat(l.valor_lote || 0).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                </tr>
                                <% }) } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <!-- Auditoría: registra la impresión real del documento (incluido Ctrl+P) -->
    <script src="/js/auditoria-impresion.js"
            data-documento="Informe de valorización de inventario"
            data-entidad="Valorización de inventario"></script>
</body>
</html>
