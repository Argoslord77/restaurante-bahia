<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Kardex de Inventario - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        @media print {
            #sidebarMenu, .content-header-responsive, .filtros-kardex, .btn, .paginacion-kardex { display: none !important; }
            main { width: 100% !important; margin: 0 !important; }
        }
    </style>
</head>
<body class="bg-light">

    <div class="container-fluid">
        <div class="row">

            <%- include('../includes/topBarMobile') %>

            <%- include('../includes/sideBarMenu') %>

            <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">

                <% if (modo === 'tarjeta') { %>
                    <%- include('../includes/header', {encabezado_pagina: 'Kardex · ' + tarjeta.producto.nombre, desc_pagina: 'Tarjeta de control físico: entradas, salidas y saldo corrido del período ' + filtros.desde + ' al ' + filtros.hasta + '.', add_btn: false}) %>
                <% } else { %>
                    <%- include('../includes/header', {encabezado_pagina: 'Kardex de Inventario', desc_pagina: 'Libro mayor de movimientos por producto: el detalle detrás de cada unidad y cada peso.', add_btn: false}) %>
                <% } %>

                <!-- Filtros comunes -->
                <div class="card border-0 shadow-sm rounded p-3 mb-4 filtros-kardex bg-white">
                    <form method="get" action="/admin/kardex" class="row g-2 align-items-end">
                        <% if (modo === 'tarjeta') { %>
                            <input type="hidden" name="producto" value="<%= tarjeta.producto.id %>">
                        <% } %>
                        <div class="col-12 col-md-3">
                            <label class="form-label small text-muted fw-semibold mb-1">Producto</label>
                            <input type="text" name="q" class="form-control form-control-sm" placeholder="Nombre o código…" value="<%= typeof filtros.q !== 'undefined' ? filtros.q : '' %>" data-limpiar data-limpiar-enviar="si" <%= modo === 'tarjeta' ? 'disabled' : '' %>>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted fw-semibold mb-1">Desde</label>
                            <input type="date" name="desde" class="form-control form-control-sm" value="<%= filtros.desde %>">
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted fw-semibold mb-1">Hasta</label>
                            <input type="date" name="hasta" class="form-control form-control-sm" value="<%= filtros.hasta %>">
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted fw-semibold mb-1">Almacén</label>
                            <select name="almacen_id" class="form-select form-select-sm">
                                <option value="">Todos</option>
                                <% almacenes.forEach(a => { %>
                                    <option value="<%= a.id %>" <%= filtros.almacen_id === a.id ? 'selected' : '' %>><%= a.nombre %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted fw-semibold mb-1">Movimientos</label>
                            <select name="tipo" class="form-select form-select-sm">
                                <option value="todos" <%= filtros.tipo === 'todos' ? 'selected' : '' %>>Todos</option>
                                <option value="entradas" <%= filtros.tipo === 'entradas' ? 'selected' : '' %>>Solo entradas</option>
                                <option value="salidas" <%= filtros.tipo === 'salidas' ? 'selected' : '' %>>Solo salidas</option>
                                <optgroup label="Tipo concreto">
                                    <% Object.entries(etiquetasMovimiento).forEach(([clave, etiqueta]) => { %>
                                        <option value="<%= clave %>" <%= filtros.tipo === clave ? 'selected' : '' %>><%= etiqueta %></option>
                                    <% }) %>
                                </optgroup>
                            </select>
                        </div>
                        <div class="col-12 col-md-1 d-grid">
                            <button type="submit" class="btn btn-dark btn-sm fw-semibold py-2">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <% if (modo === 'tarjeta') { %>

                <!-- ═══════════ TARJETA DE KARDEX ═══════════ -->

                <!-- Acciones -->
                <div class="d-flex flex-wrap justify-content-end gap-2 mb-3">
                    <a href="/admin/kardex?q=<%= encodeURIComponent(tarjeta.producto.nombre) %>&desde=<%= filtros.desde %>&hasta=<%= filtros.hasta %>" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                        <i class="fa-solid fa-arrow-left text-secondary me-1"></i> Otro producto
                    </a>
                    <a href="/admin/kardex/exportar?producto=<%= tarjeta.producto.id %>&desde=<%= filtros.desde %>&hasta=<%= filtros.hasta %><%= filtros.almacen_id ? '&almacen_id=' + filtros.almacen_id : '' %><%= filtros.tipo !== 'todos' ? '&tipo=' + filtros.tipo : '' %>" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                        <i class="fa-solid fa-file-csv text-success me-1"></i> Exportar CSV
                    </a>
                    <button type="button" onclick="window.print()" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                        <i class="fa-solid fa-print text-secondary me-1"></i> Imprimir
                    </button>
                </div>

                <!-- Ficha del producto -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Existencia actual</h6>
                            <h3 class="fw-bold mb-0 text-dark"><%= tarjeta.producto.stock_actual.toLocaleString('es-ES') %> <small class="text-muted fs-7 fw-normal"><%= tarjeta.producto.unidad %></small></h3>
                            <% if (tarjeta.producto.stock_minimo > 0 && tarjeta.producto.stock_actual <= tarjeta.producto.stock_minimo) { %>
                                <span class="badge text-bg-danger mt-2">Bajo mínimo (<%= tarjeta.producto.stock_minimo %>)</span>
                            <% } %>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-success border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Valor del stock (lotes)</h6>
                            <h3 class="fw-bold mb-0 text-success">$<%= tarjeta.producto.valor_stock.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></h3>
                            <small class="text-muted">Costo promedio: $<%= tarjeta.producto.costo_promedio.toLocaleString('es-ES', { minimumFractionDigits: 4 }) %></small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-primary border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Entradas del período</h6>
                            <h3 class="fw-bold mb-0 text-primary"><%= tarjeta.totales.entradas_cantidad.toLocaleString('es-ES') %> <small class="fs-7 fw-normal">$<%= tarjeta.totales.entradas_valor.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></small></h3>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-danger border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Salidas del período</h6>
                            <h3 class="fw-bold mb-0 text-danger"><%= tarjeta.totales.salidas_cantidad.toLocaleString('es-ES') %> <small class="fs-7 fw-normal">$<%= tarjeta.totales.salidas_valor.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></small></h3>
                        </div>
                    </div>
                </div>

                <% if (Math.abs(tarjeta.descuadre) > 0.001) { %>
                <div class="alert alert-warning d-flex align-items-start gap-2 shadow-sm border-0 rounded py-2 px-3 mb-4" role="alert">
                    <i class="fa-solid fa-scale-unbalanced mt-1"></i>
                    <div>
                        <strong>Descuadre entre kardex y existencia:</strong>
                        el saldo final calculado (<%= tarjeta.totales.saldo_cantidad.toLocaleString('es-ES') %>) y la existencia actual de lotes (<%= tarjeta.producto.stock_actual.toLocaleString('es-ES') %>) difieren en <strong><%= tarjeta.descuadre.toLocaleString('es-ES') %></strong>. Suele indicar historial incompleto o ajustes hechos directamente sobre lotes.
                    </div>
                </div>
                <% } %>

                <!-- Movimientos -->
                <div class="card border-0 shadow-sm rounded bg-white mb-4">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 fs-7">
                            <thead class="table-light">
                                <tr class="text-center text-nowrap">
                                    <th class="ps-4 py-3 text-start" style="min-width:170px">Fecha / Detalle</th>
                                    <th class="py-3">Documento / Lote</th>
                                    <th class="py-3">Almacén / Usuario</th>
                                    <th class="py-3 text-end">Cant.</th>
                                    <th class="py-3 text-end">C. unit.</th>
                                    <th class="py-3 text-end">Valor</th>
                                    <th class="py-3 text-end">Cant.</th>
                                    <th class="py-3 text-end">C. unit.</th>
                                    <th class="py-3 text-end">Valor</th>
                                    <th class="py-3 text-end">Cant.</th>
                                    <th class="py-3 text-end pe-4">Valor</th>
                                </tr>
                                <tr class="text-center table-secondary small">
                                    <th colspan="3" class="ps-4 text-start">ENTRADAS ← &nbsp;&nbsp; SALIDAS → &nbsp;&nbsp; SALDO</th>
                                    <th colspan="3" class="text-center text-success">Entradas</th>
                                    <th colspan="3" class="text-center text-danger">Salidas</th>
                                    <th colspan="2" class="text-center text-dark pe-4">Saldo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-light fw-semibold">
                                    <td class="ps-4">
                                        <span class="text-muted"><%= filtros.desde %></span><br>
                                        <span class="small text-muted">Saldo inicial</span>
                                    </td>
                                    <td colspan="8" class="text-muted">Existencia acumulada antes del período</td>
                                    <td class="text-end"><%= tarjeta.saldoInicial.cantidad.toLocaleString('es-ES') %></td>
                                    <td class="text-end pe-4">$<%= tarjeta.saldoInicial.valor.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                </tr>
                                <% tarjeta.movimientos.forEach(m => { %>
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-semibold"><%= new Date(m.fecha).toLocaleDateString('es-ES') %></span>
                                        <small class="text-muted d-block"><%= new Date(m.fecha).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) %></small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge <%= m.entrada_cantidad != null ? 'text-bg-success' : (m.salida_cantidad != null ? 'text-bg-danger' : 'text-bg-secondary') %>"><%= m.etiqueta %></span>
                                        <small class="text-muted d-block font-monospace"><%= m.documento %><%= m.lote ? ' · ' + m.lote : '' %></small>
                                    </td>
                                    <td class="text-center">
                                        <small><%= m.almacen %></small>
                                        <small class="text-muted d-block"><%= m.usuario %></small>
                                    </td>
                                    <td class="text-end text-success"><%= m.entrada_cantidad != null ? m.entrada_cantidad.toLocaleString('es-ES') : '—' %></td>
                                    <td class="text-end text-success"><%= m.entrada_costo != null ? m.entrada_costo.toLocaleString('es-ES', { minimumFractionDigits: 4 }) : '—' %></td>
                                    <td class="text-end text-success"><%= m.entrada_valor != null ? '$' + m.entrada_valor.toLocaleString('es-ES', { minimumFractionDigits: 2 }) : '—' %></td>
                                    <td class="text-end text-danger"><%= m.salida_cantidad != null ? m.salida_cantidad.toLocaleString('es-ES') : '—' %></td>
                                    <td class="text-end text-danger"><%= m.salida_costo != null ? m.salida_costo.toLocaleString('es-ES', { minimumFractionDigits: 4 }) : '—' %></td>
                                    <td class="text-end text-danger"><%= m.salida_valor != null ? '$' + m.salida_valor.toLocaleString('es-ES', { minimumFractionDigits: 2 }) : '—' %></td>
                                    <td class="text-end fw-semibold"><%= m.saldo_cantidad.toLocaleString('es-ES') %></td>
                                    <td class="text-end fw-semibold pe-4">$<%= m.saldo_valor.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                </tr>
                                <% if (m.observaciones) { %>
                                <tr class="small text-muted">
                                    <td colspan="11" class="ps-4 py-1"><i class="fa-solid fa-comment-dots me-1"></i><%= m.observaciones %></td>
                                </tr>
                                <% } %>
                                <% }) %>
                                <% if (tarjeta.movimientos.length === 0) { %>
                                <tr>
                                    <td colspan="11" class="text-center text-muted py-4">Sin movimientos en el período con estos filtros.</td>
                                </tr>
                                <% } %>
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="3" class="ps-4">TOTALES DEL PERÍODO</td>
                                    <td class="text-end text-success"><%= tarjeta.totales.entradas_cantidad.toLocaleString('es-ES') %></td>
                                    <td></td>
                                    <td class="text-end text-success">$<%= tarjeta.totales.entradas_valor.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-end text-danger"><%= tarjeta.totales.salidas_cantidad.toLocaleString('es-ES') %></td>
                                    <td></td>
                                    <td class="text-end text-danger">$<%= tarjeta.totales.salidas_valor.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-end"><%= tarjeta.totales.saldo_cantidad.toLocaleString('es-ES') %></td>
                                    <td class="text-end pe-4">$<%= tarjeta.totales.saldo_valor.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <% } else { %>

                <!-- ═══════════ ÍNDICE DE PRODUCTOS ═══════════ -->

                <div class="card border-0 shadow-sm rounded bg-white mb-4">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 fs-7">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 py-3">Código</th>
                                    <th class="py-3">Producto</th>
                                    <th class="py-3 text-end">Existencia</th>
                                    <th class="py-3 text-end">Valor stock</th>
                                    <th class="py-3 text-end">Entradas (período)</th>
                                    <th class="py-3 text-end">Salidas (período)</th>
                                    <th class="py-3 text-center pe-4" style="min-width:120px">Kardex</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% listado.productos.forEach(p => { %>
                                <tr>
                                    <td class="ps-4 font-monospace"><%= p.codigo || '—' %></td>
                                    <td>
                                        <span class="fw-semibold"><%= p.nombre %></span>
                                        <% if (p.stock_minimo > 0 && p.stock_actual <= p.stock_minimo) { %>
                                            <span class="badge text-bg-danger ms-1">bajo mínimo</span>
                                        <% } else if (p.stock_actual === 0) { %>
                                            <span class="badge text-bg-secondary ms-1">agotado</span>
                                        <% } %>
                                        <% if (p.unidad) { %><small class="text-muted d-block"><%= p.unidad %></small><% } %>
                                    </td>
                                    <td class="text-end fw-semibold"><%= p.stock_actual.toLocaleString('es-ES') %></td>
                                    <td class="text-end">$<%= p.valor_stock.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-end text-success"><%= p.entradas ? p.entradas.toLocaleString('es-ES') : '—' %></td>
                                    <td class="text-end text-danger"><%= p.salidas ? p.salidas.toLocaleString('es-ES') : '—' %></td>
                                    <td class="text-center pe-4">
                                        <a href="/admin/kardex?producto=<%= p.id %>&desde=<%= filtros.desde %>&hasta=<%= filtros.hasta %><%= filtros.almacen_id ? '&almacen_id=' + filtros.almacen_id : '' %><%= filtros.tipo !== 'todos' ? '&tipo=' + filtros.tipo : '' %>" class="btn btn-sm btn-outline-dark border shadow-sm py-1 px-2 fw-semibold">
                                            <i class="fa-solid fa-clipboard-check me-1"></i>Ver
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                                <% if (listado.productos.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">No hay productos que coincidan con la búsqueda.</td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Paginación -->
                <% if (listado.total > listado.porPagina) { %>
                <nav class="paginacion-kardex d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4" aria-label="Paginación del kardex">
                    <small class="text-muted"><%= listado.total %> productos · página <%= listado.pagina %> de <%= Math.ceil(listado.total / listado.porPagina) %></small>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item <%= listado.pagina <= 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="/admin/kardex?q=<%= encodeURIComponent(filtros.q || '') %>&desde=<%= filtros.desde %>&hasta=<%= filtros.hasta %>&pagina=<%= listado.pagina - 1 %>">Anterior</a>
                        </li>
                        <li class="page-item active"><span class="page-link"><%= listado.pagina %></span></li>
                        <li class="page-item <%= listado.pagina >= Math.ceil(listado.total / listado.porPagina) ? 'disabled' : '' %>">
                            <a class="page-link" href="/admin/kardex?q=<%= encodeURIComponent(filtros.q || '') %>&desde=<%= filtros.desde %>&hasta=<%= filtros.hasta %>&pagina=<%= listado.pagina + 1 %>">Siguiente</a>
                        </li>
                    </ul>
                </nav>
                <% } %>

                <% } %>

                <%- include('../includes/footer') %>
            </main>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
</body>
</html>
