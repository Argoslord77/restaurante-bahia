<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Monitoreo de Stock - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <style>
        /* Estilos armonizados para reducir fatiga visual en administración */
        .bg-success-soft { background-color: rgba(40, 167, 69, 0.15); color: #28a745; }
        .bg-warning-soft { background-color: rgba(255, 193, 7, 0.15); color: #ffc107; }
        .bg-danger-soft { background-color: rgba(220, 53, 69, 0.15); color: #dc3545; }
        .card-table th { font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px; }
        .fila-producto { transition: background-color 0.2s ease; }
    </style>
</head>
<body class="bg-light">

    <div class="container-fluid py-4">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="h4 mb-0 text-gray-800">Monitoreo de Stock por Almacén</h2>
                <p class="text-muted small mb-0">Visualiza y filtra las existencias de productos en tiempo real.</p>
            </div>
            
            <div class="col-md-4 col-lg-3">
                <label for="selectAlmacenStock" class="form-label small text-muted fw-bold mb-1">Seleccionar Almacén:</label>
                <select class="form-select form-select-sm shadow-sm" id="selectAlmacenStock" name="almacen_id">
                    <% if (almacenes && almacenes.length > 0) { %>
                        <% almacenes.forEach(almacen => { %>
                            <option value="<%= almacen.id %>" <%= (typeof almacenSeleccionado !== 'undefined' && almacenSeleccionado == almacen.id) ? 'selected' : '' %>>
                                <%= almacen.nombre %> <%= almacen.codigo ? `(${almacen.codigo})` : '' %>
                            </option>
                        <% }) %>
                    <% } else { %>
                        <option value="">No hay almacenes disponibles</option>
                    <% } %>
                </select>
            </div>
        </div>

        <div class="card mb-3 shadow-sm border-0">
            <div class="card-body py-2 px-3 bg-white rounded">
                <div class="row align-items-center">
                    <div class="col-md-6 col-lg-4 ms-auto">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" id="buscarProductoStock" class="form-control bg-light border-start-0 ps-0" placeholder="Buscar por código o producto...">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle card-table mb-0" id="tablaStockProductos">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Código</th>
                                <th>Producto</th>
                                <th>Categoría</th>
                                <th class="text-center">Stock Actual</th>
                                <th class="text-center">Stock Mínimo</th>
                                <th class="pe-4">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (productos && productos.length > 0) { %>
                                <% productos.forEach(prod => { %>
                                    <tr class="fila-producto" data-codigo="<%= prod.codigo ? prod.codigo.toLowerCase() : '' %>" data-nombre="<%= prod.nombre ? prod.nombre.toLowerCase() : '' %>">
                                        <td class="ps-4 fw-bold text-secondary"><%= prod.codigo %></td>
                                        <td><%= prod.nombre %></td>
                                        <td><%= prod.categoria_nombre || 'General' %></td>
                                        <td class="text-center fw-bold <%= (parseFloat(prod.stock_actual) <= parseFloat(prod.stock_minimo)) ? 'text-danger' : 'text-success' %>">
                                            <%= prod.stock_actual %>
                                        </td>
                                        <td class="text-center text-muted"><%= prod.stock_minimo %></td>
                                        <td class="pe-4">
                                            <% if (parseFloat(prod.stock_actual) <= 0) { %>
                                                <span class="badge bg-danger-soft text-danger py-1 px-2">Agotado</span>
                                            <% } else if (parseFloat(prod.stock_actual) <= parseFloat(prod.stock_minimo)) { %>
                                                <span class="badge bg-warning-soft text-warning py-1 px-2">Stock Crítico</span>
                                            <% } else { %>
                                                <span class="badge bg-success-soft text-success py-1 px-2">Disponible</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr id="filaNoDatos">
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-box-open d-block mb-2 fs-3 text-secondary opacity-50"></i>
                                        No hay productos registrados o con existencias en este almacén.
                                    </td>
                                </tr>
                            <% } %>
                            
                            <tr id="filaNoCoincidencias" style="display: none;">
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-filter d-block mb-2 fs-3 text-secondary opacity-50"></i>
                                    No se encontraron productos que coincidan con la búsqueda.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        
        // ==========================================
        // 1. BUSCADOR FILTRADO EN TIEMPO REAL (FRONT)
        // ==========================================
        const inputBuscar = document.getElementById('buscarProductoStock');
        const filasProductos = document.querySelectorAll('.fila-producto');
        const filaNoCoincidencias = document.getElementById('filaNoCoincidencias');

        if (inputBuscar) {
            inputBuscar.addEventListener('input', function(e) {
                const termino = e.target.value.toLowerCase().trim();
                let coincidencias = 0;

                filasProductos.forEach(fila => {
                    const codigo = fila.getAttribute('data-codigo') || '';
                    const nombre = fila.getAttribute('data-nombre') || '';

                    if (codigo.includes(termino) || nombre.includes(termino)) {
                        fila.style.display = '';
                        coincidencias++;
                    } else {
                        fila.style.display = 'none';
                    }
                });

                if (filasProductos.length > 0) {
                    if (coincidencias === 0) {
                        filaNoCoincidencias.style.display = '';
                    } else {
                        filaNoCoincidencias.style.display = 'none';
                    }
                }
            });
        }

        // ==========================================
        // 2. REDIRECCIÓN POR CAMBIO DE ALMACÉN
        // ==========================================
        const selectAlmacen = document.getElementById('selectAlmacenStock');
        if (selectAlmacen) {
            selectAlmacen.addEventListener('change', function() {
                const almacenId = this.value;
                if (almacenId) {
                    // Usamos la ruta base actual de la ventana eliminando los query params antiguos
                    // Esto preserva automáticamente los prefijos como /admin o /admin/inventario
                    const urlBase = window.location.pathname;
                    window.location.href = `${urlBase}?almacenId=${almacenId}`;
                }
            });
        }
    });
    </script>
</body>
</html>