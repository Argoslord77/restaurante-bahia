<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">

    <%- include('../includes/sideBarMenu') %>

    <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4">
        <%- include('../includes/header', {
            encabezado_pagina: 'Control de Stock Actual', 
            desc_pagina: 'Monitoreo de existencias en tiempo real y gestión preventiva de mermas.',
            add_btn: false ,
            warehouse_menu: false
        }) %>

        <div class="container-fluid px-0">
            <div class="d-flex flex-column flex-md-row justify-content-end align-items-md-center gap-3 mb-4 bg-white p-3 rounded shadow-sm border">
                <div class="d-flex align-items-center gap-2">
                    <label for="almacenSelector" class="fw-semibold text-secondary text-nowrap mb-0 fs-7">Cambiar Almacén:</label>
                    <select id="almacenSelector" class="form-select form-select-sm fw-semibold border shadow-sm" onchange="cambiarAlmacen(this.value)">
                        <% almacenes.forEach(almacen => { %>
                            <option value="<%= almacen.id %>" <%= almacenSeleccionado && almacenSeleccionado.id == almacen.id ? 'selected' : '' %>><%= almacen.nombre %> (<%= almacen.tipo %>)</option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <% if (!almacenSeleccionado) { %>
                <div class="alert alert-warning text-center shadow-sm">
                    <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i> No se encontraron almacenes configurados en el sistema.
                </div>
            <% } else { %>
                <% 
                    let totalProductos = stock.length;
                    let productosBajoMinimo = stock.filter(item => item.stock_actual <= item.stock_minimo).length;
                    let lotesCriticosVencimiento = alertasVencimiento.filter(l => l.dias_para_vencer <= 7).length;
                %>
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="text-muted fw-semibold mb-1 fs-7">Ítems Registrados</h6>
                                    <h3 class="fw-bold mb-0 text-dark"><%= totalProductos %></h3>
                                </div>
                                <div class="bg-primary-subtle text-primary p-3 rounded-circle"><i class="fa-solid fa-list-check fs-4"></i></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-warning border-4">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="text-muted fw-semibold mb-1 fs-7">Stock Bajo el Mínimo</h6>
                                    <h3 class="fw-bold mb-0 text-warning"><%= productosBajoMinimo %></h3>
                                </div>
                                <div class="bg-warning-subtle text-warning p-3 rounded-circle"><i class="fa-solid fa-triangle-exclamation fs-4"></i></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-danger border-4">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="text-muted fw-semibold mb-1 fs-7">Alertas Críticas Vencimiento (≤7 días)</h6>
                                    <h3 class="fw-bold mb-0 text-danger"><%= lotesCriticosVencimiento %></h3>
                                </div>
                                <div class="bg-danger-subtle text-danger p-3 rounded-circle"><i class="fa-solid fa-hourglass-half fs-4"></i></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded bg-white">
                    <div class="card-header bg-white border-bottom pt-3">
                        <ul class="nav nav-tabs card-header-tabs" id="inventarioTabs" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link active fw-semibold text-secondary" id="general-tab" data-bs-toggle="tab" data-bs-target="#general-panel" type="button" role="tab">
                                    <i class="fa-solid fa-warehouse me-2"></i>Existencias Generales
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link fw-semibold text-secondary position-relative" id="vencimiento-tab" data-bs-toggle="tab" data-bs-target="#vencimiento-panel" type="button" role="tab">
                                    <i class="fa-solid fa-calendar-times me-2"></i>Alertas de Vencimiento
                                    <% if(alertasVencimiento.length > 0) { %>
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"><%= alertasVencimiento.length %></span>
                                    <% } %>
                                </button>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body p-0">
                        <div class="tab-content" id="inventarioTabsContent">
                            <div class="tab-pane fade show active p-3" id="general-panel" role="tabpanel">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light fs-7 text-uppercase text-secondary">
                                            <tr>
                                                <th>Código</th>
                                                <th>Producto / Insumo</th>
                                                <th>Categoría</th>
                                                <th class="text-end">Stock Mínimo</th>
                                                <th class="text-end">Stock Actual</th>
                                                <th class="text-center">Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody class="fs-7">
                                            <% if(stock.length === 0) { %>
                                                <tr>
                                                    <td colspan="6" class="text-center text-muted py-4">No hay productos registrados en este almacén.</td>
                                                </tr>
                                            <% } else { %>
                                                <% stock.forEach(item => { %>
                                                    <tr>
                                                        <td class="fw-semibold text-secondary">#<%= item.producto_codigo %></td>
                                                        <td>
                                                            <span class="fw-bold text-dark d-block"><%= item.producto_nombre %></span>
                                                            <small class="text-muted">Medida: <%= item.unidad_medida || 'Unidades' %></small>
                                                        </td>
                                                        <td><span class="badge bg-light text-dark border"><%= item.categoria %></span></td>
                                                        <td class="text-end fw-semibold text-muted"><%= parseFloat(item.stock_minimo).toFixed(2) %></td>
                                                        <td class="text-end fw-bold <%= item.stock_actual <= item.stock_minimo ? 'text-danger fs-6' : 'text-success' %>">
                                                            <%= parseFloat(item.stock_actual).toFixed(2) %>
                                                        </td>
                                                        <td class="text-center">
                                                            <% if(item.stock_actual <= 0) { %>
                                                                <span class="badge bg-danger text-white px-2 py-1"><i class="fa-solid fa-circle-xmark me-1"></i>Agotado</span>
                                                            <% } else if (item.stock_actual <= item.stock_minimo) { %>
                                                                <span class="badge bg-warning text-dark px-2 py-1"><i class="fa-solid fa-triangle-exclamation me-1"></i>Bajo Mínimo</span>
                                                            <% } else { %>
                                                                <span class="badge bg-success text-white px-2 py-1"><i class="fa-solid fa-circle-check me-1"></i>Óptimo</span>
                                                            <% } %>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="tab-pane fade p-3" id="vencimiento-panel" role="tabpanel">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light fs-7 text-uppercase text-secondary">
                                            <tr>
                                                <th>Lote</th>
                                                <th>Producto</th>
                                                <th class="text-end">Cantidad</th>
                                                <th>Vencimiento</th>
                                                <th>Estado / Diagnóstico</th>
                                            </tr>
                                        </thead>
                                        <tbody class="fs-7">
                                            <% if(alertasVencimiento.length === 0) { %>
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted py-4"><i class="fa-solid fa-shield-halved text-success me-2"></i>Todos los lotes se encuentran estables.</td>
                                                </tr>
                                            <% } else { %>
                                                <% alertasVencimiento.forEach(lote => { %>
                                                    <tr class="<%= lote.dias_para_vencer < 0 ? 'table-danger-custom' : '' %>">
                                                        <td class="fw-semibold text-primary">#<%= lote.lote_codigo %></td>
                                                        <td class="fw-bold text-dark"><%= lote.producto_nombre %></td>
                                                        <td class="text-end fw-bold text-secondary"><%= parseFloat(lote.cantidad_actual).toFixed(2) %></td>
                                                        <td>
                                                            <span class="fw-semibold"><%= new Date(lote.fecha_vencimiento).toLocaleDateString('es-ES') %></span>
                                                        </td>
                                                        <td>
                                                            <% if (lote.dias_para_vencer < 0) { %>
                                                                <span class="text-danger fw-bold"><i class="fa-solid fa-skull-crossbones me-1"></i> Vencido hace <%= Math.abs(lote.dias_para_vencer) %> días</span>
                                                            <% } else if (lote.dias_para_vencer <= 7) { %>
                                                                <span class="text-warning fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i> Crítico: <%= lote.dias_para_vencer %> días</span>
                                                            <% } else { %>
                                                                <span class="text-secondary fw-semibold"><i class="fa-solid fa-clock me-1"></i> Próximo (<%= lote.dias_para_vencer %> días)</span>
                                                            <% } %>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </main>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>
        function cambiarAlmacen(id) {
            window.location.href = `/admin/inventario/stock?almacenId=${id}`;
        }
    </script>
</body>
</html>