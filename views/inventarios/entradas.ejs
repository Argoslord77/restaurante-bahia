<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Registrar Entrada de Inventario - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css"> 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <%- include('../includes/sideBarMenu') %>

    <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4 bg-light">
        <%- include('../includes/header', {
            encabezado_pagina: 'Registrar Entrada de Inventario', 
            desc_pagina: 'Carga stock directamente al almacén generando traza transaccional y control de lotes.',
            add_btn: false,
            warehouse_menu: false
        }) %>

        <div class="container-fluid py-2 px-0">
            <div class="row justify-content-center">
                <div class="col-xl-10 col-lg-12">
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-5">
                        <div class="card-header bg-dark py-3 px-4">
                            <h6 class="text-white mb-0 fw-bold"><i class="fa-solid fa-file-invoice me-2"></i>Datos de la Operación de Ingreso</h6>
                        </div>
                        <div class="card-body p-4">
                            <form id="formRegistrarEntrada" onsubmit="enviarEntrada(event)">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-secondary fs-7">Almacén Destino</label>
                                        <select class="form-select form-select-sm shadow-sm" id="almacen_id" required>
                                            <option value="" disabled selected>Seleccione el almacén...</option>
                                            <% almacenes.forEach(al => { %>
                                                <option value="<%= al.id %>"><%= al.nombre %> (<%= al.codigo %>)</option>
                                            <% }) %>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-secondary fs-7">Nº Documento / Referencia</label>
                                        <input type="text" class="form-control form-control-sm shadow-sm" id="documento_numero" placeholder="Ej: FAC-2026-0019" required>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label fw-semibold text-secondary fs-7">Producto / Materia Prima</label>
                                        <select class="form-select form-select-sm shadow-sm" id="producto_id" required onchange="evaluarLoteProducto()">
                                            <option value="" disabled selected>Seleccione el insumo...</option>
                                            <% productos.forEach(p => { %>
                                                <option value="<%= p.id %>" data-tipo="<%= p.tipo %>">#<%= p.codigo %> — <%= p.nombre %></option>
                                            <% }) %>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-secondary fs-7">Cantidad a Ingresar</label>
                                        <input type="number" step="0.001" min="0.001" class="form-control form-control-sm shadow-sm fw-bold text-primary" id="cantidad" placeholder="0.000" required>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-secondary fs-7">Costo Unitario ($)</label>
                                        <input type="number" step="0.0001" min="0.0000" class="form-control form-control-sm shadow-sm text-success" id="costo_unitario" placeholder="0.00" required>
                                    </div>

                                    <div class="col-12" id="seccion_lote_checkbox">
                                        <div class="form-check form-switch bg-light p-3 rounded border shadow-sm mt-2">
                                            <input class="form-check-input ms-1 me-2" type="checkbox" id="maneja_lote" onchange="toggleCamposLote()">
                                            <label class="form-check-label fw-bold text-dark fs-7" for="maneja_lote">¿Este ingreso requiere trazabilidad por Lote / Vencimiento?</label>
                                        </div>
                                    </div>

                                    <div class="col-md-6 campos-lote" style="display: none;">
                                        <label class="form-label fw-semibold text-danger fs-7">Número de Lote</label>
                                        <input type="text" class="form-control form-control-sm shadow-sm" id="numero_lote" placeholder="Ej: LOT-2026-M1">
                                    </div>

                                    <div class="col-md-6 campos-lote" style="display: none;">
                                        <label class="form-label fw-semibold text-danger fs-7">Fecha de Vencimiento</label>
                                        <input type="date" class="form-control form-control-sm shadow-sm" id="fecha_vencimiento">
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label fw-semibold text-secondary fs-7">Observaciones</label>
                                        <textarea class="form-control form-control-sm shadow-sm" id="observaciones" rows="3"></textarea>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                                    <a href="/admin/inventario/movimientos" class="btn btn-light btn-sm fw-semibold border px-4">Volver al Historial</a>
                                    <button type="submit" class="btn btn-primary btn-sm fw-bold px-4 shadow">Procesar Entrada</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleCamposLote() {
            const checkLote = document.getElementById('maneja_lote').checked;
            const campos = document.querySelectorAll('.campos-lote');
            campos.forEach(c => {
                c.style.display = checkLote ? 'block' : 'none';
                const input = c.querySelector('input');
                if (input) input.required = checkLote;
            });
        }

        function evaluarLoteProducto() {
            const selector = document.getElementById('producto_id');
            const opcionSeleccionada = selector.options[selector.selectedIndex];
            const tipoProducto = opcionSeleccionada.getAttribute('data-tipo');
            const checkLote = document.getElementById('maneja_lote');
            checkLote.checked = (tipoProducto === 'materia_prima' || tipoProducto === 'producto_preparado');
            toggleCamposLote();
        }

        async function enviarEntrada(e) {
            e.preventDefault();
            const data = {
                almacen_id: document.getElementById('almacen_id').value,
                producto_id: document.getElementById('producto_id').value,
                cantidad: document.getElementById('cantidad').value,
                costo_unitario: document.getElementById('costo_unitario').value,
                documento_numero: document.getElementById('documento_numero').value.trim(),
                observaciones: document.getElementById('observaciones').value.trim(),
                maneja_lote: document.getElementById('maneja_lote').checked,
                numero_lote: document.getElementById('numero_lote').value.trim(),
                fecha_vencimiento: document.getElementById('fecha_vencimiento').value
            };

            Swal.fire({ title: 'Procesando...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

            try {
                const response = await fetch('/admin/inventario/entradas/registrar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const res = await response.json();
                if (res.success) {
                    Swal.fire('¡Éxito!', res.message, 'success').then(() => {
                        document.getElementById('formRegistrarEntrada').reset();
                        toggleCamposLote();
                    });
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            } catch (err) {
                Swal.fire('Error', 'No se pudo procesar la transacción.', 'error');
            }
        }
    </script>
</body>
</html>