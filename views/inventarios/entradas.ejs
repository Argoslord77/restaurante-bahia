<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Entradas de Almacén - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css">
    
    <style>
        /* Ajuste estético para integrar Select2 con los inputs de Bootstrap 5 */
        .select2-container--default .select2-selection--single {
            height: calc(3.5rem + 2px);
            padding: 0.375rem 0.75rem;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            box-shadow: 0 .125rem .25rem rgba(0,0,0,.075)!important;
            display: flex;
            align-items: center;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 100%;
            top: 0;
            right: 10px;
        }
        .select2-container {
            width: 100% !important;
        }
        /* Variación visual cuando Select2 está deshabilitado */
        .select2-container--default.select2-container--disabled .select2-selection--single {
            background-color: #e9ecef;
            cursor: not-allowed;
        }
    </style>
</head>
<body>

    <%- include('../includes/topBarMobile') %>

    <%- include('../includes/sideBarMenu') %>
    
    <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">
        
        <%- include('../includes/header', {
            encabezado_pagina: 'Entradas de Almacén e Ingreso de Lotes', 
            desc_pagina: 'Registra compras, stock inicial e ingresos físicos de mercadería directo al inventario FIFO.', 
            add_btn: true, 
            btn_label: "Registrar Entrada", 
            modal: "modalEntrada"
        }) %>

        <div class="card card-custom shadow-sm border-0 overflow-hidden mt-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-custom-thead text-uppercase fs-7 bg-light">
                        <tr>
                            <th class="ps-4 py-3">Fecha Ingreso</th>
                            <th class="py-3">Producto</th>
                            <th class="py-3">Almacén Destino</th>
                            <th class="py-3">Nº Lote</th>
                            <th class="text-end py-3">Cant. Inicial (U. inventario)</th>
                            <th class="py-3">U. Entrada</th>
                            <th class="text-end py-3">Cant. Actual (Stock)</th>
                            <th class="text-end py-3">Costo Unit.</th>
                            <th class="text-center py-3">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof entradas !== 'undefined' && entradas.length > 0) { %>
                            <% entradas.forEach(e => { %>
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">
                                            <%= new Date(e.fecha_ingreso).toLocaleDateString('es-ES', {day: '2-digit', month: '2-digit', year: 'numeric'}) %>
                                        </div>
                                        <% if(e.fecha_vencimiento) { %>
                                            <small class="text-danger fs-7">Vence: <%= new Date(e.fecha_vencimiento).toLocaleDateString('es-ES', {day: '2-digit', month: '2-digit', year: 'numeric'}) %></small>
                                        <% } else { %>
                                            <small class="text-muted fs-7">Sin vencimiento</small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= e.producto_nombre %></div>
                                        <small class="font-monospace text-primary">#<%= e.producto_codigo %></small>
                                    </td>
                                    <td><span class="badge bg-light text-dark border"><i class="fa-solid fa-warehouse me-1 text-secondary"></i><%= e.almacen_nombre %></span></td>
                                    <td><span class="font-monospace fw-bold text-secondary"><%= e.numero_lote %></span></td>
                                    <td class="text-end font-monospace"><%= parseFloat(e.cantidad_inicial || 0).toFixed(2) %> <%= e.unidad_inventario_abreviatura || '' %></td>
                                    <td><span class="badge bg-info-subtle text-info-emphasis border"><%= e.unidad_medida_abreviatura || e.unidad_inventario_abreviatura || '—' %></span>
                                        <% if (e.cantidad_ingresada !== null && e.cantidad_ingresada !== undefined) { %>
                                            <small class="d-block text-muted"><%= parseFloat(e.cantidad_ingresada).toFixed(2) %> recibidos</small>
                                        <% } %>
                                    </td>
                                    <td class="text-end font-monospace fw-bold text-success"><%= parseFloat(e.cantidad_actual || 0).toFixed(2) %> <%= e.unidad_inventario_abreviatura || '' %></td>
                                    <td class="text-end font-monospace text-dark">$<%= parseFloat(e.costo_unitario).toFixed(2) %></td>
                                    <td class="text-center">
                                        <% if (parseFloat(e.cantidad_actual) <= 0) { %>
                                            <span class="badge bg-secondary-subtle text-secondary px-3 rounded-pill fw-semibold">AGOTADO</span>
                                        <% } else { %>
                                            <span class="badge bg-success-subtle text-success px-3 rounded-pill fw-semibold">ACTIVO</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-box-open d-block fs-3 mb-2 text-secondary"></i>
                                    No se registran lotes o entradas en este momento.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        
        <footer class="mt-auto">
            <%- include('../includes/footer') %>
        </footer>
    </main>

    <div class="modal fade" id="modalEntrada" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <form id="formEntrada" class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-square-plus me-2"></i>Registrar Entrada de Mercadería</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="almacen_id" class="form-label fw-semibold text-secondary small">Almacén de Destino</label>
                            <select class="form-select shadow-sm" id="almacen_id" required>
                                <option value="">Seleccione almacén...</option>
                                <% if (typeof almacenes !== 'undefined') { %>
                                    <% almacenes.forEach(a => { %>
                                        <option value="<%= a.id %>"><%= a.nombre %> (<%= a.codigo %>)</option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="producto_id" class="form-label fw-semibold text-secondary small">Producto / Insumo (Buscador)</label>
                            <select class="form-select shadow-sm select2-busqueda" id="producto_id" required disabled>
                                <option value="">Escriba para buscar un insumo...</option>
                                <% if (typeof productos !== 'undefined') { %>
                                    <% productos.forEach(p => { %>
                                        <option value="<%= p.id %>"
                                                data-unidad-inventario-id="<%= p.unidad_inventario_id || '' %>"
                                                data-unidad-inventario="<%= p.unidad_inventario_abreviatura || p.unidad_inventario_nombre || '' %>">[<%= p.codigo %>] <%= p.nombre %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="unidad_medida_id" class="form-label fw-semibold text-secondary small">Unidad de la entrada</label>
                            <select class="form-select shadow-sm" id="unidad_medida_id" required disabled>
                                <option value="">Seleccione el producto primero...</option>
                                <% if (typeof unidades !== 'undefined') { %>
                                    <% unidades.forEach(u => { %>
                                        <option value="<%= u.id %>" data-tipo="<%= u.tipo %>"><%= u.nombre %> (<%= u.abreviatura %>)</option>
                                    <% }) %>
                                <% } %>
                            </select>
                            <div class="form-text">Use una unidad del catálogo. Si es distinta de la unidad de inventario, debe existir un factor de conversión activo.</div>
                        </div>
                        <div class="col-md-4">
                            <label for="numero_lote" class="form-label fw-semibold text-secondary small">Número de Lote / Consecutivo</label>
                            <input type="text" id="numero_lote" class="form-control shadow-sm font-monospace bg-light text-muted" disabled placeholder="Autogenerado (LOT-2026-XXX)">
                        </div>
                        <div class="col-md-4">
                            <label for="fecha_ingreso" class="form-label fw-semibold text-secondary small">Fecha de Ingreso</label>
                            <input type="date" id="fecha_ingreso" class="form-control shadow-sm" required>
                        </div>
                        <div class="col-md-4">
                            <label for="fecha_vencimiento" class="form-label fw-semibold text-secondary small">Fecha Vencimiento (Opcional)</label>
                            <input type="date" id="fecha_vencimiento" class="form-control shadow-sm">
                        </div>
                        <div class="col-md-6">
                            <label for="cantidad" class="form-label fw-semibold text-secondary small">Cantidad Ingresada</label>
                            <div class="input-group">
                                <input type="number" step="0.001" id="cantidad" class="form-control shadow-sm" required min="0.001" placeholder="0.000">
                                <span class="input-group-text bg-light text-muted" id="cantidadUnidad">—</span>
                            </div>
                            <div id="conversionHint" class="form-text small"></div>
                        </div>
                        <div class="col-md-6">
                            <label for="costo_unitario" class="form-label fw-semibold text-secondary small">Costo Unitario ($)</label>
                            <input type="number" step="0.000001" id="costo_unitario" class="form-control shadow-sm" required min="0.000001" placeholder="0.00">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success px-4 shadow-sm">Guardar Stock</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="/js/select2-busqueda-instantanea.js"></script>
    
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const modalElement = document.getElementById('modalEntrada');
        const bsModal = new bootstrap.Modal(modalElement);
        
        const fechaIngresoInput = document.getElementById('fecha_ingreso');
        const fechaVencimientoInput = document.getElementById('fecha_vencimiento');

        // Función para limitar el calendario de vencimiento dinámicamente
        function actualizarMinimoVencimiento() {
            const fechaIngresoValue = fechaIngresoInput.value;
            if (fechaIngresoValue) {
                // La fecha de vencimiento debe ser estrictamente posterior a la de ingreso
                const dateObj = new Date(fechaIngresoValue + 'T00:00:00');
                dateObj.setDate(dateObj.getDate() + 1);
                const minDateIso = dateObj.toISOString().split('T')[0];
                fechaVencimientoInput.min = minDateIso;
            } else {
                fechaVencimientoInput.removeAttribute('min');
            }
        }

        // Forzar por defecto la fecha de hoy e inicializar restricciones básicas
        fechaIngresoInput.value = new Date().toISOString().split('T')[0];
        actualizarMinimoVencimiento();

        // Escuchar cambios en la fecha de ingreso para actualizar los límites del calendario
        fechaIngresoInput.addEventListener('change', actualizarMinimoVencimiento);

        // Inicializar Select2 al abrir el modal de Bootstrap
        $(modalElement).on('shown.bs.modal', function () {
            $('.select2-busqueda').select2({
                dropdownParent: $(modalElement),
                placeholder: "Escriba para buscar un insumo...",
                allowClear: true
            });
        });

        // CONTROL DE FLUJO SÍNCRONO ENTRE SELECTS
        const $almacenSelect = $('#almacen_id');
        const $productoSelect = $('.select2-busqueda');
        const $unidadSelect = $('#unidad_medida_id');

        $almacenSelect.on('change', function() {
            const almacenSeleccionado = $(this).val();
            if (almacenSeleccionado && almacenSeleccionado !== "") {
                $productoSelect.prop('disabled', false);
            } else {
                $productoSelect.val('').trigger('change.select2');
                $productoSelect.prop('disabled', true);
                $unidadSelect.val('').prop('disabled', true);
            }
        });

        // ── Unidad de medida: abreviatura junto a la cantidad + equivalencia ──
        const cacheFactores = {};
        let unidadInventarioTxt = '';

        function abrevUnidadSeleccionada() {
            const texto = $unidadSelect.find('option:selected').text() || '';
            const m = texto.match(/\(([^)]+)\)\s*$/);
            return m ? m[1] : '';
        }

        async function actualizarUnidadUI() {
            const option = $productoSelect[0] ? $productoSelect[0].options[$productoSelect[0].selectedIndex] : null;
            const unidadInventarioId = option ? (option.getAttribute('data-unidad-inventario-id') || '') : '';
            unidadInventarioTxt = option ? (option.getAttribute('data-unidad-inventario') || '') : '';

            const productoId = $productoSelect.val();
            const unidadId = $unidadSelect.val();
            const abrevSel = unidadId ? abrevUnidadSeleccionada() : '';
            $('#cantidadUnidad').text(abrevSel || '—');

            const hint = $('#conversionHint');
            if (!productoId || !unidadId) {
                hint.attr('class', 'form-text small').html('');
                return;
            }

            // Si la unidad elegida difiere de la unidad de inventario, muestra la
            // equivalencia de la cantidad capturada (factor por producto, global
            // o vía unidad base, según la configuración de conversiones).
            if (unidadInventarioId && Number(unidadId) !== Number(unidadInventarioId)) {
                const clave = productoId + ':' + unidadId;
                let factor = cacheFactores[clave];
                if (factor === undefined) {
                    try {
                        const resp = await fetch('/admin/api/unidades-medida/convertir?cantidad=1&desde=' + unidadId + '&hasta=' + unidadInventarioId + '&producto_id=' + productoId);
                        const data = await resp.json();
                        factor = data.success ? (Number(data.factor) || 1) : null;
                    } catch (e) {
                        factor = null;
                    }
                    cacheFactores[clave] = factor;
                }
                if (factor === null) {
                    hint.attr('class', 'form-text small text-danger fw-semibold')
                        .html('<i class="fa-solid fa-triangle-exclamation me-1"></i>No hay factor de conversión activo hacia la unidad de inventario' + (unidadInventarioTxt ? ' (' + unidadInventarioTxt + ')' : '') + '.');
                    return;
                }
                const cantidad = parseFloat($('#cantidad').val());
                hint.attr('class', 'form-text small text-muted')
                    .html('<i class="fa-solid fa-right-left me-1"></i>1 ' + abrevSel + ' = ' + factor + ' ' + (unidadInventarioTxt || 'unidad de inventario') +
                          (!isNaN(cantidad) ? ' · Equivale a: <strong>' + (cantidad * factor).toLocaleString('es-ES', { maximumFractionDigits: 3 }) + ' ' + (unidadInventarioTxt || '') + '</strong>' : ''));
            } else {
                hint.attr('class', 'form-text small').html('');
            }
        }

        $unidadSelect.on('change', actualizarUnidadUI);
        $('#cantidad').on('input', actualizarUnidadUI);

        // El producto propone su unidad canónica de inventario, pero la
        // entrada permite cualquier unidad activa con factor configurado.
        $productoSelect.on('change', function() {
            const option = this.options[this.selectedIndex];
            const unidadInventarioId = option ? option.getAttribute('data-unidad-inventario-id') : '';
            $unidadSelect.prop('disabled', !this.value);
            $unidadSelect.val(unidadInventarioId || '');
            actualizarUnidadUI();
        });

        // Manejo dinámico para abrir el modal desde el Header
        document.addEventListener('click', (e) => {
            const tgt = e.target.closest('[data-bs-target="modalEntrada"]') || e.target.closest('[data-bs-target="#modalEntrada"]');
            if (tgt) {
                e.preventDefault();
                bsModal.show();
            }
        });

        // Limpiar el modal por completo tras su cierre
        modalElement.addEventListener('hidden.bs.modal', () => {
            document.getElementById('formEntrada').reset();
            $productoSelect.val('').trigger('change.select2');
            $productoSelect.prop('disabled', true);
            $unidadSelect.val('').prop('disabled', true);
            $('#cantidadUnidad').text('—');
            $('#conversionHint').attr('class', 'form-text small').html('');
            fechaIngresoInput.value = new Date().toISOString().split('T')[0];
            actualizarMinimoVencimiento();
        });

        // Envío AJAX asíncrono controlado
        document.getElementById('formEntrada').addEventListener('submit', async function(e) {
            e.preventDefault();

            const fIngreso = fechaIngresoInput.value;
            const fVencimiento = fechaVencimientoInput.value;

            // Validación de seguridad cronológica de última línea
            if (fVencimiento && fVencimiento !== "") {
                if (new Date(fVencimiento + 'T00:00:00') <= new Date(fIngreso + 'T00:00:00')) {
                    Swal.fire({
                        title: 'Inconsistencia de Fechas',
                        text: 'La fecha de vencimiento debe ser posterior a la fecha de ingreso de la mercadería.',
                        icon: 'error',
                        confirmButtonColor: '#3085d6'
                    });
                    return; // Detiene la ejecución e impide el envío al servidor
                }
            }
            
            const payload = {
                almacen_id: document.getElementById('almacen_id').value,
                producto_id: document.getElementById('producto_id').value,
                unidad_medida_id: document.getElementById('unidad_medida_id').value,
                fecha_ingreso: fIngreso,
                fecha_vencimiento: fVencimiento || '', 
                cantidad: document.getElementById('cantidad').value,
                costo_unitario: document.getElementById('costo_unitario').value
            };

            Swal.fire({
                title: 'Registrando entrada...',
                text: 'Actualizando el inventario',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => Swal.showLoading()
            });

            try {
                const response = await fetch('/admin/almacenes/entradas/api', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();
                
                if (data.success) {
                    bsModal.hide();
                    Swal.fire({
                        title: '¡Ingreso Exitoso!',
                        text: data.message,
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => { location.reload(); });
                } else {
                    let errorMsg = data.message;
                    if (data.errors && data.errors.length > 0) {
                        errorMsg = data.errors.map(err => `• ${err.message}`).join('<br>');
                    }
                    Swal.fire({
                        title: 'Validación Incompleta',
                        html: `<div class="text-start">${errorMsg}</div>`,
                        icon: 'warning'
                    });
                }
            } catch (error) {
                Swal.fire('Error Operativo', 'No se pudo comunicar con el servidor central de inventarios.', 'error');
            }
        });
    });
    </script>
</body>
</html>