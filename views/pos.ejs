                            </div>
                            <button type="button" id="btn-add-pago" class="btn btn-primary btn-sm w-100 fw-bold">
                                + Agregar Abono
                            </button>
                        </div>

                        <div class="border rounded overflow-hidden mb-2">
                            <table class="table table-sm table-striped mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>Método</th>
                                        <th>Moneda</th>
                                        <th>Monto</th>
                                        <th>Eq. Local</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="tbl-pagos-body">
                                    <tr><td colspan="5" class="text-center text-muted py-2">Sin abonos agregados</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex gap-3 pt-2 border-top">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="swal-es-pendiente-pago">
                                <label class="form-check-label small" for="swal-es-pendiente-pago">Pendiente Pago</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="swal-es-cortesia">
                                <label class="form-check-label small" for="swal-es-cortesia">Cortesía (100%)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="swal-es-factura">
                                <label class="form-check-label small" for="swal-es-factura">Factura (Crédito)</label>
                            </div>
                        </div>
                    </div>
                `,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Finalizar y Liberar Mesa',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#059669',
                cancelButtonColor: '#64748b',
                didOpen: () => {
                    const chkCortesia = document.getElementById('swal-es-cortesia');
                    const chkFactura = document.getElementById('swal-es-factura');
                    const chkPendiente = document.getElementById('swal-es-pendiente-pago');

                    const inputDescuento = document.getElementById('swal-descuento');
                    const inputRecargo = document.getElementById('swal-recargo');
                    const inputPropina = document.getElementById('swal-propina');

                    const lblTotalPagar = document.getElementById('lbl-total-pagar');
                    const lblRestante = document.getElementById('lbl-restante');
                    const lblExcedente = document.getElementById('lbl-excedente');

                    const listaPagos = [];

                    function calcularTotalNeto() {
                        if (chkCortesia && chkCortesia.checked) return 0;
                        const desc = Math.max(0, parseFloat(inputDescuento ? inputDescuento.value : 0) || 0);
                        const rec = Math.max(0, parseFloat(inputRecargo ? inputRecargo.value : 0) || 0);
                        const prop = Math.max(0, parseFloat(inputPropina ? inputPropina.value : 0) || 0);
                        // La propina se suma al total a pagar: el cliente paga
                        // órdenes + propina y ambas cantidades entran a caja.
                        return Math.max(0, (totalBaseCalculado - desc + rec + prop));
                    }

                    function updateTabla() {
                        const tbody = document.getElementById('tbl-pagos-body');
                        const totalRequerido = calcularTotalNeto();
                        if (lblTotalPagar) lblTotalPagar.textContent = `$${totalRequerido.toFixed(2)}`;

                        const totalAbonadoLocal = listaPagos.reduce((s, p) => s + p.monto_equivalente_local, 0);
                        const diferencia = totalAbonadoLocal - totalRequerido;

                        if (diferencia >= 0) {
                            if (lblRestante) lblRestante.textContent = `$0.00`;
                            if (lblExcedente) lblExcedente.textContent = `$${diferencia.toFixed(2)}`;
                        } else {
                            if (lblRestante) lblRestante.textContent = `$${Math.abs(diferencia).toFixed(2)}`;
                            if (lblExcedente) lblExcedente.textContent = `$0.00`;
                        }

                        if (!tbody) return;

                        if (listaPagos.length === 0) {
                            tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-2">Sin abonos agregados</td></tr>`;
                            return;
                        }

                        tbody.innerHTML = listaPagos.map((p, idx) => `
                            <tr>
                                <td class="text-uppercase fw-bold">${p.metodo_pago}</td>
                                <td class="font-digits">${p.codigo_moneda}</td>
                                <td class="font-digits">${p.simbolo}${p.monto_moneda_origen.toFixed(2)}</td>
                                <td class="font-digits fw-bold text-success">$${p.monto_equivalente_local.toFixed(2)}</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 btn-remove-pago" data-idx="${idx}">✕</button>
                                </td>
                            </tr>
                        `).join('');

                        document.querySelectorAll('.btn-remove-pago').forEach(btn => {
                            btn.addEventListener('click', (e) => {
                                const index = parseInt(e.target.dataset.idx);
                                listaPagos.splice(index, 1);
                                updateTabla();
                            });
                        });
                    }

                    if (chkPendiente) {
                        chkPendiente.addEventListener('change', (e) => {
                            if (e.target.checked) {
                                if (chkCortesia) chkCortesia.checked = false;
                                if (chkFactura) chkFactura.checked = false;
                            }
                            updateTabla();
                        });
                    }

                    if (chkCortesia) {
                        chkCortesia.addEventListener('change', (e) => {
                            if (e.target.checked) {
                                if (chkFactura) chkFactura.checked = false;
                                if (chkPendiente) chkPendiente.checked = false;
                            }
                            updateTabla();
                        });
                    }

                    if (chkFactura) {
                        chkFactura.addEventListener('change', (e) => {
                            if (e.target.checked) {
                                if (chkCortesia) chkCortesia.checked = false;
                                if (chkPendiente) chkPendiente.checked = false;
                            }
                            updateTabla();
                        });
                    }

                    if (inputDescuento) inputDescuento.addEventListener('input', updateTabla);
                    if (inputRecargo) inputRecargo.addEventListener('input', updateTabla);
                    if (inputPropina) inputPropina.addEventListener('input', updateTabla);

                    const btnAddPago = document.getElementById('btn-add-pago');
                    if (btnAddPago) {
                        btnAddPago.addEventListener('click', () => {
                            const selectMoneda = document.getElementById('swal-moneda');
                            const optionSelected = selectMoneda.options[selectMoneda.selectedIndex];
                            
                            const metodo = document.getElementById('swal-metodo').value;
                            const moneda_id = parseInt(selectMoneda.value);
                            const codigo_moneda = optionSelected.dataset.codigo || 'USD';
                            const factor_cambio = parseFloat(optionSelected.dataset.factor || 1.0);
                            const simbolo = optionSelected.dataset.simbolo || '$';
                            const monto_origen = parseFloat(document.getElementById('swal-monto-origen').value);
                            const referencia = document.getElementById('swal-referencia').value;

                            if (isNaN(monto_origen) || monto_origen <= 0) return;

                            const monto_equivalente_local = monto_origen * factor_cambio;

                            listaPagos.push({
                                metodo_pago: metodo,
                                moneda_id,
                                codigo_moneda,
                                factor_cambio_aplicado: factor_cambio,
                                monto_moneda_origen: monto_origen,
                                monto_equivalente_local,
                                referencia_transaccion: referencia,
                                simbolo
                            });

                            document.getElementById('swal-monto-origen').value = '';
                            document.getElementById('swal-referencia').value = '';
                            updateTabla();
                        });
                    }

                    window._tempPagosModal = listaPagos;
                    updateTabla();
                },
                preConfirm: () => {
                    const esCortesia = document.getElementById('swal-es-cortesia')?.checked || false;
                    const esFactura = document.getElementById('swal-es-factura')?.checked || false;
                    const esPendientePago = document.getElementById('swal-es-pendiente-pago')?.checked || false;
                    const descuento = Math.max(0, parseFloat(document.getElementById('swal-descuento')?.value) || 0);
                    const recargo = Math.max(0, parseFloat(document.getElementById('swal-recargo')?.value) || 0);
                    const propina = Math.max(0, parseFloat(document.getElementById('swal-propina')?.value) || 0);
                    const motivo_ajuste = document.getElementById('swal-motivo-ajuste')?.value || '';
                    const pagos = window._tempPagosModal || [];

                    if (!esCortesia && !esFactura && !esPendientePago && pagos.length === 0) {
                        return false;
                    }

                    return {
                        pagos,
                        es_cortesia: esCortesia,
                        es_factura_credito: esFactura,
                        es_pendiente_pago: esPendientePago,
                        descuento,
                        recargo,
                        propina,
                        motivo_ajuste
                    };
                }
            });

            if (!formValues) return;

            try {
                const response = await fetch(`/pos/cobrar/${idPedido}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formValues)
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Mesa Cobrada y Liberada',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.href = POS_DASHBOARD_URL;
                    });
                } else {
                    Swal.fire('Error en el cobro', data.message || 'No se pudo registrar el pago', 'error');
                }
            } catch (err) {
                Swal.fire('Error de Red', 'Fallo al procesar el pago.', 'error');
            }
        }

        let itemsListosAnteriores = new Set();
        function verificarItemsListos() {
            if (!MONITORES_HABILITADOS) return;
            const idPedido = document.getElementById('pos_id_pedido').value;
            if (!idPedido || idPedido == 0) return;

            fetch(`/api/pos/items-listos/${idPedido}`)
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.itemsListos) {
                        let hayNuevosListos = false;

                        data.itemsListos.forEach(item => {
                            if (!itemsListosAnteriores.has(item.id_detalle)) {
                                itemsListosAnteriores.add(item.id_detalle);
                                hayNuevosListos = true;

                                const hItem = historicoDetalles.find(d => d.id_detalle == item.id_detalle);
                                if (hItem) hItem.estado = 'listo';
                            }
                        });

                        if (hayNuevosListos) {
                            renderHistory();
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: '¡Nuevos platillos listos!',
                                showConfirmButton: false,
                                timer: 3000
                            });
                        }
                    }
                })
                .catch(err => console.error("Error al consultar ítems listos:", err));
        }

        let pollTimer = null;
        function iniciarPollingItemsListos() {
            if (!MONITORES_HABILITADOS) return;
            verificarItemsListos();
            if (!pollTimer) pollTimer = setInterval(verificarItemsListos, 8000);
        }

        function detenerPollingItemsListos() {
            if (pollTimer) {
                clearInterval(pollTimer);
                pollTimer = null;
            }
        }

        iniciarPollingItemsListos();
        window.addEventListener('beforeunload', detenerPollingItemsListos);
    </script>
</body>
</html>