                const resMonedas = await fetch('/api/pos/monedas-turno-activo');
                const dataMonedas = await resMonedas.json();
                if (dataMonedas.success) monedasTurno = dataMonedas.monedas || [];
            } catch (e) {
                console.error("Error al consultar monedas:", e);
            }

            const { value: formValues } = await Swal.fire({
                title: 'Cobro y Cierre de Mesa',
                width: '640px',
                html: `
                    <div class="text-start small p-1">
                        <div class="bg-light p-2.5 rounded border d-flex justify-content-between text-center mb-3">
                            <div>
                                <small class="text-muted d-block font-semibold">${FACTURA_IMPUESTO > 0 ? 'Subtotal+Tax' : 'Subtotal'}</small>
