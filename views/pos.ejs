                            </div>
                            <div>
                                <small class="text-muted d-block font-semibold">Excedente</small>
                                <strong class="font-digits fs-6 text-success" id="lbl-excedente">$0.00</strong>
                            </div>
                        </div>

                        <div class="row g-2 mb-3 bg-light p-2 rounded border">
                            <div class="col-6">
                                <label class="small fw-bold">Descuento ($)</label>
                                <input type="number" id="swal-descuento" min="0" step="0.01" value="0.00" class="form-control form-control-sm font-digits">
                            </div>
                            <div class="col-6">
                                <label class="small fw-bold">Recargo ($)</label>
                                <input type="number" id="swal-recargo" min="0" step="0.01" value="0.00" class="form-control form-control-sm font-digits">
                            </div>
                            <div class="col-6">
                                <label class="small fw-bold text-success">Propina ($)</label>
                                <input type="number" id="swal-propina" min="0" step="0.01" value="0.00" class="form-control form-control-sm font-digits text-success">
                            </div>
                            <div class="col-6">
                                <label class="small fw-bold">Motivo</label>
                                <input type="text" id="swal-motivo-ajuste" class="form-control form-control-sm" placeholder="VIP / Servicio">
                            </div>
