<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - Restaurante Bahía</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <style>
        body { 
            background-color: #f3f4f6; 
            min-height: 100vh;
        }
        .card-login {
            background: #ffffff;
            border-radius: 0.75rem; 
            border: 1px solid #e5e7eb;
            max-width: 420px;
            width: 100%;
        }
        /* Ajuste para que el logotipo luzca nítido y proporcionado */
        .brand-logo {
            max-width: 240px;
            height: auto;
            display: block;
            margin: 0 auto;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center p-3">

    <div class="card card-login shadow-sm p-4 p-sm-5">
        
        <div class="text-center mb-4">
            <img src="/img/bahia_logotipo.png" alt="Logotipo Restaurante Bahía" class="brand-logo mb-3">
        </div>

        <form action="/login" method="POST">
            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary small">Usuario</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="fa-solid fa-user small"></i></span>
                    <input type="text" name="usuario" class="form-control border-start-0" placeholder="Usuario" required autofocus>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary small">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="fa-solid fa-lock small"></i></span>
                    <input type="password" name="password" class="form-control border-start-0" placeholder="Contraseña" required>
                </div>
            </div>

            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="remember" name="remember">
                <label class="form-check-label" for="remember">Recu&eacute;rdame</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 shadow-sm fw-semibold d-flex align-items-center justify-content-center gap-2">
                <i class="fa-solid fa-right-to-bracket"></i> ENTRAR
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <p class="text-muted mb-2" style="font-size: 0.78rem;">
                &copy; 2026 Restaurante Bahía. Todos los derechos reservados.
            </p>
            
            <!-- Marca de la Aplicación (SURAXIS) incorporada del footer -->
            <div class="d-flex align-items-center justify-content-center gap-2 mt-2">
                <img src="/img/logo-suraxis.png" alt="SURAXIS Logo" style="height: 20px; width: auto; object-fit: contain;">
                <span class="fw-bold" style="color: #0b457f; font-size: 0.82rem;">SURAXIS &COPY;</span>
            </div>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Inyección controlada y segura de las variables flash del servidor
            const errorMsg = "<%= (typeof error_msg !== 'undefined' && error_msg) ? error_msg : '' %>";
            const successMsg = "<%= (typeof success_msg !== 'undefined' && success_msg) ? success_msg : '' %>";

            // Alerta para errores de login
            if (errorMsg && errorMsg.trim() !== "") {
                Swal.fire({
                    icon: 'error',
                    title: 'Acceso Denegado',
                    text: errorMsg,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Entendido'
                });
            }

            // Alerta para mensajes informativos exitosos (Cierre de sesión, etc.)
            if (successMsg && successMsg.trim() !== "") {
                Swal.fire({
                    icon: 'success',
                    title: '¡Operación Exitosa!',
                    text: successMsg,
                    confirmButtonColor: '#198754',
                    confirmButtonText: 'Aceptar',
                    timer: 2500
                });
            }
        });
    </script>
</body>
</html>