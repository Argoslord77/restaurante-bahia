<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Ventas por Hora y Día - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        @media print {
            #sidebarMenu, .content-header-responsive, .btn { display: none !important; }
            main { width: 100% !important; margin: 0 !important; }
        }
    </style>
</head>
<body class="bg-light">

    <div class="container-fluid">
        <div class="row">

            <%- include('../includes/topBarMobile') %>

            <%- include('../includes/sideBarMenu') %>

            <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">

                <%- include('../includes/header', {encabezado_pagina: 'Ventas por Hora y Día', desc_pagina: 'Distribución del tráfico de cuentas cobradas por hora y día de la semana (según apertura de la mesa).', add_btn: false}) %>

                <!-- Filtro de período -->
                <div class="card border-0 shadow-sm rounded p-3 mb-4 bg-white">
                    <form method="get" action="/admin/reportes/ventas-horas" class="row g-2 align-items-end">
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted fw-semibold mb-1">Desde</label>
                            <input type="date" name="desde" class="form-control form-control-sm" value="<%= rango.desde %>">
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted fw-semibold mb-1">Hasta</label>
                            <input type="date" name="hasta" class="form-control form-control-sm" value="<%= rango.hasta %>">
                        </div>
                        <div class="col-12 col-md-2 d-grid">
                            <button type="submit" class="btn btn-dark btn-sm fw-semibold py-2">
                                <i class="fa-solid fa-magnifying-glass me-1"></i> Consultar
                            </button>
                        </div>
                        <div class="col-12 col-md-4 d-flex justify-content-md-end gap-2">
                            <a href="/admin/reportes/ventas-horas/exportar?desde=<%= rango.desde %>&hasta=<%= rango.hasta %>" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                                <i class="fa-solid fa-file-csv text-success me-1"></i> Exportar CSV
                            </a>
                            <button type="button" onclick="window.print()" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                                <i class="fa-solid fa-print text-secondary me-1"></i> Imprimir
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Resumen y picos -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Cuentas del período</h6>
                            <h3 class="fw-bold mb-0 text-dark"><%= reporte.totales.cuentas %></h3>
                            <small class="text-muted">Cobradas</small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-success border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Ventas</h6>
                            <h3 class="fw-bold mb-0 text-success">$<%= reporte.totales.ventas.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></h3>
                            <small class="text-muted">Ticket promedio $<%= reporte.totales.ticket_promedio.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-primary border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Hora pico</h6>
                            <h3 class="fw-bold mb-0 text-primary"><%= reporte.horaPico ? reporte.horaPico.etiqueta : '—' %></h3>
                            <small class="text-muted"><%= reporte.horaPico ? reporte.horaPico.cuentas + ' cuentas · $' + reporte.horaPico.ventas.toLocaleString('es-ES', { minimumFractionDigits: 2 }) : 'Sin datos' %></small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-warning border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Día pico</h6>
                            <h3 class="fw-bold mb-0 text-warning"><%= reporte.diaPico ? reporte.diaPico.nombre : '—' %></h3>
                            <small class="text-muted"><%= reporte.diaPico ? reporte.diaPico.cuentas + ' cuentas · $' + reporte.diaPico.ventas.toLocaleString('es-ES', { minimumFractionDigits: 2 }) : 'Sin datos' %></small>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <!-- Por hora -->
                    <div class="col-12 col-xl-6">
                        <div class="card border-0 shadow-sm rounded bg-white h-100">
                            <div class="card-header bg-white border-0 pt-3 px-4 d-flex align-items-center gap-2">
                                <i class="fa-solid fa-clock text-dark"></i>
                                <h6 class="fw-bold mb-0">Distribución por hora</h6>
                                <span class="badge text-bg-dark ms-auto">apertura de la cuenta</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0 fs-7">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4 py-3">Hora</th>
                                            <th class="py-3 text-end">Cuentas</th>
                                            <th class="py-3 text-end">Ventas</th>
                                            <th class="py-3 text-end">Excedente</th>
                                            <th class="py-3 text-end pe-4" style="min-width:160px">Peso</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% reporte.horas.forEach(h => { %>
                                            <% const pct = reporte.maxHoraVentas > 0 ? (h.ventas / reporte.maxHoraVentas * 100) : 0; %>
                                            <% const esPico = reporte.horaPico && h.hora === reporte.horaPico.hora; %>
                                        <tr class="<%= esPico ? 'table-primary' : '' %>">
                                            <td class="ps-4 fw-semibold"><%= h.etiqueta %><% if (esPico) { %> <span class="badge text-bg-primary ms-1">pico</span><% } %></td>
                                            <td class="text-end"><%= h.cuentas %></td>
                                            <td class="text-end fw-semibold">$<%= h.ventas.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                            <td class="text-end text-warning">$<%= (h.excedentes || 0).toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                            <td class="pe-4">
                                                <div class="progress" style="height: 16px;">
                                                    <div class="progress-bar bg-<%= esPico ? 'primary' : 'secondary' %>" role="progressbar" style="width: <%= Math.min(pct, 100) %>%;" aria-valuenow="<%= pct.toFixed(0) %>" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                        <% if (reporte.horas.length === 0) { %>
                                        <tr><td colspan="4" class="text-center text-muted py-4">Sin cuentas cobradas en el período.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Por día de la semana -->
                    <div class="col-12 col-xl-6">
                        <div class="card border-0 shadow-sm rounded bg-white h-100">
                            <div class="card-header bg-white border-0 pt-3 px-4 d-flex align-items-center gap-2">
                                <i class="fa-solid fa-calendar-week text-dark"></i>
                                <h6 class="fw-bold mb-0">Distribución por día</h6>
                                <span class="badge text-bg-dark ms-auto">lunes a domingo</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0 fs-7">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4 py-3">Día</th>
                                            <th class="py-3 text-end">Cuentas</th>
                                            <th class="py-3 text-end">Ventas</th>
                                            <th class="py-3 text-end">Excedente</th>
                                            <th class="py-3 text-end pe-4" style="min-width:160px">Peso</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% reporte.dias.forEach(d => { %>
                                            <% const pct = reporte.maxDiaVentas > 0 ? (d.ventas / reporte.maxDiaVentas * 100) : 0; %>
                                            <% const esPico = reporte.diaPico && d.dia === reporte.diaPico.dia; %>
                                        <tr class="<%= esPico ? 'table-warning' : '' %>">
                                            <td class="ps-4 fw-semibold"><%= d.nombre %><% if (esPico) { %> <span class="badge text-bg-warning text-dark ms-1">pico</span><% } %></td>
                                            <td class="text-end"><%= d.cuentas %></td>
                                            <td class="text-end fw-semibold">$<%= d.ventas.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                            <td class="text-end text-warning">$<%= (d.excedentes || 0).toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                            <td class="pe-4">
                                                <div class="progress" style="height: 16px;">
                                                    <div class="progress-bar bg-<%= esPico ? 'warning' : 'secondary' %>" role="progressbar" style="width: <%= Math.min(pct, 100) %>%;" aria-valuenow="<%= pct.toFixed(0) %>" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                        <% if (reporte.dias.length === 0) { %>
                                        <tr><td colspan="4" class="text-center text-muted py-4">Sin cuentas cobradas en el período.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <%- include('../includes/footer') %>
            </main>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
</body>
</html>
