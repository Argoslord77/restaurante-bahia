<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Tendencias de Venta - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        @media print {
            #sidebarMenu, .content-header-responsive, .btn { display: none !important; }
            main { width: 100% !important; margin: 0 !important; }
        }
        .barra-venta { height: 14px; }
    </style>
</head>
<body class="bg-light">

    <div class="container-fluid">
        <div class="row">

            <%- include('../includes/topBarMobile') %>

            <%- include('../includes/sideBarMenu') %>

            <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">

                <%- include('../includes/header', {encabezado_pagina: 'Tendencias', desc_pagina: 'Hacia dónde va la venta: evolución en el tiempo, comparación contra el período anterior de igual duración y tragos/platillos a la alza o baja.', add_btn: false}) %>

                <% const fmtMoneda = (v) => (v == null ? '—' : '$' + Number(v).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 })); %>
                <% const fmtNum = (v, dec = 0) => (v == null ? '—' : Number(v).toLocaleString('es-ES', { minimumFractionDigits: dec, maximumFractionDigits: dec })); %>
                <% const claseDelta = (d) => (d == null ? 'secondary' : (d > 0 ? 'success' : (d < 0 ? 'danger' : 'secondary'))); %>
                <% const textoDelta = (d) => (d == null ? '—' : (d > 0 ? '+' : '') + fmtNum(d, 1) + '%'); %>
                <% const iconoDelta = (d) => (d == null ? 'fa-minus' : (d > 0 ? 'fa-arrow-trend-up' : (d < 0 ? 'fa-arrow-trend-down' : 'fa-equals'))); %>
                <% const claseEstado = (e) => ({ 'sube': 'success', 'nuevo': 'success', 'baja': 'danger', 'sin-ventas': 'danger', 'estable': 'secondary' }[e] || 'secondary'); %>

                <!-- Filtro de período -->
                <div class="card border-0 shadow-sm rounded p-3 mb-4 bg-white">
                    <form method="get" action="/admin/reportes/tendencias" class="row g-2 align-items-end">
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted fw-semibold mb-1">Desde</label>
                            <input type="date" name="desde" class="form-control form-control-sm" value="<%= rango.desde %>">
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted fw-semibold mb-1">Hasta</label>
                            <input type="date" name="hasta" class="form-control form-control-sm" value="<%= rango.hasta %>">
                        </div>
                        <div class="col-12 col-md-2 d-grid">
                            <button type="submit" class="btn btn-dark btn-sm fw-semibold py-2">
                                <i class="fa-solid fa-magnifying-glass me-1"></i> Consultar
                            </button>
                        </div>
                        <div class="col-12 col-md-4 d-flex justify-content-md-end gap-2">
                            <a href="/admin/reportes/tendencias/exportar?desde=<%= rango.desde %>&hasta=<%= rango.hasta %>" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                                <i class="fa-solid fa-file-csv text-success me-1"></i> Exportar CSV
                            </a>
                            <button type="button" onclick="window.print()" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                                <i class="fa-solid fa-print text-secondary me-1"></i> Imprimir
                            </button>
                        </div>
                    </form>
                    <div class="mt-2 small text-muted">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Período del <%= rango.desde %> al <%= rango.hasta %> (<%= reporte.dias %> día<%= reporte.dias === 1 ? '' : 's' %>), comparado con el <%= reporte.prevDesde %> al <%= reporte.prevHasta %>.
                        <% if (reporte.agrupacion === 'semanal') { %>
                            El alcance es largo: la serie se muestra por semanas.
                        <% } %>
                    </div>
                </div>

                <!-- Indicadores comparativos -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-success border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Venta cobrada</h6>
                            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                                <h3 class="fw-bold mb-0 text-success"><%= fmtMoneda(reporte.totales.venta) %></h3>
                                <span class="badge text-bg-<%= claseDelta(reporte.totales.venta_delta_pct) %>">
                                    <i class="fa-solid <%= iconoDelta(reporte.totales.venta_delta_pct) %> me-1"></i><%= textoDelta(reporte.totales.venta_delta_pct) %>
                                </span>
                            </div>
                            <small class="text-muted">anterior: <%= fmtMoneda(reporte.totales.venta_prev) %></small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-primary border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Cuentas cobradas</h6>
                            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                                <h3 class="fw-bold mb-0 text-primary"><%= fmtNum(reporte.totales.cuentas) %></h3>
                                <span class="badge text-bg-<%= claseDelta(reporte.totales.cuentas_delta_pct) %>">
                                    <i class="fa-solid <%= iconoDelta(reporte.totales.cuentas_delta_pct) %> me-1"></i><%= textoDelta(reporte.totales.cuentas_delta_pct) %>
                                </span>
                            </div>
                            <small class="text-muted">anterior: <%= fmtNum(reporte.totales.cuentas_prev) %></small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-dark border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Ticket promedio</h6>
                            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                                <h3 class="fw-bold mb-0"><%= fmtMoneda(reporte.totales.ticket) %></h3>
                                <span class="badge text-bg-<%= claseDelta(reporte.totales.ticket_delta_pct) %>">
                                    <i class="fa-solid <%= iconoDelta(reporte.totales.ticket_delta_pct) %> me-1"></i><%= textoDelta(reporte.totales.ticket_delta_pct) %>
                                </span>
                            </div>
                            <small class="text-muted">anterior: <%= fmtMoneda(reporte.totales.ticket_prev) %></small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-warning border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Ritmo del período</h6>
                            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                                <% if (reporte.ritmo.direccion === 'acelerando') { %>
                                    <h3 class="fw-bold mb-0 text-success"><i class="fa-solid fa-gauge-high me-1"></i>Acelerando</h3>
                                <% } else if (reporte.ritmo.direccion === 'frenando') { %>
                                    <h3 class="fw-bold mb-0 text-danger"><i class="fa-solid fa-gauge-low me-1"></i>Frenando</h3>
                                <% } else if (reporte.ritmo.direccion === 'estable') { %>
                                    <h3 class="fw-bold mb-0 text-secondary"><i class="fa-solid fa-equals me-1"></i>Estable</h3>
                                <% } else { %>
                                    <h3 class="fw-bold mb-0 text-secondary">—</h3>
                                <% } %>
                            </div>
                            <small class="text-muted">
                                <%= reporte.ritmo.delta_pct != null ? (reporte.ritmo.delta_pct > 0 ? '+' : '') + fmtNum(reporte.ritmo.delta_pct, 1) + '% de venta media: 2.ª mitad vs 1.ª mitad' : 'sin base de comparación' %>
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Serie temporal -->
                <div class="card border-0 shadow-sm rounded bg-white mb-4">
                    <div class="card-header bg-white border-0 pt-3 px-4 d-flex align-items-center gap-2 flex-wrap">
                        <i class="fa-solid fa-chart-column text-dark"></i>
                        <h6 class="fw-bold mb-0">Evolución de la venta</h6>
                        <span class="badge text-bg-dark ms-auto"><%= reporte.agrupacion === 'semanal' ? 'por semana' : 'por día' %></span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 fs-7">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 py-3"><%= reporte.agrupacion === 'semanal' ? 'Semana' : 'Día' %></th>
                                    <th class="py-3 text-end">Cuentas</th>
                                    <th class="py-3 text-end">Venta</th>
                                    <th class="py-3 pe-4" style="min-width: 220px;">Volumen</th>
                                    <th class="py-3 text-center pe-4">vs anterior</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% reporte.serie.forEach(d => { %>
                                    <tr class="<%= d.es_max ? 'table-warning' : '' %>">
                                        <td class="ps-4 fw-semibold">
                                            <%= d.etiqueta %>
                                            <% if (d.es_max) { %><span class="badge text-bg-warning ms-1" style="font-size:.6rem">mejor</span><% } %>
                                        </td>
                                        <td class="text-end"><%= fmtNum(d.cuentas) %></td>
                                        <td class="text-end fw-semibold"><%= fmtMoneda(d.venta) %></td>
                                        <td class="pe-4">
                                            <div class="progress barra-venta">
                                                <div class="progress-bar bg-<%= d.es_max ? 'warning' : 'secondary' %>" role="progressbar"
                                                     aria-valuenow="<%= reporte.serieMax > 0 ? Math.round(Math.min((d.venta / reporte.serieMax) * 100, 100)) : 0 %>"
                                                     aria-valuemin="0" aria-valuemax="100"
                                                     data-pct="<%= reporte.serieMax > 0 ? Math.min((d.venta / reporte.serieMax) * 100, 100).toFixed(1) : 0 %>"></div>
                                            </div>
                                        </td>
                                        <td class="text-center pe-4">
                                            <span class="badge text-bg-<%= claseDelta(d.delta_pct) %>"><%= textoDelta(d.delta_pct) %></span>
                                        </td>
                                    </tr>
                                <% }) %>
                                <% if (reporte.serie.length === 0) { %>
                                    <tr><td colspan="5" class="text-center text-muted py-4">Sin datos para el período seleccionado.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <% if (reporte.agrupacion === 'diaria') { %>
                        <div class="px-4 pb-3 pt-1">
                            <small class="text-muted">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                "vs anterior" compara cada día contra el día previo dentro del período. Los días sin venta se muestran en cero.
                            </small>
                        </div>
                    <% } %>
                </div>

                <!-- Tragos vs platillos + alza/baja -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-xl-6">
                        <div class="card border-0 shadow-sm rounded bg-white h-100">
                            <div class="card-header bg-white border-0 pt-3 px-4 d-flex align-items-center gap-2">
                                <i class="fa-solid fa-layer-group text-dark"></i>
                                <h6 class="fw-bold mb-0">Tragos vs platillos y categorías</h6>
                                <span class="badge text-bg-dark ms-auto">unidades</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0 fs-7">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4 py-3">Segmento</th>
                                            <th class="py-3 text-end">Actual</th>
                                            <th class="py-3 text-end">Anterior</th>
                                            <th class="py-3 text-center">Cambio</th>
                                            <th class="py-3 text-end pe-4">Venta actual</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% reporte.tipos.forEach(t => { %>
                                            <tr class="table-light">
                                                <td class="ps-4 fw-semibold">
                                                    <i class="fa-solid <%= t.etiqueta === 'Tragos' ? 'fa-martini-glass-citrus' : 'fa-bowl-food' %> me-2 text-muted"></i><%= t.etiqueta %>
                                                </td>
                                                <td class="text-end fw-semibold"><%= fmtNum(t.unidades_cur) %></td>
                                                <td class="text-end"><%= fmtNum(t.unidades_prev) %></td>
                                                <td class="text-center"><span class="badge text-bg-<%= claseEstado(t.estado) %>"><%= textoDelta(t.unidades_delta_pct) %></span></td>
                                                <td class="text-end pe-4"><%= fmtMoneda(t.venta_cur) %></td>
                                            </tr>
                                        <% }) %>
                                        <% reporte.categorias.forEach(c => { %>
                                            <tr>
                                                <td class="ps-4">
                                                    <span class="text-muted small me-2"><%= c.tipo %></span><%= c.etiqueta %>
                                                </td>
                                                <td class="text-end fw-semibold"><%= fmtNum(c.unidades_cur) %></td>
                                                <td class="text-end"><%= fmtNum(c.unidades_prev) %></td>
                                                <td class="text-center"><span class="badge text-bg-<%= claseEstado(c.estado) %>"><%= textoDelta(c.unidades_delta_pct) %></span></td>
                                                <td class="text-end pe-4"><%= fmtMoneda(c.venta_cur) %></td>
                                            </tr>
                                        <% }) %>
                                        <% if (reporte.tipos.length === 0 && reporte.categorias.length === 0) { %>
                                            <tr><td colspan="5" class="text-center text-muted py-4">Sin ventas en el período.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-6">
                        <div class="row g-3 h-100">
                            <div class="col-12 col-md-6">
                                <div class="card border-0 shadow-sm rounded bg-white h-100 border-start border-success border-4">
                                    <div class="card-header bg-white border-0 pt-3 px-3 d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-arrow-trend-up text-success"></i>
                                        <h6 class="fw-bold mb-0">A la alza</h6>
                                    </div>
                                    <ul class="list-group list-group-flush fs-7">
                                        <% reporte.alza.forEach(p => { %>
                                            <li class="list-group-item d-flex justify-content-between align-items-center ps-3">
                                                <span class="me-2 text-truncate" title="<%= p.nombre %>"><%= p.nombre %></span>
                                                <span class="text-nowrap">
                                                    <small class="text-muted"><%= fmtNum(p.unidades_prev) %> → <span class="fw-bold text-dark"><%= fmtNum(p.unidades_cur) %></span></small>
                                                    <span class="badge text-bg-success ms-1"><%= p.estado === 'nuevo' ? 'nuevo' : '+' + fmtNum(p.unidades_delta_pct, 1) + '%' %></span>
                                                </span>
                                            </li>
                                        <% }) %>
                                        <% if (reporte.alza.length === 0) { %>
                                            <li class="list-group-item text-center text-muted py-3">Nada a la alza en el período.</li>
                                        <% } %>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="card border-0 shadow-sm rounded bg-white h-100 border-start border-danger border-4">
                                    <div class="card-header bg-white border-0 pt-3 px-3 d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-arrow-trend-down text-danger"></i>
                                        <h6 class="fw-bold mb-0">A la baja</h6>
                                    </div>
                                    <ul class="list-group list-group-flush fs-7">
                                        <% reporte.baja.forEach(p => { %>
                                            <li class="list-group-item d-flex justify-content-between align-items-center ps-3">
                                                <span class="me-2 text-truncate" title="<%= p.nombre %>"><%= p.nombre %></span>
                                                <span class="text-nowrap">
                                                    <small class="text-muted"><%= fmtNum(p.unidades_prev) %> → <span class="fw-bold text-dark"><%= fmtNum(p.unidades_cur) %></span></small>
                                                    <span class="badge text-bg-danger ms-1"><%= p.estado === 'sin-ventas' ? 'sin ventas' : fmtNum(p.unidades_delta_pct, 1) + '%' %></span>
                                                </span>
                                            </li>
                                        <% }) %>
                                        <% if (reporte.baja.length === 0) { %>
                                            <li class="list-group-item text-center text-muted py-3">Nada a la baja en el período.</li>
                                        <% } %>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Detalle por producto -->
                <div class="card border-0 shadow-sm rounded bg-white mb-4">
                    <div class="card-header bg-white border-0 pt-3 px-4 d-flex align-items-center gap-2 flex-wrap">
                        <i class="fa-solid fa-utensils text-dark"></i>
                        <h6 class="fw-bold mb-0">Tendencia por trago/platillo</h6>
                        <span class="badge text-bg-dark ms-auto"><%= reporte.platillos.length %> productos</span>
                        <small class="text-muted w-100">
                            Comparación de unidades vendidas contra el período anterior (<%= reporte.prevDesde %> al <%= reporte.prevHasta %>). La venta es a precio de carta.
                        </small>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 fs-7">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 py-3">Trago / Platillo</th>
                                    <th class="py-3 text-end">Unid. act.</th>
                                    <th class="py-3 text-end">Unid. ant.</th>
                                    <th class="py-3 text-center">Cambio</th>
                                    <th class="py-3 text-end">Venta act.</th>
                                    <th class="py-3 text-end">Venta ant.</th>
                                    <th class="py-3 text-center pe-4">Tendencia</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% reporte.platillos.slice(0, 100).forEach(p => { %>
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge text-bg-<%= p.etiqueta === 'Trago' ? 'info' : 'secondary' %>" style="font-size:.6rem"><%= p.etiqueta %></span>
                                                <span class="fw-semibold"><%= p.nombre %></span>
                                            </div>
                                            <small class="text-muted d-block"><%= p.categoria %></small>
                                        </td>
                                        <td class="text-end fw-semibold"><%= fmtNum(p.unidades_cur) %></td>
                                        <td class="text-end"><%= fmtNum(p.unidades_prev) %></td>
                                        <td class="text-center">
                                            <span class="badge text-bg-<%= claseEstado(p.estado) %>">
                                                <%= p.unidades_delta_pct != null ? (p.unidades_delta_pct > 0 ? '+' : '') + fmtNum(p.unidades_delta_pct, 1) + '%' : '—' %>
                                            </span>
                                        </td>
                                        <td class="text-end fw-semibold"><%= fmtMoneda(p.venta_cur) %></td>
                                        <td class="text-end"><%= fmtMoneda(p.venta_prev) %></td>
                                        <td class="text-center pe-4">
                                            <small class="text-<%= claseEstado(p.estado) === 'secondary' ? 'muted' : claseEstado(p.estado) %> fw-semibold"><%= p.tendencia %></small>
                                        </td>
                                    </tr>
                                <% }) %>
                                <% if (reporte.platillos.length === 0) { %>
                                    <tr><td colspan="7" class="text-center text-muted py-4">Sin ventas de productos en el período seleccionado.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <%- include('../includes/footer') %>
            </main>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script>
        // Barras de volumen: el ancho llega por data-pct (calculado con la
        // venta máxima de la serie) para no meter lógica de reporte en EJS.
        document.querySelectorAll('.progress-bar[data-pct]').forEach(function (barra) {
            barra.style.width = (parseFloat(barra.dataset.pct) || 0) + '%';
        });
    </script>
</body>
</html>
