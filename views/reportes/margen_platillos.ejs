<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Margen por Platillo - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        @media print {
            #sidebarMenu, .content-header-responsive, .btn { display: none !important; }
            main { width: 100% !important; margin: 0 !important; }
        }
    </style>
</head>
<body class="bg-light">

    <div class="container-fluid">
        <div class="row">

            <%- include('../includes/topBarMobile') %>

            <%- include('../includes/sideBarMenu') %>

            <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">

                <%- include('../includes/header', {encabezado_pagina: 'Margen Real por Platillo', desc_pagina: 'Ventas cobradas del período vs costo estándar: qué platillos dejan dinero y cuáles lo queman.', add_btn: false}) %>

                <!-- Filtro de período -->
                <div class="card border-0 shadow-sm rounded p-3 mb-4 bg-white">
                    <form method="get" action="/admin/reportes/margen-platillos" class="row g-2 align-items-end">
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted fw-semibold mb-1">Desde</label>
                            <input type="date" name="desde" class="form-control form-control-sm" value="<%= rango.desde %>">
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted fw-semibold mb-1">Hasta</label>
                            <input type="date" name="hasta" class="form-control form-control-sm" value="<%= rango.hasta %>">
                        </div>
                        <div class="col-12 col-md-2 d-grid">
                            <button type="submit" class="btn btn-dark btn-sm fw-semibold py-2">
                                <i class="fa-solid fa-magnifying-glass me-1"></i> Calcular
                            </button>
                        </div>
                        <div class="col-12 col-md-4 d-flex justify-content-md-end gap-2">
                            <a href="/admin/reportes/margen-platillos/exportar?desde=<%= rango.desde %>&hasta=<%= rango.hasta %>" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                                <i class="fa-solid fa-file-csv text-success me-1"></i> Exportar CSV
                            </a>
                            <button type="button" onclick="window.print()" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                                <i class="fa-solid fa-print text-secondary me-1"></i> Imprimir
                            </button>
                        </div>
                    </form>
                </div>

                <% if (reporte.totales) { %>

                <!-- Resumen del período -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Ingreso del período</h6>
                            <h3 class="fw-bold mb-0 text-dark">$<%= reporte.totales.ingreso.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></h3>
                            <small class="text-muted"><%= reporte.totales.unidades %> unidades vendidas</small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-danger border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Costo estándar</h6>
                            <h3 class="fw-bold mb-0 text-danger">$<%= reporte.totales.costo.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></h3>
                            <small class="text-muted">Insumos según ficha técnica</small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-success border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Margen contribuido</h6>
                            <h3 class="fw-bold mb-0 text-success">$<%= reporte.totales.margen.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></h3>
                            <small class="text-muted">Ingreso − costo</small>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-warning border-4">
                            <h6 class="text-muted fw-semibold mb-1 fs-7">Food cost real</h6>
                            <h3 class="fw-bold mb-0 text-warning"><%= reporte.totales.food_cost %>%</h3>
                            <small class="text-muted">Ponderado por ventas</small>
                        </div>
                    </div>
                </div>

                <!-- Detalle por platillo -->
                <div class="card border-0 shadow-sm rounded bg-white mb-4">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 fs-7">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 py-3">#</th>
                                    <th class="py-3">Platillo</th>
                                    <th class="py-3 text-end">Unid.</th>
                                    <th class="py-3 text-end">Ingreso</th>
                                    <th class="py-3 text-end">Costo unit.</th>
                                    <th class="py-3 text-end">Costo total</th>
                                    <th class="py-3 text-end">Margen</th>
                                    <th class="py-3 text-end">Margen/unid.</th>
                                    <th class="py-3 text-center pe-4" style="min-width:140px">Food cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% reporte.platillos.forEach((p, i) => { %>
                                    <% const fc = p.food_cost; const clase = fc == null ? 'secondary' : (fc <= 30 ? 'success' : (fc <= 45 ? 'warning' : 'danger')); %>
                                <tr>
                                    <td class="ps-4 text-muted"><%= i + 1 %></td>
                                    <td class="fw-semibold"><%= p.nombre %></td>
                                    <td class="text-end"><%= p.unidades %></td>
                                    <td class="text-end">$<%= p.ingreso.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-end">$<%= p.costo_unitario.toLocaleString('es-ES', { minimumFractionDigits: 4 }) %></td>
                                    <td class="text-end text-danger">$<%= p.costo_total.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-end fw-semibold <%= p.margen >= 0 ? 'text-success' : 'text-danger' %>">$<%= p.margen.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-end">$<%= p.margen_unitario.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-center pe-4">
                                        <div class="progress" style="height: 18px; min-width:110px" title="Food cost <%= fc != null ? fc : '—' %>%">
                                            <div class="progress-bar bg-<%= clase %>" role="progressbar" style="width: <%= Math.min(fc != null ? fc : 0, 100) %>%;" aria-valuenow="<%= fc != null ? fc : 0 %>" aria-valuemin="0" aria-valuemax="100">
                                                <%= fc != null ? fc + '%' : '—' %>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                <% if (reporte.platillos.length === 0) { %>
                                <tr><td colspan="9" class="text-center text-muted py-4">Sin ventas cobradas en el período.</td></tr>
                                <% } %>
                            </tbody>
                            <% if (reporte.platillos.length) { %>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="2" class="ps-4">TOTAL</td>
                                    <td class="text-end"><%= reporte.totales.unidades %></td>
                                    <td class="text-end">$<%= reporte.totales.ingreso.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td></td>
                                    <td class="text-end text-danger">$<%= reporte.totales.costo.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-end text-success">$<%= reporte.totales.margen.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td></td>
                                    <td class="text-center pe-4"><%= reporte.totales.food_cost %>%</td>
                                </tr>
                            </tfoot>
                            <% } %>
                        </table>
                    </div>
                </div>

                <% if (reporte.sinReceta.length) { %>
                <div class="alert alert-warning shadow-sm border-0 rounded py-2 px-3 mb-4" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    <strong><%= reporte.sinReceta.length %> platillo(s) vendidos sin ficha técnica activa</strong>
                    (no se les pudo atribuir costo, quedan fuera del margen):
                    <ul class="small mb-0 mt-1">
                        <% reporte.sinReceta.slice(0, 8).forEach(p => { %>
                            <li><%= p.nombre %> — <%= p.unidades %> unid. · $<%= p.ingreso.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></li>
                        <% }) %>
                        <% if (reporte.sinReceta.length > 8) { %><li>… y <%= reporte.sinReceta.length - 8 %> más</li><% } %>
                    </ul>
                </div>
                <% } %>

                <% } else { %>
                <div class="alert alert-light border shadow-sm rounded py-3 px-3 text-muted" role="alert">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    No hay ventas cobradas en el período seleccionado.
                </div>
                <% } %>

                <%- include('../includes/footer') %>
            </main>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
</body>
</html>
