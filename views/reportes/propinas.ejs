<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Propinas del Turno - Restaurante Bahía' %></title>
    <link rel="stylesheet" href="/css/jquery-ui.min.css">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/select2.min.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        /* Altura compacta del Select2 para alinearlo con los form-select-sm */
        #turno-select + .select2-container .select2-selection--single { height: 31px; }
        #turno-select + .select2-container .select2-selection__rendered { line-height: 29px; }
        #turno-select + .select2-container .select2-selection__arrow { height: 29px; }
        @media print {
            #sidebarMenu, .content-header-responsive, .btn { display: none !important; }
            main { width: 100% !important; margin: 0 !important; }
        }
    </style>
</head>
<body class="bg-light">

    <div class="container-fluid">
        <div class="row">

            <%- include('../includes/topBarMobile') %>

            <%- include('../includes/sideBarMenu') %>

            <main class="col-md-9 ms-md-auto col-lg-10 px-3 px-md-5 py-4 d-flex flex-column min-vh-100">

                <%- include('../includes/header', {encabezado_pagina: 'Propinas del Turno', desc_pagina: 'Propinas por mesero y por cuenta en un turno (cerrado o en curso): pool, promedios y detalle para reparto.', add_btn: false}) %>

                <% const fmt$ = (v) => '$' + Number(v || 0).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); %>
                <% const fmtN = (v) => Number(v || 0).toLocaleString('es-ES'); %>
                <% const fmtF = (v) => { if (!v) return '—'; const d = new Date(v); return isNaN(d.getTime()) ? '—' : d.toLocaleString(); }; %>

                <!-- Selector de turno -->
                <div class="card border-0 shadow-sm rounded p-3 mb-4 bg-white">
                    <form method="get" action="/admin/reportes/propinas" class="row g-2 align-items-end">
                        <div class="col-12 col-md-6">
                            <label class="form-label small text-muted fw-semibold mb-1">Turno de servicio</label>
                            <select name="turno" id="turno-select" class="form-select form-select-sm">
                                <% if (turnoSeleccionado && !turnos.some(t => t.id === turnoSeleccionado) && reporte) { %>
                                    <option value="<%= reporte.turno.id %>" selected>
                                        Turno #<%= reporte.turno.id %> · <%= reporte.turno.abierto_por %> · <%= fmtF(reporte.turno.fecha_apertura) %><%= reporte.turno.en_curso ? ' · EN CURSO' : '' %>
                                    </option>
                                <% } %>
                                <% turnos.forEach(t => { %>
                                    <option value="<%= t.id %>" <%= turnoSeleccionado === t.id ? 'selected' : '' %>>
                                        Turno #<%= t.id %> · <%= t.abierto_por %> · <%= fmtF(t.fecha_apertura) %> · <%= t.pedidos %> pedido(s)<%= t.en_curso ? ' · EN CURSO' : '' %>
                                    </option>
                                <% }) %>
                                <% if (turnos.length === 0) { %>
                                    <option value="">Sin turnos registrados</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-12 col-md-2 d-grid">
                            <button type="submit" class="btn btn-dark btn-sm fw-semibold py-2">
                                <i class="fa-solid fa-magnifying-glass me-1"></i> Consultar
                            </button>
                        </div>
                        <div class="col-12 col-md-4 d-flex justify-content-md-end gap-2">
                            <a href="/admin/reportes/propinas/exportar<%= turnoSeleccionado ? '?turno=' + turnoSeleccionado : '' %>" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                                <i class="fa-solid fa-file-csv text-success me-1"></i> Exportar CSV
                            </a>
                            <button type="button" onclick="window.print()" class="btn btn-white border shadow-sm fw-semibold btn-sm py-2 text-dark">
                                <i class="fa-solid fa-print text-secondary me-1"></i> Imprimir
                            </button>
                        </div>
                    </form>
                </div>

                <% if (reporte) { %>
                    <div class="alert alert-light border shadow-sm rounded py-2 px-3 mb-4 small text-muted">
                        <i class="fa-solid fa-clock me-1"></i>
                        Turno #<%= reporte.turno.id %> · <%= reporte.turno.abierto_por %> · apertura <%= fmtF(reporte.turno.fecha_apertura) %><%= reporte.turno.en_curso ? ' · <span class="badge text-bg-success">EN CURSO</span>' : ' · cierre ' + fmtF(reporte.turno.fecha_cierre) %>
                    </div>

                    <!-- Resumen del pool -->
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-sm-6 col-md-3">
                            <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-success border-4">
                                <h6 class="text-muted fw-semibold mb-1 fs-7">Pool de propinas</h6>
                                <h3 class="fw-bold mb-0 text-success"><%= fmt$(reporte.totales.propinas) %></h3>
                                <small class="text-muted"><%= fmtN(reporte.totales.cuentas) %> cuentas cobradas</small>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white">
                                <h6 class="text-muted fw-semibold mb-1 fs-7">Propina promedio</h6>
                                <h3 class="fw-bold mb-0 text-dark"><%= fmt$(reporte.totales.propina_promedio) %></h3>
                                <small class="text-muted">Por cuenta cobrada</small>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white">
                                <h6 class="text-muted fw-semibold mb-1 fs-7">Ventas del turno</h6>
                                <h3 class="fw-bold mb-0 text-dark"><%= fmt$(reporte.totales.ventas) %></h3>
                                <small class="text-muted"><%= fmtN(reporte.totales.meseros) %> meseros en sala</small>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <div class="card border-0 shadow-sm rounded p-3 h-100 bg-white border-start border-primary border-4">
                                <h6 class="text-muted fw-semibold mb-1 fs-7">% sobre ventas</h6>
                                <h3 class="fw-bold mb-0 text-primary"><%= reporte.totales.ventas > 0 ? (reporte.totales.propinas / reporte.totales.ventas * 100).toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) : '0,0' %> %</h3>
                                <small class="text-muted">Propinas / ventas</small>
                            </div>
                        </div>
                    </div>

                    <!-- Por mesero -->
                    <div class="card border-0 shadow-sm rounded bg-white mb-4">
                        <div class="card-header bg-white border-0 pt-3 pb-0">
                            <h6 class="fw-bold mb-0"><i class="fa-solid fa-user-tie text-secondary me-2"></i>Propinas por mesero</h6>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0 fs-7">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4 py-3">#</th>
                                        <th class="py-3">Mesero</th>
                                        <th class="py-3 text-end">Cuentas</th>
                                        <th class="py-3 text-end">Ventas</th>
                                        <th class="py-3 text-end">Propinas</th>
                                        <th class="py-3 text-end">Promedio</th>
                                        <th class="py-3 text-end pe-4">% del pool</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% reporte.meseros.forEach((m, i) => { %>
                                    <tr>
                                        <td class="ps-4 text-muted"><%= i + 1 %></td>
                                        <td><span class="fw-semibold"><%= m.mesero %></span></td>
                                        <td class="text-end"><%= fmtN(m.cuentas) %></td>
                                        <td class="text-end"><%= fmt$(m.ventas) %></td>
                                        <td class="text-end text-success fw-semibold"><%= fmt$(m.propinas) %></td>
                                        <td class="text-end"><%= fmt$(m.propina_promedio) %></td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex align-items-center justify-content-end gap-2">
                                                <div class="progress flex-grow-1" style="height: 6px; max-width: 90px;" role="progressbar" aria-valuenow="<%= m.pct_pool %>" aria-valuemin="0" aria-valuemax="100">
                                                    <div class="progress-bar bg-success" style="width: <%= Math.min(100, m.pct_pool) %>%"></div>
                                                </div>
                                                <span class="fw-semibold"><%= m.pct_pool.toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) %> %</span>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                    <% if (reporte.meseros.length === 0) { %>
                                    <tr><td colspan="7" class="text-center text-muted py-4">Sin cuentas cobradas en este turno.</td></tr>
                                    <% } %>
                                </tbody>
                                <% if (reporte.meseros.length) { %>
                                <tfoot class="table-light fw-bold">
                                    <tr>
                                        <td colspan="2" class="ps-4">TOTAL (<%= reporte.totales.meseros %> meseros)</td>
                                        <td class="text-end"><%= fmtN(reporte.totales.cuentas) %></td>
                                        <td class="text-end"><%= fmt$(reporte.totales.ventas) %></td>
                                        <td class="text-end text-success"><%= fmt$(reporte.totales.propinas) %></td>
                                        <td class="text-end"><%= fmt$(reporte.totales.propina_promedio) %></td>
                                        <td class="text-end pe-4">100,0 %</td>
                                    </tr>
                                </tfoot>
                                <% } %>
                            </table>
                        </div>
                    </div>

                    <!-- Detalle por cuenta -->
                    <div class="card border-0 shadow-sm rounded bg-white mb-4">
                        <div class="card-header bg-white border-0 pt-3 pb-0">
                            <h6 class="fw-bold mb-0"><i class="fa-solid fa-receipt text-secondary me-2"></i>Detalle por cuenta</h6>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0 fs-7">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4 py-3">Cuenta</th>
                                        <th class="py-3">Mesa</th>
                                        <th class="py-3">Mesero</th>
                                        <th class="py-3 text-end">Total</th>
                                        <th class="py-3 text-end">Propina</th>
                                        <th class="py-3">Estado</th>
                                        <th class="py-3 text-end pe-4">Cierre</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% reporte.cuentas.forEach(c => { %>
                                    <tr>
                                        <td class="ps-4 text-muted">#<%= c.id %></td>
                                        <td class="fw-semibold"><%= c.mesa %></td>
                                        <td><%= c.mesero %></td>
                                        <td class="text-end"><%= fmt$(c.total) %></td>
                                        <td class="text-end <%= c.propina > 0 ? 'text-success fw-semibold' : 'text-muted' %>"><%= fmt$(c.propina) %></td>
                                        <td><span class="badge <%= c.estado_pago === 'pagado' ? 'text-bg-success' : (c.estado_pago === 'facturado' ? 'text-bg-primary' : 'text-bg-warning') %>"><%= c.estado_pago %></span></td>
                                        <td class="text-end pe-4 text-muted"><%= fmtF(c.fecha_cierre) %></td>
                                    </tr>
                                    <% }) %>
                                    <% if (reporte.cuentas.length === 0) { %>
                                    <tr><td colspan="7" class="text-center text-muted py-4">Sin cuentas cobradas en este turno.</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="alert alert-light border shadow-sm rounded py-2 px-3 mb-4 small text-muted" role="note">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Sólo cuentan las cuentas <strong>cobradas</strong> del turno (pagadas, facturadas y cortesías). El % del pool sirve de base para el reparto de propinas.
                    </div>

                <% } else { %>
                    <div class="alert alert-warning border-0 shadow-sm rounded">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        No hay turnos para analizar. Abre un turno para comenzar.
                    </div>
                <% } %>

                <%- include('../includes/footer') %>
            </main>
        </div>
    </div>

    <script src="/js/jquery-4.0.0.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-ui.min.js"></script>
    <script src="/js/sweetalert2.all.min.js"></script>
    <script src="/js/libs/select2.min.js"></script>
    <script src="/js/select2-busqueda-instantanea.js"></script>
    <script>
        // Selector de turno con búsqueda (Select2): permite localizar por
        // número, responsable o fecha escribiendo en el propio campo.
        $(function () {
            $('#turno-select').select2({
                placeholder: 'Buscar turno…',
                width: '100%',
                language: {
                    noResults: function () { return 'Sin resultados'; },
                    searching: function () { return 'Buscando…'; }
                }
            });
        });
    </script>
</body>
</html>
