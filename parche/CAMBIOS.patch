+                                    <th>Platillo</th>
+                                    <th class="text-end">Costo/porción</th>
+                                    <th class="text-center">Carta CUP</th>
+                                    <th class="text-center">Carta Comisión</th>
+                                    <th class="text-center">Carta Zelle</th>
+                                </tr>
+                            </thead>
+                            <tbody id="cuerpoPrecios"></tbody>
+                        </table>
+                    </div>
+                </div>
+                <div class="modal-footer bg-light">
+                    <button type="button" class="btn btn-outline-secondary" id="btnNoActualizar">
+                        No, dejar los precios como están
+                    </button>
+                    <button type="button" class="btn btn-primary px-4" id="btnAplicarPrecios">
+                        <i class="fa-solid fa-check me-2"></i>Aplicar los precios marcados
+                    </button>
+                </div>
+            </div>
+        </div>
+    </div>
+
+    <script src="/js/bootstrap.bundle.min.js"></script>
+    <script src="/js/sweetalert2.all.min.js"></script>
+    <script>
+    (function () {
+        'use strict';
+        const productoId = document.getElementById('productoId').value;
+        const foodCostObjetivo = <%= parametros.foodCostObjetivo %>;
+        const nf = (n, d = 2) => Number(n || 0).toLocaleString('es-ES', { minimumFractionDigits: d, maximumFractionDigits: d });
+
+        // ── Conceptos libres ────────────────────────────────────────────
+        const lista = document.getElementById('listaConceptos');
+        document.getElementById('btnAgregarConcepto').addEventListener('click', () => {
+            const fila = document.createElement('div');
+            fila.className = 'row g-2 mb-2 fila-concepto';
+            fila.innerHTML =
+                '<div class="col-6"><input type="text" class="form-control form-control-sm concepto-nombre" placeholder="Concepto"></div>' +
+                '<div class="col-3"><select class="form-select form-select-sm concepto-tipo"><option value="FIJO">Importe</option><option value="PORCENTAJE">%</option></select></div>' +
+                '<div class="col-2"><input type="number" step="0.01" class="form-control form-control-sm fc-mono concepto-valor" value="0"></div>' +
+                '<div class="col-1"><button type="button" class="btn btn-sm btn-outline-danger border-0 btn-quitar-concepto"><i class="fa-solid fa-xmark"></i></button></div>';
+            lista.appendChild(fila);
+        });
+        lista.addEventListener('click', (e) => {
+            const btn = e.target.closest('.btn-quitar-concepto');
+            if (btn) { btn.closest('.fila-concepto').remove(); recalcular(); }
+        });
+        lista.addEventListener('input', recalcular);
+        lista.addEventListener('change', recalcular);
+
+        function leerConceptos() {
+            return Array.from(document.querySelectorAll('.fila-concepto')).map(f => ({
+                concepto: f.querySelector('.concepto-nombre').value,
+                tipo: f.querySelector('.concepto-tipo').value,
+                valor: parseFloat(f.querySelector('.concepto-valor').value) || 0
+            })).filter(c => c.concepto && c.concepto.trim());
+        }
+
+        function leerFormulario() {
+            const n = id => parseFloat(document.getElementById(id).value) || 0;
+            return {
+                precio_compra: n('precio_compra'),
+                cantidad_presentacion: n('cantidad_presentacion') || 1,
+                porcentaje_merma: n('porcentaje_merma'),
+                costo_flete: n('costo_flete'),
+                costo_envase: n('costo_envase'),
+                costo_mano_obra: n('costo_mano_obra'),
+                otros_costos: n('otros_costos'),
+                porcentaje_imprevistos: n('porcentaje_imprevistos'),
+                proveedor: document.getElementById('proveedor').value,
+                observaciones: document.getElementById('observaciones').value,
+                conceptos: leerConceptos()
+            };
+        }
+
+        // ── Cálculo en vivo contra el servidor (una sola fuente de verdad) ──
+        const costoAnterior = <%= ficha ? Number(ficha.costo_final_unitario) : 'null' %>;
+        let temporizador = null;
+
+        function recalcular() {
+            clearTimeout(temporizador);
+            temporizador = setTimeout(async () => {
+                try {
+                    const r = await fetch('/admin/api/fichas-costo/previsualizar', {
+                        method: 'POST',
+                        headers: { 'Content-Type': 'application/json' },
+                        body: JSON.stringify(leerFormulario())
+                    });
+                    const data = await r.json();
+                    if (!data.success) return;
+                    pintar(data.calculo);
+                } catch (_) { /* sin conexión: se mantiene lo mostrado */ }
+            }, 180);
+        }
+
+        function pintar(c) {
+            document.getElementById('resCostoFinal').textContent = nf(c.costo_final_unitario, 4);
+            document.getElementById('resBruto').textContent = nf(c.costo_unitario_bruto, 4);
+            document.getElementById('resMerma').textContent = '+' + nf(c.sobrecosto_merma, 4);
+            document.getElementById('resNeto').textContent = nf(c.costo_unitario_neto, 4);
+            document.getElementById('resDirectos').textContent = '+' + nf(c.costos_directos_unitarios, 4);
+            document.getElementById('resConceptos').textContent =
+                '+' + nf(c.conceptos_fijos_unitarios + c.conceptos_porcentaje_unitarios, 4);
+            document.getElementById('resImprevistos').textContent = '+' + nf(c.importe_imprevistos, 4);
+            document.getElementById('resFinal2').textContent = nf(c.costo_final_unitario, 4);
+            document.getElementById('resRendimiento').textContent = nf(c.rendimiento_porcentaje, 1) + '%';
+            document.getElementById('resFactor').textContent = '×' + nf(c.factor_rendimiento, 4);
+
+            const comp = document.getElementById('resComparativa');
+            if (costoAnterior && costoAnterior > 0) {
+                const dif = ((c.costo_final_unitario - costoAnterior) / costoAnterior) * 100;
+                if (Math.abs(dif) < 0.01) comp.textContent = 'Sin variación respecto a la ficha vigente';
+                else comp.textContent = (dif > 0 ? '▲ ' : '▼ ') + nf(Math.abs(dif), 1) +
+                                        '% respecto a la ficha vigente (' + nf(costoAnterior, 4) + ')';
+            } else {
+                comp.textContent = 'Primera ficha de este insumo';
+            }
+        }
+
+        document.querySelectorAll('.campo').forEach(el => el.addEventListener('input', recalcular));
+        recalcular();
+
+        // ── Guardar y, si procede, ofrecer el ajuste de precios ─────────
+        let platillosPendientes = [];
+
+        document.getElementById('formFicha').addEventListener('submit', async (e) => {
+            e.preventDefault();
+            const datos = leerFormulario();
+            if (!(datos.precio_compra > 0)) {
+                Swal.fire('Falta el precio', 'Indica el precio de compra del insumo.', 'warning');
+                return;
+            }
+
+            try {
+                const r = await fetch('/admin/api/fichas-costo/' + productoId, {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify(datos)
+                });
+                const data = await r.json();
+                if (!data.success) {
+                    Swal.fire('Error', data.message || 'No se pudo guardar la ficha.', 'error');
+                    return;
+                }
+
+                if (data.requiere_revision_precios && data.platillos.length) {
+                    platillosPendientes = data.platillos;
+                    abrirDialogoPrecios(data);
+                } else {
+                    Swal.fire({ title: 'Ficha guardada', text: data.message, icon: 'success', timer: 1800, showConfirmButton: false })
+                        .then(() => window.location.reload());
+                }
+            } catch (_) {
+                Swal.fire('Error', 'No se pudo comunicar con el servidor.', 'error');
+            }
+        });
+
+        function abrirDialogoPrecios(data) {
+            const variacion = data.variacion_porcentaje;
+            let texto = 'El costo de <strong><%= producto.nombre %></strong> ahora es <strong>' +
+                        nf(data.costo_nuevo, 4) + '</strong>';
+            if (variacion !== null && variacion !== undefined) {
+                texto += ' (' + (variacion > 0 ? 'subió ' : 'bajó ') + nf(Math.abs(variacion), 1) + '%)';
+            }
+            texto += '. Este insumo se usa en <strong>' + data.platillos.length +
+                     '</strong> platillo(s). Los precios propuestos mantienen la proporción actual entre ' +
+                     'las tres cartas y buscan un food cost del <strong>' + foodCostObjetivo + '%</strong>.';
+            document.getElementById('textoResumenCambio').innerHTML = texto;
+
+            const cuerpo = document.getElementById('cuerpoPrecios');
+            cuerpo.innerHTML = '';
+
+            data.platillos.forEach((p, i) => {
+                if (!p.tiene_platillo) return;
+                const fila = document.createElement('tr');
+                const celdaCarta = (carta) => {
+                    const s = p.sugerencias[carta];
+                    const actual = s.actual !== null ? nf(s.actual, 2) : '—';
+                    const fcActual = s.indicadores_actual.food_cost_porcentaje;
+                    const fcNuevo = s.indicadores_sugerido.food_cost_porcentaje;
+                    const clase = fcActual === null ? 'secondary' : (fcActual <= foodCostObjetivo ? 'success' : (fcActual <= foodCostObjetivo * 1.25 ? 'warning' : 'danger'));
+                    return '<td class="text-center">' +
+                        '<div class="form-check d-inline-block me-1">' +
+                          '<input class="form-check-input chk-carta" type="checkbox" data-fila="' + i + '" data-carta="' + carta + '" checked>' +
+                        '</div>' +
+                        '<input type="number" step="0.01" min="0" class="form-control form-control-sm fc-mono d-inline-block precio-carta" ' +
+                               'style="width:92px" data-fila="' + i + '" data-carta="' + carta + '" value="' + s.sugerido + '">' +
+                        '<div class="fs-8 text-muted mt-1">antes ' + actual +
+                          (fcActual !== null ? ' · <span class="text-' + clase + '">FC ' + nf(fcActual, 1) + '%</span>' : '') +
+                          (fcNuevo !== null ? ' → ' + nf(fcNuevo, 1) + '%' : '') +
+                        '</div></td>';
+                };
+
+                fila.innerHTML =
+                    '<td><input class="form-check-input chk-platillo" type="checkbox" data-fila="' + i + '" checked></td>' +
+                    '<td><div class="fw-semibold">' + p.platillo_nombre + '</div>' +
+                        '<div class="fs-8 text-muted">' + (p.variacion_costo !== null
+                            ? 'costo ' + (p.variacion_costo > 0 ? '▲' : '▼') + nf(Math.abs(p.variacion_costo), 1) + '%'
+                            : 'nuevo cálculo') +
+                            (p.ingredientes_sin_ficha > 0
+                                ? ' · <span class="text-danger">' + p.ingredientes_sin_ficha + ' insumo(s) sin ficha</span>'
+                                : '') + '</div></td>' +
+                    '<td class="text-end fc-mono">' + nf(p.costo_nuevo, 2) + '</td>' +
+                    celdaCarta('CUP') + celdaCarta('COMISION') + celdaCarta('ZELLE');
+                cuerpo.appendChild(fila);
+            });
+
+            if (!cuerpo.children.length) {
+                cuerpo.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">' +
+                    'Las recetas afectadas no están vinculadas a ningún platillo de la carta.</td></tr>';
+            }
+
+            new bootstrap.Modal(document.getElementById('modalPrecios')).show();
+        }
+
+        document.getElementById('btnMarcarTodo').addEventListener('click', () => {
+            document.querySelectorAll('#cuerpoPrecios input[type=checkbox]').forEach(c => c.checked = true);
+        });
+        document.getElementById('btnDesmarcarTodo').addEventListener('click', () => {
+            document.querySelectorAll('#cuerpoPrecios input[type=checkbox]').forEach(c => c.checked = false);
+        });
+
+        document.getElementById('btnNoActualizar').addEventListener('click', () => {
+            Swal.fire({
+                title: 'Ficha guardada',
+                text: 'Los precios de la carta se mantienen sin cambios.',
+                icon: 'success', timer: 1800, showConfirmButton: false
+            }).then(() => window.location.reload());
+        });
+
+        document.getElementById('btnAplicarPrecios').addEventListener('click', async () => {
+            const cambios = [];
+            platillosPendientes.forEach((p, i) => {
+                const chkPlatillo = document.querySelector('.chk-platillo[data-fila="' + i + '"]');
+                if (!chkPlatillo || !chkPlatillo.checked || !p.tiene_platillo) return;
+
+                const cartas = {};
+                ['CUP', 'COMISION', 'ZELLE'].forEach(carta => {
+                    const chk = document.querySelector('.chk-carta[data-fila="' + i + '"][data-carta="' + carta + '"]');
+                    const inp = document.querySelector('.precio-carta[data-fila="' + i + '"][data-carta="' + carta + '"]');
+                    if (chk && chk.checked && inp && inp.value !== '') cartas[carta] = parseFloat(inp.value);
+                });
+                if (Object.keys(cartas).length) {
+                    cambios.push({ platillo_id: p.platillo_id, es_platillo_dia: false, cartas, costo_platillo: p.costo_nuevo });
+                }
+            });
+
+            if (!cambios.length) {
+                Swal.fire('Nada que aplicar', 'No has marcado ningún precio.', 'info');
+                return;
+            }
+
+            try {
+                const r = await fetch('/admin/api/fichas-costo/precios/aplicar', {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({ producto_id: productoId, cambios })
+                });
+                const data = await r.json();
+                if (data.success) {
+                    Swal.fire({ title: 'Precios actualizados', text: data.message, icon: 'success' })
+                        .then(() => window.location.reload());
+                } else {
+                    Swal.fire('Error', data.message || 'No se pudieron aplicar los precios.', 'error');
+                }
+            } catch (_) {
+                Swal.fire('Error', 'No se pudo comunicar con el servidor.', 'error');
+            }
+        });
+    })();
+    </script>
+</body>
+</html>
diff --git b/views/inventarios/fichas-costo.ejs b/views/inventarios/fichas-costo.ejs
new file mode 100644
index 0000000..547af62
--- /dev/null
+++ b/views/inventarios/fichas-costo.ejs
@@ -0,0 +1,233 @@
+<!DOCTYPE html>
+<html lang="es">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title><%= pageTitle %> - Restaurante Bahía</title>
+    <link rel="stylesheet" href="/css/bootstrap.min.css">
+    <link rel="stylesheet" href="/css/all.min.css">
+    <link rel="stylesheet" href="/css/styles.css">
+    <style>
+        .fc-tabla { font-size: .82rem; }
+        .fc-chip { font-size: .68rem; font-weight: 600; padding: .18rem .45rem; border-radius: .35rem; }
+        .fc-kpi { border-left: 3px solid #0e7c86; }
+        .fc-kpi .valor { font-size: 1.4rem; font-weight: 700; line-height: 1.1; }
+        .fc-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
+        .fc-formula { background: #f1f5f9; border-left: 3px solid #0e7c86; }
+        .fc-formula code { color: #0f172a; font-size: .78rem; }
+    </style>
+</head>
+<body>
+    <%- include('../includes/topBarMobile') %>
+
+    <div class="container-fluid">
+        <div class="row">
+            <%- include('../includes/sideBarMenu') %>
+            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4">
+                <%- include('../includes/header', {
+                    encabezado_pagina: '🧮 Fichas de Costo',
+                    desc_pagina: 'Costo real de cada insumo de almacén, desde el precio de compra hasta el costo puesto en producción.',
+                    add_btn: false
+                }) %>
+
+                <%
+                    const fmt = (n, d = 2) => Number(n || 0).toLocaleString('es-ES', { minimumFractionDigits: d, maximumFractionDigits: d });
+                    const conFicha = productos.filter(p => p.ficha_id);
+                    const sinFicha = productos.filter(p => !p.ficha_id);
+                    const usadosEnRecetas = productos.filter(p => Number(p.recetas_afectadas) > 0);
+                    const sinFichaEnRecetas = usadosEnRecetas.filter(p => !p.ficha_id);
+                %>
+
+                <!-- Ayuda: la fórmula estándar -->
+                <div class="card border-0 shadow-sm mb-4 fc-formula">
+                    <div class="card-body py-3">
+                        <div class="d-flex justify-content-between align-items-start">
+                            <h6 class="fw-bold mb-2"><i class="fa-solid fa-lightbulb me-2 text-warning"></i>Cómo se calcula (fórmula estándar del sector)</h6>
+                            <button class="btn btn-sm btn-link text-decoration-none p-0" type="button"
+                                    data-bs-toggle="collapse" data-bs-target="#ayudaFormula">Ver / ocultar</button>
+                        </div>
+                        <div class="collapse show" id="ayudaFormula">
+                            <div class="row g-3 small">
+                                <div class="col-md-6">
+                                    <div class="fw-semibold text-secondary mb-1">1 · Del precio de compra al costo útil</div>
+                                    <code class="d-block">Rendimiento (%) = 100 − % merma</code>
+                                    <code class="d-block">Costo bruto = Precio de compra ÷ cantidad de la presentación</code>
+                                    <code class="d-block">Costo neto = Costo bruto ÷ (1 − % merma)</code>
+                                    <code class="d-block">Costo final = (Costo neto + costos directos) × (1 + % imprevistos)</code>
+                                </div>
+                                <div class="col-md-6">
+                                    <div class="fw-semibold text-secondary mb-1">2 · Del insumo al precio de carta</div>
+                                    <code class="d-block">Costo del platillo = Σ (cantidad × costo final del insumo)</code>
+                                    <code class="d-block">Precio sugerido = Costo ÷ (food cost objetivo ÷ 100)</code>
+                                    <code class="d-block">Food cost (%) = (Costo ÷ Precio de venta) × 100</code>
+                                </div>
+                            </div>
+                            <div class="mt-3 pt-2 border-top">
+                                <span class="text-secondary small me-2">Food cost orientativo:</span>
+                                <% referencias.forEach(r => { %>
+                                    <span class="fc-chip bg-white border text-secondary me-1"><%= r.tipo %>: <%= r.min %>–<%= r.max %>%</span>
+                                <% }) %>
+                                <span class="fc-chip bg-primary-subtle text-primary-emphasis ms-2">
+                                    Objetivo configurado: <%= parametros.foodCostObjetivo %>%
+                                </span>
+                            </div>
+                            <div class="small text-secondary mt-2 mb-0">
+                                <i class="fa-solid fa-circle-info me-1"></i>
+                                La ficha es una <strong>ayuda</strong>: puedes añadir los conceptos que necesites
+                                (flete, envase, mano de obra o cualquier otro) y ajustarla a tu operación.
+                            </div>
+                        </div>
+                    </div>
+                </div>
+
+                <!-- Indicadores -->
+                <div class="row g-3 mb-4">
+                    <div class="col-6 col-lg-3">
+                        <div class="card border-0 shadow-sm fc-kpi h-100">
+                            <div class="card-body py-3">
+                                <div class="text-secondary small text-uppercase">Insumos activos</div>
+                                <div class="valor text-dark"><%= productos.length %></div>
+                            </div>
+                        </div>
+                    </div>
+                    <div class="col-6 col-lg-3">
+                        <div class="card border-0 shadow-sm fc-kpi h-100" style="border-left-color:#1e6e43">
+                            <div class="card-body py-3">
+                                <div class="text-secondary small text-uppercase">Con ficha</div>
+                                <div class="valor text-success"><%= conFicha.length %></div>
+                            </div>
+                        </div>
+                    </div>
+                    <div class="col-6 col-lg-3">
+                        <div class="card border-0 shadow-sm fc-kpi h-100" style="border-left-color:#b45309">
+                            <div class="card-body py-3">
+                                <div class="text-secondary small text-uppercase">Sin ficha</div>
+                                <div class="valor <%= sinFicha.length ? 'text-warning-emphasis' : 'text-dark' %>"><%= sinFicha.length %></div>
+                            </div>
+                        </div>
+                    </div>
+                    <div class="col-6 col-lg-3">
+                        <div class="card border-0 shadow-sm fc-kpi h-100" style="border-left-color:#be123c">
+                            <div class="card-body py-3">
+                                <div class="text-secondary small text-uppercase">Usados en recetas sin ficha</div>
+                                <div class="valor <%= sinFichaEnRecetas.length ? 'text-danger' : 'text-dark' %>"><%= sinFichaEnRecetas.length %></div>
+                            </div>
+                        </div>
+                    </div>
+                </div>
+
+                <% if (sinFichaEnRecetas.length > 0) { %>
+                    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-3">
+                        <i class="fa-solid fa-triangle-exclamation fs-4 mt-1"></i>
+                        <div>
+                            <div class="fw-bold">Hay insumos en uso sin ficha de costo</div>
+                            <div class="small">
+                                <strong><%= sinFichaEnRecetas.length %></strong> insumo(s) se utilizan en recetas pero no
+                                tienen ficha. El food cost de esos platillos aparecerá <strong>más bajo de lo real</strong>,
+                                porque esos ingredientes se cuentan como si no costaran nada.
+                                <a href="/admin/fichas-costo?sinFicha=1" class="alert-link">Ver solo los que faltan</a>.
+                            </div>
+                        </div>
+                    </div>
+                <% } %>
+
+                <div class="card card-custom border-0 shadow-sm">
+                    <div class="card-header bg-white border-0 py-3">
+                        <form method="get" action="/admin/fichas-costo" class="row g-2 align-items-end">
+                            <div class="col-sm-6 col-md-5">
+                                <label for="busqueda" class="form-label small fw-semibold text-secondary">Buscar insumo</label>
+                                <input type="text" class="form-control form-control-sm" id="busqueda" name="busqueda"
+                                       value="<%= filtros.busqueda %>" placeholder="Nombre o código">
+                            </div>
+                            <div class="col-sm-6 col-md-3">
+                                <div class="form-check mt-4">
+                                    <input class="form-check-input" type="checkbox" value="1" id="sinFicha" name="sinFicha"
+                                           <%= filtros.sinFicha ? 'checked' : '' %>>
+                                    <label class="form-check-label small text-secondary" for="sinFicha">Solo los que no tienen ficha</label>
+                                </div>
+                            </div>
+                            <div class="col-md-4 d-flex gap-2">
+                                <button type="submit" class="btn btn-sm btn-dark flex-grow-1"><i class="fa-solid fa-filter me-1"></i>Filtrar</button>
+                                <a href="/admin/fichas-costo" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-rotate-left"></i></a>
+                                <a href="/admin/fichas-costo/rentabilidad" class="btn btn-sm btn-outline-primary text-nowrap">
+                                    <i class="fa-solid fa-chart-line me-1"></i>Rentabilidad
+                                </a>
+                            </div>
+                        </form>
+                    </div>
+                    <div class="card-body p-0">
+                        <div class="table-responsive">
+                            <table class="table table-hover align-middle mb-0 fc-tabla">
+                                <thead class="table-custom-thead text-uppercase fs-7 bg-light">
+                                    <tr>
+                                        <th class="ps-4 py-3">Insumo</th>
+                                        <th class="py-3 text-end">Precio compra</th>
+                                        <th class="py-3 text-center">% Merma</th>
+                                        <th class="py-3 text-center">Rendimiento</th>
+                                        <th class="py-3 text-end">Costo final</th>
+                                        <th class="py-3 text-center">En recetas</th>
+                                        <th class="py-3 text-center">Estado</th>
+                                        <th class="py-3 text-center pe-3" style="width:110px">Acción</th>
+                                    </tr>
+                                </thead>
+                                <tbody>
+                                    <% if (!productos.length) { %>
+                                        <tr><td colspan="8" class="text-center py-5 text-muted">
+                                            <i class="fa-solid fa-box-open d-block fs-2 mb-2"></i>No hay insumos que coincidan con el filtro.
+                                        </td></tr>
+                                    <% } else { %>
+                                        <% productos.forEach(p => { %>
+                                            <tr>
+                                                <td class="ps-4">
+                                                    <div class="fw-semibold text-dark"><%= p.nombre %></div>
+                                                    <div class="text-muted small fc-mono"><%= p.codigo || 'S/C' %><%= p.unidad_inventario ? ' · ' + p.unidad_inventario : '' %></div>
+                                                </td>
+                                                <td class="text-end fc-mono">
+                                                    <%= p.ficha_id ? fmt(p.precio_compra) : '—' %>
+                                                </td>
+                                                <td class="text-center fc-mono text-muted">
+                                                    <%= p.ficha_id ? fmt(p.porcentaje_merma, 1) + '%' : '—' %>
+                                                </td>
+                                                <td class="text-center fc-mono text-muted">
+                                                    <%= p.ficha_id ? fmt(p.rendimiento_porcentaje, 1) + '%' : '—' %>
+                                                </td>
+                                                <td class="text-end fw-bold fc-mono text-dark">
+                                                    <%= p.ficha_id ? fmt(p.costo_final_unitario, 4) : fmt(p.costo_promedio, 4) %>
+                                                </td>
+                                                <td class="text-center">
+                                                    <% if (Number(p.recetas_afectadas) > 0) { %>
+                                                        <span class="fc-chip bg-info-subtle text-info-emphasis"><%= p.recetas_afectadas %></span>
+                                                    <% } else { %><span class="text-muted">—</span><% } %>
+                                                </td>
+                                                <td class="text-center">
+                                                    <% if (p.ficha_id) { %>
+                                                        <span class="fc-chip bg-success-subtle text-success-emphasis">
+                                                            <i class="fa-solid fa-check me-1"></i>Con ficha
+                                                        </span>
+                                                    <% } else { %>
+                                                        <span class="fc-chip <%= Number(p.recetas_afectadas) > 0 ? 'bg-danger-subtle text-danger-emphasis' : 'bg-light text-secondary border' %>">
+                                                            <i class="fa-solid fa-circle-exclamation me-1"></i>Sin ficha
+                                                        </span>
+                                                    <% } %>
+                                                </td>
+                                                <td class="text-center pe-3">
+                                                    <a href="/admin/fichas-costo/<%= p.id %>" class="btn btn-sm btn-outline-primary border-0" title="Abrir ficha de costo">
+                                                        <i class="fa-solid fa-calculator"></i>
+                                                    </a>
+                                                </td>
+                                            </tr>
+                                        <% }) %>
+                                    <% } %>
+                                </tbody>
+                            </table>
+                        </div>
+                    </div>
+                </div>
+
+                <%- include('../includes/footer') %>
+            </main>
+        </div>
+    </div>
+    <script src="/js/bootstrap.bundle.min.js"></script>
+</body>
+</html>
diff --git b/views/inventarios/rentabilidad-carta.ejs b/views/inventarios/rentabilidad-carta.ejs
new file mode 100644
index 0000000..83452d6
--- /dev/null
+++ b/views/inventarios/rentabilidad-carta.ejs
@@ -0,0 +1,175 @@
+<!DOCTYPE html>
+<html lang="es">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title><%= pageTitle %> - Restaurante Bahía</title>
+    <link rel="stylesheet" href="/css/bootstrap.min.css">
+    <link rel="stylesheet" href="/css/all.min.css">
+    <link rel="stylesheet" href="/css/styles.css">
+    <style>
+        .rc-tabla { font-size: .8rem; }
+        .rc-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
+        .rc-chip { font-size: .68rem; font-weight: 600; padding: .18rem .45rem; border-radius: .35rem; }
+        .rc-kpi { border-left: 3px solid #0e7c86; }
+        .rc-kpi .valor { font-size: 1.4rem; font-weight: 700; line-height: 1.1; }
+        .rc-barra { height: 6px; border-radius: 3px; background: #e2e8f0; overflow: hidden; min-width: 70px; }
+        .rc-barra span { display: block; height: 100%; }
+    </style>
+</head>
+<body>
+    <%- include('../includes/topBarMobile') %>
+
+    <div class="container-fluid">
+        <div class="row">
+            <%- include('../includes/sideBarMenu') %>
+            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4">
+                <%- include('../includes/header', {
+                    encabezado_pagina: '📈 Rentabilidad de la Carta',
+                    desc_pagina: 'Food cost de cada platillo calculado a partir de las fichas de costo de sus insumos.',
+                    add_btn: false,
+                    back_btn: true,
+                    back_url: '/admin/fichas-costo'
+                }) %>
+
+                <%
+                    const fmt = (n, d = 2) => n === null || n === undefined
+                        ? '—' : Number(n).toLocaleString('es-ES', { minimumFractionDigits: d, maximumFractionDigits: d });
+                    const objetivo = parametros.foodCostObjetivo;
+                %>
+
+                <div class="row g-3 mb-4">
+                    <div class="col-6 col-lg-3">
+                        <div class="card border-0 shadow-sm rc-kpi h-100">
+                            <div class="card-body py-3">
+                                <div class="text-secondary small text-uppercase">Platillos con receta</div>
+                                <div class="valor text-dark"><%= resumen.total %></div>
+                            </div>
+                        </div>
+                    </div>
+                    <div class="col-6 col-lg-3">
+                        <div class="card border-0 shadow-sm rc-kpi h-100" style="border-left-color:#1b3a5c">
+                            <div class="card-body py-3">
+                                <div class="text-secondary small text-uppercase">Food cost medio</div>
+                                <div class="valor text-dark"><%= resumen.food_cost_medio !== null ? fmt(resumen.food_cost_medio, 1) + '%' : '—' %></div>
+                                <div class="fs-8 text-muted">objetivo <%= objetivo %>%</div>
+                            </div>
+                        </div>
+                    </div>
+                    <div class="col-6 col-lg-3">
+                        <div class="card border-0 shadow-sm rc-kpi h-100" style="border-left-color:#be123c">
+                            <div class="card-body py-3">
+                                <div class="text-secondary small text-uppercase">Por encima del objetivo</div>
+                                <div class="valor <%= resumen.criticos ? 'text-danger' : 'text-dark' %>"><%= resumen.criticos %></div>
+                            </div>
+                        </div>
+                    </div>
+                    <div class="col-6 col-lg-3">
+                        <div class="card border-0 shadow-sm rc-kpi h-100" style="border-left-color:#b45309">
+                            <div class="card-body py-3">
+                                <div class="text-secondary small text-uppercase">Cálculo incompleto</div>
+                                <div class="valor <%= resumen.incompletos ? 'text-warning-emphasis' : 'text-dark' %>"><%= resumen.incompletos %></div>
+                                <div class="fs-8 text-muted">insumos sin ficha</div>
+                            </div>
+                        </div>
+                    </div>
+                </div>
+
+                <% if (resumen.incompletos > 0) { %>
+                    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-3">
+                        <i class="fa-solid fa-triangle-exclamation fs-4 mt-1"></i>
+                        <div class="small">
+                            <strong><%= resumen.incompletos %></strong> platillo(s) tienen ingredientes sin ficha de costo.
+                            Su food cost real es <strong>mayor</strong> que el mostrado aquí, porque esos insumos se
+                            están contando como si fueran gratis.
+                            <a href="/admin/fichas-costo?sinFicha=1" class="alert-link">Completar las fichas que faltan</a>.
+                        </div>
+                    </div>
+                <% } %>
+
+                <div class="card card-custom border-0 shadow-sm">
+                    <div class="card-body p-0">
+                        <div class="table-responsive">
+                            <table class="table table-hover align-middle mb-0 rc-tabla">
+                                <thead class="table-custom-thead text-uppercase fs-7 bg-light">
+                                    <tr>
+                                        <th class="ps-4 py-3">Platillo</th>
+                                        <th class="py-3 text-end">Costo</th>
+                                        <th class="py-3 text-end">Precio CUP</th>
+                                        <th class="py-3 text-end">Comisión</th>
+                                        <th class="py-3 text-end">Zelle</th>
+                                        <th class="py-3 text-center" style="min-width:150px">Food cost</th>
+                                        <th class="py-3 text-end">Margen</th>
+                                        <th class="py-3 text-end pe-4">Sugerido CUP</th>
+                                    </tr>
+                                </thead>
+                                <tbody>
+                                    <% if (!platillos.length) { %>
+                                        <tr><td colspan="8" class="text-center py-5 text-muted">
+                                            <i class="fa-solid fa-clipboard-list d-block fs-2 mb-2"></i>
+                                            No hay recetas activas para analizar.
+                                        </td></tr>
+                                    <% } else { %>
+                                        <% platillos.forEach(p => {
+                                            const fc = p.food_cost_porcentaje;
+                                            const ancho = fc === null ? 0 : Math.min(100, (fc / (objetivo * 2)) * 100);
+                                        %>
+                                            <tr>
+                                                <td class="ps-4">
+                                                    <div class="fw-semibold text-dark"><%= p.nombre %></div>
+                                                    <% if (p.ingredientes_sin_ficha > 0) { %>
+                                                        <div class="fs-8 text-danger">
+                                                            <i class="fa-solid fa-circle-exclamation me-1"></i><%= p.ingredientes_sin_ficha %> insumo(s) sin ficha
+                                                        </div>
+                                                    <% } %>
+                                                </td>
+                                                <td class="text-end rc-mono"><%= fmt(p.costo) %></td>
+                                                <td class="text-end rc-mono fw-semibold"><%= fmt(p.precio_cup) %></td>
+                                                <td class="text-end rc-mono text-muted"><%= fmt(p.precio_comision) %></td>
+                                                <td class="text-end rc-mono text-muted"><%= fmt(p.precio_zelle) %></td>
+                                                <td class="text-center">
+                                                    <% if (fc === null) { %>
+                                                        <span class="rc-chip bg-light text-secondary border">Sin precio</span>
+                                                    <% } else { %>
+                                                        <div class="d-flex align-items-center gap-2 justify-content-center">
+                                                            <span class="rc-chip bg-<%= p.evaluacion.clase %>-subtle text-<%= p.evaluacion.clase %>-emphasis rc-mono"><%= fmt(fc, 1) %>%</span>
+                                                            <div class="rc-barra flex-grow-1">
+                                                                <span class="bg-<%= p.evaluacion.clase %>" style="width:<%= ancho %>%"></span>
+                                                            </div>
+                                                        </div>
+                                                        <div class="fs-8 text-muted mt-1"><%= p.evaluacion.etiqueta %></div>
+                                                    <% } %>
+                                                </td>
+                                                <td class="text-end rc-mono <%= p.margen !== null && p.margen < 0 ? 'text-danger fw-bold' : '' %>">
+                                                    <%= fmt(p.margen) %>
+                                                </td>
+                                                <td class="text-end pe-4">
+                                                    <span class="rc-mono fw-semibold text-primary"><%= fmt(p.sugerido) %></span>
+                                                    <% if (p.precio_cup && p.sugerido > p.precio_cup) { %>
+                                                        <div class="fs-8 text-danger">▲ <%= fmt(p.sugerido - p.precio_cup) %></div>
+                                                    <% } else if (p.precio_cup && p.sugerido < p.precio_cup) { %>
+                                                        <div class="fs-8 text-success">holgura <%= fmt(p.precio_cup - p.sugerido) %></div>
+                                                    <% } %>
+                                                </td>
+                                            </tr>
+                                        <% }) %>
+                                    <% } %>
+                                </tbody>
+                            </table>
+                        </div>
+                    </div>
+                    <div class="card-footer bg-white border-0 small text-secondary">
+                        <i class="fa-solid fa-circle-info me-1"></i>
+                        El food cost se mide contra la carta CUP. «Sugerido» es el precio mínimo para alcanzar el
+                        objetivo del <%= objetivo %>%: <span class="rc-mono">Costo ÷ <%= (objetivo / 100).toFixed(2) %></span>,
+                        redondeado a múltiplos de <%= parametros.multiploRedondeo %>.
+                    </div>
+                </div>
+
+                <%- include('../includes/footer') %>
+            </main>
+        </div>
+    </div>
+    <script src="/js/bootstrap.bundle.min.js"></script>
+</body>
+</html>
