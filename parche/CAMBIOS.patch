+            <div class="card-body border-top p-0">
+                <div class="px-3 py-2 bg-light d-flex justify-content-between align-items-center">
+                    <span class="small text-secondary"><i class="fa-solid fa-shield-halved me-1"></i><strong><%= paginacion.total.toLocaleString('es-ES') %></strong> operación(es) registrada(s)</span>
+                    <span class="small text-muted">Página <%= paginacion.pagina %> de <%= paginacion.totalPaginas %></span>
+                </div>
+                <div class="table-responsive">
+                    <table class="table table-hover align-middle mb-0 audit-table">
+                        <thead class="table-light text-uppercase text-secondary">
+                            <tr>
+                                <th class="ps-3">Fecha</th>
+                                <th>Usuario</th>
+                                <th>Categoría</th>
+                                <th>Acción</th>
+                                <th>Entidad</th>
+                                <th>Origen</th>
+                                <th>Resultado</th>
+                                <th>Datos</th>
+                            </tr>
+                        </thead>
+                        <tbody>
+                            <% if (logs && logs.length > 0) { %>
+                                <% logs.forEach(log => { %>
+                                    <tr class="<%= log.severidad === 'CRITICO' ? 'audit-row-critico' : (log.severidad === 'AVISO' ? 'audit-row-aviso' : '') %>">
+                                        <td class="ps-3 text-nowrap">
+                                            <%= log.creado_en ? new Date(log.creado_en).toLocaleString('es-ES') : '—' %>
+                                            <small class="d-block text-muted">
+                                                <%= log.duracion_ms || 0 %> ms
+                                                <% if (log.repeticiones && log.repeticiones > 1) { %>
+                                                    · <span class="text-info-emphasis" title="Peticiones de sondeo agrupadas en este asiento">×<%= log.repeticiones %></span>
+                                                <% } %>
+                                            </small>
+                                        </td>
+                                        <td class="text-nowrap">
+                                            <strong><%= log.usuario_nombre || 'Anónimo' %></strong>
+                                            <small class="d-block text-muted"><%= log.usuario_rol || 'público' %><%= log.usuario_id ? ` · #${log.usuario_id}` : '' %></small>
+                                        </td>
+                                        <td class="text-nowrap">
+                                            <span class="audit-chip <%= colorCategoria[log.categoria] || 'bg-light text-secondary border' %>">
+                                                <i class="fa-solid <%= iconoCategoria[log.categoria] || 'fa-circle' %> me-1"></i><%= log.categoria || '—' %>
+                                            </span>
+                                            <% if (log.severidad && log.severidad !== 'INFO') { %>
+                                                <span class="audit-chip <%= colorSeveridad[log.severidad] %> ms-1"><%= log.severidad %></span>
+                                            <% } %>
+                                            <% if (log.modulo) { %><small class="d-block text-muted mt-1"><%= log.modulo %></small><% } %>
+                                        </td>
+                                        <td><%= log.accion %></td>
+                                        <td class="text-nowrap">
+                                            <% if (log.entidad) { %>
+                                                <%= log.entidad %>
+                                                <% if (log.entidad_id) { %><small class="d-block text-muted audit-code">#<%= log.entidad_id %></small><% } %>
+                                            <% } else { %>—<% } %>
+                                        </td>
+                                        <td class="audit-code text-nowrap">
+                                            <%= log.metodo_http %> <%= log.ruta %>
+                                            <small class="d-block text-muted"><%= log.ip_origen || '—' %></small>
+                                        </td>
+                                        <td class="text-nowrap">
+                                            <span class="fw-bold <%= log.operacion_exitosa ? 'audit-success' : 'audit-failure' %>">
+                                                <i class="fa-solid <%= log.operacion_exitosa ? 'fa-circle-check' : 'fa-circle-xmark' %> me-1"></i><%= log.estado_http || '—' %>
+                                            </span>
+                                        </td>
+                                        <td class="audit-details">
+                                            <% if (log.datos_operacion) { %>
+                                                <details>
+                                                    <summary class="text-primary" style="cursor:pointer;">Ver datos</summary>
+                                                    <pre class="audit-code bg-light border rounded p-2 mt-2 mb-0"><%= log.datos_operacion %></pre>
+                                                </details>
+                                            <% } else { %>—<% } %>
+                                        </td>
+                                    </tr>
+                                <% }) %>
+                            <% } else { %>
+                                <tr><td colspan="8" class="text-center text-muted py-5"><i class="fa-solid fa-clipboard-check fs-3 d-block mb-2"></i>No hay operaciones para los filtros seleccionados.</td></tr>
+                            <% } %>
+                        </tbody>
+                    </table>
+                </div>
+            </div>
+
+            <% if (paginacion.totalPaginas > 1) { %>
+                <%
+                    const actual = paginacion.pagina;
+                    const ultima = paginacion.totalPaginas;
+                    // Ventana de páginas alrededor de la actual: evita pintar
+                    // cientos de enlaces cuando el historial es grande
+                    const inicio = Math.max(1, actual - 2);
+                    const fin = Math.min(ultima, actual + 2);
+                %>
+                <div class="card-footer bg-white border-0 d-flex justify-content-center">
+                    <nav aria-label="Paginación de auditoría">
+                        <ul class="pagination pagination-sm mb-0">
+                            <li class="page-item <%= actual === 1 ? 'disabled' : '' %>">
+                                <a class="page-link" href="/admin/auditoria?<%= qs({ pagina: 1 }) %>">«</a>
+                            </li>
+                            <% if (inicio > 1) { %><li class="page-item disabled"><span class="page-link">…</span></li><% } %>
+                            <% for (let p = inicio; p <= fin; p++) { %>
+                                <li class="page-item <%= p === actual ? 'active' : '' %>">
+                                    <a class="page-link" href="/admin/auditoria?<%= qs({ pagina: p }) %>"><%= p %></a>
+                                </li>
+                            <% } %>
+                            <% if (fin < ultima) { %><li class="page-item disabled"><span class="page-link">…</span></li><% } %>
+                            <li class="page-item <%= actual === ultima ? 'disabled' : '' %>">
+                                <a class="page-link" href="/admin/auditoria?<%= qs({ pagina: ultima }) %>">»</a>
+                            </li>
+                        </ul>
+                    </nav>
+                </div>
+            <% } %>
+        </div>
+
+        <!-- Política de retención: solo superadministrador -->
+        <% if (user && user.rol === 'superadministrador') { %>
+            <div class="card border-0 shadow-sm mb-4">
+                <div class="card-body">
+                    <h6 class="fw-bold mb-1"><i class="fa-solid fa-broom me-2 text-secondary"></i>Retención del historial</h6>
+                    <p class="small text-secondary mb-3">
+                        El registro crece de forma continua. Esta purga elimina la actividad ordinaria
+                        más antigua y conserva durante más tiempo los asientos <strong>críticos</strong>
+                        (cobros, cierres, borrados, permisos y accesos denegados).
+                    </p>
+                    <form method="post" action="/admin/auditoria/purgar" class="row g-2 align-items-end"
+                          onsubmit="return confirm('Se eliminarán definitivamente los asientos anteriores a los días indicados. ¿Continuar?');">
+                        <div class="col-6 col-md-3">
+                            <label for="dias" class="form-label small fw-semibold text-secondary">Conservar actividad ordinaria (días)</label>
+                            <input type="number" min="7" max="3650" class="form-control form-control-sm" id="dias" name="dias" value="180">
+                        </div>
+                        <div class="col-6 col-md-3">
+                            <label for="diasCritico" class="form-label small fw-semibold text-secondary">Conservar asientos críticos (días)</label>
+                            <input type="number" min="30" max="3650" class="form-control form-control-sm" id="diasCritico" name="diasCritico" value="730">
+                        </div>
+                        <div class="col-md-3">
+                            <button type="submit" class="btn btn-sm btn-outline-danger">
+                                <i class="fa-solid fa-trash me-1"></i>Ejecutar purga
+                            </button>
+                        </div>
+                    </form>
+                </div>
+            </div>
+        <% } %>
+
+        <footer class="mt-auto"><%- include('../includes/footer') %></footer>
+    </main>
+    <script src="/js/bootstrap.bundle.min.js"></script>
+</body>
+</html>
diff --git b/views/admin/licencia-bloqueada.ejs b/views/admin/licencia-bloqueada.ejs
new file mode 100644
index 0000000..9d88de2
--- /dev/null
+++ b/views/admin/licencia-bloqueada.ejs
@@ -0,0 +1,60 @@
+<!DOCTYPE html>
+<html lang="es">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Licencia no válida - Restaurante Bahía</title>
+    <link rel="stylesheet" href="/css/bootstrap.min.css">
+    <link rel="stylesheet" href="/css/all.min.css">
+    <style>
+        body { background:#0f172a; min-height:100vh; display:flex; align-items:center; }
+        .tarjeta { max-width: 720px; margin: 0 auto; border-radius: 1rem; }
+        .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
+        .codigo { font-family: ui-monospace, monospace; font-size:1.3rem; font-weight:700; letter-spacing:.08em; }
+    </style>
+</head>
+<body>
+    <div class="container py-5">
+        <div class="card border-0 shadow-lg tarjeta">
+            <div class="card-body p-4 p-md-5">
+                <div class="text-center mb-4">
+                    <i class="fa-solid fa-lock fs-1 text-danger"></i>
+                    <h1 class="h3 fw-bold mt-3 mb-1">Licencia no válida</h1>
+                    <p class="text-secondary mb-0">
+                        Esta instalación no tiene una licencia válida. Puedes seguir
+                        <strong>cerrando</strong> las operaciones abiertas (cobrar cuentas y cerrar el
+                        turno), pero no abrir trabajo nuevo.
+                    </p>
+                </div>
+
+                <div class="alert alert-danger border-0">
+                    <div class="fw-bold mb-2">Motivo</div>
+                    <ul class="mb-0 small">
+                        <% (evaluacion.problemas || []).forEach(p => { %>
+                            <li><span class="mono">[<%= p.codigo %>]</span> <%= p.mensaje %></li>
+                        <% }) %>
+                    </ul>
+                </div>
+
+                <div class="bg-light rounded p-3 mb-3">
+                    <div class="small text-secondary mb-1">Código de instalación</div>
+                    <div class="codigo"><%= evaluacion.instalacion.codigo %></div>
+                    <div class="small text-muted mt-2">
+                        Facilita este código al proveedor para obtener o renovar tu licencia.
+                    </div>
+                </div>
+
+                <div class="d-flex flex-wrap gap-2">
+                    <a href="/admin/licencia" class="btn btn-primary">
+                        <i class="fa-solid fa-key me-1"></i>Instalar o revisar licencia
+                    </a>
+                    <a href="/admin/cierre-dia" class="btn btn-outline-secondary">
+                        <i class="fa-solid fa-cash-register me-1"></i>Cerrar cuentas pendientes
+                    </a>
+                    <a href="/logout" class="btn btn-outline-secondary">Salir</a>
+                </div>
+            </div>
+        </div>
+    </div>
+</body>
+</html>
diff --git b/views/admin/licencia.ejs b/views/admin/licencia.ejs
new file mode 100644
index 0000000..d4693f3
--- /dev/null
+++ b/views/admin/licencia.ejs
@@ -0,0 +1,305 @@
+<!DOCTYPE html>
+<html lang="es">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title><%= pageTitle %> - Restaurante Bahía</title>
+    <link rel="stylesheet" href="/css/bootstrap.min.css">
+    <link rel="stylesheet" href="/css/all.min.css">
+    <link rel="stylesheet" href="/css/styles.css">
+    <style>
+        .lic-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
+        .lic-codigo { font-family: ui-monospace, monospace; font-size: 1.35rem; font-weight: 700;
+                      letter-spacing: .08em; color: #0f172a; }
+        .lic-chip { font-size: .68rem; font-weight: 600; padding: .2rem .5rem; border-radius: .35rem; }
+        .lic-barra { height: 8px; border-radius: 4px; background: #e2e8f0; overflow: hidden; }
+        .lic-barra span { display: block; height: 100%; }
+        .lic-comp { font-size: .78rem; padding: .35rem 0; border-bottom: 1px dashed #e2e8f0; }
+        .lic-comp:last-child { border-bottom: 0; }
+    </style>
+</head>
+<body>
+    <%- include('../includes/topBarMobile') %>
+    <div class="container-fluid">
+        <div class="row">
+            <%- include('../includes/sideBarMenu') %>
+            <main class="col-md-9 ms-md-auto col-lg-10 px-md-5 py-4">
+                <%- include('../includes/header', {
+                    encabezado_pagina: '🔐 Licencia del Sistema',
+                    desc_pagina: 'Estado de la licencia, identidad de esta instalación y comprobaciones de integridad.',
+                    add_btn: false
+                }) %>
+
+                <%
+                    const e = evaluacion;
+                    const colores = { ACTIVA:'success', GRACIA:'warning', BLOQUEADA:'danger', SIN_LICENCIA:'danger' };
+                    const color = colores[e.estado] || 'secondary';
+                    const fecha = v => v ? new Date(v).toLocaleString('es-ES') : '—';
+                    const nombresComponente = {
+                        maquina:'Identificador del sistema operativo', disco:'Disco / volumen raíz',
+                        red:'Tarjetas de red', cpu:'Procesador', nucleos:'Núcleos',
+                        so:'Sistema y arquitectura', equipo:'Nombre del equipo', memoria:'Memoria instalada'
+                    };
+                %>
+
+                <!-- Estado general -->
+                <div class="card border-0 shadow-sm mb-4 border-start border-4 border-<%= color %>">
+                    <div class="card-body">
+                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
+                            <div>
+                                <div class="text-uppercase small text-secondary">Estado</div>
+                                <div class="fs-3 fw-bold text-<%= color %>"><%= e.estado.replace('_',' ') %></div>
+                                <% if (e.licencia) { %>
+                                    <div class="text-secondary small mt-1">
+                                        <%= e.licencia.cliente %> · plan <%= e.licencia.plan %> ·
+                                        <span class="lic-mono"><%= e.licencia.id %></span>
+                                    </div>
+                                <% } else { %>
+                                    <div class="text-secondary small mt-1">No hay ninguna licencia instalada en este equipo.</div>
+                                <% } %>
+                            </div>
+                            <div class="text-end">
+                                <% if (e.licencia && e.licencia.expira_en) { %>
+                                    <div class="text-uppercase small text-secondary">Caduca</div>
+                                    <div class="fw-bold"><%= new Date(e.licencia.expira_en).toLocaleDateString('es-ES') %></div>
+                                <% } else if (e.licencia) { %>
+                                    <span class="lic-chip bg-success-subtle text-success-emphasis">Perpetua</span>
+                                <% } %>
+                            </div>
+                        </div>
+
+                        <% if (e.gracia) { %>
+                            <div class="alert alert-warning border-0 mt-3 mb-0 d-flex align-items-start gap-3">
+                                <i class="fa-solid fa-hourglass-half fs-4 mt-1"></i>
+                                <div>
+                                    <div class="fw-bold">Periodo de gracia · quedan <%= e.gracia.dias_restantes %> de <%= e.gracia.dias_totales %> días</div>
+                                    <div class="small">
+                                        El sistema funciona con normalidad, pero al agotarse este plazo solo se
+                                        permitirá <strong>cerrar</strong> las operaciones abiertas: cobrar las cuentas
+                                        en curso y cerrar el turno. No se podrán abrir turnos ni comandas nuevas.
+                                    </div>
+                                </div>
+                            </div>
+                        <% } %>
+
+                        <% if (e.problemas.length) { %>
+                            <div class="alert alert-danger border-0 mt-3 mb-0">
+                                <div class="fw-bold mb-2"><i class="fa-solid fa-triangle-exclamation me-2"></i>Problemas detectados</div>
+                                <ul class="mb-0 small">
+                                    <% e.problemas.forEach(p => { %>
+                                        <li><span class="lic-mono text-danger-emphasis">[<%= p.codigo %>]</span> <%= p.mensaje %></li>
+                                    <% }) %>
+                                </ul>
+                            </div>
+                        <% } %>
+
+                        <% if (e.avisos.length) { %>
+                            <div class="alert alert-warning border-0 mt-3 mb-0">
+                                <ul class="mb-0 small">
+                                    <% e.avisos.forEach(p => { %>
+                                        <li><span class="lic-mono">[<%= p.codigo %>]</span> <%= p.mensaje %></li>
+                                    <% }) %>
+                                </ul>
+                            </div>
+                        <% } %>
+                    </div>
+                </div>
+
+                <div class="row g-4">
+                    <!-- Identidad de la instalación -->
+                    <div class="col-lg-6">
+                        <div class="card border-0 shadow-sm h-100">
+                            <div class="card-header bg-white border-0 py-3">
+                                <h6 class="fw-bold mb-0"><i class="fa-solid fa-fingerprint me-2 text-primary"></i>Identidad de esta instalación</h6>
+                            </div>
+                            <div class="card-body">
+                                <div class="text-secondary small mb-1">Código de instalación (dictable por teléfono)</div>
+                                <div class="lic-codigo mb-3"><%= e.instalacion.codigo %></div>
+
+                                <div class="lic-comp d-flex justify-content-between">
+                                    <span class="text-secondary">Identificador</span>
+                                    <span class="lic-mono"><%= e.instalacion.uuid %></span>
+                                </div>
+                                <div class="lic-comp d-flex justify-content-between">
+                                    <span class="text-secondary">Huella del equipo</span>
+                                    <span class="lic-mono"><%= e.instalacion.huella_resumen %>…</span>
+                                </div>
+
+                                <a href="/admin/licencia/solicitud" class="btn btn-sm btn-outline-primary mt-3">
+                                    <i class="fa-solid fa-download me-1"></i>Descargar solicitud de licencia
+                                </a>
+                                <div class="form-text fs-8 mt-2">
+                                    Envía este archivo (o dicta el código) al proveedor para obtener tu licencia.
+                                </div>
+                            </div>
+                        </div>
+                    </div>
+
+                    <!-- Tiempo de confianza -->
+                    <div class="col-lg-6">
+                        <div class="card border-0 shadow-sm h-100">
+                            <div class="card-header bg-white border-0 py-3">
+                                <h6 class="fw-bold mb-0"><i class="fa-solid fa-clock me-2 text-primary"></i>Tiempo de confianza</h6>
+                                <div class="text-muted fs-8">Inmune a los cambios de hora del equipo</div>
+                            </div>
+                            <div class="card-body">
+                                <div class="lic-comp d-flex justify-content-between">
+                                    <span class="text-secondary">Tiempo verificado</span>
+                                    <span class="lic-mono fw-semibold"><%= fecha(e.tiempo.confiable) %></span>
+                                </div>
+                                <div class="lic-comp d-flex justify-content-between">
+                                    <span class="text-secondary">Reloj del equipo</span>
+                                    <span class="lic-mono <%= e.tiempo.reloj_manipulado ? 'text-danger fw-bold' : '' %>"><%= fecha(e.tiempo.sistema) %></span>
+                                </div>
+                                <div class="lic-comp d-flex justify-content-between">
+                                    <span class="text-secondary">Fuente del tiempo</span>
+                                    <span class="lic-mono"><%= e.tiempo.fuente %></span>
+                                </div>
+
+                                <% if (e.tiempo.reloj_manipulado) { %>
+                                    <div class="alert alert-danger border-0 mt-3 mb-0 py-2 small">
+                                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
+                                        El reloj del equipo va <strong><%= e.tiempo.retraso_horas %> horas</strong> por
+                                        detrás del tiempo que el propio sistema ya tiene registrado en sus ventas,
+                                        cierres y auditoría. Atrasar la hora no prolonga la licencia.
+                                    </div>
+                                <% } %>
+
+                                <div class="mt-3 pt-2 border-top">
+                                    <div class="d-flex justify-content-between small">
+                                        <span class="text-secondary">Días de uso</span>
+                                        <span class="lic-mono fw-semibold">
+                                            <%= e.uso.dias_consumidos %><%= e.uso.dias_contratados ? ' / ' + e.uso.dias_contratados : '' %>
+                                        </span>
+                                    </div>
+                                    <% if (e.uso.dias_contratados) {
+                                        const pct = Math.min(100, Math.round((e.uso.dias_consumidos / e.uso.dias_contratados) * 100));
+                                        const c = pct >= 90 ? 'danger' : (pct >= 75 ? 'warning' : 'success'); %>
+                                        <div class="lic-barra mt-2"><span class="bg-<%= c %>" style="width:<%= pct %>%"></span></div>
+                                    <% } %>
+                                    <div class="d-flex justify-content-between small mt-2">
+                                        <span class="text-secondary">Arranques registrados</span>
+                                        <span class="lic-mono"><%= e.uso.secuencia %></span>
+                                    </div>
+                                </div>
+                            </div>
+                        </div>
+                    </div>
+
+                    <!-- Huella del equipo -->
+                    <div class="col-lg-6">
+                        <div class="card border-0 shadow-sm h-100">
+                            <div class="card-header bg-white border-0 py-3">
+                                <h6 class="fw-bold mb-0"><i class="fa-solid fa-microchip me-2 text-primary"></i>Componentes del equipo</h6>
+                                <% if (comparacion) { %>
+                                    <div class="text-muted fs-8">
+                                        Coincidencia con el equipo autorizado:
+                                        <strong class="text-<%= comparacion.coincide ? 'success' : 'danger' %>"><%= comparacion.puntuacion %>%</strong>
+                                        (se exige <%= comparacion.umbral %>%)
+                                    </div>
+                                <% } %>
+                            </div>
+                            <div class="card-body">
+                                <% Object.entries(huella.componentes).forEach(([nombre, valor]) => {
+                                    let estadoComp = 'no-detectado';
+                                    if (comparacion) {
+                                        if (comparacion.coincidentes.includes(nombre)) estadoComp = 'coincide';
+                                        else if (comparacion.divergentes.includes(nombre)) estadoComp = 'difiere';
+                                        else if (comparacion.ausentes.includes(nombre)) estadoComp = 'no-registrado';
+                                    } else if (valor) estadoComp = 'detectado';
+                                %>
+                                    <div class="lic-comp d-flex justify-content-between align-items-center">
+                                        <span class="text-secondary"><%= nombresComponente[nombre] || nombre %>
+                                            <span class="text-muted">· peso <%= huella.pesos[nombre] %></span>
+                                        </span>
+                                        <% if (estadoComp === 'coincide') { %>
+                                            <span class="lic-chip bg-success-subtle text-success-emphasis"><i class="fa-solid fa-check me-1"></i>coincide</span>
+                                        <% } else if (estadoComp === 'difiere') { %>
+                                            <span class="lic-chip bg-danger-subtle text-danger-emphasis"><i class="fa-solid fa-xmark me-1"></i>difiere</span>
+                                        <% } else if (estadoComp === 'no-registrado') { %>
+                                            <span class="lic-chip bg-light text-secondary border">no registrado</span>
+                                        <% } else if (valor) { %>
+                                            <span class="lic-mono text-muted"><%= valor.slice(0,10) %>…</span>
+                                        <% } else { %>
+                                            <span class="lic-chip bg-light text-secondary border">no disponible</span>
+                                        <% } %>
+                                    </div>
