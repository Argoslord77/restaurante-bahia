# Puerto del servidor
PORT=3000

# Configuración de Base de Datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=restaurante_user
DB_PASS=tu_contraseña_segura
DB_NAME=restaurante_db
DB_SSL=false

# Configuración de Base de Datos para Testing
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASS=
TEST_DB_NAME=restaurante_db_test

# Secretos de sesión y cookies
SESSION_SECRET=tu_secreto_de_sesion_muy_largo_y_seguro
COOKIE_SECRET=tu_secreto_de_cookies_muy_largo_y_seguro

# Ambiente
NODE_ENV=development

# IP fija del servidor (opcional; normalmente vacío para soportar DHCP)
SERVER_IP=
