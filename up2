CREATE TABLE `pedidos` (
    `id` BIGINT(20) UNSIGNED NOT NULL AUTO_INCREMENT,
    `id_mesa` INT(11) NOT NULL,
    `cliente_nombre` VARCHAR(100) NULL DEFAULT NULL COLLATE 'utf8mb4_general_ci',
    `comensales` INT(11) NOT NULL DEFAULT '1',
    `estado_pedido` ENUM('pendiente','preparando','listo','entregado','cancelado') NULL DEFAULT 'pendiente' COLLATE 'utf8mb4_general_ci',
    `fecha_precuenta` DATETIME NULL DEFAULT NULL,
    `impresiones_precuenta` INT(10) UNSIGNED NOT NULL DEFAULT '0',
    `estado_pago` ENUM('pendiente','pagado','cortesia','facturado','cancelado') NOT NULL DEFAULT 'pendiente' COLLATE 'utf8mb4_general_ci',
    `subtotal` DECIMAL(10,2) NOT NULL DEFAULT '0.00',
    `descuento` DECIMAL(10,2) NOT NULL DEFAULT '0.00',
    `impuesto` DECIMAL(10,2) NOT NULL DEFAULT '0.00',
    `total` DECIMAL(10,2) NOT NULL DEFAULT '0.00',
    `propina` DECIMAL(10,2) NOT NULL DEFAULT '0.00',
    `id_usuario_mesero` INT(11) NOT NULL,
    `id_usuario_cajero` INT(11) NULL DEFAULT NULL,
    `creado_en` TIMESTAMP NOT NULL DEFAULT current_timestamp(),
    `actualizado_en` TIMESTAMP NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
    `fecha_cierre` DATETIME NULL DEFAULT NULL,
    `turno_servicio_id` BIGINT(20) UNSIGNED NOT NULL,
    PRIMARY KEY (`id`) USING BTREE,
    INDEX `fk_pedidos_mesa` (`id_mesa`) USING BTREE,
    INDEX `fk_pedidos_mesero` (`id_usuario_mesero`) USING BTREE,
    INDEX `fk_pedidos_cajero` (`id_usuario_cajero`) USING BTREE,
    INDEX `fk_pedidos_turno` (`turno_servicio_id`) USING BTREE,
    INDEX `idx_pedidos_mesa_estado` (`id_mesa`, `estado_pedido`, `estado_pago`) USING BTREE,
    CONSTRAINT `fk_pedidos_cajero` FOREIGN KEY (`id_usuario_cajero`) REFERENCES `usuarios` (`id`) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT `fk_pedidos_mesa` FOREIGN KEY (`id_mesa`) REFERENCES `mesas` (`id`) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT `fk_pedidos_mesero` FOREIGN KEY (`id_usuario_mesero`) REFERENCES `usuarios` (`id`) ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT `fk_pedidos_turno` FOREIGN KEY (`turno_servicio_id`) REFERENCES `turnos_servicio` (`id`) ON UPDATE RESTRICT ON DELETE RESTRICT
)
COLLATE='utf8mb4_general_ci'
ENGINE=InnoDB
AUTO_INCREMENT=24
;


CREATE TABLE `platillos_menu` (
    `id` BIGINT(20) UNSIGNED NOT NULL AUTO_INCREMENT,
    `nombre` VARCHAR(150) NOT NULL COLLATE 'utf8mb4_unicode_ci',
    `descripcion` TEXT NULL DEFAULT NULL COLLATE 'utf8mb4_unicode_ci',
    `precio` DECIMAL(10,2) NOT NULL,
    `categoria` VARCHAR(100) NOT NULL COLLATE 'utf8mb4_unicode_ci',
    `precio_alt` DECIMAL(10,2) NULL DEFAULT NULL,
    `foto` VARCHAR(255) NULL DEFAULT NULL COLLATE 'utf8mb4_unicode_ci',
    `creado_en` TIMESTAMP NOT NULL DEFAULT current_timestamp(),
    PRIMARY KEY (`id`) USING BTREE
)
COLLATE='utf8mb4_unicode_ci'
ENGINE=InnoDB
AUTO_INCREMENT=162
;

CREATE TABLE `detalles_pedido` (
    `id` BIGINT(20) UNSIGNED NOT NULL AUTO_INCREMENT,
    `id_pedido` BIGINT(20) UNSIGNED NOT NULL,
    `id_platillo` BIGINT(20) UNSIGNED NOT NULL,
    `cantidad` INT(11) NOT NULL,
    `precio_unitario` DECIMAL(10,2) NOT NULL,
    `notas_especiales` VARCHAR(255) NULL DEFAULT NULL COLLATE 'utf8mb4_general_ci',
    `estado_item` ENUM('en_espera','en_cocina','en_bar','listo','entregado','cancelado') NULL DEFAULT 'en_espera' COLLATE 'utf8mb4_general_ci',
    `afecta_inventario` TINYINT(1) NULL DEFAULT '1',
    PRIMARY KEY (`id`) USING BTREE,
    INDEX `fk_dp_pedido` (`id_pedido`) USING BTREE,
    INDEX `fk_dp_platillo` (`id_platillo`) USING BTREE,
    INDEX `idx_dp_estado_item` (`estado_item`, `afecta_inventario`) USING BTREE,
    CONSTRAINT `fk_dp_pedido` FOREIGN KEY (`id_pedido`) REFERENCES `pedidos` (`id`) ON UPDATE RESTRICT ON DELETE CASCADE,
    CONSTRAINT `fk_dp_platillo` FOREIGN KEY (`id_platillo`) REFERENCES `platillos_menu` (`id`) ON UPDATE RESTRICT ON DELETE NO ACTION
)
COLLATE='utf8mb4_general_ci'
ENGINE=InnoDB
AUTO_INCREMENT=140
;

CREATE TABLE `pre_pedidos` (
    `id` BIGINT(20) UNSIGNED NOT NULL AUTO_INCREMENT,
    `id_mesa` INT(11) NOT NULL,
    `id_platillo` BIGINT(20) UNSIGNED NOT NULL,
    `cantidad` INT(11) NOT NULL DEFAULT '1',
    `notas_especiales` VARCHAR(255) NULL DEFAULT NULL COLLATE 'utf8mb4_general_ci',
    `creado_en` TIMESTAMP NOT NULL DEFAULT current_timestamp(),
    PRIMARY KEY (`id`) USING BTREE,
    INDEX `fk_prepedidos_mesa` (`id_mesa`) USING BTREE,
    INDEX `fk_prepedidos_platillo` (`id_platillo`) USING BTREE,
    CONSTRAINT `fk_prepedidos_mesa` FOREIGN KEY (`id_mesa`) REFERENCES `mesas` (`id`) ON UPDATE RESTRICT ON DELETE CASCADE,
    CONSTRAINT `fk_prepedidos_platillo` FOREIGN KEY (`id_platillo`) REFERENCES `platillos_menu` (`id`) ON UPDATE RESTRICT ON DELETE CASCADE
)
COLLATE='utf8mb4_general_ci'
ENGINE=InnoDB
AUTO_INCREMENT=2
;

CREATE TABLE `notificaciones_mesero` (
    `id` BIGINT(20) UNSIGNED NOT NULL AUTO_INCREMENT,
    `id_mesa` INT(11) NOT NULL,
    `id_pedido` BIGINT(20) UNSIGNED NULL DEFAULT NULL,
    `tipo` ENUM('LLAMADA_SERVICIO','SOLICITUD_CIERRE','PRE_PEDIDO') NOT NULL DEFAULT 'LLAMADA_SERVICIO' COLLATE 'utf8mb4_general_ci',
    `mensaje` VARCHAR(255) NOT NULL COLLATE 'utf8mb4_general_ci',
    `leido` TINYINT(1) NOT NULL DEFAULT '0',
    `creado_en` TIMESTAMP NOT NULL DEFAULT current_timestamp(),
    PRIMARY KEY (`id`) USING BTREE,
    INDEX `fk_notif_mesa` (`id_mesa`) USING BTREE,
    INDEX `fk_notif_pedido` (`id_pedido`) USING BTREE,
    INDEX `idx_notif_estado` (`id_mesa`, `leido`) USING BTREE,
    CONSTRAINT `fk_notif_mesa` FOREIGN KEY (`id_mesa`) REFERENCES `mesas` (`id`) ON UPDATE RESTRICT ON DELETE CASCADE,
    CONSTRAINT `fk_notif_pedido` FOREIGN KEY (`id_pedido`) REFERENCES `pedidos` (`id`) ON UPDATE RESTRICT ON DELETE CASCADE
)
COLLATE='utf8mb4_general_ci'
ENGINE=InnoDB
AUTO_INCREMENT=5
;
